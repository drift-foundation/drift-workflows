// Microflows host e2e — planned creation, the durable instance-ARGUMENTS path, and the
// pinned-identity reads, against a real MariaDB instance.
//
// Exercises the HostImpl methods that the SP regression covers at the procedure level but
// which had NO live host coverage (an SP-name or decode defect in HostImpl would otherwise
// pass): create_planned (Created / Exists / WorkflowConflict), args_get (Found / NotFound),
// plan_get (Found / NotFound). Confirms the host CANONICALIZES arguments at the boundary
// (reordered keys are idempotent) and that args_get round-trips the canonical object.
//
// Prerequisites: MariaDB on 127.0.0.1:34214 (root/rootpw), microflows schema + procs loaded.
// Isolation: this run's script_name IS the per-run namespace (MICROFLOWS_E2E_NS).

module microflows.tests.e2e.live_args_test;

import std.core as core;
import std.core.arc as arc;
import std.io as io;
import std.json as json;
import std.env as env;
import std.uuid as uuid;
import std.codec as codec;
import microflows.host as host;

// DB endpoint/credentials come from the cert-env-resolved environment (DB_HOST/DB_PORT/
// DB_USER/MDB_ROOT_PWD); local-dev fallbacks match the historical defaults.
fn _env_or(key: String, dflt: String) nothrow -> String {
	match env.get(key) {
		Optional::Some(v) => { if v.byte_length() > 0 { return move v; } },
		Optional::None => {}
	}
	return dflt;
}

fn _config_json() -> json.JsonNode {
	val db_host = _env_or("DB_HOST", "127.0.0.1");
	val port = _env_or("DB_PORT", "34214");
	val user = _env_or("DB_USER", "root");
	val pwd = _env_or("MDB_ROOT_PWD", "rootpw");
	val text: String = "{\"backend\":\"mariadb\",\"host\":\"" + db_host + "\",\"port\":" + port + ",\"user\":\"" + user + "\",\"password\":\"" + pwd + "\",\"database\":\"microflows\",\"connect_timeout_ms\":3000,\"io_timeout_ms\":3000,\"pool\":{\"keepalive_interval_ms\":100}}";
	return json.parse(&text).or_throw();
}

fn _ns() nothrow -> String {
	match env.get("MICROFLOWS_E2E_NS") {
		Optional::Some(v) => { if v.byte_length() > 0 { return move v; } },
		Optional::None => {}
	}
	return "drift-test";
}

fn _concat(a: &String, b: &String) nothrow -> String {
	val na = a.byte_length();
	val nb = b.byte_length();
	var buf = io.buffer(na + nb);
	var i = 0;
	while i < na { io.buffer_write(&mut buf, i, a.byte_at(i)); i = i + 1; }
	var j = 0;
	while j < nb { io.buffer_write(&mut buf, na + j, b.byte_at(j)); j = j + 1; }
	return core.string_from_utf8_bytes(io.buffer_ptr(&buf), na + nb);
}

fn _build_host(worker_name: &String) -> arc.Arc<host.MicroflowsHost> {
	val cfg = _config_json();
	val identity = host.identity_from_worker_name(worker_name);
	var b = host.new_host_builder();
	host.with_json(&mut b, &cfg);
	host.with_identity(&mut b, move identity);
	return host.build_host(move b).or_throw();
}

fn _wf_id(seed: &String) nothrow -> Array<Byte> {
	val ns = _ns();
	val combined = _concat(&ns, seed);
	val u: uuid.Uuid = uuid.v3_from_string(&combined);
	return uuid.to_bytes(&u);
}

fn _expect_int(node: &json.JsonNode, key: &String, want: Int) nothrow -> Bool {
	match node.get(key) {
		Optional::Some(n) => {
			match n.as_int() { Optional::Some(v) => { return v == want; }, Optional::None => { return false; } }
		},
		Optional::None => { return false; }
	}
}

fn scenario_args() -> Int {
	val h = _build_host(&"pd-args-w1");
	val script = _ns();
	val wf = _wf_id(&"-args-wf1");
	val absent = _wf_id(&"-args-never");

	// 33-byte content_hash (1 scheme byte + 32-byte digest); value is arbitrary for this test.
	val ch = codec.hex_decode(&"010101010101010101010101010101010101010101010101010101010101010101").or_throw();

	// create_planned with instance arguments -> Created.
	match h.get().create_planned(&wf, &script, &"1.0.0",
		&"2026-01-01 10:00:00.000000", &"2026-01-01 10:00:00.000000",
		&"{\"pos\":\"start\"}", &"{}", &ch, 2, &"{\"b\":2,\"a\":1}") {
		host.CreatePlannedOutcome::Created(_) => {},
		default => { return 301; }
	}

	// Idempotent re-create with the SAME content in a DIFFERENT key order -> Exists (the host
	// canonicalizes at the boundary, so reordering is not a conflict).
	match h.get().create_planned(&wf, &script, &"1.0.0",
		&"2026-01-01 10:00:00.000000", &"2026-01-01 10:00:00.000000",
		&"{\"pos\":\"start\"}", &"{}", &ch, 2, &"{\"a\":1,\"b\":2}") {
		host.CreatePlannedOutcome::Exists(_) => {},
		default => { return 302; }
	}

	// args_get: Found, round-tripping the canonical object {"a":1,"b":2}.
	match h.get().args_get(&wf) {
		host.ArgsGetOutcome::Found(args_json) => {
			val node = json.parse(&args_json).or_throw();
			if !_expect_int(&node, &"a", 1) { return 303; }
			if !_expect_int(&node, &"b", 2) { return 304; }
		},
		host.ArgsGetOutcome::NotFound => { return 305; }
	}

	// args_get on a never-created id: NotFound.
	match h.get().args_get(&absent) {
		host.ArgsGetOutcome::NotFound => {},
		host.ArgsGetOutcome::Found(_) => { return 306; }
	}

	// plan_get: Found (pinned identity) + NotFound — also previously untested live.
	match h.get().plan_get(&wf) {
		host.PlanGetOutcome::Found(p) => { if p.plan_version != "1.0.0" { return 307; } },
		host.PlanGetOutcome::NotFound => { return 308; }
	}
	match h.get().plan_get(&absent) {
		host.PlanGetOutcome::NotFound => {},
		host.PlanGetOutcome::Found(_) => { return 309; }
	}

	// Same plan name, DIFFERENT instance arguments -> WorkflowConflict (byte-compared).
	match h.get().create_planned(&wf, &script, &"1.0.0",
		&"2026-01-01 10:00:00.000000", &"2026-01-01 10:00:00.000000",
		&"{\"pos\":\"start\"}", &"{}", &ch, 2, &"{\"a\":1,\"b\":9}") {
		host.CreatePlannedOutcome::WorkflowConflict(_) => {},
		default => { return 310; }
	}

	return 0;
}

fn main() nothrow -> Int {
	try {
		val r = scenario_args();
		if r != 0 { return r; }
		return 0;
	} catch unexpected {
		return 9;
	}
}
