	pub fn operation_settle(self: &HostImpl, workflow_id: &Array<Byte>, fencing_token: Int,
	                        operation_seq: Int, operation_id: &Array<Byte>, checkpoint_seq: Int,
	                        result_json: &String, checkpoint_payload: &String,
	                        workflow_return_json: &Optional<String>, new_continuation: &String,
	                        event_ts: &String, event_payload: &String, is_final: Bool) -> OperationSettleOutcome {
		_validate_id16("workflow_id", workflow_id);
		_validate_id16("operation_id", operation_id);
		if fencing_token < 1 { throw HostException(kind = HostErrorKind::InvalidArg(field = "fencing_token")); }
		if operation_seq < 1 { throw HostException(kind = HostErrorKind::InvalidArg(field = "operation_seq")); }
		if checkpoint_seq < 1 { throw HostException(kind = HostErrorKind::InvalidArg(field = "checkpoint_seq")); }
		_validate_nonempty("event_ts", event_ts);
		try {
			var lease = _acquire_conn(self);
			val conn: &mut rpc.RpcConnection = lease.conn().or_throw();
			var args = rpc.new_args();
			args.push(rpc.arg_bytes(_dup_bytes(workflow_id)));
			args.push(rpc.arg_bytes(_dup_bytes(&self.identity.executor_id)));
			args.push(rpc.arg_int(fencing_token));
			args.push(rpc.arg_int(operation_seq));
			args.push(rpc.arg_bytes(_dup_bytes(operation_id)));
			args.push(rpc.arg_int(checkpoint_seq));
			args.push(_json_object_arg("result_json", result_json));
			args.push(_json_object_arg("checkpoint_payload", checkpoint_payload));
			args.push(_json_object_or_null_arg("workflow_return_json", workflow_return_json));
			args.push(_json_object_arg("continuation", new_continuation));
			args.push(rpc.arg_string(_dup(event_ts)));
			args.push(_meta_object_arg("event_payload", event_payload));
			var is_final_int: Int = 0;
			if is_final { is_final_int = 1; }
			args.push(rpc.arg_int(is_final_int));
			val sp: String = "sp_mf_operation_settle";
			val doc = _call_sp_doc(conn, &sp, move args);
			val outcome = _doc_outcome(&doc);
			if outcome == "settled" {
				return OperationSettleOutcome::Settled(_doc_object_text_req(&doc, &"result"));
			}
			if outcome == "already_settled" {
				return OperationSettleOutcome::AlreadySettled(_doc_object_text_req(&doc, &"result"));
			}
			if outcome == "operation_conflict" { return OperationSettleOutcome::OperationConflict(); }
			if outcome == "fence_lost" { return OperationSettleOutcome::FenceLost(); }
			if outcome == "not_found" { return OperationSettleOutcome::NotFound(); }
			if outcome == "operation_not_found" { return OperationSettleOutcome::OperationNotFound(); }
			if outcome == "plan_violation" {
				return OperationSettleOutcome::PlanViolation(_doc_str_req(&doc, &"reason", "settle-no-plan-violation-reason"));
			}
			if outcome == "event_time_skew" {
				return OperationSettleOutcome::EventTimeSkew(_doc_str_req(&doc, &"defer_until", "settle-no-defer-until"));
			}
			throw HostException(kind = HostErrorKind::BackendResponseInvalid(detail = "unexpected-outcome:operation_settle"));
		} catch managed:ManagedError(e) {
			val tag_owned: String = e.tag;
			throw HostException(kind = HostErrorKind::BackendUnavailable(detail = move tag_owned));
		}
	}

