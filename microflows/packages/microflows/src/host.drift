			val outcome = _doc_outcome(&doc);
			if outcome == "not_found" { return WorkflowInspectOutcome::NotFound(); }
			if outcome == "found" {
				val state_code = _doc_int_req(&doc, &"state", "inspect-no-state");
				val direction = _doc_int_req(&doc, &"execution_direction", "inspect-no-direction");
				val disp = _doc_int_req(&doc, &"current_disposition", "inspect-no-disposition");
				val terminal = _doc_int_req(&doc, &"is_terminal", "inspect-no-terminal");
				val leased = _doc_int_req(&doc, &"leased", "inspect-no-leased");
				val continuation = _doc_object_text_req(&doc, &"continuation");
				return WorkflowInspectOutcome::Found(WorkflowSnapshot(
					state_code = state_code,
