// Microflows MariaDB host gateway — milestone 1 (microflows_design.md §6,
// prior §24).
//
// Step 3 surface: workflow creation, lease claim/heartbeat/release, and
// database-clock sourcing. Remote-operation dispatch + result persistence
// arrive in step 4.
//
// Modeled on Singular's gateway (../pushcoin/singular gateway.drift): a
// connection pool wrapped behind an interface, every operation calling one
// stored procedure that returns ONE result row with ONE column `result` — a
// discriminated JSON DOCUMENT keyed by `outcome`.
//
// Time discipline (§24.4): the gateway never invents time. clock_read() is
// the sole clock source (database NOW(6)); every mutating call takes
// explicit, caller-fixed datetime strings and passes them through unchanged.

module microflows.host;

import std.core as core;
import std.core.arc as arc;
import std.concurrent as conc;
import std.io as io;
import std.json as json;
import std.codec as codec;
import std.mem as mem;
import std.uuid as uuid;

import mariadb.rpc as rpc;
import mariadb.rpc.pool as pool;
import mariadb.rpc.managed as managed;

export {
	MicroflowsHost,
	ExecutorIdentity,
	identity_from_worker_name,
	HostBuilder,
	new_host_builder,
	with_json,
	with_identity,
	build_host,
	HostConfigErrorKind,
	HostConfigError,
	HostErrorKind,
	HostException,
	ClockReading,
	ClaimedWorkflow,
	CreateOutcome,
	ClaimOutcome,
	HeartbeatOutcome,
	ReleaseOutcome,
	ClaimByIdOutcome,
	WorkflowSnapshot,
	WorkflowInspectOutcome,
	OperationRequestOutcome,
	OperationSettleOutcome,
	OperationResultOutcome,
	OperationFailOutcome,
	OperationRequestRecord,
	OperationRequestGetOutcome,
	BeginReversalOutcome,
	ReverseRequestOutcome,
	ReverseSettleOutcome,
	ReverseBlockOutcome,
	ReverseHeadOutcome,
	CreatePlannedOutcome
};

// ===== Identity =====

pub struct ExecutorIdentity {
	pub executor_id: Array<Byte>     // exactly 16 bytes
}

// Derive a stable 16-byte executor identity from a worker name (UUID v3).
pub fn identity_from_worker_name(worker_name: &String) nothrow -> ExecutorIdentity {
	val u: uuid.Uuid = uuid.v3_from_string(worker_name);
	val bytes: Array<Byte> = uuid.to_bytes(&u);
	return ExecutorIdentity(executor_id = move bytes);
}

// ===== Result shapes =====

// A database clock reading (§24.4): `now` plus an absolute deadline `now +
// lease_seconds` derived server-side. `deadline` is NEUTRAL — the caller decides
// what it bounds (a lease expiry for claim/heartbeat, OR a next-attempt time for
// a voluntary deferral), so retry scheduling is not coupled to lease duration.
// Both are datetime(6) literals ("YYYY-MM-DD HH:MM:SS.ffffff") passed onward as
// explicit, retry-fixed command parameters.
pub struct ClockReading {
	pub now: String,
	pub deadline: String
}

// The claimed snapshot: everything an executor needs to resume from the
// durable continuation under its new fencing token (§24.2, §24.5).
pub struct ClaimedWorkflow {
	pub workflow_id: Array<Byte>,
	pub fencing_token: Int,
	pub state_code: Int,             // microflows.state storage code
	pub execution_direction: Int,    // 1=forward 2=reverse (microflows.state)
	pub current_disposition: Int,
	pub script_name: String,
	pub script_revision: Int,
	pub current_event_seq: Int,
	pub current_operation_attempt: Int,
	pub continuation_json: String    // JSON object text (compact)
}

// create_workflow: the PK INSERT is the serializer; a replay of the same
// stable command ID (= workflow_id) resolves to Exists without mutating.
pub variant CreateOutcome { Created, Exists }

// claim_next: a due, unleased/expired instance for one registered script —
// or nothing due.
pub variant ClaimOutcome {
	Claimed(wf: ClaimedWorkflow),
	NoneDue
}

// claim_workflow: claim ONE specific workflow by id. NotClaimable = exists but
// leased / not due / terminal (inspect to distinguish); NotFound = absent.
pub variant ClaimByIdOutcome {
	Claimed(wf: ClaimedWorkflow),
	NotClaimable,
	NotFound
}

// A read-only workflow snapshot (inspect_workflow) — enough to distinguish
// terminal vs active(leased) vs claimable/deferred vs absent.
pub struct WorkflowSnapshot {
	pub state_code: Int,             // microflows.state storage code
	pub execution_direction: Int,
	pub current_disposition: Int,
	pub is_terminal: Bool,
	pub leased: Bool,                // an unexpired lease is held at db_now
	pub continuation_json: String
}

pub variant WorkflowInspectOutcome {
	Found(snapshot: WorkflowSnapshot),
	NotFound
}

// Fenced lease operations: FenceLost covers every mismatch (wrong owner,
// stale token, expired lease, non-claimable state) — a stale worker learns
// only that it can no longer publish.
pub variant HeartbeatOutcome { Extended, FenceLost, NotFound }
pub variant ReleaseOutcome { Released, FenceLost, NotFound }

// Operation request (persist request + suspended continuation before dispatch).
// FenceLost is fence-first (a stale executor must NOT receive Exists and
// dispatch). OperationConflict = same (workflow_id, operation_seq) with
// different immutable fields. EventTimeSkew = non-increasing event_ts.
pub variant OperationRequestOutcome {
	Requested(operation_id: Array<Byte>),
	Exists(operation_id: Array<Byte>),
	OperationConflict,
	FenceLost,
	NotFound,
	// The request is out of the pinned plan: seq out of range, or (seq > 1) the
	// predecessor has not settled. `reason` names which.
	PlanViolation(reason: String),
	// defer_until = current_event_ts + margin (the deferral deadline).
	EventTimeSkew(defer_until: String)
}

// operation_result: the LOCAL authoritative result (participant-independent),
// so a completed workflow stays inspectable when the participant is down.
pub variant OperationResultOutcome {
	Succeeded(result_json: String),
	Requested,
	NotFound
}

// operation_fail: durable non-retryable failure -> blocked_resolution. Blocked
// is the committed transition; AlreadyBlocked is the idempotent replay.
pub variant OperationFailOutcome {
	Blocked,
	AlreadyBlocked,
	OperationConflict,
	FenceLost,
	NotFound,
	OperationNotFound,
	EventTimeSkew(defer_until: String)
}

// begin_reversal: forward(1) -> reversing(2) (cursor at the top active checkpoint)
// or -> reversed(5) when nothing to compensate. AlreadyBegun is the trigger-bound
// idempotent replay (carrying the current reverse-direction state).
pub variant BeginReversalOutcome {
	Reversing(top_seq: Int),
	Reversed,
	AlreadyBegun(state: Int),
	TriggerMismatch,
	OperationNotFound,
	OperationConflict,
	OperationNotFailed(status: Int),
	FenceLost,
	NotFound,
	EventTimeSkew(defer_until: String)
}

// reverse_head: the authoritative top active checkpoint (the checkpoint stack,
// not the continuation, decides what to compensate next). Pending = not yet
// dispatched (forward identity to derive the binding); Dispatched = the durable
// pinned reverse binding to reconcile/redispatch against.
pub variant ReverseHeadOutcome {
	NoneActive,
	Pending(seq: Int, forward_operation_name: String, forward_payload: String),
	Dispatched(seq: Int, forward_operation_name: String, reverse_invocation_id: String,
	           reverse_operation_name: String, reverse_schema_version: Int,
	           reverse_input_json: String, reverse_input_hash: String)
}

// checkpoint_reverse_request: persist the reverse-invocation id + the full
// compensation binding before dispatch. AlreadyRequested returns the persisted id.
pub variant ReverseRequestOutcome {
	Requested(reverse_invocation_id: String),
	AlreadyRequested(reverse_invocation_id: String, reverse_operation_name: String,
	                 reverse_schema_version: Int, reverse_input_json: String, reverse_input_hash: String),
	BindingConflict,
	OutOfOrder(top_seq: Int),
	CheckpointInactive(reversal_state: Int),
	CheckpointNotFound,
	FenceLost,
	NotFound,
	EventTimeSkew(defer_until: String)
}

// checkpoint_reverse_settle: mark a checkpoint reversed then descend (Reversing
// next_seq) or reach terminal Reversed. AlreadyReversed is the lost-ack replay.
pub variant ReverseSettleOutcome {
	Reversed,
	Reversing(next_seq: Int),
	AlreadyReversed,
	ReverseIdMismatch,
	NotRequested,
	CheckpointNotSettleable(reversal_state: Int),
	OutOfOrder(top_seq: Int),
	CheckpointNotFound,
	FenceLost,
	NotFound,
	EventTimeSkew(defer_until: String)
}

// checkpoint_reverse_block: enter blocked_resolution (reverse direction).
pub variant ReverseBlockOutcome {
	Blocked,
	AlreadyBlocked,
	ReverseIdMismatch,
	NotRequested,
	CheckpointNotBlockable(reversal_state: Int),
	OutOfOrder(top_seq: Int),
	CheckpointNotFound,
	FenceLost,
	NotFound,
	EventTimeSkew(defer_until: String)
}

// The durable operation request — authoritative for recovery (a resuming worker
// uses this, never re-derives from CLI input).
pub struct OperationRequestRecord {
	pub operation_id: Array<Byte>,
	pub operation_name: String,
	pub schema_version: Int,
	pub input_json: String,
	pub input_hash: String,
	pub status: Int
}

pub variant OperationRequestGetOutcome {
	Found(record: OperationRequestRecord),
	NotFound
}

// Operation settle (record success + checkpoint + advance continuation +
// complete workflow). AlreadySettled.result is AUTHORITATIVE — the caller must
// use it, never its submitted result. Identify-first then idempotent-read
// before fence (settle clears the lease).
pub variant OperationSettleOutcome {
	Settled(result_json: String),
	AlreadySettled(result_json: String),
	OperationConflict,
	FenceLost,
	NotFound,
	OperationNotFound,
	// The settle violates the pinned plan: seq out of range, checkpoint_seq != seq, or
	// finality disagreeing with plan_length. `reason` names which.
	PlanViolation(reason: String),
	EventTimeSkew(defer_until: String)
}

// create_planned: create a workflow + pin its manual-IR plan atomically.
pub variant CreatePlannedOutcome {
	Created,
	Exists,
	// The workflow exists under a DIFFERENT plan (a config change altered it).
	PlanConflict(plan_length: Int)
}

// ===== Error surface =====

pub variant HostConfigErrorKind {
	BuilderMissingJson,
	BuilderMissingIdentity,
	BuilderBadExecutorIdLength(actual: Int),
	JsonMissingKey(key: String),
	JsonBadType(key: String, expected: String),
	JsonUnknownBackend(value: String),
	JsonPortOutOfRange(value: Int),
	JsonTimeoutNonPositive(key: String, value: Int),
	JsonPoolSizingInvalid(key: String, value: Int),
	PoolOpenFailed(upstream_tag: String),
	RpcConfigInvalid(upstream_tag: String)
}

implement core.Diagnostic for HostConfigErrorKind {
	pub fn to_json_text(self: &HostConfigErrorKind) nothrow -> String {
		return match self {
			HostConfigErrorKind::BuilderMissingJson => { "\"builder-missing-json\"" },
			HostConfigErrorKind::BuilderMissingIdentity => { "\"builder-missing-identity\"" },
			HostConfigErrorKind::BuilderBadExecutorIdLength(actual) => { "\"builder-bad-executor-id-length\"" },
			HostConfigErrorKind::JsonMissingKey(key) => { "\"json-missing-key\"" },
			HostConfigErrorKind::JsonBadType(key, expected) => { "\"json-bad-type\"" },
			HostConfigErrorKind::JsonUnknownBackend(value) => { "\"json-unknown-backend\"" },
			HostConfigErrorKind::JsonPortOutOfRange(value) => { "\"json-port-out-of-range\"" },
			HostConfigErrorKind::JsonTimeoutNonPositive(key, value) => { "\"json-timeout-non-positive\"" },
			HostConfigErrorKind::JsonPoolSizingInvalid(key, value) => { "\"json-pool-sizing-invalid\"" },
			HostConfigErrorKind::PoolOpenFailed(upstream_tag) => { "\"pool-open-failed\"" },
			HostConfigErrorKind::RpcConfigInvalid(upstream_tag) => { "\"rpc-config-invalid\"" }
		};
	}
}

pub error HostConfigError {
	kind: HostConfigErrorKind,
	path: String
}

// Runtime failure taxonomy — caller-actionable, backend-agnostic. `detail`
// is diagnostic-only, never a contract.
pub variant HostErrorKind {
	InvalidId(field: String, actual_len: Int),      // caller input bug
	InvalidArg(field: String),                      // caller input bug
	InvalidJson(field: String),                     // caller input bug
	BackendUnavailable(detail: String),             // could not reach/acquire the store — retriable
	BackendTimeout(detail: String),                 // a deadline elapsed — retriable / shed load
	BackendRejected(detail: String),                // store ran the op and reported failure
	BackendResponseInvalid(detail: String)          // malformed/unexpected response — schema/version skew
}

implement core.Diagnostic for HostErrorKind {
	pub fn to_json_text(self: &HostErrorKind) nothrow -> String {
		return match self {
			HostErrorKind::InvalidId(field, actual_len) => { "\"invalid-id\"" },
			HostErrorKind::InvalidArg(field) => { "\"invalid-arg\"" },
			HostErrorKind::InvalidJson(field) => { "\"invalid-json\"" },
			HostErrorKind::BackendUnavailable(detail) => { "\"backend-unavailable\"" },
			HostErrorKind::BackendTimeout(detail) => { "\"backend-timeout\"" },
			HostErrorKind::BackendRejected(detail) => { "\"backend-rejected\"" },
			HostErrorKind::BackendResponseInvalid(detail) => { "\"backend-response-invalid\"" }
		};
	}
}

pub error HostException {
	kind: HostErrorKind
}

// ===== Interface =====

pub interface MicroflowsHost {
	// Source database_now (+ a lease deadline lease_seconds ahead). The only
	// clock read in the system (§24.4).
	fn clock_read(self: &Self, lease_seconds: Int) -> ClockReading;
	// Create a workflow instance pinned to (script_name, script_revision),
	// with its 'created' event. Idempotent by workflow_id.
	fn create_workflow(self: &Self, workflow_id: &Array<Byte>, script_name: &String,
	                   script_revision: Int, event_ts: &String, next_attempt_at: &String,
	                   continuation_json: &String, event_payload_json: &String) -> CreateOutcome;
	// Create a workflow AND pin its manual-IR plan (hash + length) atomically.
	// Idempotent; PlanConflict if the workflow exists under a different plan.
	fn create_planned(self: &Self, workflow_id: &Array<Byte>, script_name: &String,
	                  script_revision: Int, event_ts: &String, next_attempt_at: &String,
	                  continuation_json: &String, event_payload_json: &String,
	                  plan_hash: &Array<Byte>, plan_length: Int) -> CreatePlannedOutcome;
	// Claim the next due instance of one script (§24.2). db_now and
	// lease_expires_at come from clock_read, fixed for this command.
	fn claim_next(self: &Self, script_name: &String, db_now: &String,
	              lease_expires_at: &String) -> ClaimOutcome;
	// Claim ONE specific workflow by id (no wrong-workflow claims).
	fn claim_workflow(self: &Self, workflow_id: &Array<Byte>, db_now: &String,
	                  lease_expires_at: &String) -> ClaimByIdOutcome;
	// Read-only workflow inspection (terminal/active/deferred/absent).
	fn inspect_workflow(self: &Self, workflow_id: &Array<Byte>, db_now: &String) -> WorkflowInspectOutcome;
	// Fenced lease extension (§24.5).
	fn heartbeat(self: &Self, workflow_id: &Array<Byte>, fencing_token: Int,
	             db_now: &String, lease_expires_at: &String) -> HeartbeatOutcome;
	// Fenced voluntary release with explicit next due time (backoff lives on
	// the row, §24.5).
	fn release(self: &Self, workflow_id: &Array<Byte>, fencing_token: Int,
	           db_now: &String, next_attempt_at: &String) -> ReleaseOutcome;
	// Durable OPERATIONAL deferral of a dispatch (forward stays forward; lease
	// cleared; next_attempt set; an 'operation_dispatch_deferred' audit event with
	// `reason` is appended on ENTRY into the wait condition, deduped on retry). For
	// repairable config states (e.g. pinned binding unavailable) — NOT a failure.
	fn defer_dispatch(self: &Self, workflow_id: &Array<Byte>, fencing_token: Int,
	                  db_now: &String, next_attempt_at: &String, event_ts: &String,
	                  reason: &String) -> ReleaseOutcome;
	// Persist an operation request + the suspended continuation, atomically,
	// BEFORE dispatch. Fenced (fence-first). Idempotent by (workflow_id,
	// operation_seq); command-identity-checked.
	fn operation_request(self: &Self, workflow_id: &Array<Byte>, fencing_token: Int,
	                     operation_seq: Int, operation_id: &Array<Byte>, operation_name: &String,
	                     schema_version: Int, input_json: &String, input_hash: &String,
	                     new_continuation: &String, event_ts: &String, event_payload: &String) -> OperationRequestOutcome;
	// Record a durable operation SUCCESS + Checkpoint + advanced continuation,
	// completing the workflow, atomically. Fenced; identify-first; idempotent
	// (AlreadySettled.result is authoritative).
	fn operation_settle(self: &Self, workflow_id: &Array<Byte>, fencing_token: Int,
	                    operation_seq: Int, operation_id: &Array<Byte>, checkpoint_seq: Int,
	                    result_json: &String, checkpoint_payload: &String, new_continuation: &String,
	                    event_ts: &String, event_payload: &String, is_final: Bool) -> OperationSettleOutcome;
	// Read the LOCAL authoritative operation result (participant-independent).
	fn operation_result(self: &Self, workflow_id: &Array<Byte>, operation_seq: Int) -> OperationResultOutcome;
	// Durable non-retryable failure: forward -> blocked_resolution (fenced).
	fn operation_fail(self: &Self, workflow_id: &Array<Byte>, fencing_token: Int,
	                  operation_seq: Int, operation_id: &Array<Byte>, new_continuation: &String,
	                  event_ts: &String, event_payload: &String) -> OperationFailOutcome;
	// Load the durable operation request (authoritative for recovery).
	fn operation_request_get(self: &Self, workflow_id: &Array<Byte>, operation_seq: Int) -> OperationRequestGetOutcome;
	// --- Reversal / compensation (reverse-direction aggregate transitions) ---
	// Begin reversal on a definite forward failure (durable triggering op).
	fn begin_reversal(self: &Self, workflow_id: &Array<Byte>, fencing_token: Int,
	                  operation_seq: Int, operation_id: &Array<Byte>, event_ts: &String,
	                  reason: &String) -> BeginReversalOutcome;
	// The authoritative top active checkpoint (reverse cursor) + durable binding.
	fn reverse_head(self: &Self, workflow_id: &Array<Byte>) -> ReverseHeadOutcome;
	// Persist a checkpoint's reverse-invocation id + compensation binding before
	// dispatch (pinned reverse contract + input identity).
	fn reverse_request(self: &Self, workflow_id: &Array<Byte>, fencing_token: Int,
	                   seq: Int, reverse_id: &Array<Byte>, reverse_operation_name: &String,
	                   reverse_schema_version: Int, reverse_input_json: &String,
	                   reverse_input_hash: &String, event_ts: &String) -> ReverseRequestOutcome;
	// Settle a checkpoint's compensation on a durable reverse-success.
	fn reverse_settle(self: &Self, workflow_id: &Array<Byte>, fencing_token: Int,
	                  seq: Int, reverse_id: &Array<Byte>, result_json: &String,
	                  event_ts: &String) -> ReverseSettleOutcome;
	// Enter blocked_resolution when compensation cannot safely continue.
	fn reverse_block(self: &Self, workflow_id: &Array<Byte>, fencing_token: Int,
	                 seq: Int, reverse_id: &Array<Byte>, disposition: Int, reason: &String,
	                 event_ts: &String) -> ReverseBlockOutcome
}

// ===== Builder =====

pub struct HostBuilder {
	json_config: Optional<json.JsonNode>,
	identity: Optional<ExecutorIdentity>
}

pub fn new_host_builder() nothrow -> HostBuilder {
	return HostBuilder(
		json_config = Optional<json.JsonNode>::None(),
		identity = Optional<ExecutorIdentity>::None()
	);
}

pub fn with_json(b: &mut HostBuilder, config: &json.JsonNode) nothrow -> Void {
	b.json_config = Optional<json.JsonNode>::Some(config.clone_deep());
}

pub fn with_identity(b: &mut HostBuilder, identity: ExecutorIdentity) -> Void {
	if identity.executor_id.len() != 16 {
		throw HostConfigError(
			kind = HostConfigErrorKind::BuilderBadExecutorIdLength(actual = identity.executor_id.len()),
			path = ""
		);
	}
	b.identity = Optional<ExecutorIdentity>::Some(move identity);
}

pub fn build_host(var b: HostBuilder) nothrow -> core.Result<arc.Arc<MicroflowsHost>, HostConfigError> {
	val have_json: Bool = match &b.json_config {
		Optional::Some(_) => { true },
		Optional::None => { false }
	};
	if !have_json {
		return core.Result<arc.Arc<MicroflowsHost>, HostConfigError>::Err(
			HostConfigError(kind = HostConfigErrorKind::BuilderMissingJson(), path = "")
		);
	}
	val have_id: Bool = match &b.identity {
		Optional::Some(_) => { true },
		Optional::None => { false }
	};
	if !have_id {
		return core.Result<arc.Arc<MicroflowsHost>, HostConfigError>::Err(
			HostConfigError(kind = HostConfigErrorKind::BuilderMissingIdentity(), path = "")
		);
	}

	var identity_local: Optional<ExecutorIdentity> = Optional<ExecutorIdentity>::None();
	mem.swap(&mut b.identity, &mut identity_local);
	var taken_identity: ExecutorIdentity = match move identity_local {
		Optional::Some(v) => { move v },
		Optional::None => { _dummy_identity() }
	};

	var json_local: Optional<json.JsonNode> = Optional<json.JsonNode>::None();
	mem.swap(&mut b.json_config, &mut json_local);
	val cfg_node: json.JsonNode = match move json_local {
		Optional::Some(n) => { move n },
		Optional::None => { json.new_object().to_node() }
	};

	try {
		val rpc_cfg: rpc.RpcConnectionConfig = _build_rpc_config_from_json_throwing(&cfg_node);
		val pool_cfg: pool.PoolConfig = _build_pool_config_from_json_throwing(&cfg_node);
		val p: pool.ConnectionPool = pool.open(move rpc_cfg, move pool_cfg).or_throw();

		val inst = HostImpl(
			identity = move taken_identity,
			pool = move p
		);
		val inst_arc: arc.Arc<HostImpl> = arc.arc(move inst);
		val host: arc.Arc<MicroflowsHost> = inst_arc.as_interface<type MicroflowsHost>();
		return core.Result<arc.Arc<MicroflowsHost>, HostConfigError>::Ok(move host);
	} catch managed:ManagedError(e) {
		return core.Result<arc.Arc<MicroflowsHost>, HostConfigError>::Err(
			HostConfigError(
				kind = HostConfigErrorKind::PoolOpenFailed(upstream_tag = _dup(&e.tag)),
				path = ""
			)
		);
	} catch HostConfigError(e) {
		return core.Result<arc.Arc<MicroflowsHost>, HostConfigError>::Err(move e);
	} catch unexpected {
		return core.Result<arc.Arc<MicroflowsHost>, HostConfigError>::Err(
			HostConfigError(
				kind = HostConfigErrorKind::PoolOpenFailed(upstream_tag = "unexpected"),
				path = ""
			)
		);
	}
}

// ===== JSON config parsing =====

fn _build_rpc_config_from_json_throwing(node: &json.JsonNode) -> rpc.RpcConnectionConfig {
	val backend: String = _read_string_throws(node, &"backend");
	if backend != "mariadb" {
		throw HostConfigError(
			kind = HostConfigErrorKind::JsonUnknownBackend(value = move backend),
			path = "backend"
		);
	}
	val host: String = _read_string_throws(node, &"host");
	val port: Int = _read_int_throws(node, &"port");
	if port < 1 or port > 65535 {
		throw HostConfigError(kind = HostConfigErrorKind::JsonPortOutOfRange(value = port), path = "port");
	}
	val user: String = _read_string_throws(node, &"user");
	val password: String = _read_string_throws(node, &"password");
	val database: String = _read_string_throws(node, &"database");
	val connect_timeout_ms: Int = _read_optional_positive_int(node, &"connect_timeout_ms", 5000);
	val io_timeout_ms: Int = _read_optional_positive_int(node, &"io_timeout_ms", 30000);

	var builder = rpc.new_connection_config_builder();
	builder.with_host(move host);
	builder.with_port(port);
	builder.with_user(move user);
	builder.with_password(move password);
	builder.with_database(move database);
	builder.with_connect_timeout_ms(connect_timeout_ms);
	builder.with_read_timeout_ms(io_timeout_ms);
	builder.with_write_timeout_ms(io_timeout_ms);
	match rpc.build_connection_config(move builder) {
		core.Result::Ok(cfg) => { return move cfg; },
		core.Result::Err(_) => {
			throw HostConfigError(
				kind = HostConfigErrorKind::RpcConfigInvalid(upstream_tag = "rpc-config-build-failed"),
				path = ""
			);
		}
	}
}

fn _build_pool_config_from_json_throwing(node: &json.JsonNode) -> pool.PoolConfig {
	var pc: pool.PoolConfig = pool.default_pool_config();

	val pool_opt: Optional<&json.JsonNode> = node.get(&"pool");
	match pool_opt {
		Optional::Some(psub) => {
			match psub.get_int_at_path(&"min_idle") {
				Optional::Some(v) => {
					if v < 0 { throw HostConfigError(kind = HostConfigErrorKind::JsonPoolSizingInvalid(key = "min_idle", value = v), path = "pool.min_idle"); }
					pc.min_idle = v;
				},
				Optional::None => {}
			}
			match psub.get_int_at_path(&"max_conns") {
				Optional::Some(v) => {
					if v < 1 { throw HostConfigError(kind = HostConfigErrorKind::JsonPoolSizingInvalid(key = "max_conns", value = v), path = "pool.max_conns"); }
					pc.max_conns = v;
				},
				Optional::None => {}
			}
			match psub.get_int_at_path(&"idle_timeout_ms") {
				Optional::Some(v) => {
					if v <= 0 { throw HostConfigError(kind = HostConfigErrorKind::JsonTimeoutNonPositive(key = "idle_timeout_ms", value = v), path = "pool.idle_timeout_ms"); }
					pc.idle_timeout_ms = v;
				},
				Optional::None => {}
			}
			match psub.get_int_at_path(&"keepalive_interval_ms") {
				Optional::Some(v) => {
					if v < 0 { throw HostConfigError(kind = HostConfigErrorKind::JsonTimeoutNonPositive(key = "keepalive_interval_ms", value = v), path = "pool.keepalive_interval_ms"); }
					pc.keepalive_interval_ms = v;
				},
				Optional::None => {}
			}
		},
		Optional::None => {}
	}

	// Always bound the pool acquire (mirrors Singular: never block forever).
	pc.acquire_timeout = Optional<conc.Duration>::Some(conc.Duration(millis = _read_acquire_timeout_ms(node)));

	return move pc;
}

fn _read_acquire_timeout_ms(node: &json.JsonNode) -> Int {
	match node.get(&"pool") {
		Optional::Some(psub) => {
			match psub.get_int_at_path(&"acquire_timeout_ms") {
				Optional::Some(v) => {
					if v <= 0 { throw HostConfigError(kind = HostConfigErrorKind::JsonTimeoutNonPositive(key = "acquire_timeout_ms", value = v), path = "pool.acquire_timeout_ms"); }
					return v;
				},
				Optional::None => { return 5000; }
			}
		},
		Optional::None => { return 5000; }
	}
}

fn _read_string_throws(node: &json.JsonNode, key: &String) -> String {
	val opt: Optional<&json.JsonNode> = node.get(key);
	match opt {
		Optional::None => {
			throw HostConfigError(kind = HostConfigErrorKind::JsonMissingKey(key = _dup(key)), path = _dup(key));
		},
		Optional::Some(n) => {
			match n.as_string() {
				Optional::Some(s) => { return move s; },
				Optional::None => {
					throw HostConfigError(
						kind = HostConfigErrorKind::JsonBadType(key = _dup(key), expected = "String"),
						path = _dup(key)
					);
				}
			}
		}
	}
}

fn _read_int_throws(node: &json.JsonNode, key: &String) -> Int {
	val opt: Optional<&json.JsonNode> = node.get(key);
	match opt {
		Optional::None => {
			throw HostConfigError(kind = HostConfigErrorKind::JsonMissingKey(key = _dup(key)), path = _dup(key));
		},
		Optional::Some(n) => {
			match n.as_int() {
				Optional::Some(v) => { return v; },
				Optional::None => {
					throw HostConfigError(
						kind = HostConfigErrorKind::JsonBadType(key = _dup(key), expected = "Int"),
						path = _dup(key)
					);
				}
			}
		}
	}
}

fn _read_optional_positive_int(node: &json.JsonNode, key: &String, default_val: Int) nothrow -> Int {
	val opt: Optional<&json.JsonNode> = node.get(key);
	match opt {
		Optional::None => { return default_val; },
		Optional::Some(n) => {
			match n.as_int() {
				Optional::Some(v) => { if v > 0 { return v; } else { return default_val; } },
				Optional::None => { return default_val; }
			}
		}
	}
}

// ===== Implementation =====

struct HostImpl
	require Self is core.Destructible
{
	identity: ExecutorIdentity,
	// acquire() is &Self + internally synchronized (mariadb-rpc 0.6); shared
	// directly via Arc<HostImpl> with no outer mutex.
	pool: pool.ConnectionPool
}

implement MicroflowsHost for HostImpl {
	pub fn clock_read(self: &HostImpl, lease_seconds: Int) -> ClockReading {
		if lease_seconds <= 0 {
			throw HostException(kind = HostErrorKind::InvalidArg(field = "lease_seconds"));
		}
		try {
			var lease = _acquire_conn(self);
			val conn: &mut rpc.RpcConnection = lease.conn().or_throw();
			var args = rpc.new_args();
			args.push(rpc.arg_int(lease_seconds));
			val sp: String = "sp_mf_clock_read";
			val doc = _call_sp_doc(conn, &sp, move args);
			val outcome = _doc_outcome(&doc);
			if outcome == "ok" {
				val now = _doc_str_req(&doc, &"now", "clock-no-now");
				// SP doc key stays "lease_expires_at" (its server-side name); the
				// host surfaces it as the neutral `deadline`.
				val deadline = _doc_str_req(&doc, &"lease_expires_at", "clock-no-expiry");
				return ClockReading(now = move now, deadline = move deadline);
			}
			throw HostException(kind = HostErrorKind::BackendResponseInvalid(detail = "unexpected-outcome:clock_read"));
		} catch managed:ManagedError(e) {
			val tag_owned: String = e.tag;
			throw HostException(kind = HostErrorKind::BackendUnavailable(detail = move tag_owned));
		}
	}

	pub fn create_workflow(self: &HostImpl, workflow_id: &Array<Byte>, script_name: &String,
	                       script_revision: Int, event_ts: &String, next_attempt_at: &String,
	                       continuation_json: &String, event_payload_json: &String) -> CreateOutcome {
		_validate_id16("workflow_id", workflow_id);
		_validate_nonempty("script_name", script_name);
		if script_revision < 1 {
			throw HostException(kind = HostErrorKind::InvalidArg(field = "script_revision"));
		}
		_validate_nonempty("event_ts", event_ts);
		_validate_nonempty("next_attempt_at", next_attempt_at);
		try {
			var lease = _acquire_conn(self);
			val conn: &mut rpc.RpcConnection = lease.conn().or_throw();
			var args = rpc.new_args();
			args.push(rpc.arg_bytes(_dup_bytes(workflow_id)));
			args.push(rpc.arg_string(_dup(script_name)));
			args.push(rpc.arg_int(script_revision));
			args.push(rpc.arg_string(_dup(event_ts)));
			args.push(rpc.arg_string(_dup(next_attempt_at)));
			args.push(_json_object_arg("continuation", continuation_json));
			args.push(_meta_object_arg("event_payload", event_payload_json));
			val sp: String = "sp_mf_workflow_create";
			val doc = _call_sp_doc(conn, &sp, move args);
			val outcome = _doc_outcome(&doc);
			if outcome == "created" { return CreateOutcome::Created(); }
			if outcome == "exists" { return CreateOutcome::Exists(); }
			throw HostException(kind = HostErrorKind::BackendResponseInvalid(detail = "unexpected-outcome:create"));
		} catch managed:ManagedError(e) {
			val tag_owned: String = e.tag;
			throw HostException(kind = HostErrorKind::BackendUnavailable(detail = move tag_owned));
		}
	}

	pub fn create_planned(self: &HostImpl, workflow_id: &Array<Byte>, script_name: &String,
	                      script_revision: Int, event_ts: &String, next_attempt_at: &String,
	                      continuation_json: &String, event_payload_json: &String,
	                      plan_hash: &Array<Byte>, plan_length: Int) -> CreatePlannedOutcome {
		_validate_id16("workflow_id", workflow_id);
		_validate_id16("plan_hash", plan_hash);
		_validate_nonempty("script_name", script_name);
		if script_revision < 1 { throw HostException(kind = HostErrorKind::InvalidArg(field = "script_revision")); }
		if plan_length < 1 { throw HostException(kind = HostErrorKind::InvalidArg(field = "plan_length")); }
		_validate_nonempty("event_ts", event_ts);
		_validate_nonempty("next_attempt_at", next_attempt_at);
		try {
			var lease = _acquire_conn(self);
			val conn: &mut rpc.RpcConnection = lease.conn().or_throw();
			var args = rpc.new_args();
			args.push(rpc.arg_bytes(_dup_bytes(workflow_id)));
			args.push(rpc.arg_string(_dup(script_name)));
			args.push(rpc.arg_int(script_revision));
			args.push(rpc.arg_string(_dup(event_ts)));
			args.push(rpc.arg_string(_dup(next_attempt_at)));
			args.push(_json_object_arg("continuation", continuation_json));
			args.push(_meta_object_arg("event_payload", event_payload_json));
			args.push(rpc.arg_bytes(_dup_bytes(plan_hash)));
			args.push(rpc.arg_int(plan_length));
			val sp: String = "sp_mf_workflow_create_planned";
			val doc = _call_sp_doc(conn, &sp, move args);
			val outcome = _doc_outcome(&doc);
			if outcome == "created" { return CreatePlannedOutcome::Created(); }
			if outcome == "exists" { return CreatePlannedOutcome::Exists(); }
			if outcome == "plan_conflict" { return CreatePlannedOutcome::PlanConflict(_doc_int_req(&doc, &"plan_length", "create-planned-no-plan-length")); }
			throw HostException(kind = HostErrorKind::BackendResponseInvalid(detail = "unexpected-outcome:create_planned"));
		} catch managed:ManagedError(e) {
			val tag_owned: String = e.tag;
			throw HostException(kind = HostErrorKind::BackendUnavailable(detail = move tag_owned));
		}
	}

	pub fn claim_next(self: &HostImpl, script_name: &String, db_now: &String,
	                  lease_expires_at: &String) -> ClaimOutcome {
		_validate_nonempty("script_name", script_name);
		_validate_nonempty("db_now", db_now);
		_validate_nonempty("lease_expires_at", lease_expires_at);
		try {
			var lease = _acquire_conn(self);
			val conn: &mut rpc.RpcConnection = lease.conn().or_throw();
			var args = rpc.new_args();
			args.push(rpc.arg_string(_dup(script_name)));
			args.push(rpc.arg_bytes(_dup_bytes(&self.identity.executor_id)));
			args.push(rpc.arg_string(_dup(db_now)));
			args.push(rpc.arg_string(_dup(lease_expires_at)));
			val sp: String = "sp_mf_workflow_claim";
			val doc = _call_sp_doc(conn, &sp, move args);
			val outcome = _doc_outcome(&doc);
			if outcome == "none" { return ClaimOutcome::NoneDue(); }
			if outcome == "claimed" {
				// Bind every (throwing) field read BEFORE construction; construct
				// LAST with only nothrow moves.
				val wf_hex = _doc_str_req(&doc, &"workflow_id", "claim-no-workflow-id");
				val wf_id = _hex16("claim-workflow-id-hex", &wf_hex);
				val fencing = _doc_int_req(&doc, &"fencing_token", "claim-no-fencing");
				val state_code = _doc_int_req(&doc, &"state", "claim-no-state");
				val direction = _doc_int_req(&doc, &"execution_direction", "claim-no-direction");
				val disp = _doc_int_req(&doc, &"current_disposition", "claim-no-disposition");
				val sname = _doc_str_req(&doc, &"script_name", "claim-no-script-name");
				val srev = _doc_int_req(&doc, &"script_revision", "claim-no-script-revision");
				val eseq = _doc_int_req(&doc, &"current_event_seq", "claim-no-event-seq");
				val attempt = _doc_int_req(&doc, &"current_operation_attempt", "claim-no-attempt");
				val continuation = _doc_object_text_req(&doc, &"continuation");
				return ClaimOutcome::Claimed(ClaimedWorkflow(
					workflow_id = move wf_id,
					fencing_token = fencing,
					state_code = state_code,
					execution_direction = direction,
					current_disposition = disp,
					script_name = move sname,
					script_revision = srev,
					current_event_seq = eseq,
					current_operation_attempt = attempt,
					continuation_json = move continuation
				));
			}
			throw HostException(kind = HostErrorKind::BackendResponseInvalid(detail = "unexpected-outcome:claim"));
		} catch managed:ManagedError(e) {
			val tag_owned: String = e.tag;
			throw HostException(kind = HostErrorKind::BackendUnavailable(detail = move tag_owned));
		}
	}

	pub fn heartbeat(self: &HostImpl, workflow_id: &Array<Byte>, fencing_token: Int,
	                 db_now: &String, lease_expires_at: &String) -> HeartbeatOutcome {
		_validate_id16("workflow_id", workflow_id);
		if fencing_token < 1 {
			throw HostException(kind = HostErrorKind::InvalidArg(field = "fencing_token"));
		}
		_validate_nonempty("db_now", db_now);
		_validate_nonempty("lease_expires_at", lease_expires_at);
		try {
			var lease = _acquire_conn(self);
			val conn: &mut rpc.RpcConnection = lease.conn().or_throw();
			var args = rpc.new_args();
			args.push(rpc.arg_bytes(_dup_bytes(workflow_id)));
			args.push(rpc.arg_bytes(_dup_bytes(&self.identity.executor_id)));
			args.push(rpc.arg_int(fencing_token));
			args.push(rpc.arg_string(_dup(db_now)));
			args.push(rpc.arg_string(_dup(lease_expires_at)));
			val sp: String = "sp_mf_workflow_heartbeat";
			val doc = _call_sp_doc(conn, &sp, move args);
			val outcome = _doc_outcome(&doc);
			if outcome == "extended" { return HeartbeatOutcome::Extended(); }
			if outcome == "fence_lost" { return HeartbeatOutcome::FenceLost(); }
			if outcome == "not_found" { return HeartbeatOutcome::NotFound(); }
			throw HostException(kind = HostErrorKind::BackendResponseInvalid(detail = "unexpected-outcome:heartbeat"));
		} catch managed:ManagedError(e) {
			val tag_owned: String = e.tag;
			throw HostException(kind = HostErrorKind::BackendUnavailable(detail = move tag_owned));
		}
	}

	pub fn release(self: &HostImpl, workflow_id: &Array<Byte>, fencing_token: Int,
	               db_now: &String, next_attempt_at: &String) -> ReleaseOutcome {
		_validate_id16("workflow_id", workflow_id);
		if fencing_token < 1 {
			throw HostException(kind = HostErrorKind::InvalidArg(field = "fencing_token"));
		}
		_validate_nonempty("db_now", db_now);
		_validate_nonempty("next_attempt_at", next_attempt_at);
		try {
			var lease = _acquire_conn(self);
			val conn: &mut rpc.RpcConnection = lease.conn().or_throw();
			var args = rpc.new_args();
			args.push(rpc.arg_bytes(_dup_bytes(workflow_id)));
			args.push(rpc.arg_bytes(_dup_bytes(&self.identity.executor_id)));
			args.push(rpc.arg_int(fencing_token));
			args.push(rpc.arg_string(_dup(db_now)));
			args.push(rpc.arg_string(_dup(next_attempt_at)));
			val sp: String = "sp_mf_workflow_release";
			val doc = _call_sp_doc(conn, &sp, move args);
			val outcome = _doc_outcome(&doc);
			if outcome == "released" { return ReleaseOutcome::Released(); }
			if outcome == "fence_lost" { return ReleaseOutcome::FenceLost(); }
			if outcome == "not_found" { return ReleaseOutcome::NotFound(); }
			throw HostException(kind = HostErrorKind::BackendResponseInvalid(detail = "unexpected-outcome:release"));
		} catch managed:ManagedError(e) {
			val tag_owned: String = e.tag;
			throw HostException(kind = HostErrorKind::BackendUnavailable(detail = move tag_owned));
		}
	}

	pub fn defer_dispatch(self: &HostImpl, workflow_id: &Array<Byte>, fencing_token: Int,
	                      db_now: &String, next_attempt_at: &String, event_ts: &String,
	                      reason: &String) -> ReleaseOutcome {
		_validate_id16("workflow_id", workflow_id);
		if fencing_token < 1 {
			throw HostException(kind = HostErrorKind::InvalidArg(field = "fencing_token"));
		}
		_validate_nonempty("db_now", db_now);
		_validate_nonempty("next_attempt_at", next_attempt_at);
		_validate_nonempty("event_ts", event_ts);
		_validate_nonempty("reason", reason);
		try {
			var lease = _acquire_conn(self);
			val conn: &mut rpc.RpcConnection = lease.conn().or_throw();
			var args = rpc.new_args();
			args.push(rpc.arg_bytes(_dup_bytes(workflow_id)));
			args.push(rpc.arg_bytes(_dup_bytes(&self.identity.executor_id)));
			args.push(rpc.arg_int(fencing_token));
			args.push(rpc.arg_string(_dup(db_now)));
			args.push(rpc.arg_string(_dup(next_attempt_at)));
			args.push(rpc.arg_string(_dup(event_ts)));
			args.push(rpc.arg_string(_dup(reason)));
			val sp: String = "sp_mf_operation_dispatch_defer";
			val doc = _call_sp_doc(conn, &sp, move args);
			val outcome = _doc_outcome(&doc);
			if outcome == "deferred" { return ReleaseOutcome::Released(); }
			if outcome == "fence_lost" { return ReleaseOutcome::FenceLost(); }
			if outcome == "not_found" { return ReleaseOutcome::NotFound(); }
			throw HostException(kind = HostErrorKind::BackendResponseInvalid(detail = "unexpected-outcome:defer_dispatch"));
		} catch managed:ManagedError(e) {
			val tag_owned: String = e.tag;
			throw HostException(kind = HostErrorKind::BackendUnavailable(detail = move tag_owned));
		}
	}

	pub fn operation_request(self: &HostImpl, workflow_id: &Array<Byte>, fencing_token: Int,
	                         operation_seq: Int, operation_id: &Array<Byte>, operation_name: &String,
	                         schema_version: Int, input_json: &String, input_hash: &String,
	                         new_continuation: &String, event_ts: &String, event_payload: &String) -> OperationRequestOutcome {
		_validate_id16("workflow_id", workflow_id);
		_validate_id16("operation_id", operation_id);
		if fencing_token < 1 { throw HostException(kind = HostErrorKind::InvalidArg(field = "fencing_token")); }
		if operation_seq < 1 { throw HostException(kind = HostErrorKind::InvalidArg(field = "operation_seq")); }
		_validate_nonempty("operation_name", operation_name);
		if schema_version < 1 { throw HostException(kind = HostErrorKind::InvalidArg(field = "schema_version")); }
		_validate_nonempty("input_hash", input_hash);
		_validate_nonempty("event_ts", event_ts);
		try {
			var lease = _acquire_conn(self);
			val conn: &mut rpc.RpcConnection = lease.conn().or_throw();
			var args = rpc.new_args();
			args.push(rpc.arg_bytes(_dup_bytes(workflow_id)));
			args.push(rpc.arg_bytes(_dup_bytes(&self.identity.executor_id)));
			args.push(rpc.arg_int(fencing_token));
			args.push(rpc.arg_int(operation_seq));
			args.push(rpc.arg_bytes(_dup_bytes(operation_id)));
			args.push(rpc.arg_string(_dup(operation_name)));
			args.push(rpc.arg_int(schema_version));
			args.push(_json_object_arg("input_json", input_json));
			args.push(rpc.arg_string(_dup(input_hash)));
			args.push(_json_object_arg("continuation", new_continuation));
			args.push(rpc.arg_string(_dup(event_ts)));
			args.push(_meta_object_arg("event_payload", event_payload));
			val sp: String = "sp_mf_operation_request";
			val doc = _call_sp_doc(conn, &sp, move args);
			val outcome = _doc_outcome(&doc);
			if outcome == "requested" {
				val hex = _doc_str_req(&doc, &"operation_id", "request-no-opid");
				return OperationRequestOutcome::Requested(_hex16("request-opid-hex", &hex));
			}
			if outcome == "exists" {
				val hex = _doc_str_req(&doc, &"operation_id", "request-no-opid");
				return OperationRequestOutcome::Exists(_hex16("request-opid-hex", &hex));
			}
			if outcome == "operation_conflict" { return OperationRequestOutcome::OperationConflict(); }
			if outcome == "fence_lost" { return OperationRequestOutcome::FenceLost(); }
			if outcome == "not_found" { return OperationRequestOutcome::NotFound(); }
			if outcome == "plan_violation" {
				return OperationRequestOutcome::PlanViolation(_doc_str_req(&doc, &"reason", "request-no-plan-violation-reason"));
			}
			if outcome == "event_time_skew" {
				return OperationRequestOutcome::EventTimeSkew(_doc_str_req(&doc, &"defer_until", "request-no-defer-until"));
			}
			throw HostException(kind = HostErrorKind::BackendResponseInvalid(detail = "unexpected-outcome:operation_request"));
		} catch managed:ManagedError(e) {
			val tag_owned: String = e.tag;
			throw HostException(kind = HostErrorKind::BackendUnavailable(detail = move tag_owned));
		}
	}

	pub fn operation_settle(self: &HostImpl, workflow_id: &Array<Byte>, fencing_token: Int,
	                        operation_seq: Int, operation_id: &Array<Byte>, checkpoint_seq: Int,
	                        result_json: &String, checkpoint_payload: &String, new_continuation: &String,
	                        event_ts: &String, event_payload: &String, is_final: Bool) -> OperationSettleOutcome {
		_validate_id16("workflow_id", workflow_id);
		_validate_id16("operation_id", operation_id);
		if fencing_token < 1 { throw HostException(kind = HostErrorKind::InvalidArg(field = "fencing_token")); }
		if operation_seq < 1 { throw HostException(kind = HostErrorKind::InvalidArg(field = "operation_seq")); }
		if checkpoint_seq < 1 { throw HostException(kind = HostErrorKind::InvalidArg(field = "checkpoint_seq")); }
		_validate_nonempty("event_ts", event_ts);
		try {
			var lease = _acquire_conn(self);
			val conn: &mut rpc.RpcConnection = lease.conn().or_throw();
			var args = rpc.new_args();
			args.push(rpc.arg_bytes(_dup_bytes(workflow_id)));
			args.push(rpc.arg_bytes(_dup_bytes(&self.identity.executor_id)));
			args.push(rpc.arg_int(fencing_token));
			args.push(rpc.arg_int(operation_seq));
			args.push(rpc.arg_bytes(_dup_bytes(operation_id)));
			args.push(rpc.arg_int(checkpoint_seq));
			args.push(_json_object_arg("result_json", result_json));
			args.push(_json_object_arg("checkpoint_payload", checkpoint_payload));
			args.push(_json_object_arg("continuation", new_continuation));
			args.push(rpc.arg_string(_dup(event_ts)));
			args.push(_meta_object_arg("event_payload", event_payload));
			var is_final_int: Int = 0;
			if is_final { is_final_int = 1; }
			args.push(rpc.arg_int(is_final_int));
			val sp: String = "sp_mf_operation_settle";
			val doc = _call_sp_doc(conn, &sp, move args);
			val outcome = _doc_outcome(&doc);
			if outcome == "settled" {
				return OperationSettleOutcome::Settled(_doc_object_text_req(&doc, &"result"));
			}
			if outcome == "already_settled" {
				return OperationSettleOutcome::AlreadySettled(_doc_object_text_req(&doc, &"result"));
			}
			if outcome == "operation_conflict" { return OperationSettleOutcome::OperationConflict(); }
			if outcome == "fence_lost" { return OperationSettleOutcome::FenceLost(); }
			if outcome == "not_found" { return OperationSettleOutcome::NotFound(); }
			if outcome == "operation_not_found" { return OperationSettleOutcome::OperationNotFound(); }
			if outcome == "plan_violation" {
				return OperationSettleOutcome::PlanViolation(_doc_str_req(&doc, &"reason", "settle-no-plan-violation-reason"));
			}
			if outcome == "event_time_skew" {
				return OperationSettleOutcome::EventTimeSkew(_doc_str_req(&doc, &"defer_until", "settle-no-defer-until"));
			}
			throw HostException(kind = HostErrorKind::BackendResponseInvalid(detail = "unexpected-outcome:operation_settle"));
		} catch managed:ManagedError(e) {
			val tag_owned: String = e.tag;
			throw HostException(kind = HostErrorKind::BackendUnavailable(detail = move tag_owned));
		}
	}

	pub fn claim_workflow(self: &HostImpl, workflow_id: &Array<Byte>, db_now: &String,
	                      lease_expires_at: &String) -> ClaimByIdOutcome {
		_validate_id16("workflow_id", workflow_id);
		_validate_nonempty("db_now", db_now);
		_validate_nonempty("lease_expires_at", lease_expires_at);
		try {
			var lease = _acquire_conn(self);
			val conn: &mut rpc.RpcConnection = lease.conn().or_throw();
			var args = rpc.new_args();
			args.push(rpc.arg_bytes(_dup_bytes(workflow_id)));
			args.push(rpc.arg_bytes(_dup_bytes(&self.identity.executor_id)));
			args.push(rpc.arg_string(_dup(db_now)));
			args.push(rpc.arg_string(_dup(lease_expires_at)));
			val sp: String = "sp_mf_workflow_claim_by_id";
			val doc = _call_sp_doc(conn, &sp, move args);
			val outcome = _doc_outcome(&doc);
			if outcome == "not_found" { return ClaimByIdOutcome::NotFound(); }
			if outcome == "not_claimable" { return ClaimByIdOutcome::NotClaimable(); }
			if outcome == "claimed" { return ClaimByIdOutcome::Claimed(_parse_claimed(&doc)); }
			throw HostException(kind = HostErrorKind::BackendResponseInvalid(detail = "unexpected-outcome:claim_workflow"));
		} catch managed:ManagedError(e) {
			val tag_owned: String = e.tag;
			throw HostException(kind = HostErrorKind::BackendUnavailable(detail = move tag_owned));
		}
	}

	pub fn inspect_workflow(self: &HostImpl, workflow_id: &Array<Byte>, db_now: &String) -> WorkflowInspectOutcome {
		_validate_id16("workflow_id", workflow_id);
		_validate_nonempty("db_now", db_now);
