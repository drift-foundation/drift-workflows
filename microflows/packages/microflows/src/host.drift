// Microflows MariaDB host gateway — milestone 1 (microflows_design.md §6,
// prior §24).
//
// Step 3 surface: workflow creation, lease claim/heartbeat/release, and
// database-clock sourcing. Remote-operation dispatch + result persistence
// arrive in step 4.
//
// Modeled on Singular's gateway (../../singular gateway.drift): a
// connection pool wrapped behind an interface, every operation calling one
// stored procedure that returns ONE result row with ONE column `result` — a
// discriminated JSON DOCUMENT keyed by `outcome`.
//
// Time discipline (§24.4): the gateway never invents time. clock_read() is
// the sole clock source (database NOW(6)); every mutating call takes
// explicit, caller-fixed datetime strings and passes them through unchanged.

module microflows.host;

import std.core as core;
import std.core.arc as arc;
import std.concurrent as conc;
import std.io as io;
import std.json as json;
import std.codec as codec;
import std.mem as mem;
import std.uuid as uuid;

import mariadb.rpc as rpc;
import mariadb.rpc.pool as pool;
import mariadb.rpc.managed as managed;

export {
	MicroflowsHost,
	ExecutorIdentity,
	identity_from_worker_name,
	HostBuilder,
	new_host_builder,
	with_json,
	with_identity,
	build_host,
	HostConfigErrorKind,
	HostConfigError,
	HostErrorKind,
	HostException,
	ClockReading,
	ClaimedWorkflow,
	CreateOutcome,
	ClaimOutcome,
	HeartbeatOutcome,
	ReleaseOutcome,
	ClaimByIdOutcome,
	WorkflowSnapshot,
	WorkflowInspectOutcome,
	OperationRequestOutcome,
	OperationSettleOutcome,
	OperationResultOutcome,
	OperationFailOutcome,
	OperationRequestRecord,
	OperationRequestGetOutcome,
	BeginReversalOutcome,
	AuthoredFailOutcome,
	ReconcileDeferOutcome,
	CheckpointReconcileDeferOutcome,
	OperationPendingDeferOutcome,
	CheckpointPendingDeferOutcome,
	ReverseRequestOutcome,
	ReverseSettleOutcome,
	ReverseBlockOutcome,
	ReverseHeadOutcome,
	CreatePlannedOutcome,
	PinnedScript,
	PlanGetOutcome,
	ArgsGetOutcome,
	CallSubmitOutcome,
	CallInspectOutcome,
	CallHintRefreshOutcome,
	ChildTerminalNotifyOutcome,
	BestEffort,
	CheckpointReverseChildReopenOutcome,
	CheckpointReverseChildSettleOutcome
};

// ===== Identity =====

pub struct ExecutorIdentity {
	pub executor_id: Array<Byte>     // exactly 16 bytes
}

// Derive a stable 16-byte executor identity from a worker name (UUID v3).
pub fn identity_from_worker_name(worker_name: &String) nothrow -> ExecutorIdentity {
	val u: uuid.Uuid = uuid.v3_from_string(worker_name);
	val bytes: Array<Byte> = uuid.to_bytes(&u);
	return ExecutorIdentity(executor_id = move bytes);
}

// ===== Result shapes =====

// A database clock reading (§24.4): `now` plus an absolute deadline `now +
// lease_seconds` derived server-side. `deadline` is NEUTRAL — the caller decides
// what it bounds (a lease expiry for claim/heartbeat, OR a next-attempt time for
// a voluntary deferral), so retry scheduling is not coupled to lease duration.
// Both are datetime(6) literals ("YYYY-MM-DD HH:MM:SS.ffffff") passed onward as
// explicit, retry-fixed command parameters.
pub struct ClockReading {
	pub now: String,
	pub deadline: String
}

// The claimed snapshot: everything an executor needs to resume from the
// durable continuation under its new fencing token (§24.2, §24.5).
pub struct ClaimedWorkflow {
	pub workflow_id: Array<Byte>,
	pub fencing_token: Int,
	pub state_code: Int,             // microflows.state storage code
	pub execution_direction: Int,    // 1=forward 2=reverse (microflows.state)
	pub current_disposition: Int,
	pub script_name: String,
	pub script_revision: Int,
	pub current_event_seq: Int,
	pub current_operation_attempt: Int,
	pub continuation_json: String    // JSON object text (compact)
}

// create_workflow: the PK INSERT is the serializer; a replay of the same
// stable command ID (= workflow_id) resolves to Exists without mutating.
pub variant CreateOutcome { Created, Exists }

// claim_next: a due, unleased/expired instance for one registered script —
// or nothing due.
pub variant ClaimOutcome {
	Claimed(wf: ClaimedWorkflow),
	NoneDue
}

// claim_workflow: claim ONE specific workflow by id. NotClaimable = exists but
// leased / not due / terminal (inspect to distinguish); NotFound = absent.
pub variant ClaimByIdOutcome {
	Claimed(wf: ClaimedWorkflow),
	NotClaimable,
	NotFound
}

// A read-only workflow snapshot (inspect_workflow) — enough to distinguish
// terminal vs active(leased) vs claimable/deferred vs absent.
pub struct WorkflowSnapshot {
	pub state_code: Int,             // microflows.state storage code
	pub execution_direction: Int,
	pub current_disposition: Int,
	pub is_terminal: Bool,
	pub leased: Bool,                // an unexpired lease is held at db_now
	pub continuation_json: String,
	pub terminal_reason: String,     // durable failure reason on a terminal failure (5/7); "" otherwise
	// Durable workflow TERMINAL RETURN (1b.0a step 3) — the AUTHORITATIVE typed
	// workflow return (separate from any per-operation result). `None` until
	// completed (state=4); ALWAYS `Some` once completed (the schema guarantees a
	// valid JSON-object value there). Read directly here — never re-derived from
	// the graph.
	pub workflow_return_json: Optional<String>
}

pub variant WorkflowInspectOutcome {
	Found(snapshot: WorkflowSnapshot),
	NotFound
}

// Fenced lease operations: FenceLost covers every mismatch (wrong owner,
// stale token, expired lease, non-claimable state) — a stale worker learns
// only that it can no longer publish.
pub variant HeartbeatOutcome { Extended, FenceLost, NotFound }
pub variant ReleaseOutcome { Released, FenceLost, NotFound }

// Operation request (persist request + suspended continuation before dispatch).
// FenceLost is fence-first (a stale executor must NOT receive Exists and
// dispatch). OperationConflict = same (workflow_id, operation_seq) with
// different immutable fields. EventTimeSkew = non-increasing event_ts.
pub variant OperationRequestOutcome {
	Requested(operation_id: Array<Byte>),
	Exists(operation_id: Array<Byte>),
	OperationConflict,
	FenceLost,
	NotFound,
	// The request is out of the pinned plan: seq out of range, or (seq > 1) the
	// predecessor has not settled. `reason` names which.
	PlanViolation(reason: String),
	// defer_until = current_event_ts + margin (the deferral deadline).
	EventTimeSkew(defer_until: String)
}

// operation_result: the LOCAL authoritative result (participant-independent),
// so a completed workflow stays inspectable when the participant is down.
pub variant OperationResultOutcome {
	Succeeded(result_json: String),
	Requested,
	NotFound
}

// operation_fail: durable non-retryable failure -> blocked_resolution. Blocked
// is the committed transition; AlreadyBlocked is the idempotent replay.
pub variant OperationFailOutcome {
	Blocked,
	AlreadyBlocked,
	OperationConflict,
	FenceLost,
	NotFound,
	OperationNotFound,
	EventTimeSkew(defer_until: String)
}

// begin_reversal: forward(1) -> reversing(2) (cursor at the top active checkpoint)
// or -> reversed(5) when nothing to compensate. AlreadyBegun is the trigger-bound
// idempotent replay (carrying the current reverse-direction state).
pub variant BeginReversalOutcome {
	Reversing(top_seq: Int),
	Failed(reason: String),                     // empty-stack reversal: terminal failed, compensated:false
	AlreadyBegun(state: Int, terminal_reason: String),
	TriggerMismatch,
	OperationNotFound,
	OperationConflict,
	OperationNotFailed(status: Int),
	FenceLost,
	NotFound,
	EventTimeSkew(defer_until: String)
}

// Outcome of sp_mf_workflow_authored_fail (a .mf `fail` node). Mirrors BeginReversalOutcome but with
// NO operation precondition: an authored fail follows a settled 200 result, so there is no failed op
// to verify. The fail command identity (a stable id) is the durable trigger.
pub variant AuthoredFailOutcome {
	Reversing(top_seq: Int),
	Failed(reason: String),                       // empty stack: terminal failed, compensated:false
	AlreadyBegun(state: Int, terminal_reason: String),
	TriggerMismatch,                              // a different fail id committed for this instance
	FenceLost,
	NotFound,
	EventTimeSkew(defer_until: String)
}

// Outcome of sp_mf_workflow_reconcile_defer (#2, FORWARD route-404 budget). Within budget -> Deferred
// (budget advanced); exhausted -> Blocked (blocked_resolution, direction forward, indeterminate). A
// block needs a strictly-advancing event_ts (EventTimeSkew -> defer + retry).
pub variant ReconcileDeferOutcome {
	Deferred(attempts: Int),
	Blocked(direction: String, reason: String),
	EventTimeSkew(defer_until: String),
	FenceLost,
	NotFound,
	OperationNotFound,
	OperationConflict,
	OperationNotRequested(status: Int)            // a settled op never route-404s
}

// Outcome of sp_mf_checkpoint_reconcile_defer (#2, REVERSE/compensation route-404 budget). Exhausted ->
// Blocked via the reverse-block path (checkpoint resolution_required). AlreadyBlocked is the
// lease-independent idempotent replay of a committed block.
pub variant CheckpointReconcileDeferOutcome {
	Deferred(attempts: Int),
	Blocked(direction: String, reason: String),
	AlreadyBlocked,
	EventTimeSkew(defer_until: String),
	FenceLost,
	NotFound,
	CheckpointNotFound,
	NotRequested,                                 // no dispatched compensation binding
	ReverseIdMismatch,
	CheckpointNotActive(reversal_state: Int),
	OutOfOrder(top_seq: Int)                       // not the top active checkpoint
}

// Outcome of sp_mf_operation_pending_defer (case [12], FORWARD pending->re-dispatch timer). On a
// CONFIRMED participant pending (GET 202) of a RECOVERED op: within the interval -> Defer (lease
// released + next_attempt set atomically by the SP); interval elapsed -> Redispatch (timer re-armed,
// lease KEPT so the runner re-PUTs byte-identically). Unlike the #2 budget there is no block.
pub variant OperationPendingDeferOutcome {
	Defer(redispatch_count: Int),
	Redispatch(redispatch_count: Int),
	FenceLost,
	NotFound,
	OperationNotFound,
	OperationConflict,
	OperationNotRequested(status: Int)            // a settled op never pends
}

// Outcome of sp_mf_checkpoint_pending_defer (case [12], REVERSE/compensation pending->re-dispatch
// timer). Same Defer/Redispatch discipline as the forward SP; AlreadyBlocked is the lease-independent
// idempotent replay of a checkpoint already blocked for resolution.
pub variant CheckpointPendingDeferOutcome {
	Defer(redispatch_count: Int),
	Redispatch(redispatch_count: Int),
	FenceLost,
	NotFound,
	CheckpointNotFound,
	NotRequested,                                 // no dispatched compensation binding
	ReverseIdMismatch,
	AlreadyBlocked,
	CheckpointNotActive(reversal_state: Int),
	OutOfOrder(top_seq: Int)                       // not the top active checkpoint
}

// reverse_head: the authoritative top active checkpoint (the checkpoint stack,
// not the continuation, decides what to compensate next). Pending = not yet
// dispatched (forward identity to derive the binding); Dispatched = the durable
// pinned reverse binding to reconcile/redispatch against.
pub variant ReverseHeadOutcome {
	NoneActive,
	// call_kind (composition, 1b.1/1c): 1=participant, 2=child_workflow — lets the runner branch to
	// checkpoint_reverse_child_reopen ("T1") + checkpoint_reverse_child_settle for a call checkpoint
	// BEFORE ever looking up a compensation binding (a call checkpoint never has one). Only carried
	// here (Pending) — a call checkpoint can never reach Dispatched, since nothing is ever
	// dispatched for one.
	Pending(seq: Int, forward_operation_name: String, forward_payload: String, call_kind: Int),
	Dispatched(seq: Int, forward_operation_name: String, reverse_invocation_id: String,
	           reverse_operation_name: String, reverse_schema_version: Int,
	           reverse_input_json: String, reverse_input_hash: String)
}

// checkpoint_reverse_request: persist the reverse-invocation id + the full
// compensation binding before dispatch. AlreadyRequested returns the persisted id.
pub variant ReverseRequestOutcome {
	Requested(reverse_invocation_id: String),
	AlreadyRequested(reverse_invocation_id: String, reverse_operation_name: String,
	                 reverse_schema_version: Int, reverse_input_json: String, reverse_input_hash: String),
	BindingConflict,
	OutOfOrder(top_seq: Int),
	CheckpointInactive(reversal_state: Int),
	CheckpointNotFound,
	FenceLost,
	NotFound,
	EventTimeSkew(defer_until: String)
}

// checkpoint_reverse_settle: mark a checkpoint reversed then descend (Reversing
// next_seq) or reach terminal Reversed. AlreadyReversed is the lost-ack replay.
pub variant ReverseSettleOutcome {
	Reversed(terminal_reason: String),         // unwind completed: terminal failed, compensated:true
	Reversing(next_seq: Int),
	AlreadyReversed,
	ReverseIdMismatch,
	NotRequested,
	CheckpointNotSettleable(reversal_state: Int),
	OutOfOrder(top_seq: Int),
	CheckpointNotFound,
	FenceLost,
	NotFound,
	EventTimeSkew(defer_until: String)
}

// checkpoint_reverse_block: enter blocked_resolution (reverse direction).
pub variant ReverseBlockOutcome {
	Blocked,
	AlreadyBlocked,
	ReverseIdMismatch,
	NotRequested,
	CheckpointNotBlockable(reversal_state: Int),
	OutOfOrder(top_seq: Int),
	CheckpointNotFound,
	FenceLost,
	NotFound,
	EventTimeSkew(defer_until: String)
}

// --- Composition (1b.1/1c): workflow-to-workflow calls ---

// call_submit: sibling of operation_request — persists the parent's call-op row AND, in the
// SAME transaction, creates the full planned-workflow bundle for the child (workflow + plan +
// args + its own created event) + the tb_mf_call sidecar, running the read-only recursion guard.
// CallConflict/CallRejected/PlanViolation mirror sp_mf_call_submit.sql's strict
// validate-then-mutate phasing: every one of them is reached with ZERO writes issued.
pub variant CallSubmitOutcome {
	Submitted(child_workflow_id: String),
	AlreadySubmitted(child_workflow_id: String),      // idempotent replay, full agreement
	CallConflict,                                     // replay with a mismatched immutable field
	CallRejected(reason: String),                     // recursion guard: call_cycle | max_call_depth_exceeded
	PlanViolation(reason: String, plan_length: Int),   // seq_out_of_range | predecessor_incomplete
	EventTimeSkew(defer_until: String),
	FenceLost,
	NotFound
}

// call_inspect: PURE read (no fence, no write) — the child workflow row's AUTHORITATIVE
// state/return, plus the sidecar's (possibly-stale) child_status DISPLAY HINT. Never used to
// settle/fail the parent's call op; that reads THIS outcome and drives operation_settle/
// begin_reversal/operation_fail, the existing (unchanged) forward-settle machinery.
pub variant CallInspectOutcome {
	Found(child_workflow_id: String, child_status: Int, state: Int, execution_direction: Int,
	      current_disposition: Int, is_terminal: Bool, terminal_reason: String,
	      workflow_return_json: Optional<String>),
	NotFound
}

// call_hint_refresh: explicitly BEST-EFFORT (no fence — a display hint, never a value of
// record). Monotonic by time: a stale/out-of-order refresh is silently absorbed, never an error.
pub variant CallHintRefreshOutcome {
	Refreshed,
	NotFound
}

// child_terminal_notify: WAKE + STATUS-HINT ONLY (§Liveness) — invoked from the CHILD's own
// terminal-transition context, a SEPARATE call strictly AFTER that transaction has already
// committed (never nested inside it). Best-effort, unfenced by design: correctness never depends
// on it landing (call_inspect's poll is the floor).
pub variant ChildTerminalNotifyOutcome {
	Notified,
	NotFound
}

// Result for the *_best_effort wrappers (child_terminal_notify_best_effort,
// call_hint_refresh_best_effort): Ok means the underlying call completed (Notified/Refreshed OR the
// harmless SkippedNotFound — e.g. this workflow isn't referenced as anyone's child — both are a clean
// outcome, never distinguished further since neither affects caller correctness). Every OTHER variant
// mirrors one HostErrorKind case (see _kind_to_best_effort) for the failure modes the *_core function
// classifies DIRECTLY (its own entry-shape checks + its own `managed:ManagedError` handling) — this is
// NOT full fidelity for every conceivable failure: a HostException thrown by the shared SP-call
// plumbing further down (_call_sp_doc and friends — see _call_hint_refresh_core's own comment) still
// escapes as a genuinely-unclassifiable exception and lands in UnexpectedDefect instead. A caller MUST
// NEVER treat any non-Ok/SkippedNotFound variant here as a reason to change its own workflow outcome
// — these calls are advisory by design (poll/call_inspect is always the correctness floor); this type
// exists purely so the failure is CLASSIFIED (as far as is achievable) and LOGGABLE, never dropped.
pub variant BestEffort {
	Ok,
	SkippedNotFound,
	InvalidId(field: String, actual_len: Int),
	InvalidArg(field: String),
	InvalidJson(field: String),
	BackendUnavailable(detail: String),
	BackendTimeout(detail: String),
	BackendRejected(detail: String),
	InvalidResponse(detail: String),
	UnexpectedDefect(detail: String)
}

// Shared HostErrorKind -> BestEffort mapping for every *_best_effort wrapper — a straight 1:1
// rename (BackendResponseInvalid -> InvalidResponse for brevity; every other case keeps its name
// and fields verbatim), kept as ONE function so the mapping can never drift between wrappers.
fn _kind_to_best_effort(kind: HostErrorKind) nothrow -> BestEffort {
	return match kind {
		HostErrorKind::InvalidId(field, actual_len) => { BestEffort::InvalidId(field = field, actual_len = actual_len) },
		HostErrorKind::InvalidArg(field) => { BestEffort::InvalidArg(field = field) },
		HostErrorKind::InvalidJson(field) => { BestEffort::InvalidJson(field = field) },
		HostErrorKind::BackendUnavailable(detail) => { BestEffort::BackendUnavailable(detail = detail) },
		HostErrorKind::BackendTimeout(detail) => { BestEffort::BackendTimeout(detail = detail) },
		HostErrorKind::BackendRejected(detail) => { BestEffort::BackendRejected(detail = detail) },
		HostErrorKind::BackendResponseInvalid(detail) => { BestEffort::InvalidResponse(detail = detail) }
	};
}

// checkpoint_reverse_child_reopen ("T1", composition 1c, work/workflow-composition/1c-design.md
// §1-2): reopen a workflow-call checkpoint's COMPLETED child into reversal
// (completed(4)->reversing(2)), fenced on the PARENT (the child has no lease of its own to fence —
// a completed(4) row is always unclaimed). An explicit two-row (parent+child) transaction: the
// parent gets a `compensation_requested` audit event in the SAME commit as the child's reopen.
// Idempotent, keyed on the CHILD's current state: AlreadyReopened covers a prior reopen (child
// state 2/3/5/6); ChildStateInconsistent is corruption evidence (a failed/otherwise-invalid child
// state for a call checkpoint that should always have been completed(4)) — never a benign skip.
pub variant CheckpointReverseChildReopenOutcome {
	Reopened(child_workflow_id: String),
	AlreadyReopened(child_state: Int),
	ChildStateInconsistent(child_state: Int),
	// Durable inconsistency: every completed(4) child settled >= 1 operation and therefore has
	// >= 1 active checkpoint by construction; NULL here means that invariant broke.
	ChildNoActiveCheckpoint,
	OutOfOrder(top_seq: Int),
	EventTimeSkew(defer_until: String),
	FenceLost,
	NotFound,
	CheckpointNotFound,
	NotCallCheckpoint,
	CallSidecarNotFound,
	ChildNotFound
}

// checkpoint_reverse_child_settle (composition 1c, 1c-design.md §2): settle a workflow-call
// checkpoint once its child's OWN compensation has actually reached a terminal compensated state —
// this SP independently re-locks and re-reads the child's CURRENT state inside its own transaction
// and REQUIRES reversed(5)/resolved_exception(6) before flipping the parent's checkpoint; it never
// trusts a separate, earlier call_inspect read as proof the child is done. ChildNotTerminal (child
// still reversing/blocked_resolution) is the expected "not yet" shape, not an error — the caller
// should defer and re-poll. ChildNotCompensated (child forward/completed/failed) is diagnostic,
// never settled as if compensated. Same reversal_state 1->2 + descend-or-terminal mechanics as the
// retired sp_mf_checkpoint_reverse_noop (that part was never wrong, only its name and the missing
// child-state check were). NotCallCheckpoint is a defensive guard: this outcome must never be
// reachable for a participant checkpoint (that must go through reverse_request/dispatch/
// reverse_settle instead).
pub variant CheckpointReverseChildSettleOutcome {
	Reversed(terminal_reason: String),
	Reversing(next_seq: Int),
	AlreadyReversed,
	ChildNotTerminal(child_state: Int),
	ChildNotCompensated(child_state: Int),
	OutOfOrder(top_seq: Int),
	EventTimeSkew(defer_until: String),
	FenceLost,
	NotFound,
	CheckpointNotFound,
	CheckpointNotSettleable(reversal_state: Int),
	NotCallCheckpoint,
	CallSidecarNotFound,
	ChildNotFound
}

// The durable operation request — authoritative for recovery (a resuming worker
// uses this, never re-derives from CLI input).
pub struct OperationRequestRecord {
	pub operation_id: Array<Byte>,
	pub operation_name: String,
	pub schema_version: Int,
	pub input_json: String,
	pub input_hash: String,
	pub status: Int
}

pub variant OperationRequestGetOutcome {
	Found(record: OperationRequestRecord),
	NotFound
}

// Operation settle (record success + checkpoint + advance continuation +
// complete workflow). AlreadySettled.result is AUTHORITATIVE — the caller must
// use it, never its submitted result. Identify-first then idempotent-read
// before fence (settle clears the lease).
pub variant OperationSettleOutcome {
	Settled(result_json: String),
	AlreadySettled(result_json: String),
	OperationConflict,
	FenceLost,
	NotFound,
	OperationNotFound,
	// The settle violates the pinned plan: seq out of range, checkpoint_seq != seq, or
	// finality disagreeing with plan_length. `reason` names which.
	PlanViolation(reason: String),
	EventTimeSkew(defer_until: String)
}

// A workflow's durable pinned PLAN identity: `(script_name, plan_version,
// content_hash, plan_length)`. plan_version is the immutable semantic version
// (major.minor.patch); content_hash is the 33-byte digest, hex-encoded. The runner
// resolves the IR for (script_name, plan_version) and verifies content_hash exactly;
// it never substitutes a different plan.
pub struct PinnedScript {
	pub script_name: String,
	pub plan_version: String,   // immutable semver: major.minor.patch
	pub content_hash: String,   // 66 hex chars (1 scheme byte + 32-byte SHA-256)
	pub plan_length: Int
}

// create_planned: create a workflow + pin its plan atomically. Created and Exists both
// RETURN the committed pin (the supplied generation on Created, the WINNING durable pin
// on Exists — creation races adopt the winner, never conflict on a differing plan).
pub variant CreatePlannedOutcome {
	Created(pin: PinnedScript),
	Exists(pin: PinnedScript),
	// The workflow_id exists under a CONTRADICTORY identity: a DIFFERENT stored plan name
	// (id collision — must not adopt the other plan), or a NON-plan (legacy) workflow with
	// no pin to return. It cannot be (re)interpreted as this plan.
	PlanConflict(plan_length: Int),
	// The workflow_id exists under the SAME plan name but DIFFERENT instance arguments
	// (compared byte-for-byte on the canonical args document). Instance data is immutable —
	// a different argument object is a different instance, not an adoptable race winner.
	WorkflowConflict(plan_length: Int)
}

// plan_get: read a workflow's durable pinned identity (registry-independent).
pub variant PlanGetOutcome {
	Found(pin: PinnedScript),
	NotFound
}

// args_get: read a workflow's durable instance arguments (the canonical JSON object).
// Resume reads this, never submission/CLI input.
pub variant ArgsGetOutcome {
	Found(args_json: String),
	NotFound
}

// ===== Error surface =====

pub variant HostConfigErrorKind {
	BuilderMissingJson,
	BuilderMissingIdentity,
	BuilderBadExecutorIdLength(actual: Int),
	JsonMissingKey(key: String),
	JsonBadType(key: String, expected: String),
	JsonUnknownBackend(value: String),
	JsonPortOutOfRange(value: Int),
	JsonTimeoutNonPositive(key: String, value: Int),
	JsonPoolSizingInvalid(key: String, value: Int),
	PoolOpenFailed(upstream_tag: String),
	RpcConfigInvalid(upstream_tag: String)
}

implement core.Diagnostic for HostConfigErrorKind {
	pub fn to_json_text(self: &HostConfigErrorKind) nothrow -> String {
		return match self {
			HostConfigErrorKind::BuilderMissingJson => { "\"builder-missing-json\"" },
			HostConfigErrorKind::BuilderMissingIdentity => { "\"builder-missing-identity\"" },
			HostConfigErrorKind::BuilderBadExecutorIdLength(actual) => { "\"builder-bad-executor-id-length\"" },
			HostConfigErrorKind::JsonMissingKey(key) => { "\"json-missing-key\"" },
			HostConfigErrorKind::JsonBadType(key, expected) => { "\"json-bad-type\"" },
			HostConfigErrorKind::JsonUnknownBackend(value) => { "\"json-unknown-backend\"" },
			HostConfigErrorKind::JsonPortOutOfRange(value) => { "\"json-port-out-of-range\"" },
			HostConfigErrorKind::JsonTimeoutNonPositive(key, value) => { "\"json-timeout-non-positive\"" },
			HostConfigErrorKind::JsonPoolSizingInvalid(key, value) => { "\"json-pool-sizing-invalid\"" },
			HostConfigErrorKind::PoolOpenFailed(upstream_tag) => { "\"pool-open-failed\"" },
			HostConfigErrorKind::RpcConfigInvalid(upstream_tag) => { "\"rpc-config-invalid\"" }
		};
	}
}

pub error HostConfigError {
	kind: HostConfigErrorKind,
	path: String
}

// Runtime failure taxonomy — caller-actionable, backend-agnostic. `detail`
// is diagnostic-only, never a contract.
pub variant HostErrorKind {
	InvalidId(field: String, actual_len: Int),      // caller input bug
	InvalidArg(field: String),                      // caller input bug
	InvalidJson(field: String),                     // caller input bug
	BackendUnavailable(detail: String),             // could not reach/acquire the store — retriable
	BackendTimeout(detail: String),                 // a deadline elapsed — retriable / shed load
	BackendRejected(detail: String),                // store ran the op and reported failure
	BackendResponseInvalid(detail: String)          // malformed/unexpected response — schema/version skew
}

implement core.Diagnostic for HostErrorKind {
	pub fn to_json_text(self: &HostErrorKind) nothrow -> String {
		return match self {
			HostErrorKind::InvalidId(field, actual_len) => { "\"invalid-id\"" },
			HostErrorKind::InvalidArg(field) => { "\"invalid-arg\"" },
			HostErrorKind::InvalidJson(field) => { "\"invalid-json\"" },
			HostErrorKind::BackendUnavailable(detail) => { "\"backend-unavailable\"" },
			HostErrorKind::BackendTimeout(detail) => { "\"backend-timeout\"" },
			HostErrorKind::BackendRejected(detail) => { "\"backend-rejected\"" },
			HostErrorKind::BackendResponseInvalid(detail) => { "\"backend-response-invalid\"" }
		};
	}
}

pub error HostException {
	kind: HostErrorKind
}

// ===== Interface =====

pub interface MicroflowsHost {
	// Source database_now (+ a lease deadline lease_seconds ahead). The only
	// clock read in the system (§24.4).
	fn clock_read(self: &Self, lease_seconds: Int) -> ClockReading;
	// Create a workflow instance pinned to (script_name, script_revision),
	// with its 'created' event. Idempotent by workflow_id.
	fn create_workflow(self: &Self, workflow_id: &Array<Byte>, script_name: &String,
	                   script_revision: Int, event_ts: &String, next_attempt_at: &String,
	                   continuation_json: &String, event_payload_json: &String) -> CreateOutcome;
	// Create a workflow AND pin its plan (plan_version + content_hash + length) + its
	// instance arguments atomically. The argument object (`args_json`) is CANONICALIZED at
	// this command boundary (ordered-key compact UTF-8) before storage/compare, so reordered
	// keys never produce a false conflict. Idempotent; Created/Exists return the committed pin
	// (Exists returns the WINNING durable pin); PlanConflict on a contradictory identity
	// (different plan name / legacy non-plan); WorkflowConflict when the same plan name is
	// reused with different canonical argument bytes.
	fn create_planned(self: &Self, workflow_id: &Array<Byte>, script_name: &String,
	                  plan_version: &String, event_ts: &String, next_attempt_at: &String,
	                  continuation_json: &String, event_payload_json: &String,
	                  content_hash: &Array<Byte>, plan_length: Int,
	                  args_json: &String) -> CreatePlannedOutcome;
	// Read a workflow's durable pinned script-revision identity (registry-independent).
	fn plan_get(self: &Self, workflow_id: &Array<Byte>) -> PlanGetOutcome;
	// Read a workflow's durable instance arguments (resume reads this, never CLI input).
	fn args_get(self: &Self, workflow_id: &Array<Byte>) -> ArgsGetOutcome;
	// Claim the next due instance of one script (§24.2). db_now and
	// lease_expires_at come from clock_read, fixed for this command.
	fn claim_next(self: &Self, script_name: &String, db_now: &String,
	              lease_expires_at: &String) -> ClaimOutcome;
	// Claim ONE specific workflow by id (no wrong-workflow claims).
	fn claim_workflow(self: &Self, workflow_id: &Array<Byte>, db_now: &String,
	                  lease_expires_at: &String) -> ClaimByIdOutcome;
	// Read-only workflow inspection (terminal/active/deferred/absent).
	fn inspect_workflow(self: &Self, workflow_id: &Array<Byte>, db_now: &String) -> WorkflowInspectOutcome;
	// Fenced lease extension (§24.5).
	fn heartbeat(self: &Self, workflow_id: &Array<Byte>, fencing_token: Int,
	             db_now: &String, lease_expires_at: &String) -> HeartbeatOutcome;
	// Fenced voluntary release with explicit next due time (backoff lives on
	// the row, §24.5).
	fn release(self: &Self, workflow_id: &Array<Byte>, fencing_token: Int,
	           db_now: &String, next_attempt_at: &String) -> ReleaseOutcome;
	// Durable OPERATIONAL deferral of a dispatch (forward stays forward; lease
	// cleared; next_attempt set; an 'operation_dispatch_deferred' audit event with
	// `reason` is appended on ENTRY into the wait condition, deduped on retry). For
	// repairable config states (e.g. pinned binding unavailable) — NOT a failure.
	fn defer_dispatch(self: &Self, workflow_id: &Array<Byte>, fencing_token: Int,
	                  db_now: &String, next_attempt_at: &String, event_ts: &String,
	                  reason: &String) -> ReleaseOutcome;
	// Advance the durable reconcile budget on a confirmed FORWARD route-404; within budget -> deferred,
	// exhausted -> blocked_resolution (forward, indeterminate). Fenced + atomic.
	fn reconcile_defer(self: &Self, workflow_id: &Array<Byte>, fencing_token: Int,
	                   operation_seq: Int, operation_id: &Array<Byte>, db_now: &String,
	                   next_attempt_at: &String, event_ts: &String,
	                   max_elapsed_ms: Int, min_attempts: Int) -> ReconcileDeferOutcome;
	// Advance the REVERSE (compensation) reconcile budget on a confirmed route-404; exhausted -> the
	// reverse-block path (blocked_resolution, checkpoint resolution_required). Fenced + atomic.
	fn checkpoint_reconcile_defer(self: &Self, workflow_id: &Array<Byte>, fencing_token: Int,
	                              seq: Int, reverse_id: &Array<Byte>, db_now: &String,
	                              next_attempt_at: &String, event_ts: &String,
	                              max_elapsed_ms: Int, min_attempts: Int) -> CheckpointReconcileDeferOutcome;
	// Advance the durable pending->re-dispatch timer on a confirmed FORWARD participant pending (GET 202)
	// of a RECOVERED op; within interval -> Defer (lease released atomically), elapsed -> Redispatch
	// (lease kept; runner re-PUTs byte-identically). Fenced + atomic. (case [12])
	fn operation_pending_defer(self: &Self, workflow_id: &Array<Byte>, fencing_token: Int,
	                           operation_seq: Int, operation_id: &Array<Byte>, db_now: &String,
	                           next_attempt_at: &String, event_ts: &String,
	                           after_ms: Int) -> OperationPendingDeferOutcome;
	// Advance the REVERSE (compensation) pending->re-dispatch timer on a confirmed participant pending of
	// a RECOVERED reverse dispatch; same Defer/Redispatch discipline. Fenced + atomic. (case [12])
	fn checkpoint_pending_defer(self: &Self, workflow_id: &Array<Byte>, fencing_token: Int,
	                            seq: Int, reverse_id: &Array<Byte>, db_now: &String,
	                            next_attempt_at: &String, event_ts: &String,
	                            after_ms: Int) -> CheckpointPendingDeferOutcome;
	// Persist an operation request + the suspended continuation, atomically,
	// BEFORE dispatch. Fenced (fence-first). Idempotent by (workflow_id,
	// operation_seq); command-identity-checked.
	fn operation_request(self: &Self, workflow_id: &Array<Byte>, fencing_token: Int,
	                     operation_seq: Int, operation_id: &Array<Byte>, operation_name: &String,
	                     schema_version: Int, input_json: &String, input_hash: &String,
	                     new_continuation: &String, event_ts: &String, event_payload: &String) -> OperationRequestOutcome;
	// Record a durable operation SUCCESS + Checkpoint + advanced continuation,
	// completing the workflow, atomically. Fenced; identify-first; idempotent
	// (AlreadySettled.result is authoritative).
	// `workflow_return_json` (1b.0a step 3) is the workflow's AUTHORITATIVE typed
	// return, separate from `result_json` (the per-operation result): `Some(json)`
	// on a final settle (`is_final=true`), `None` on a non-final one — the SP
	// requires exactly this (a JSON object iff final, SQL NULL otherwise).
	fn operation_settle(self: &Self, workflow_id: &Array<Byte>, fencing_token: Int,
	                    operation_seq: Int, operation_id: &Array<Byte>, checkpoint_seq: Int,
	                    result_json: &String, checkpoint_payload: &String,
	                    workflow_return_json: &Optional<String>, new_continuation: &String,
	                    event_ts: &String, event_payload: &String, is_final: Bool) -> OperationSettleOutcome;
	// Read the LOCAL authoritative operation result (participant-independent).
	fn operation_result(self: &Self, workflow_id: &Array<Byte>, operation_seq: Int) -> OperationResultOutcome;
	// Durable non-retryable failure: forward -> blocked_resolution (fenced).
	fn operation_fail(self: &Self, workflow_id: &Array<Byte>, fencing_token: Int,
	                  operation_seq: Int, operation_id: &Array<Byte>, new_continuation: &String,
	                  event_ts: &String, event_payload: &String) -> OperationFailOutcome;
	// Load the durable operation request (authoritative for recovery).
	fn operation_request_get(self: &Self, workflow_id: &Array<Byte>, operation_seq: Int) -> OperationRequestGetOutcome;
	// --- Reversal / compensation (reverse-direction aggregate transitions) ---
	// Begin reversal on a definite forward failure (durable triggering op).
	fn begin_reversal(self: &Self, workflow_id: &Array<Byte>, fencing_token: Int,
	                  operation_seq: Int, operation_id: &Array<Byte>, event_ts: &String,
	                  reason: &String) -> BeginReversalOutcome;
	// Begin reversal on an AUTHORED fail (.mf `fail` node); fail_id is the stable command identity.
	fn authored_fail(self: &Self, workflow_id: &Array<Byte>, fencing_token: Int,
	                 fail_id: &Array<Byte>, event_ts: &String, reason: &String) -> AuthoredFailOutcome;
	// The authoritative top active checkpoint (reverse cursor) + durable binding.
	fn reverse_head(self: &Self, workflow_id: &Array<Byte>) -> ReverseHeadOutcome;
	// Persist a checkpoint's reverse-invocation id + compensation binding before
	// dispatch (pinned reverse contract + input identity).
	fn reverse_request(self: &Self, workflow_id: &Array<Byte>, fencing_token: Int,
	                   seq: Int, reverse_id: &Array<Byte>, reverse_operation_name: &String,
	                   reverse_schema_version: Int, reverse_input_json: &String,
	                   reverse_input_hash: &String, event_ts: &String) -> ReverseRequestOutcome;
	// Settle a checkpoint's compensation on a durable reverse-success.
	fn reverse_settle(self: &Self, workflow_id: &Array<Byte>, fencing_token: Int,
	                  seq: Int, reverse_id: &Array<Byte>, result_json: &String,
	                  event_ts: &String) -> ReverseSettleOutcome;
	// Enter blocked_resolution when compensation cannot safely continue.
	fn reverse_block(self: &Self, workflow_id: &Array<Byte>, fencing_token: Int,
	                 seq: Int, reverse_id: &Array<Byte>, disposition: Int, reason: &String,
	                 event_ts: &String) -> ReverseBlockOutcome;
	// --- Composition (1b.1/1c): workflow-to-workflow calls ---
	// Submit a workflow call: persist the parent's call op + create the full planned child
	// bundle, atomically. input_json is the call's input, canonicalized here exactly as
	// create_planned canonicalizes instance args (it becomes the child's own args).
	// input_hash is DERIVED here from the SAME canonical bytes, never caller-supplied — this
	// avoids the hidden invariant a separate caller-supplied hash would create (the caller
	// would have to independently canonicalize identically to the host's own canonicalization).
	fn call_submit(self: &Self, workflow_id: &Array<Byte>, fencing_token: Int,
	              operation_seq: Int, operation_id: &Array<Byte>,
	              input_json: &String,
	              new_continuation: &String, event_ts: &String, event_payload: &String,
	              child_workflow_id: &Array<Byte>, child_script_name: &String,
	              child_plan_version: &String, child_content_hash: &Array<Byte>,
	              child_plan_length: Int, child_continuation: &String,
	              child_next_attempt_at: &String, child_event_payload: &String,
	              parent_node_id: &String, max_call_depth: Int) -> CallSubmitOutcome;
	// PURE read of the child's authoritative state/return + the sidecar's display hint.
	fn call_inspect(self: &Self, workflow_id: &Array<Byte>, operation_seq: Int) -> CallInspectOutcome;
	// Best-effort, unfenced refresh of the sidecar's display-only child_status hint.
	fn call_hint_refresh(self: &Self, workflow_id: &Array<Byte>, operation_seq: Int,
	                     child_status: Int, event_ts: &String) -> CallHintRefreshOutcome;
	// Wake + status-hint ONLY, on a child terminal — best-effort, unfenced, never settles the parent.
	fn child_terminal_notify(self: &Self, child_workflow_id: &Array<Byte>, child_status: Int,
	                         event_ts: &String) -> ChildTerminalNotifyOutcome;
	// NOTHROW best-effort wrapper around child_terminal_notify: the underlying HostErrorKind is
	// recovered as a plain value (errors-as-values — see _child_terminal_notify_core) and CLASSIFIED
	// into a typed BestEffort for its own entry-shape/backend checks, never silently swallowed by a
	// caller-side catch-all. A HostException escaping from the shared SP-call plumbing further down
	// (see _child_terminal_notify_core's own comment) is NOT re-classified — it lands in
	// BestEffort::UnexpectedDefect, still fully diagnosable via its captured envelope, just not a
	// specific HostErrorKind. A caller that must not let this change its own workflow outcome (1b.1's
	// runner, on every terminal transition) gets a typed, loggable result either way, instead of an
	// exception to either propagate (wrong — this is advisory) or blindly swallow (wrong — hides real
	// defects).
	fn child_terminal_notify_best_effort(self: &Self, child_workflow_id: &Array<Byte>, child_status: Int,
	                                     event_ts: &String) nothrow -> BestEffort;
	// NOTHROW best-effort wrapper around call_hint_refresh — same rationale as
	// child_terminal_notify_best_effort above.
	fn call_hint_refresh_best_effort(self: &Self, workflow_id: &Array<Byte>, operation_seq: Int,
	                                 child_status: Int, event_ts: &String) nothrow -> BestEffort;
	// Reopen a workflow-call checkpoint's completed child into reversal ("T1", composition 1c).
	fn checkpoint_reverse_child_reopen(self: &Self, workflow_id: &Array<Byte>, fencing_token: Int,
	                                   seq: Int, event_ts: &String) -> CheckpointReverseChildReopenOutcome;
	// Settle a workflow-call checkpoint once its child's own compensation reached a terminal
	// compensated state (composition 1c).
	fn checkpoint_reverse_child_settle(self: &Self, workflow_id: &Array<Byte>, fencing_token: Int,
	                                   seq: Int, event_ts: &String) -> CheckpointReverseChildSettleOutcome
}

// ===== Builder =====

pub struct HostBuilder {
	json_config: Optional<json.JsonNode>,
	identity: Optional<ExecutorIdentity>
}

pub fn new_host_builder() nothrow -> HostBuilder {
	return HostBuilder(
		json_config = Optional<json.JsonNode>::None(),
		identity = Optional<ExecutorIdentity>::None()
	);
}

pub fn with_json(b: &mut HostBuilder, config: &json.JsonNode) nothrow -> Void {
	b.json_config = Optional<json.JsonNode>::Some(config.clone_deep());
}

pub fn with_identity(b: &mut HostBuilder, identity: ExecutorIdentity) -> Void {
	if identity.executor_id.len() != 16 {
		throw HostConfigError(
			kind = HostConfigErrorKind::BuilderBadExecutorIdLength(actual = identity.executor_id.len()),
			path = ""
		);
	}
	b.identity = Optional<ExecutorIdentity>::Some(move identity);
}

pub fn build_host(var b: HostBuilder) nothrow -> core.Result<arc.Arc<MicroflowsHost>, HostConfigError> {
	val have_json: Bool = match &b.json_config {
		Optional::Some(_) => { true },
		Optional::None => { false }
	};
	if !have_json {
		return core.Result<arc.Arc<MicroflowsHost>, HostConfigError>::Err(
			HostConfigError(kind = HostConfigErrorKind::BuilderMissingJson(), path = "")
		);
	}
	val have_id: Bool = match &b.identity {
		Optional::Some(_) => { true },
		Optional::None => { false }
	};
	if !have_id {
		return core.Result<arc.Arc<MicroflowsHost>, HostConfigError>::Err(
			HostConfigError(kind = HostConfigErrorKind::BuilderMissingIdentity(), path = "")
		);
	}

	var identity_local: Optional<ExecutorIdentity> = Optional<ExecutorIdentity>::None();
	mem.swap(&mut b.identity, &mut identity_local);
	var taken_identity: ExecutorIdentity = match move identity_local {
		Optional::Some(v) => { move v },
		Optional::None => { _dummy_identity() }
	};

	var json_local: Optional<json.JsonNode> = Optional<json.JsonNode>::None();
	mem.swap(&mut b.json_config, &mut json_local);
	val cfg_node: json.JsonNode = match move json_local {
		Optional::Some(n) => { move n },
		Optional::None => { json.new_object().to_node() }
	};

	// Errors-as-values: the parsers RETURN Result<_, HostConfigError> so the structured error
	// stays a movable native value and never round-trips through throw/catch. (A caught
	// HostConfigError cannot be re-raised in its concrete form — its `kind` is a non-scalar
	// variant field, outside the v1 typed-catch projection boundary; confirmed an intentional
	// toolchain limitation, 2026-06-15.) Statement-form matches: the Err arm returns the value,
	// the Ok arm carries the config forward. pool.open's Result is matched directly — no try
	// (match-arm bindings are not in scope inside a nested try block).
	match _build_rpc_config_from_json(&cfg_node) {
		core.Result::Err(cfg_err) => {
			return core.Result<arc.Arc<MicroflowsHost>, HostConfigError>::Err(move cfg_err);
		},
		core.Result::Ok(rpc_cfg) => {
			match _build_pool_config_from_json(&cfg_node) {
				core.Result::Err(cfg_err) => {
					return core.Result<arc.Arc<MicroflowsHost>, HostConfigError>::Err(move cfg_err);
				},
				core.Result::Ok(pool_cfg) => {
					match pool.open(move rpc_cfg, move pool_cfg) {
						core.Result::Err(open_err) => {
							return core.Result<arc.Arc<MicroflowsHost>, HostConfigError>::Err(
								HostConfigError(
									kind = HostConfigErrorKind::PoolOpenFailed(upstream_tag = _dup(&open_err.tag)),
									path = ""
								)
							);
						},
						core.Result::Ok(p) => {
							val inst = HostImpl(
								identity = move taken_identity,
								pool = move p
							);
							val inst_arc: arc.Arc<HostImpl> = arc.arc(move inst);
							val host: arc.Arc<MicroflowsHost> = inst_arc.as_interface<type MicroflowsHost>();
							return core.Result<arc.Arc<MicroflowsHost>, HostConfigError>::Ok(move host);
						}
					}
				}
			}
		}
	}
}

// ===== JSON config parsing =====

// Errors-as-values: returns Result<_, HostConfigError>; a parse failure is a movable native
// HostConfigError, never thrown/recaught. Flat propagation idiom: `var x = <default>; match`
// (a statement-form match may `return` from an arm; expression-form `val x = match …` may not).
fn _build_rpc_config_from_json(node: &json.JsonNode)
	nothrow -> core.Result<rpc.RpcConnectionConfig, HostConfigError>
{
	var backend: String = "";
	match _read_required_string(node, &"backend") {
		core.Result::Ok(s) => { backend = move s; },
		core.Result::Err(e) => { return core.Result<rpc.RpcConnectionConfig, HostConfigError>::Err(move e); }
	}
	if backend != "mariadb" {
		return core.Result<rpc.RpcConnectionConfig, HostConfigError>::Err(
			HostConfigError(kind = HostConfigErrorKind::JsonUnknownBackend(value = move backend), path = "backend")
		);
	}
	var host: String = "";
	match _read_required_string(node, &"host") {
		core.Result::Ok(s) => { host = move s; },
		core.Result::Err(e) => { return core.Result<rpc.RpcConnectionConfig, HostConfigError>::Err(move e); }
	}
	var port: Int = 0;
	match _read_required_int(node, &"port") {
		core.Result::Ok(v) => { port = v; },
		core.Result::Err(e) => { return core.Result<rpc.RpcConnectionConfig, HostConfigError>::Err(move e); }
	}
	if port < 1 or port > 65535 {
		return core.Result<rpc.RpcConnectionConfig, HostConfigError>::Err(
			HostConfigError(kind = HostConfigErrorKind::JsonPortOutOfRange(value = port), path = "port")
		);
	}
	var user: String = "";
	match _read_required_string(node, &"user") {
		core.Result::Ok(s) => { user = move s; },
		core.Result::Err(e) => { return core.Result<rpc.RpcConnectionConfig, HostConfigError>::Err(move e); }
	}
	var password: String = "";
	match _read_required_string(node, &"password") {
		core.Result::Ok(s) => { password = move s; },
		core.Result::Err(e) => { return core.Result<rpc.RpcConnectionConfig, HostConfigError>::Err(move e); }
	}
	var database: String = "";
	match _read_required_string(node, &"database") {
		core.Result::Ok(s) => { database = move s; },
		core.Result::Err(e) => { return core.Result<rpc.RpcConnectionConfig, HostConfigError>::Err(move e); }
	}
	val connect_timeout_ms: Int = _read_optional_positive_int(node, &"connect_timeout_ms", 5000);
	val io_timeout_ms: Int = _read_optional_positive_int(node, &"io_timeout_ms", 30000);

	var builder = rpc.new_connection_config_builder();
	builder.with_host(move host);
	builder.with_port(port);
	builder.with_user(move user);
	builder.with_password(move password);
	builder.with_database(move database);
	builder.with_connect_timeout_ms(connect_timeout_ms);
	builder.with_read_timeout_ms(io_timeout_ms);
	builder.with_write_timeout_ms(io_timeout_ms);
	match rpc.build_connection_config(move builder) {
		core.Result::Ok(cfg) => { return core.Result<rpc.RpcConnectionConfig, HostConfigError>::Ok(move cfg); },
		core.Result::Err(_) => {
			return core.Result<rpc.RpcConnectionConfig, HostConfigError>::Err(
				HostConfigError(kind = HostConfigErrorKind::RpcConfigInvalid(upstream_tag = "rpc-config-build-failed"), path = "")
			);
		}
	}
}

fn _build_pool_config_from_json(node: &json.JsonNode)
	nothrow -> core.Result<pool.PoolConfig, HostConfigError>
{
	var pc: pool.PoolConfig = pool.default_pool_config();

	val pool_opt: Optional<&json.JsonNode> = node.get(&"pool");
	match pool_opt {
		Optional::Some(psub) => {
			match psub.get_int_at_path(&"min_idle") {
				Optional::Some(v) => {
					if v < 0 { return core.Result<pool.PoolConfig, HostConfigError>::Err(HostConfigError(kind = HostConfigErrorKind::JsonPoolSizingInvalid(key = "min_idle", value = v), path = "pool.min_idle")); }
					pc.min_idle = v;
				},
				Optional::None => {}
			}
			match psub.get_int_at_path(&"max_conns") {
				Optional::Some(v) => {
					if v < 1 { return core.Result<pool.PoolConfig, HostConfigError>::Err(HostConfigError(kind = HostConfigErrorKind::JsonPoolSizingInvalid(key = "max_conns", value = v), path = "pool.max_conns")); }
					pc.max_conns = v;
				},
				Optional::None => {}
			}
			match psub.get_int_at_path(&"idle_timeout_ms") {
				Optional::Some(v) => {
					if v <= 0 { return core.Result<pool.PoolConfig, HostConfigError>::Err(HostConfigError(kind = HostConfigErrorKind::JsonTimeoutNonPositive(key = "idle_timeout_ms", value = v), path = "pool.idle_timeout_ms")); }
					pc.idle_timeout_ms = v;
				},
				Optional::None => {}
			}
			match psub.get_int_at_path(&"keepalive_interval_ms") {
				Optional::Some(v) => {
					if v < 0 { return core.Result<pool.PoolConfig, HostConfigError>::Err(HostConfigError(kind = HostConfigErrorKind::JsonTimeoutNonPositive(key = "keepalive_interval_ms", value = v), path = "pool.keepalive_interval_ms")); }
					pc.keepalive_interval_ms = v;
				},
				Optional::None => {}
			}
		},
		Optional::None => {}
	}

	// Always bound the pool acquire (mirrors Singular: never block forever).
	var acquire_ms: Int = 5000;
	match _read_acquire_timeout_ms(node) {
		core.Result::Ok(v) => { acquire_ms = v; },
		core.Result::Err(e) => { return core.Result<pool.PoolConfig, HostConfigError>::Err(move e); }
	}
	pc.acquire_timeout = Optional<conc.Duration>::Some(conc.Duration(millis = acquire_ms));

	return core.Result<pool.PoolConfig, HostConfigError>::Ok(move pc);
}

fn _read_acquire_timeout_ms(node: &json.JsonNode) nothrow -> core.Result<Int, HostConfigError> {
	match node.get(&"pool") {
		Optional::Some(psub) => {
			match psub.get_int_at_path(&"acquire_timeout_ms") {
				Optional::Some(v) => {
					if v <= 0 { return core.Result<Int, HostConfigError>::Err(HostConfigError(kind = HostConfigErrorKind::JsonTimeoutNonPositive(key = "acquire_timeout_ms", value = v), path = "pool.acquire_timeout_ms")); }
					return core.Result<Int, HostConfigError>::Ok(v);
				},
				Optional::None => { return core.Result<Int, HostConfigError>::Ok(5000); }
			}
		},
		Optional::None => { return core.Result<Int, HostConfigError>::Ok(5000); }
	}
}

fn _read_required_string(node: &json.JsonNode, key: &String)
	nothrow -> core.Result<String, HostConfigError>
{
	val opt: Optional<&json.JsonNode> = node.get(key);
	match opt {
		Optional::None => {
			return core.Result<String, HostConfigError>::Err(
				HostConfigError(kind = HostConfigErrorKind::JsonMissingKey(key = _dup(key)), path = _dup(key))
			);
		},
		Optional::Some(n) => {
			match n.as_string() {
				Optional::Some(s) => { return core.Result<String, HostConfigError>::Ok(move s); },
				Optional::None => {
					return core.Result<String, HostConfigError>::Err(
						HostConfigError(kind = HostConfigErrorKind::JsonBadType(key = _dup(key), expected = "String"), path = _dup(key))
					);
				}
			}
		}
	}
}

fn _read_required_int(node: &json.JsonNode, key: &String)
	nothrow -> core.Result<Int, HostConfigError>
{
	val opt: Optional<&json.JsonNode> = node.get(key);
	match opt {
		Optional::None => {
			return core.Result<Int, HostConfigError>::Err(
				HostConfigError(kind = HostConfigErrorKind::JsonMissingKey(key = _dup(key)), path = _dup(key))
			);
		},
		Optional::Some(n) => {
			match n.as_int() {
				Optional::Some(v) => { return core.Result<Int, HostConfigError>::Ok(v); },
				Optional::None => {
					return core.Result<Int, HostConfigError>::Err(
						HostConfigError(kind = HostConfigErrorKind::JsonBadType(key = _dup(key), expected = "Int"), path = _dup(key))
					);
				}
			}
		}
	}
}

fn _read_optional_positive_int(node: &json.JsonNode, key: &String, default_val: Int) nothrow -> Int {
	val opt: Optional<&json.JsonNode> = node.get(key);
	match opt {
		Optional::None => { return default_val; },
		Optional::Some(n) => {
			match n.as_int() {
				Optional::Some(v) => { if v > 0 { return v; } else { return default_val; } },
				Optional::None => { return default_val; }
			}
		}
	}
}

// ===== Implementation =====

struct HostImpl
	require Self is core.Destructible
{
	identity: ExecutorIdentity,
	// acquire() is &Self + internally synchronized (mariadb-rpc 0.6); shared
	// directly via Arc<HostImpl> with no outer mutex.
	pool: pool.ConnectionPool
}

implement MicroflowsHost for HostImpl {
	pub fn clock_read(self: &HostImpl, lease_seconds: Int) -> ClockReading {
		if lease_seconds <= 0 {
			throw HostException(kind = HostErrorKind::InvalidArg(field = "lease_seconds"));
		}
		try {
			var lease = _acquire_conn(self);
			val conn: &mut rpc.RpcConnection = lease.conn().or_throw();
			var args = rpc.new_args();
			args.push(rpc.arg_int(lease_seconds));
			val sp: String = "sp_mf_clock_read";
			val doc = _call_sp_doc(conn, &sp, move args);
			val outcome = _doc_outcome(&doc);
			if outcome == "ok" {
				val now = _doc_str_req(&doc, &"now", "clock-no-now");
				// SP doc key stays "lease_expires_at" (its server-side name); the
				// host surfaces it as the neutral `deadline`.
				val deadline = _doc_str_req(&doc, &"lease_expires_at", "clock-no-expiry");
				return ClockReading(now = move now, deadline = move deadline);
			}
			throw HostException(kind = HostErrorKind::BackendResponseInvalid(detail = "unexpected-outcome:clock_read"));
		} catch managed:ManagedError(e) {
			val tag_owned: String = e.tag;
			throw HostException(kind = HostErrorKind::BackendUnavailable(detail = move tag_owned));
		}
	}

	pub fn create_workflow(self: &HostImpl, workflow_id: &Array<Byte>, script_name: &String,
	                       script_revision: Int, event_ts: &String, next_attempt_at: &String,
	                       continuation_json: &String, event_payload_json: &String) -> CreateOutcome {
		_validate_id16("workflow_id", workflow_id);
		_validate_nonempty("script_name", script_name);
		if script_revision < 1 {
			throw HostException(kind = HostErrorKind::InvalidArg(field = "script_revision"));
		}
		_validate_nonempty("event_ts", event_ts);
		_validate_nonempty("next_attempt_at", next_attempt_at);
		try {
			var lease = _acquire_conn(self);
			val conn: &mut rpc.RpcConnection = lease.conn().or_throw();
			var args = rpc.new_args();
			args.push(rpc.arg_bytes(_dup_bytes(workflow_id)));
			args.push(rpc.arg_string(_dup(script_name)));
			args.push(rpc.arg_int(script_revision));
			args.push(rpc.arg_string(_dup(event_ts)));
			args.push(rpc.arg_string(_dup(next_attempt_at)));
			args.push(_json_object_arg("continuation", continuation_json));
			args.push(_meta_object_arg("event_payload", event_payload_json));
			val sp: String = "sp_mf_workflow_create";
			val doc = _call_sp_doc(conn, &sp, move args);
			val outcome = _doc_outcome(&doc);
			if outcome == "created" { return CreateOutcome::Created(); }
			if outcome == "exists" { return CreateOutcome::Exists(); }
			throw HostException(kind = HostErrorKind::BackendResponseInvalid(detail = "unexpected-outcome:create"));
		} catch managed:ManagedError(e) {
			val tag_owned: String = e.tag;
			throw HostException(kind = HostErrorKind::BackendUnavailable(detail = move tag_owned));
		}
	}

	pub fn create_planned(self: &HostImpl, workflow_id: &Array<Byte>, script_name: &String,
	                      plan_version: &String, event_ts: &String, next_attempt_at: &String,
	                      continuation_json: &String, event_payload_json: &String,
	                      content_hash: &Array<Byte>, plan_length: Int,
	                      args_json: &String) -> CreatePlannedOutcome {
		_validate_id16("workflow_id", workflow_id);
		if content_hash.len != 33 { throw HostException(kind = HostErrorKind::InvalidArg(field = "content_hash")); }
		_validate_nonempty("script_name", script_name);
		_validate_nonempty("plan_version", plan_version);
		if plan_length < 1 { throw HostException(kind = HostErrorKind::InvalidArg(field = "plan_length")); }
		_validate_nonempty("event_ts", event_ts);
		_validate_nonempty("next_attempt_at", next_attempt_at);
		// Canonicalize the arguments at the command boundary (ordered-key compact UTF-8) and
		// pass them as BYTES, so the proc stores + byte-compares a canonical document (never
		// collated text, never a caller's incidental key order).
		val args_canon = _canonical_args(args_json);
		try {
			var lease = _acquire_conn(self);
			val conn: &mut rpc.RpcConnection = lease.conn().or_throw();
			var args = rpc.new_args();
			args.push(rpc.arg_bytes(_dup_bytes(workflow_id)));
			args.push(rpc.arg_string(_dup(script_name)));
			args.push(rpc.arg_string(_dup(plan_version)));
			args.push(rpc.arg_string(_dup(event_ts)));
			args.push(rpc.arg_string(_dup(next_attempt_at)));
			args.push(_json_object_arg("continuation", continuation_json));
			args.push(_meta_object_arg("event_payload", event_payload_json));
			args.push(rpc.arg_bytes(_dup_bytes(content_hash)));
			args.push(rpc.arg_int(plan_length));
			args.push(rpc.arg_bytes(_utf8_bytes(&args_canon)));
			val sp: String = "sp_mf_workflow_create_planned";
			val doc = _call_sp_doc(conn, &sp, move args);
			val outcome = _doc_outcome(&doc);
			if outcome == "created" { return CreatePlannedOutcome::Created(_decode_pin(&doc)); }
			if outcome == "exists" { return CreatePlannedOutcome::Exists(_decode_pin(&doc)); }
			if outcome == "plan_conflict" { return CreatePlannedOutcome::PlanConflict(_doc_int_req(&doc, &"plan_length", "create-planned-no-plan-length")); }
			if outcome == "workflow_conflict" { return CreatePlannedOutcome::WorkflowConflict(_doc_int_req(&doc, &"plan_length", "create-planned-no-plan-length")); }
			throw HostException(kind = HostErrorKind::BackendResponseInvalid(detail = "unexpected-outcome:create_planned"));
		} catch managed:ManagedError(e) {
			val tag_owned: String = e.tag;
			throw HostException(kind = HostErrorKind::BackendUnavailable(detail = move tag_owned));
		}
	}

	pub fn args_get(self: &HostImpl, workflow_id: &Array<Byte>) -> ArgsGetOutcome {
