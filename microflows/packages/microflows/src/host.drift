// Parse a 'claimed' result document into a ClaimedWorkflow.
fn _parse_claimed(doc: &json.JsonNode) -> ClaimedWorkflow {
	val wf_hex = _doc_str_req(doc, &"workflow_id", "claim-no-workflow-id");
	val wf_id = _hex16("claim-workflow-id-hex", &wf_hex);
	val fencing = _doc_int_req(doc, &"fencing_token", "claim-no-fencing");
	val state_code = _doc_int_req(doc, &"state", "claim-no-state");
	val direction = _doc_int_req(doc, &"execution_direction", "claim-no-direction");
	val disp = _doc_int_req(doc, &"current_disposition", "claim-no-disposition");
	val sname = _doc_str_req(doc, &"script_name", "claim-no-script-name");
	val srev = _doc_int_req(doc, &"script_revision", "claim-no-script-revision");
	val eseq = _doc_int_req(doc, &"current_event_seq", "claim-no-event-seq");
	val attempt = _doc_int_req(doc, &"current_operation_attempt", "claim-no-attempt");
	val continuation = _doc_object_text_req(doc, &"continuation");
	return ClaimedWorkflow(
		workflow_id = move wf_id,
		fencing_token = fencing,
		state_code = state_code,
		execution_direction = direction,
		current_disposition = disp,
		script_name = move sname,
		script_revision = srev,
		current_event_seq = eseq,
		current_operation_attempt = attempt,
		continuation_json = move continuation
	);
}

implement core.Destructible for HostImpl {
	pub fn destroy(var self: HostImpl) nothrow -> Void {
		val _ = self.pool.close();
	}
}

// ===== Internal helpers =====

fn _dummy_identity() nothrow -> ExecutorIdentity {
	val empty: Array<Byte> = [];
	return ExecutorIdentity(executor_id = move empty);
}

fn _validate_id16(field: String, id: &Array<Byte>) -> Void {
	if id.len != 16 {
		throw HostException(kind = HostErrorKind::InvalidId(field = move field, actual_len = id.len));
	}
}

fn _validate_nonempty(field: String, s: &String) -> Void {
	if s.byte_length() == 0 {
		throw HostException(kind = HostErrorKind::InvalidArg(field = move field));
	}
}

fn _is_json_object(s: &String) nothrow -> Bool {
	match json.parse(s) {
		core.Result::Ok(node) => {
			var is_obj = false;
			match node.as_object() { Optional::Some(_) => { is_obj = true; }, Optional::None => {} }
			return is_obj;
		},
		core.Result::Err(_) => { return false; }
	}
}

// Required JSON object document argument (continuation): empty/malformed/
// non-object -> caller-input InvalidJson.
fn _json_object_arg(field: String, s: &String) -> rpc.RpcArg {
	if s.byte_length() == 0 { throw HostException(kind = HostErrorKind::InvalidJson(field = move field)); }
	if _is_json_object(s) { return rpc.arg_string(_dup(s)); }
	throw HostException(kind = HostErrorKind::InvalidJson(field = move field));
}

// Optional metadata document: absent (empty input) is the empty document `{}`.
fn _meta_object_arg(field: String, s: &String) -> rpc.RpcArg {
	if s.byte_length() == 0 { return rpc.arg_string("{}"); }
	if _is_json_object(s) { return rpc.arg_string(_dup(s)); }
	throw HostException(kind = HostErrorKind::InvalidJson(field = move field));
}

fn _dup(s: &String) nothrow -> String {
	val n = s.byte_length();
	var buf = io.buffer(n);
	var i = 0;
	while i < n { io.buffer_write(&mut buf, i, s.byte_at(i)); i = i + 1; }
	return core.string_from_utf8_bytes(io.buffer_ptr(&buf), n);
}

fn _dup_bytes(b: &Array<Byte>) nothrow -> Array<Byte> {
	var out: Array<Byte> = Array<type Byte>::with_capacity(b.len);
	var i = 0;
	while i < b.len { out.push(b[i]); i = i + 1; }
	return move out;
}

// Decode a lowercase-hex string into EXACTLY 16 bytes.
fn _hex16(detail: String, s: &String) -> Array<Byte> {
	match codec.hex_decode(s) {
		core.Result::Ok(b) => { if b.len == 16 { return move b; } },
		core.Result::Err(_) => {}
	}
	throw HostException(kind = HostErrorKind::BackendResponseInvalid(detail = move detail));
}

// ===== RPC dispatch (Singular's document contract) =====

fn _acquire_conn(impl_: &HostImpl) -> managed.LeasedConn {
	match impl_.pool.acquire() {
		core.Result::Ok(lease) => { return move lease; },
		core.Result::Err(e) => {
			val tag_owned: String = e.tag;
			throw HostException(kind = _classify_acquire_tag(move tag_owned));
		}
	}
}

fn _classify_acquire_tag(tag: String) nothrow -> HostErrorKind {
	if tag == "acquire-timeout" {
		return HostErrorKind::BackendTimeout(detail = move tag);
	}
	return HostErrorKind::BackendUnavailable(detail = move tag);
}

fn _exec_with_conn(conn: &mut rpc.RpcConnection, sp_name: &String, args: Array<rpc.RpcArg>)
	-> rpc.RpcStatement
{
	match conn.call(sp_name, &args) {
		core.Result::Err(e) => {
			val tag_owned: String = e.tag;
			throw HostException(kind = HostErrorKind::BackendUnavailable(detail = move tag_owned));
		},
		core.Result::Ok(stmt) => { return move stmt; }
	}
}

fn _finish_stmt_and_commit(stmt: &mut rpc.RpcStatement, conn: &mut rpc.RpcConnection) -> Void {
	match rpc.skip_remaining(stmt) {
		core.Result::Err(e) => {
			val tag_owned: String = e.tag;
			throw HostException(kind = HostErrorKind::BackendUnavailable(detail = move tag_owned));
		},
		core.Result::Ok(_) => {}
	}
	match rpc.commit(conn) {
		core.Result::Err(e) => {
			val tag_owned: String = e.tag;
			throw HostException(kind = HostErrorKind::BackendRejected(detail = move tag_owned));
		},
		core.Result::Ok(_) => {}
	}
}

fn _next(stmt: &mut rpc.RpcStatement) -> rpc.RpcEvent {
	match rpc.next_event(stmt) {
		core.Result::Err(e) => {
			val tag_owned: String = e.tag;
			throw HostException(kind = HostErrorKind::BackendUnavailable(detail = move tag_owned));
		},
		core.Result::Ok(ev) => { return move ev; }
	}
}

fn _parse_object_doc(text: &String) -> json.JsonNode {
	var got: Optional<json.JsonNode> = Optional<json.JsonNode>::None();
	var detail = "result-not-json";
	match json.parse(text) {
		core.Result::Ok(node) => {
			var is_obj = false;
			match node.as_object() { Optional::Some(_) => { is_obj = true; }, Optional::None => {} }
			if is_obj { got = Optional<json.JsonNode>::Some(move node); }
			else { detail = "result-not-object"; }
		},
		core.Result::Err(_) => {}
	}
	match move got {
		Optional::Some(node) => { return move node; },
		Optional::None => { throw HostException(kind = HostErrorKind::BackendResponseInvalid(detail = detail)); }
	}
}

fn _read_result_doc(stmt: &mut rpc.RpcStatement) -> json.JsonNode {
	val event = _next(stmt);
	match event {
		rpc.RpcEvent::Row(row) => {
			val text = _str_req(&row, 0);
			return _parse_object_doc(&text);
		},
		rpc.RpcEvent::ServerErr(err) => {
			val errcode_owned: Uint = err.error_code; val msg_owned: String = err.message;
			throw HostException(kind = _server_err_kind(errcode_owned, move msg_owned));
		},
		default => {
			throw HostException(kind = HostErrorKind::BackendResponseInvalid(detail = "missing-result-row"));
		}
	}
}

fn _call_sp_doc(conn: &mut rpc.RpcConnection, sp_name: &String, args: Array<rpc.RpcArg>)
	-> json.JsonNode
{
	var stmt = _exec_with_conn(conn, sp_name, move args);
	val doc = _read_result_doc(&mut stmt);
	_finish_stmt_and_commit(&mut stmt, conn);
	return move doc;
}

fn _doc_outcome(doc: &json.JsonNode) -> String {
	return _doc_str_req(doc, &"outcome", "result-no-outcome");
}

fn _doc_str_req(doc: &json.JsonNode, key: &String, detail: String) -> String {
	match doc.get(key) {
		Optional::Some(n) => {
			match n.as_string() {
				Optional::Some(s) => { return move s; },
				Optional::None => { throw HostException(kind = HostErrorKind::BackendResponseInvalid(detail = move detail)); }
			}
		},
		Optional::None => { throw HostException(kind = HostErrorKind::BackendResponseInvalid(detail = move detail)); }
	}
}

fn _doc_int_req(doc: &json.JsonNode, key: &String, detail: String) -> Int {
	match doc.get(key) {
		Optional::Some(n) => {
			match n.as_int() {
				Optional::Some(v) => { return v; },
				Optional::None => { throw HostException(kind = HostErrorKind::BackendResponseInvalid(detail = move detail)); }
			}
		},
		Optional::None => { throw HostException(kind = HostErrorKind::BackendResponseInvalid(detail = move detail)); }
	}
}

fn _doc_object_text_req(doc: &json.JsonNode, key: &String) -> String {
	match doc.get(key) {
		Optional::Some(n) => {
			var is_obj = false;
			match n.as_object() { Optional::Some(_) => { is_obj = true; }, Optional::None => {} }
			if !is_obj { throw HostException(kind = HostErrorKind::BackendResponseInvalid(detail = "doc-field-not-object")); }
			return json.encode_compact(n);
		},
		Optional::None => { throw HostException(kind = HostErrorKind::BackendResponseInvalid(detail = "doc-field-missing")); }
	}
}

// SPs SIGNAL caller-input/contract violations with SQLSTATE '45000' (errno
// 1644). Map those to BackendRejected (the message names the Pd* contract);
// everything else is also BackendRejected with its server message.
fn _server_err_kind(error_code: Uint, message: String) nothrow -> HostErrorKind {
	return HostErrorKind::BackendRejected(detail = move message);
}

fn _str_req(row: &rpc.RpcRow, col: Int) -> String {
	match row.is_null(col) {
		core.Result::Ok(v) => { if v { throw HostException(kind = HostErrorKind::BackendResponseInvalid(detail = "row-required-null")); } },
		core.Result::Err(_) => { throw HostException(kind = HostErrorKind::BackendResponseInvalid(detail = "row-isnull")); }
	}
	match row.get_string(col) {
		core.Result::Err(_) => { throw HostException(kind = HostErrorKind::BackendResponseInvalid(detail = "row-str")); },
		core.Result::Ok(v) => { return v; }
	}
}
