	pub fn reverse_request(self: &HostImpl, workflow_id: &Array<Byte>, fencing_token: Int,
	                       seq: Int, reverse_id: &Array<Byte>, reverse_operation_name: &String,
	                       reverse_schema_version: Int, reverse_input_json: &String,
	                       reverse_input_hash: &String, event_ts: &String) -> ReverseRequestOutcome {
