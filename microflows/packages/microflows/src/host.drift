		_validate_nonempty("reason", reason);
		try {
			var lease = _acquire_conn(self);
			val conn: &mut rpc.RpcConnection = lease.conn().or_throw();
			var args = rpc.new_args();
			args.push(rpc.arg_bytes(_dup_bytes(workflow_id)));
			args.push(rpc.arg_bytes(_dup_bytes(&self.identity.executor_id)));
			args.push(rpc.arg_int(fencing_token));
			args.push(rpc.arg_int(operation_seq));
			args.push(rpc.arg_bytes(_dup_bytes(operation_id)));
			args.push(rpc.arg_string(_dup(event_ts)));
			args.push(rpc.arg_string(_dup(reason)));
			val sp: String = "sp_mf_workflow_begin_reversal";
			val doc = _call_sp_doc(conn, &sp, move args);
			val outcome = _doc_outcome(&doc);
			if outcome == "reversing" { return BeginReversalOutcome::Reversing(_doc_int_req(&doc, &"top_seq", "begin-no-top-seq")); }
			if outcome == "failed" { return BeginReversalOutcome::Failed(_doc_str_opt(&doc, &"terminal_reason")); }
			if outcome == "already_begun" { return BeginReversalOutcome::AlreadyBegun(_doc_int_req(&doc, &"state", "begin-no-state"), _doc_str_opt(&doc, &"terminal_reason")); }
			if outcome == "trigger_mismatch" { return BeginReversalOutcome::TriggerMismatch(); }
			if outcome == "operation_not_found" { return BeginReversalOutcome::OperationNotFound(); }
			if outcome == "operation_conflict" { return BeginReversalOutcome::OperationConflict(); }
			if outcome == "operation_not_failed" { return BeginReversalOutcome::OperationNotFailed(_doc_int_req(&doc, &"status", "begin-no-status")); }
			if outcome == "fence_lost" { return BeginReversalOutcome::FenceLost(); }
			if outcome == "not_found" { return BeginReversalOutcome::NotFound(); }
			if outcome == "event_time_skew" { return BeginReversalOutcome::EventTimeSkew(_doc_str_req(&doc, &"defer_until", "begin-no-defer-until")); }
			throw HostException(kind = HostErrorKind::BackendResponseInvalid(detail = "unexpected-outcome:begin_reversal"));
		} catch managed:ManagedError(e) {
			val tag_owned: String = e.tag;
			throw HostException(kind = HostErrorKind::BackendUnavailable(detail = move tag_owned));
		}
	}

	pub fn authored_fail(self: &HostImpl, workflow_id: &Array<Byte>, fencing_token: Int,
	                     fail_id: &Array<Byte>, event_ts: &String, reason: &String) -> AuthoredFailOutcome {
		_validate_id16("workflow_id", workflow_id);
