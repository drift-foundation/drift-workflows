			args.push(rpc.arg_string(_dup(reason)));
			val sp: String = "sp_mf_workflow_authored_fail";
			val doc = _call_sp_doc(conn, &sp, move args);
			val outcome = _doc_outcome(&doc);
			if outcome == "reversing" { return AuthoredFailOutcome::Reversing(_doc_int_req(&doc, &"top_seq", "afail-no-top-seq")); }
			if outcome == "failed" { return AuthoredFailOutcome::Failed(_doc_str_opt(&doc, &"terminal_reason")); }
			if outcome == "already_begun" { return AuthoredFailOutcome::AlreadyBegun(_doc_int_req(&doc, &"state", "afail-no-state"), _doc_str_opt(&doc, &"terminal_reason")); }
			if outcome == "trigger_mismatch" { return AuthoredFailOutcome::TriggerMismatch(); }
			if outcome == "fence_lost" { return AuthoredFailOutcome::FenceLost(); }
			if outcome == "not_found" { return AuthoredFailOutcome::NotFound(); }
			if outcome == "event_time_skew" { return AuthoredFailOutcome::EventTimeSkew(_doc_str_req(&doc, &"defer_until", "afail-no-defer-until")); }
			throw HostException(kind = HostErrorKind::BackendResponseInvalid(detail = "unexpected-outcome:authored_fail"));
