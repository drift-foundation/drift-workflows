		if fencing_token < 1 { throw HostException(kind = HostErrorKind::InvalidArg(field = "fencing_token")); }
		if seq < 1 { throw HostException(kind = HostErrorKind::InvalidArg(field = "seq")); }
		_validate_nonempty("reverse_operation_name", reverse_operation_name);
		if reverse_schema_version < 1 { throw HostException(kind = HostErrorKind::InvalidArg(field = "reverse_schema_version")); }
		_validate_nonempty("reverse_input_hash", reverse_input_hash);
		_validate_nonempty("event_ts", event_ts);
		try {
			var lease = _acquire_conn(self);
			val conn: &mut rpc.RpcConnection = lease.conn().or_throw();
			var args = rpc.new_args();
			args.push(rpc.arg_bytes(_dup_bytes(workflow_id)));
			args.push(rpc.arg_bytes(_dup_bytes(&self.identity.executor_id)));
			args.push(rpc.arg_int(fencing_token));
			args.push(rpc.arg_int(seq));
			args.push(rpc.arg_bytes(_dup_bytes(reverse_id)));
			args.push(rpc.arg_string(_dup(reverse_operation_name)));
			args.push(rpc.arg_int(reverse_schema_version));
			args.push(_json_object_arg("reverse_input_json", reverse_input_json));
			args.push(rpc.arg_string(_dup(reverse_input_hash)));
			args.push(rpc.arg_string(_dup(event_ts)));
			val sp: String = "sp_mf_checkpoint_reverse_request";
			val doc = _call_sp_doc(conn, &sp, move args);
			val outcome = _doc_outcome(&doc);
			if outcome == "requested" { return ReverseRequestOutcome::Requested(_doc_str_req(&doc, &"reverse_invocation_id", "revreq-no-id")); }
			if outcome == "already_requested" {
				return ReverseRequestOutcome::AlreadyRequested(
					_doc_str_req(&doc, &"reverse_invocation_id", "revreq-no-id"),
					_doc_str_req(&doc, &"reverse_operation_name", "revreq-no-rname"),
					_doc_int_req(&doc, &"reverse_schema_version", "revreq-no-rsv"),
					_doc_object_text_req(&doc, &"reverse_input_json"),
					_doc_str_req(&doc, &"reverse_input_hash", "revreq-no-rhash"));
			}
			if outcome == "binding_conflict" { return ReverseRequestOutcome::BindingConflict(); }
			if outcome == "out_of_order" { return ReverseRequestOutcome::OutOfOrder(_doc_int_req(&doc, &"top_seq", "revreq-no-top")); }
			if outcome == "checkpoint_inactive" { return ReverseRequestOutcome::CheckpointInactive(_doc_int_req(&doc, &"reversal_state", "revreq-no-cpstate")); }
			if outcome == "checkpoint_not_found" { return ReverseRequestOutcome::CheckpointNotFound(); }
			if outcome == "fence_lost" { return ReverseRequestOutcome::FenceLost(); }
			if outcome == "not_found" { return ReverseRequestOutcome::NotFound(); }
			if outcome == "event_time_skew" { return ReverseRequestOutcome::EventTimeSkew(_doc_str_req(&doc, &"defer_until", "revreq-no-defer-until")); }
			throw HostException(kind = HostErrorKind::BackendResponseInvalid(detail = "unexpected-outcome:reverse_request"));
		} catch managed:ManagedError(e) {
			val tag_owned: String = e.tag;
			throw HostException(kind = HostErrorKind::BackendUnavailable(detail = move tag_owned));
		}
	}

