	pub fn begin_reversal(self: &HostImpl, workflow_id: &Array<Byte>, fencing_token: Int,
	                      operation_seq: Int, operation_id: &Array<Byte>, event_ts: &String,
	                      reason: &String) -> BeginReversalOutcome {
		_validate_id16("workflow_id", workflow_id);
		_validate_id16("operation_id", operation_id);
		if fencing_token < 1 { throw HostException(kind = HostErrorKind::InvalidArg(field = "fencing_token")); }
		if operation_seq < 1 { throw HostException(kind = HostErrorKind::InvalidArg(field = "operation_seq")); }
