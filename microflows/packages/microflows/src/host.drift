	// --- Composition (1b.1/1c): workflow-to-workflow calls ---

	pub fn call_submit(self: &HostImpl, workflow_id: &Array<Byte>, fencing_token: Int,
	                   operation_seq: Int, operation_id: &Array<Byte>,
	                   input_json: &String,
	                   new_continuation: &String, event_ts: &String, event_payload: &String,
	                   child_workflow_id: &Array<Byte>, child_script_name: &String,
	                   child_plan_version: &String, child_content_hash: &Array<Byte>,
	                   child_plan_length: Int, child_continuation: &String,
	                   child_next_attempt_at: &String, child_event_payload: &String,
	                   parent_node_id: &String, max_call_depth: Int) -> CallSubmitOutcome {
		_validate_id16("workflow_id", workflow_id);
		if fencing_token < 1 { throw HostException(kind = HostErrorKind::InvalidArg(field = "fencing_token")); }
		if operation_seq < 1 { throw HostException(kind = HostErrorKind::InvalidArg(field = "operation_seq")); }
		_validate_id16("operation_id", operation_id);
		_validate_nonempty("event_ts", event_ts);
		_validate_id16("child_workflow_id", child_workflow_id);
		_validate_nonempty("child_script_name", child_script_name);
		_validate_nonempty("child_plan_version", child_plan_version);
		if child_content_hash.len != 33 { throw HostException(kind = HostErrorKind::InvalidArg(field = "child_content_hash")); }
		if child_plan_length < 1 { throw HostException(kind = HostErrorKind::InvalidArg(field = "child_plan_length")); }
		_validate_nonempty("child_next_attempt_at", child_next_attempt_at);
		_validate_nonempty("parent_node_id", parent_node_id);
		if max_call_depth < 1 { throw HostException(kind = HostErrorKind::InvalidArg(field = "max_call_depth")); }
		// Canonicalize the call's input at the command boundary — exactly like create_planned
		// canonicalizes instance args (§Durable state): it becomes BOTH the call op's own
		// input_json AND, verbatim, the child's tb_mf_workflow_args.args_canonical. Reusing
		// _canonical_args as-is is correct here — the call's input literally BECOMES the
		// child's instance arguments, the same document create_planned's own args_json is.
		val input_canon = _canonical_args(input_json);
		// input_hash is DERIVED from the SAME canonical string, not caller-supplied — matches
		// runner.drift's own _input_hash exactly (canonical text -> UUIDv3 -> hex), so this
		// stays consistent with how every other input_hash in the system is produced. Computing
		// it from input_canon (not the caller's raw input_json) makes it structurally impossible
		// for the hash to disagree with what's actually stored — no hidden "the caller must have
		// canonicalized identically" invariant.
		val input_hash = _canonical_input_hash(&input_canon);
		try {
			var lease = _acquire_conn(self);
			val conn: &mut rpc.RpcConnection = lease.conn().or_throw();
			var args = rpc.new_args();
			args.push(rpc.arg_bytes(_dup_bytes(workflow_id)));
			args.push(rpc.arg_bytes(_dup_bytes(&self.identity.executor_id)));
			args.push(rpc.arg_int(fencing_token));
			args.push(rpc.arg_int(operation_seq));
			args.push(rpc.arg_bytes(_dup_bytes(operation_id)));
			args.push(_json_object_arg("input_json", &input_canon));
			args.push(rpc.arg_string(_dup(&input_hash)));
			args.push(_json_object_arg("new_continuation", new_continuation));
			args.push(rpc.arg_string(_dup(event_ts)));
			args.push(_meta_object_arg("event_payload", event_payload));
			args.push(rpc.arg_bytes(_dup_bytes(child_workflow_id)));
			args.push(rpc.arg_string(_dup(child_script_name)));
			args.push(rpc.arg_string(_dup(child_plan_version)));
			args.push(rpc.arg_bytes(_dup_bytes(child_content_hash)));
			args.push(rpc.arg_int(child_plan_length));
			args.push(_json_object_arg("child_continuation", child_continuation));
			args.push(rpc.arg_string(_dup(child_next_attempt_at)));
			args.push(_meta_object_arg("child_event_payload", child_event_payload));
			args.push(rpc.arg_string(_dup(parent_node_id)));
			args.push(rpc.arg_int(max_call_depth));
			val sp: String = "sp_mf_call_submit";
			val doc = _call_sp_doc(conn, &sp, move args);
			val outcome = _doc_outcome(&doc);
			if outcome == "submitted" { return CallSubmitOutcome::Submitted(_doc_str_req(&doc, &"child_workflow_id", "call-submit-no-child-id")); }
			if outcome == "already_submitted" { return CallSubmitOutcome::AlreadySubmitted(_doc_str_req(&doc, &"child_workflow_id", "call-submit-no-child-id")); }
			if outcome == "call_conflict" { return CallSubmitOutcome::CallConflict(); }
			if outcome == "call_rejected" { return CallSubmitOutcome::CallRejected(_doc_str_req(&doc, &"reason", "call-submit-no-reason")); }
			if outcome == "plan_violation" { return CallSubmitOutcome::PlanViolation(_doc_str_req(&doc, &"reason", "call-submit-no-plan-reason"), _doc_int_req(&doc, &"plan_length", "call-submit-no-plan-length")); }
			if outcome == "event_time_skew" { return CallSubmitOutcome::EventTimeSkew(_doc_str_req(&doc, &"defer_until", "call-submit-no-defer-until")); }
			if outcome == "fence_lost" { return CallSubmitOutcome::FenceLost(); }
			if outcome == "not_found" { return CallSubmitOutcome::NotFound(); }
			throw HostException(kind = HostErrorKind::BackendResponseInvalid(detail = "unexpected-outcome:call_submit"));
		} catch managed:ManagedError(e) {
			val tag_owned: String = e.tag;
			throw HostException(kind = HostErrorKind::BackendUnavailable(detail = move tag_owned));
		}
	}

	pub fn call_inspect(self: &HostImpl, workflow_id: &Array<Byte>, operation_seq: Int) -> CallInspectOutcome {
		_validate_id16("workflow_id", workflow_id);
		if operation_seq < 1 { throw HostException(kind = HostErrorKind::InvalidArg(field = "operation_seq")); }
		try {
			var lease = _acquire_conn(self);
			val conn: &mut rpc.RpcConnection = lease.conn().or_throw();
			var args = rpc.new_args();
			args.push(rpc.arg_bytes(_dup_bytes(workflow_id)));
			args.push(rpc.arg_int(operation_seq));
			val sp: String = "sp_mf_call_inspect";
			val doc = _call_sp_doc(conn, &sp, move args);
			val outcome = _doc_outcome(&doc);
			if outcome == "not_found" { return CallInspectOutcome::NotFound(); }
			if outcome == "found" {
				val child_status = _doc_int_req(&doc, &"child_status", "call-inspect-no-child-status");
				val state = _doc_int_req(&doc, &"state", "call-inspect-no-state");
				val direction = _doc_int_req(&doc, &"execution_direction", "call-inspect-no-direction");
				val disp = _doc_int_req(&doc, &"current_disposition", "call-inspect-no-disposition");
				val terminal = _doc_int_req(&doc, &"is_terminal", "call-inspect-no-terminal");
				return CallInspectOutcome::Found(
					_doc_str_req(&doc, &"child_workflow_id", "call-inspect-no-child-id"),
					child_status, state, direction, disp, terminal != 0,
					_doc_str_opt(&doc, &"terminal_reason"),
					_doc_object_text_opt(&doc, &"workflow_return_json"));
			}
			throw HostException(kind = HostErrorKind::BackendResponseInvalid(detail = "unexpected-outcome:call_inspect"));
		} catch managed:ManagedError(e) {
			val tag_owned: String = e.tag;
			throw HostException(kind = HostErrorKind::BackendUnavailable(detail = move tag_owned));
		}
	}

	pub fn call_hint_refresh(self: &HostImpl, workflow_id: &Array<Byte>, operation_seq: Int,
	                         child_status: Int, event_ts: &String) -> CallHintRefreshOutcome {
		match _call_hint_refresh_core(self, workflow_id, operation_seq, child_status, event_ts) {
			core.Result::Ok(v) => { return v; },
			core.Result::Err(kind) => { throw HostException(kind = move kind); }
		}
	}

	pub fn child_terminal_notify(self: &HostImpl, child_workflow_id: &Array<Byte>, child_status: Int,
	                             event_ts: &String) -> ChildTerminalNotifyOutcome {
		match _child_terminal_notify_core(self, child_workflow_id, child_status, event_ts) {
			core.Result::Ok(v) => { return v; },
			core.Result::Err(kind) => { throw HostException(kind = move kind); }
		}
	}

	// NOTHROW best-effort wrapper: maps _child_terminal_notify_core's Result DIRECTLY into a typed
	// BestEffort value — no catch, no swallowed detail, for every failure mode the core classifies
	// itself. The outer bound `catch e` covers a genuinely-unanticipated escape (a HostException thrown
	// by the shared SP-call plumbing the core calls into, or any other non-ManagedError throw) — never
	// used for the core's own well-classified Err path, which is handled entirely by the match above
	// it. See _call_hint_refresh_core's comment for exactly what is and isn't covered by that Err path.
	pub fn child_terminal_notify_best_effort(self: &HostImpl, child_workflow_id: &Array<Byte>, child_status: Int,
	                                         event_ts: &String) nothrow -> BestEffort {
		try {
			match _child_terminal_notify_core(self, child_workflow_id, child_status, event_ts) {
				core.Result::Ok(v) => {
					match v {
						ChildTerminalNotifyOutcome::Notified() => { return BestEffort::Ok(); },
						ChildTerminalNotifyOutcome::NotFound() => { return BestEffort::SkippedNotFound(); }
					}
				},
				core.Result::Err(kind) => { return _kind_to_best_effort(kind); }
			}
		} catch e {
			// A GENUINELY unanticipated escape (not the core's own well-classified Err path, which
			// never reaches here) — bound, not swallowed: e.encode_compact() carries the full
			// diagnostic envelope, per effective-drift.md's "bind it as `catch e` and record/report
			// it" guidance for a hard catch-all boundary.
			return BestEffort::UnexpectedDefect(detail = "child_terminal_notify:" + e.encode_compact());
		}
	}

	// NOTHROW best-effort wrapper — same rationale as child_terminal_notify_best_effort above.
	pub fn call_hint_refresh_best_effort(self: &HostImpl, workflow_id: &Array<Byte>, operation_seq: Int,
	                                     child_status: Int, event_ts: &String) nothrow -> BestEffort {
		try {
			match _call_hint_refresh_core(self, workflow_id, operation_seq, child_status, event_ts) {
				core.Result::Ok(v) => {
					match v {
						CallHintRefreshOutcome::Refreshed() => { return BestEffort::Ok(); },
						CallHintRefreshOutcome::NotFound() => { return BestEffort::SkippedNotFound(); }
					}
				},
				core.Result::Err(kind) => { return _kind_to_best_effort(kind); }
			}
		} catch e {
			return BestEffort::UnexpectedDefect(detail = "call_hint_refresh:" + e.encode_compact());
		}
	}

	pub fn checkpoint_reverse_child_reopen(self: &HostImpl, workflow_id: &Array<Byte>, fencing_token: Int,
	                                       seq: Int, event_ts: &String) -> CheckpointReverseChildReopenOutcome {
		_validate_id16("workflow_id", workflow_id);
		if fencing_token < 1 { throw HostException(kind = HostErrorKind::InvalidArg(field = "fencing_token")); }
		if seq < 1 { throw HostException(kind = HostErrorKind::InvalidArg(field = "seq")); }
		_validate_nonempty("event_ts", event_ts);
		try {
			var lease = _acquire_conn(self);
			val conn: &mut rpc.RpcConnection = lease.conn().or_throw();
			var args = rpc.new_args();
			args.push(rpc.arg_bytes(_dup_bytes(workflow_id)));
			args.push(rpc.arg_bytes(_dup_bytes(&self.identity.executor_id)));
			args.push(rpc.arg_int(fencing_token));
			args.push(rpc.arg_int(seq));
			args.push(rpc.arg_string(_dup(event_ts)));
			val sp: String = "sp_mf_checkpoint_reverse_child_reopen";
			val doc = _call_sp_doc(conn, &sp, move args);
			val outcome = _doc_outcome(&doc);
			if outcome == "reopened" { return CheckpointReverseChildReopenOutcome::Reopened(_doc_str_req(&doc, &"child_workflow_id", "reopen-no-child-id")); }
			if outcome == "already_reopened" { return CheckpointReverseChildReopenOutcome::AlreadyReopened(_doc_int_req(&doc, &"child_state", "reopen-no-child-state")); }
			if outcome == "child_state_inconsistent" { return CheckpointReverseChildReopenOutcome::ChildStateInconsistent(_doc_int_req(&doc, &"child_state", "reopen-no-child-state")); }
			if outcome == "child_no_active_checkpoint" { return CheckpointReverseChildReopenOutcome::ChildNoActiveCheckpoint(); }
			if outcome == "out_of_order" { return CheckpointReverseChildReopenOutcome::OutOfOrder(_doc_int_req(&doc, &"top_seq", "reopen-no-top")); }
			if outcome == "event_time_skew" { return CheckpointReverseChildReopenOutcome::EventTimeSkew(_doc_str_req(&doc, &"defer_until", "reopen-no-defer-until")); }
			if outcome == "fence_lost" { return CheckpointReverseChildReopenOutcome::FenceLost(); }
			if outcome == "not_found" { return CheckpointReverseChildReopenOutcome::NotFound(); }
			if outcome == "checkpoint_not_found" { return CheckpointReverseChildReopenOutcome::CheckpointNotFound(); }
			if outcome == "not_call_checkpoint" { return CheckpointReverseChildReopenOutcome::NotCallCheckpoint(); }
			if outcome == "call_sidecar_not_found" { return CheckpointReverseChildReopenOutcome::CallSidecarNotFound(); }
			if outcome == "child_not_found" { return CheckpointReverseChildReopenOutcome::ChildNotFound(); }
			throw HostException(kind = HostErrorKind::BackendResponseInvalid(detail = "unexpected-outcome:checkpoint_reverse_child_reopen"));
		} catch managed:ManagedError(e) {
			val tag_owned: String = e.tag;
			throw HostException(kind = HostErrorKind::BackendUnavailable(detail = move tag_owned));
		}
	}

	pub fn checkpoint_reverse_child_settle(self: &HostImpl, workflow_id: &Array<Byte>, fencing_token: Int,
	                                       seq: Int, event_ts: &String) -> CheckpointReverseChildSettleOutcome {
		_validate_id16("workflow_id", workflow_id);
		if fencing_token < 1 { throw HostException(kind = HostErrorKind::InvalidArg(field = "fencing_token")); }
		if seq < 1 { throw HostException(kind = HostErrorKind::InvalidArg(field = "seq")); }
		_validate_nonempty("event_ts", event_ts);
		try {
			var lease = _acquire_conn(self);
			val conn: &mut rpc.RpcConnection = lease.conn().or_throw();
			var args = rpc.new_args();
			args.push(rpc.arg_bytes(_dup_bytes(workflow_id)));
			args.push(rpc.arg_bytes(_dup_bytes(&self.identity.executor_id)));
			args.push(rpc.arg_int(fencing_token));
			args.push(rpc.arg_int(seq));
			args.push(rpc.arg_string(_dup(event_ts)));
			val sp: String = "sp_mf_checkpoint_reverse_child_settle";
			val doc = _call_sp_doc(conn, &sp, move args);
			val outcome = _doc_outcome(&doc);
			if outcome == "reversed" { return CheckpointReverseChildSettleOutcome::Reversed(_doc_str_opt(&doc, &"terminal_reason")); }
			if outcome == "reversing" { return CheckpointReverseChildSettleOutcome::Reversing(_doc_int_req(&doc, &"next_seq", "settle-no-next-seq")); }
			if outcome == "already_reversed" { return CheckpointReverseChildSettleOutcome::AlreadyReversed(); }
			if outcome == "child_not_terminal" { return CheckpointReverseChildSettleOutcome::ChildNotTerminal(_doc_int_req(&doc, &"child_state", "settle-no-child-state")); }
			if outcome == "child_not_compensated" { return CheckpointReverseChildSettleOutcome::ChildNotCompensated(_doc_int_req(&doc, &"child_state", "settle-no-child-state")); }
			if outcome == "out_of_order" { return CheckpointReverseChildSettleOutcome::OutOfOrder(_doc_int_req(&doc, &"top_seq", "settle-no-top")); }
			if outcome == "event_time_skew" { return CheckpointReverseChildSettleOutcome::EventTimeSkew(_doc_str_req(&doc, &"defer_until", "settle-no-defer-until")); }
			if outcome == "fence_lost" { return CheckpointReverseChildSettleOutcome::FenceLost(); }
			if outcome == "not_found" { return CheckpointReverseChildSettleOutcome::NotFound(); }
			if outcome == "checkpoint_not_found" { return CheckpointReverseChildSettleOutcome::CheckpointNotFound(); }
			if outcome == "checkpoint_not_settleable" { return CheckpointReverseChildSettleOutcome::CheckpointNotSettleable(_doc_int_req(&doc, &"reversal_state", "settle-no-cpstate")); }
			if outcome == "not_call_checkpoint" { return CheckpointReverseChildSettleOutcome::NotCallCheckpoint(); }
			if outcome == "call_sidecar_not_found" { return CheckpointReverseChildSettleOutcome::CallSidecarNotFound(); }
			if outcome == "child_not_found" { return CheckpointReverseChildSettleOutcome::ChildNotFound(); }
			throw HostException(kind = HostErrorKind::BackendResponseInvalid(detail = "unexpected-outcome:checkpoint_reverse_child_settle"));
		} catch managed:ManagedError(e) {
			val tag_owned: String = e.tag;
			throw HostException(kind = HostErrorKind::BackendUnavailable(detail = move tag_owned));
		}
	}
}

// PRIVATE core (errors-as-values): the entry-shape checks + this function's OWN `managed:ManagedError`
// handling around the SP call return Err(HostErrorKind) as a PLAIN VALUE, never a thrown HostException
// — HostException's `kind` field cannot be PROJECTED through a typed catch in this toolchain release
// (E_TYPED_CATCH_FIELD_UNSUPPORTED_TYPE: only scalar Int/Uint/Bool/Float/String fields are supported;
// `kind: HostErrorKind` is a nested variant). Matching on a normally-RETURNED HostErrorKind value has
// no such restriction, so the best-effort wrapper below recovers FULL classification for every failure
// mode THIS function decides directly.
//
// NOT covered (be honest about the boundary, not "full-fidelity" for every possible failure): the SP
// plumbing this function CALLS INTO (`_call_sp_doc` / `_read_result_doc` / `_finish_stmt_and_commit` /
// `_doc_str_req` / `_doc_outcome`, etc.) throws `HostException` DIRECTLY in several places of its own
// (a malformed response document, a post-exec commit failure, an unreadable result row — see their own
// bodies). Those are NOT caught here (doing so would hit the exact same unprojectable-field limitation,
// with no way to recover which HostErrorKind they already constructed at their own throw site) — they
// propagate straight through this function untouched. The throwing public method below is UNCHANGED by
// that (it was always throws-capable and re-raises the original HostException exactly as before this
// core/wrapper split existed). The best-effort wrapper's own outer bound `catch e` is what actually
// absorbs that case, and it can only fold it into `BestEffort::UnexpectedDefect` — logged with the full
// diagnostic envelope (`e.encode_compact()`), but genuinely NOT re-classified into the specific
// HostErrorKind the plumbing already knew. Closing that gap for real would mean converting the shared
// SP-call plumbing itself to return `Result` instead of throwing — a change with much wider blast radius
// (every host method uses it), out of scope here.
fn _call_hint_refresh_core(impl_: &HostImpl, workflow_id: &Array<Byte>, operation_seq: Int,
                           child_status: Int, event_ts: &String) -> core.Result<CallHintRefreshOutcome, HostErrorKind> {
	if workflow_id.len != 16 { return core.Result<CallHintRefreshOutcome, HostErrorKind>::Err(HostErrorKind::InvalidId(field = "workflow_id", actual_len = workflow_id.len)); }
	if operation_seq < 1 { return core.Result<CallHintRefreshOutcome, HostErrorKind>::Err(HostErrorKind::InvalidArg(field = "operation_seq")); }
	if child_status < 1 or child_status > 4 { return core.Result<CallHintRefreshOutcome, HostErrorKind>::Err(HostErrorKind::InvalidArg(field = "child_status")); }
	if event_ts.byte_length() == 0 { return core.Result<CallHintRefreshOutcome, HostErrorKind>::Err(HostErrorKind::InvalidArg(field = "event_ts")); }
	try {
		var lease = _acquire_conn(impl_);
		val conn: &mut rpc.RpcConnection = lease.conn().or_throw();
		var args = rpc.new_args();
		args.push(rpc.arg_bytes(_dup_bytes(workflow_id)));
		args.push(rpc.arg_int(operation_seq));
		args.push(rpc.arg_int(child_status));
		args.push(rpc.arg_string(_dup(event_ts)));
		val sp: String = "sp_mf_call_hint_refresh";
		val doc = _call_sp_doc(conn, &sp, move args);
		val outcome = _doc_outcome(&doc);
		if outcome == "refreshed" { return core.Result<CallHintRefreshOutcome, HostErrorKind>::Ok(CallHintRefreshOutcome::Refreshed()); }
		if outcome == "not_found" { return core.Result<CallHintRefreshOutcome, HostErrorKind>::Ok(CallHintRefreshOutcome::NotFound()); }
		return core.Result<CallHintRefreshOutcome, HostErrorKind>::Err(HostErrorKind::BackendResponseInvalid(detail = "unexpected-outcome:call_hint_refresh"));
	} catch managed:ManagedError(e) {
		val tag_owned: String = e.tag;
		return core.Result<CallHintRefreshOutcome, HostErrorKind>::Err(HostErrorKind::BackendUnavailable(detail = move tag_owned));
	}
}

// PRIVATE core for child_terminal_notify — same rationale as _call_hint_refresh_core above.
fn _child_terminal_notify_core(impl_: &HostImpl, child_workflow_id: &Array<Byte>, child_status: Int,
                               event_ts: &String) -> core.Result<ChildTerminalNotifyOutcome, HostErrorKind> {
	if child_workflow_id.len != 16 { return core.Result<ChildTerminalNotifyOutcome, HostErrorKind>::Err(HostErrorKind::InvalidId(field = "child_workflow_id", actual_len = child_workflow_id.len)); }
	if child_status != 2 and child_status != 3 { return core.Result<ChildTerminalNotifyOutcome, HostErrorKind>::Err(HostErrorKind::InvalidArg(field = "child_status")); }
	if event_ts.byte_length() == 0 { return core.Result<ChildTerminalNotifyOutcome, HostErrorKind>::Err(HostErrorKind::InvalidArg(field = "event_ts")); }
	try {
		var lease = _acquire_conn(impl_);
		val conn: &mut rpc.RpcConnection = lease.conn().or_throw();
		var args = rpc.new_args();
		args.push(rpc.arg_bytes(_dup_bytes(child_workflow_id)));
		args.push(rpc.arg_int(child_status));
		args.push(rpc.arg_string(_dup(event_ts)));
		val sp: String = "sp_mf_child_terminal_notify";
		val doc = _call_sp_doc(conn, &sp, move args);
		val outcome = _doc_outcome(&doc);
		if outcome == "notified" { return core.Result<ChildTerminalNotifyOutcome, HostErrorKind>::Ok(ChildTerminalNotifyOutcome::Notified()); }
		if outcome == "not_found" { return core.Result<ChildTerminalNotifyOutcome, HostErrorKind>::Ok(ChildTerminalNotifyOutcome::NotFound()); }
		return core.Result<ChildTerminalNotifyOutcome, HostErrorKind>::Err(HostErrorKind::BackendResponseInvalid(detail = "unexpected-outcome:child_terminal_notify"));
	} catch managed:ManagedError(e) {
		val tag_owned: String = e.tag;
		return core.Result<ChildTerminalNotifyOutcome, HostErrorKind>::Err(HostErrorKind::BackendUnavailable(detail = move tag_owned));
	}
}

// Parse a 'claimed' result document into a ClaimedWorkflow.
fn _parse_claimed(doc: &json.JsonNode) -> ClaimedWorkflow {
	val wf_hex = _doc_str_req(doc, &"workflow_id", "claim-no-workflow-id");
	val wf_id = _hex16("claim-workflow-id-hex", &wf_hex);
	val fencing = _doc_int_req(doc, &"fencing_token", "claim-no-fencing");
	val state_code = _doc_int_req(doc, &"state", "claim-no-state");
	val direction = _doc_int_req(doc, &"execution_direction", "claim-no-direction");
	val disp = _doc_int_req(doc, &"current_disposition", "claim-no-disposition");
	val sname = _doc_str_req(doc, &"script_name", "claim-no-script-name");
	val srev = _doc_int_req(doc, &"script_revision", "claim-no-script-revision");
	val eseq = _doc_int_req(doc, &"current_event_seq", "claim-no-event-seq");
	val attempt = _doc_int_req(doc, &"current_operation_attempt", "claim-no-attempt");
	val continuation = _doc_object_text_req(doc, &"continuation");
	return ClaimedWorkflow(
		workflow_id = move wf_id,
		fencing_token = fencing,
		state_code = state_code,
		execution_direction = direction,
		current_disposition = disp,
		script_name = move sname,
		script_revision = srev,
		current_event_seq = eseq,
		current_operation_attempt = attempt,
		continuation_json = move continuation
	);
}

implement core.Destructible for HostImpl {
	pub fn destroy(var self: HostImpl) nothrow -> Void {
		val _ = self.pool.close();
	}
}

// ===== Internal helpers =====

fn _dummy_identity() nothrow -> ExecutorIdentity {
	val empty: Array<Byte> = [];
	return ExecutorIdentity(executor_id = move empty);
}

fn _validate_id16(field: String, id: &Array<Byte>) -> Void {
	if id.len != 16 {
		throw HostException(kind = HostErrorKind::InvalidId(field = move field, actual_len = id.len));
	}
}

fn _validate_nonempty(field: String, s: &String) -> Void {
	if s.byte_length() == 0 {
		throw HostException(kind = HostErrorKind::InvalidArg(field = move field));
	}
}

fn _is_json_object(s: &String) nothrow -> Bool {
	match json.parse(s) {
		core.Result::Ok(node) => {
			var is_obj = false;
			match node.as_object() { Optional::Some(_) => { is_obj = true; }, Optional::None => {} }
			return is_obj;
		},
		core.Result::Err(_) => { return false; }
	}
}

// Canonicalize an arguments JSON document to ORDERED-KEY COMPACT UTF-8. Enforced at the
// command boundary: a caller's incidental key order/whitespace can never produce a false
// workflow_conflict. A non-object / malformed value is rejected (InvalidJson).
fn _canonical_args(args_json: &String) -> String {
	val cfg = json.JsonConfig(key_order = json.JsonKeyOrder::OrderedLexUtf8());
	// STRICT: reject duplicate keys + non-standard numbers, so the canonical argument document
	// (and the workflow_conflict identity it backs) is well-defined.
	match json.parse_strict(args_json) {
		core.Result::Ok(node) => {
			match node.as_object() {
				Optional::Some(_) => { return json.encode_compact_with_config(&node, &cfg); },
				Optional::None => { throw HostException(kind = HostErrorKind::InvalidJson(field = "arguments")); }
			}
		},
		core.Result::Err(_) => { throw HostException(kind = HostErrorKind::InvalidJson(field = "arguments")); }
	}
}

// Deterministic input-identity hash over an ALREADY-CANONICAL string (ordered-key compact
// JSON text, e.g. from _canonical_args) — matches runner.drift's own _input_hash exactly
// (canonical text -> UUIDv3 -> lowercase hex), so every input_hash in the system is produced
// the same way. Callers must pass an already-canonicalized string; this does not canonicalize.
fn _canonical_input_hash(canonical: &String) nothrow -> String {
	val u: uuid.Uuid = uuid.v3_from_string(canonical);
	val bytes: Array<Byte> = uuid.to_bytes(&u);
	return codec.hex_encode(&bytes);
}

// UTF-8 bytes of a String (for a binary RPC argument).
fn _utf8_bytes(s: &String) nothrow -> Array<Byte> {
	val n = s.byte_length();
	var out: Array<Byte> = [];
	var i = 0;
	while i < n { out.push(s.byte_at(i)); i = i + 1; }
	return move out;
}

// Required JSON object document argument (continuation): empty/malformed/
// non-object -> caller-input InvalidJson.
fn _json_object_arg(field: String, s: &String) -> rpc.RpcArg {
	if s.byte_length() == 0 { throw HostException(kind = HostErrorKind::InvalidJson(field = move field)); }
	if _is_json_object(s) { return rpc.arg_string(_dup(s)); }
	throw HostException(kind = HostErrorKind::InvalidJson(field = move field));
}

// Optional metadata document: absent (empty input) is the empty document `{}`.
fn _meta_object_arg(field: String, s: &String) -> rpc.RpcArg {
	if s.byte_length() == 0 { return rpc.arg_string("{}"); }
	if _is_json_object(s) { return rpc.arg_string(_dup(s)); }
	throw HostException(kind = HostErrorKind::InvalidJson(field = move field));
}

// A GENUINELY OPTIONAL JSON object document argument — unlike `_meta_object_arg`
// (absent -> the empty document `{}`), `None` here means SQL NULL, not `{}` (1b.0a
// step 3: `workflow_return_json` is required present-and-object on a final settle,
// required NULL on a non-final one — the SP itself enforces which via arg_is_final,
// so this helper only enforces object-shape when `Some`, never substituting a value).
fn _json_object_or_null_arg(field: String, opt: &Optional<String>) -> rpc.RpcArg {
	match opt {
		Optional::None => { return rpc.arg_null(); },
		Optional::Some(s) => {
			if s.byte_length() == 0 { throw HostException(kind = HostErrorKind::InvalidJson(field = move field)); }
			if _is_json_object(s) { return rpc.arg_string(_dup(s)); }
			throw HostException(kind = HostErrorKind::InvalidJson(field = move field));
		}
	}
}

fn _dup(s: &String) nothrow -> String {
	val n = s.byte_length();
	var buf = io.buffer(n);
	var i = 0;
	while i < n { io.buffer_write(&mut buf, i, s.byte_at(i)); i = i + 1; }
	return core.string_from_utf8_bytes(io.buffer_ptr(&buf), n);
}

fn _dup_bytes(b: &Array<Byte>) nothrow -> Array<Byte> {
	var out: Array<Byte> = Array<type Byte>::with_capacity(b.len);
	var i = 0;
	while i < b.len { out.push(b[i]); i = i + 1; }
	return move out;
}

// Decode a lowercase-hex string into EXACTLY 16 bytes.
fn _hex16(detail: String, s: &String) -> Array<Byte> {
	match codec.hex_decode(s) {
		core.Result::Ok(b) => { if b.len == 16 { return move b; } },
		core.Result::Err(_) => {}
	}
	throw HostException(kind = HostErrorKind::BackendResponseInvalid(detail = move detail));
}

// ===== RPC dispatch (Singular's document contract) =====

fn _acquire_conn(impl_: &HostImpl) -> managed.LeasedConn {
	match impl_.pool.acquire() {
		core.Result::Ok(lease) => { return move lease; },
		core.Result::Err(e) => {
			val tag_owned: String = e.tag;
			throw HostException(kind = _classify_acquire_tag(move tag_owned));
		}
	}
}

fn _classify_acquire_tag(tag: String) nothrow -> HostErrorKind {
	if tag == "acquire-timeout" {
		return HostErrorKind::BackendTimeout(detail = move tag);
	}
	return HostErrorKind::BackendUnavailable(detail = move tag);
}

fn _exec_with_conn(conn: &mut rpc.RpcConnection, sp_name: &String, args: Array<rpc.RpcArg>)
	-> rpc.RpcStatement
{
	match conn.call(sp_name, &args) {
		core.Result::Err(e) => {
			val tag_owned: String = e.tag;
			throw HostException(kind = HostErrorKind::BackendUnavailable(detail = move tag_owned));
		},
		core.Result::Ok(stmt) => { return move stmt; }
	}
}

fn _finish_stmt_and_commit(stmt: &mut rpc.RpcStatement, conn: &mut rpc.RpcConnection) -> Void {
	match rpc.skip_remaining(stmt) {
		core.Result::Err(e) => {
			val tag_owned: String = e.tag;
			throw HostException(kind = HostErrorKind::BackendUnavailable(detail = move tag_owned));
		},
		core.Result::Ok(_) => {}
	}
	match rpc.commit(conn) {
		core.Result::Err(e) => {
			val tag_owned: String = e.tag;
			throw HostException(kind = HostErrorKind::BackendRejected(detail = move tag_owned));
		},
		core.Result::Ok(_) => {}
	}
}

fn _next(stmt: &mut rpc.RpcStatement) -> rpc.RpcEvent {
	match rpc.next_event(stmt) {
		core.Result::Err(e) => {
			val tag_owned: String = e.tag;
			throw HostException(kind = HostErrorKind::BackendUnavailable(detail = move tag_owned));
		},
		core.Result::Ok(ev) => { return move ev; }
	}
}

fn _parse_object_doc(text: &String) -> json.JsonNode {
	var got: Optional<json.JsonNode> = Optional<json.JsonNode>::None();
	var detail = "result-not-json";
	match json.parse(text) {
		core.Result::Ok(node) => {
			var is_obj = false;
			match node.as_object() { Optional::Some(_) => { is_obj = true; }, Optional::None => {} }
			if is_obj { got = Optional<json.JsonNode>::Some(move node); }
			else { detail = "result-not-object"; }
		},
		core.Result::Err(_) => {}
	}
	match move got {
		Optional::Some(node) => { return move node; },
		Optional::None => { throw HostException(kind = HostErrorKind::BackendResponseInvalid(detail = detail)); }
	}
}

fn _read_result_doc(stmt: &mut rpc.RpcStatement) -> json.JsonNode {
	val event = _next(stmt);
	match event {
		rpc.RpcEvent::Row(row) => {
			val text = _str_req(&row, 0);
			return _parse_object_doc(&text);
		},
		rpc.RpcEvent::ServerErr(err) => {
			val errcode_owned: Uint = err.error_code; val msg_owned: String = err.message;
			throw HostException(kind = _server_err_kind(errcode_owned, move msg_owned));
		},
		default => {
			throw HostException(kind = HostErrorKind::BackendResponseInvalid(detail = "missing-result-row"));
		}
	}
}

fn _call_sp_doc(conn: &mut rpc.RpcConnection, sp_name: &String, args: Array<rpc.RpcArg>)
	-> json.JsonNode
{
	var stmt = _exec_with_conn(conn, sp_name, move args);
	val doc = _read_result_doc(&mut stmt);
	_finish_stmt_and_commit(&mut stmt, conn);
	return move doc;
}

fn _doc_outcome(doc: &json.JsonNode) -> String {
	return _doc_str_req(doc, &"outcome", "result-no-outcome");
}

fn _doc_str_req(doc: &json.JsonNode, key: &String, detail: String) -> String {
	match doc.get(key) {
		Optional::Some(n) => {
			match n.as_string() {
				Optional::Some(s) => { return move s; },
				Optional::None => { throw HostException(kind = HostErrorKind::BackendResponseInvalid(detail = move detail)); }
			}
		},
		Optional::None => { throw HostException(kind = HostErrorKind::BackendResponseInvalid(detail = move detail)); }
	}
}

// Optional string field: "" when the key is missing or JSON null (e.g. terminal_reason on a
// non-failure terminal). Used so a nullable durable field never forces a hard decode error.
fn _doc_str_opt(doc: &json.JsonNode, key: &String) nothrow -> String {
	match doc.get(key) {
		Optional::Some(n) => {
			match n.as_string() {
				Optional::Some(s) => { return move s; },
				Optional::None => { return ""; }
			}
		},
		Optional::None => { return ""; }
	}
}

// Decode the durable pin from a create_planned / plan_get result document.
fn _decode_pin(doc: &json.JsonNode) -> PinnedScript {
	return PinnedScript(
		script_name = _doc_str_req(doc, &"script_name", "pin-no-script-name"),
		plan_version = _doc_str_req(doc, &"plan_version", "pin-no-plan-version"),
		content_hash = _doc_str_req(doc, &"content_hash", "pin-no-content-hash"),
		plan_length = _doc_int_req(doc, &"plan_length", "pin-no-plan-length"));
}

fn _doc_int_req(doc: &json.JsonNode, key: &String, detail: String) -> Int {
	match doc.get(key) {
		Optional::Some(n) => {
			match n.as_int() {
				Optional::Some(v) => { return v; },
				Optional::None => { throw HostException(kind = HostErrorKind::BackendResponseInvalid(detail = move detail)); }
			}
		},
		Optional::None => { throw HostException(kind = HostErrorKind::BackendResponseInvalid(detail = move detail)); }
	}
}

fn _doc_object_text_req(doc: &json.JsonNode, key: &String) -> String {
	match doc.get(key) {
		Optional::Some(n) => {
			var is_obj = false;
			match n.as_object() { Optional::Some(_) => { is_obj = true; }, Optional::None => {} }
			if !is_obj { throw HostException(kind = HostErrorKind::BackendResponseInvalid(detail = "doc-field-not-object")); }
			return json.encode_compact(n);
		},
		Optional::None => { throw HostException(kind = HostErrorKind::BackendResponseInvalid(detail = "doc-field-missing")); }
	}
}

// Optional JSON-object document field: `None` when the key is missing or JSON null
// (e.g. workflow_return_json before completion — `_doc_object_text_req`'s "" sentinel
// trick doesn't work here since `{}` is itself a meaningful, distinct value from
// "absent"). Present-but-non-object is still a backend contract violation.
fn _doc_object_text_opt(doc: &json.JsonNode, key: &String) -> Optional<String> {
	match doc.get(key) {
		Optional::Some(n) => {
			if n.is_null() { return Optional<String>::None(); }
			var is_obj = false;
			match n.as_object() { Optional::Some(_) => { is_obj = true; }, Optional::None => {} }
			if !is_obj { throw HostException(kind = HostErrorKind::BackendResponseInvalid(detail = "doc-field-not-object")); }
			return Optional<String>::Some(json.encode_compact(n));
		},
		Optional::None => { return Optional<String>::None(); }
	}
}

// SPs SIGNAL caller-input/contract violations with SQLSTATE '45000' (errno
// 1644). Map those to BackendRejected (the message names the Pd* contract);
// everything else is also BackendRejected with its server message.
fn _server_err_kind(error_code: Uint, message: String) nothrow -> HostErrorKind {
	return HostErrorKind::BackendRejected(detail = move message);
}

fn _str_req(row: &rpc.RpcRow, col: Int) -> String {
	match row.is_null(col) {
		core.Result::Ok(v) => { if v { throw HostException(kind = HostErrorKind::BackendResponseInvalid(detail = "row-required-null")); } },
		core.Result::Err(_) => { throw HostException(kind = HostErrorKind::BackendResponseInvalid(detail = "row-isnull")); }
	}
	match row.get_string(col) {
		core.Result::Err(_) => { throw HostException(kind = HostErrorKind::BackendResponseInvalid(detail = "row-str")); },
		core.Result::Ok(v) => { return v; }
	}
}
