# mfinspect — read-only workflow/call-tree state dump for Microflows composition (1b.1).
#
# Local venv layout (created by `just setup`):
#   .venv/                      — Python virtual environment (gitignored)
#   .venv/bin/mfinspect          — console script entry point
#   src/mfinspect/               — package source (editable install)
#   ./mfinspect                  — standalone zipapp executable (`just build`, committed)
#
# Modeled on ../../../mariachi/justfile. All commands resolve Python from the venv;
# no system-python or ambient PYTHONPATH is read.
#
# positional-arguments is required for `run`'s *ARGS to forward correctly: plain {{ARGS}}
# interpolation joins variadic args into one space-separated TEXT string that the recipe's own
# shell then re-splits on whitespace, silently breaking any arg containing a space (e.g.
# --since "2026-07-01 00:00:00" becomes two args). With this set, {{ARGS}} keeps using text
# interpolation for the OTHER recipes below (which don't reference it), but `run` uses "$@"
# instead, which `just` populates as real, boundary-preserving positional shell parameters.
set positional-arguments := true

VENV := ".venv"
PY := VENV + "/bin/python"
MFINSPECT := VENV + "/bin/mfinspect"

# Create the venv and install the editable package + deps.
# Idempotent: re-runs reinstall the editable wheel.
setup:
	#!/usr/bin/env bash
	set -euo pipefail
	if [[ ! -d "{{VENV}}" ]]; then
		python3 -m venv "{{VENV}}"
	fi
	"{{PY}}" -m pip install --upgrade pip
	"{{PY}}" -m pip install -e .

# Build the self-contained ./mfinspect zipapp executable (runs on Python 3.10+
# alone — no venv, no pip install on the target machine).
# Regenerate any time with: just setup && just build
build:
	#!/usr/bin/env bash
	set -euo pipefail
	[[ -x "{{PY}}" ]] || { echo "error: venv missing — run 'just setup' first" >&2; exit 1; }
	"{{PY}}" tools/build_zipapp.py

# Run the packaging test suite.
test:
	#!/usr/bin/env bash
	set -euo pipefail
	[[ -x "{{PY}}" ]] || { echo "error: venv missing — run 'just setup' first" >&2; exit 1; }
	PYTHONPATH=src "{{PY}}" -m unittest discover -s tests -v

# Pass through to the built console script verbatim -- ARGS must include the action
# (`inspect`/`list`), since global DB args (--host/--port/...) come BEFORE the action in
# mfinspect's CLI and a hardcoded per-action recipe can't preserve that ordering.
# Examples:
#   just run --host 127.0.0.1 --port 34214 inspect 7f3a9d2c4b8e11f0a6c9d1e2f3045566
#   just run list --script checkout --since "2026-07-02 10:00:00" --until "2026-07-02 10:30:00"
run *ARGS:
	#!/usr/bin/env bash
	set -euo pipefail
	[[ -x "{{MFINSPECT}}" ]] || { echo "error: venv missing — run 'just setup' first" >&2; exit 1; }
	"{{MFINSPECT}}" "$@"

# Show the CLI help.
help:
	#!/usr/bin/env bash
	set -euo pipefail
	[[ -x "{{MFINSPECT}}" ]] || { echo "error: venv missing — run 'just setup' first" >&2; exit 1; }
	"{{MFINSPECT}}" --help

# Remove the venv (forces a clean re-bootstrap on next `just setup`).
clean:
	rm -rf "{{VENV}}"
