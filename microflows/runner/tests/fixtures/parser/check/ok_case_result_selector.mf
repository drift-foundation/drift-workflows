args { amount: int }
op authorize { input: { amount: int } result: { status: string } }
op capture { input: { token: string } }
steps {
  let auth = authorize { "amount": arg amount }
  case result auth.status { "approved" { capture { "token": "a" } } "declined" { capture { "token": "d" } } default { capture { "token": "x" } } }
  capture { "token": "fin" }
}
