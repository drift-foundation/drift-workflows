module microflows.runner.ir;

import std.core as core;
import std.json as json;
import std.format as fmt;
import std.io as io;
import std.float as float;

export {
	IrType,
	IrField,
	IrError,
	empty_object_type,
	parse_type,
	parse_object_type,
	validate,
	canonical,
	// ----- control-flow graph IR (Step 1b(ii): types + canonical hashing + flat-plan compat) -----
	IrExpr,
	LoopKind,
	IrCaseArm,
	IrNode,
	IrGraph,
	FlatStep,
	flat_to_graph,
	parse_graph,
	graph_canonical,
	canonical_json,
	validate_graph,
	op_depth,
	nonfinal_operations,
	operation_names,
	OpResult,
	StepOutcome,
	advance
};

// ===== V1 closed value-type model (manual-IR frontend, Step 1b: argument types) =====
//
// The closed, minimal V1 type set: scalars (Null/Bool/Int/Float/String) + Array<T> +
// closed-field Object + Optional<T>. A script revision declares a closed-OBJECT argument
// TYPE; submitted instance arguments are validated against it before creation, and the
// type's deterministic canonical encoding participates in the script content_hash (so the
// argument contract is part of the revision identity — unconditionally).
//
// Control-flow graph IR (Step 1b(ii)) lives in the second half of this file: graph node
// TYPES, their deterministic `graph_canonical` encoding, and a `flat_to_graph` builder that
// re-expresses today's flat operation plan as a degenerate straight-line graph. Interpretation
// (execution) and structural validation are a SEPARATE chunk; this chunk does not touch the
// runner's live content_hash or runtime behavior.

// Recursive arms (TArray/TOptional) hold their child through `core.Box<IrType>` — a move-only,
// unique-ownership heap indirection giving the value type a FINITE layout. Construct with
// `core.box(child)` and read the borrow with `.get()` (Box does NOT auto-deref).
//
// Direct recursive value layouts (e.g. `TArray(elem: IrType)`) remain invalid — driftc rejects
// them with `E_RECURSIVE_VALUE_TYPE` and a source span. `Box<Self>` is the sanctioned
// indirection (driftc 0.33.35 / ABI 17). `TObject(fields: Array<IrField>)` is a genuine list,
// not a recursion indirection, so it stays an Array. (`Arc<IrType>` would be shared ownership —
// not what we want here; the type tree is uniquely owned.)
pub variant IrType {
	TNull,
	TBool,
	TInt,
	TFloat,
	TString,
	TArray(elem: core.Box<IrType>),
	TObject(fields: Array<IrField>),   // fields kept SORTED by name (deterministic canonical)
	TOptional(inner: core.Box<IrType>)
}

pub struct IrField {
	name: String,
	ty: IrType
}

pub error IrError { message: String }

// The empty closed-object type `{}` — the default argument type for a script that declares
// none. Its canonical form ("O{}") still participates in content_hash (never elided).
pub fn empty_object_type() nothrow -> IrType {
	var fields: Array<IrField> = [];
	return IrType::TObject(fields = move fields);
}

// ----- parse a declared type from its config JSON encoding -----
//
// Encoding (a JSON object with a "type" discriminant):
//   {"type":"null"|"bool"|"int"|"float"|"string"}
//   {"type":"array","elem": <type>}
//   {"type":"optional","inner": <type>}
//   {"type":"object","fields":[ {"name":"a","type":<type>}, ... ]}   // fields as an ARRAY
//
// A script's argument type MUST be an object type (enforced by the caller via
// parse_object_type).
pub fn parse_type(node: &json.JsonNode) -> IrType {
	// UNKNOWN-KEY rejection: a declaration carries exactly its allowed keys. The required keys
	// are fetched below; any count above the allowed set is a typo (e.g. "tpye"/"elment") that
	// would otherwise be silently dropped — and dropped data would also be absent from
	// content_hash, yielding a valid-but-unintended contract. We reject it.
	val nkeys = _obj_len(node);
	val kind = _req_str(node, &"type");
	if _str_eq(&kind, &"null") { _reject_extra(nkeys, 1); return IrType::TNull(); }
	if _str_eq(&kind, &"bool") { _reject_extra(nkeys, 1); return IrType::TBool(); }
	if _str_eq(&kind, &"int") { _reject_extra(nkeys, 1); return IrType::TInt(); }
	if _str_eq(&kind, &"float") { _reject_extra(nkeys, 1); return IrType::TFloat(); }
	if _str_eq(&kind, &"string") { _reject_extra(nkeys, 1); return IrType::TString(); }
	if _str_eq(&kind, &"array") {
		match node.get(&"elem") {
			Optional::Some(e) => { val inner = parse_type(e); _reject_extra(nkeys, 2); return IrType::TArray(elem = core.box(move inner)); },
			Optional::None => { throw IrError(message = "array type missing 'elem'"); }
		}
	}
	if _str_eq(&kind, &"optional") {
		match node.get(&"inner") {
			Optional::Some(e) => { val inner = parse_type(e); _reject_extra(nkeys, 2); return IrType::TOptional(inner = core.box(move inner)); },
			Optional::None => { throw IrError(message = "optional type missing 'inner'"); }
		}
	}
	if _str_eq(&kind, &"object") {
		var fields: Array<IrField> = [];
		match node.get(&"fields") {
			Optional::Some(fnode) => {
				match fnode.as_array() {
					Optional::Some(arr) => {
						var i = 0;
						while i < arr.len {
							fields.push(_parse_field(&arr[i]));
							i = i + 1;
						}
					},
					Optional::None => { throw IrError(message = "object 'fields' must be an array"); }
				}
			},
			Optional::None => { throw IrError(message = "object type missing 'fields'"); }
		}
		_reject_extra(nkeys, 2);
		_sort_fields(&mut fields);
		_check_no_dup_fields(&fields);
		return IrType::TObject(fields = move fields);
	}
	throw IrError(message = "unknown type kind: " + _dup(&kind));
}

// One object field: exactly {"name", "type"} — extra keys rejected.
fn _parse_field(fnode: &json.JsonNode) -> IrField {
	val nkeys = _obj_len(fnode);
	val nm = _req_str(fnode, &"name");
	match fnode.get(&"type") {
		Optional::Some(ft) => {
			val fty = parse_type(ft);
			_reject_extra(nkeys, 2);
			return IrField(name = move nm, ty = move fty);
		},
		Optional::None => { throw IrError(message = "object field missing 'type'"); }
	}
}

// Parse + require a closed-OBJECT argument type. Returns a Result (IrError caught HERE, where
// it is a local type) so callers in other modules need no error-type-qualified `catch` and can
// distinguish this expected validation failure from unexpected defects.
pub fn parse_object_type(node: &json.JsonNode) -> core.Result<IrType, IrError> {
	// The inner parse only ever throws IrError (a declaration validation failure). Catch it
	// TYPED and reconstruct the native error from its fields: a typed-catch binder is a
	// read-only view over the in-flight error, not a movable `IrError` value (moving the whole
	// binder is rejected with E_TYPED_CATCH_BINDER_NOT_VALUE), so we copy `e.message` into a
	// fresh IrError. Unexpected (non-IrError) defects propagate — they are not silently mapped
	// to a validation failure.
	try {
		val ty = _parse_object_type_throwing(node);
		return core.Result<IrType, IrError>::Ok(move ty);
	} catch IrError(e) {
		return core.Result<IrType, IrError>::Err(IrError(message = e.message));
	}
}

fn _parse_object_type_throwing(node: &json.JsonNode) -> IrType {
	val ty = parse_type(node);
	var is_obj = false;
	match &ty { IrType::TObject(_) => { is_obj = true; }, default => {} }
	if !is_obj { throw IrError(message = "argument_type must be an object type"); }
	return move ty;
}

// ----- validate a JSON value against a type. Returns None on success, or Some(message). -----
pub fn validate(value: &json.JsonNode, ty: &IrType) nothrow -> Optional<String> {
	match ty {
		IrType::TNull() => {
			if value.is_null() { return Optional<String>::None(); }
			return Optional<String>::Some("expected null");
		},
		IrType::TBool() => {
			match value.as_bool() { Optional::Some(_) => { return Optional<String>::None(); }, Optional::None => {} }
			return Optional<String>::Some("expected bool");
		},
		IrType::TInt() => {
			// EXACT: an INTEGER-shaped JSON number (no '.'/'e'/'E') within signed range. A
			// float-shaped literal (1.0, 1e3) or an out-of-range magnitude (overflow) is NOT an
			// int — no implicit coercion.
			match value.as_number_raw() {
				Optional::Some(raw) => {
					if _is_float_shaped(&raw) { return Optional<String>::Some("expected int (got a float-shaped number)"); }
					match value.as_int() { Optional::Some(_) => { return Optional<String>::None(); }, Optional::None => {} }
					return Optional<String>::Some("expected int (out of range)");
				},
				Optional::None => { return Optional<String>::Some("expected int"); }
			}
		},
		IrType::TFloat() => {
			// EXACT: a FLOAT-shaped JSON number ('.' or exponent) that parses FINITE. An
			// integer-shaped literal (1) is an int, not a float (no implicit coercion); a
			// non-finite magnitude (e.g. 1e400) is rejected.
			match value.as_number_raw() {
				Optional::Some(raw) => {
					if !_is_float_shaped(&raw) { return Optional<String>::Some("expected float (got an integer-shaped number)"); }
					match value.as_float() {
						Optional::Some(v) => {
							if float.is_finite(v) { return Optional<String>::None(); }
							return Optional<String>::Some("expected float (non-finite)");
						},
						Optional::None => {}
					}
					return Optional<String>::Some("expected float");
				},
				Optional::None => { return Optional<String>::Some("expected float"); }
			}
		},
		IrType::TString() => {
			match value.as_string() { Optional::Some(_) => { return Optional<String>::None(); }, Optional::None => {} }
			return Optional<String>::Some("expected string");
		},
		IrType::TArray(elem) => {
			match value.as_array() {
				Optional::Some(arr) => {
					var i = 0;
					while i < arr.len {
						match validate(&arr[i], elem.get()) {
							Optional::Some(m) => { return Optional<String>::Some("array[" + fmt.format_int(i) + "]: " + m); },
							Optional::None => {}
						}
						i = i + 1;
					}
					return Optional<String>::None();
				},
				Optional::None => { return Optional<String>::Some("expected array"); }
			}
		},
		IrType::TOptional(inner) => {
			if value.is_null() { return Optional<String>::None(); }
			return validate(value, inner.get());
		},
		IrType::TObject(fields) => {
			match value.as_object() {
				Optional::Some(obj) => {
					var matched = 0;
					var i = 0;
					while i < fields.len {
						val nm = &fields[i].name;
						match value.get(nm) {
							Optional::Some(fv) => {
								match validate(fv, &fields[i].ty) {
									Optional::Some(m) => { return Optional<String>::Some("field '" + _dup(nm) + "': " + m); },
									Optional::None => {}
								}
								matched = matched + 1;
							},
							Optional::None => {
								// Absent is allowed ONLY for an optional field.
								if !_is_optional(&fields[i].ty) {
									return Optional<String>::Some("missing field '" + _dup(nm) + "'");
								}
							}
						}
						i = i + 1;
					}
					// CLOSED object: no field present that wasn't declared. Every present
					// declared field was counted in `matched`; if the value carries more fields
					// than we matched, at least one is undeclared.
					if obj.len() > matched {
						return Optional<String>::Some("unexpected extra field(s)");
					}
					return Optional<String>::None();
				},
				Optional::None => { return Optional<String>::Some("expected object"); }
			}
		}
	}
}

// ----- deterministic canonical encoding (for content_hash). Field order is normalized to
// sorted-by-name at parse time, so the encoding is independent of declaration order. -----
pub fn canonical(ty: &IrType) nothrow -> String {
	match ty {
		IrType::TNull() => { return "n"; },
		IrType::TBool() => { return "b"; },
		IrType::TInt() => { return "i"; },
		IrType::TFloat() => { return "f"; },
		IrType::TString() => { return "s"; },
		IrType::TArray(elem) => { return "a(" + canonical(elem.get()) + ")"; },
		IrType::TOptional(inner) => { return "o(" + canonical(inner.get()) + ")"; },
		IrType::TObject(fields) => {
			var s: String = "O{";
			var i = 0;
			while i < fields.len {
				s = s + _lp(&fields[i].name) + canonical(&fields[i].ty) + ";";
				i = i + 1;
			}
			return s + "}";
		}
	}
}

// ===== V1 control-flow graph IR (Step 1b(ii) — types + canonical hashing + flat-plan compat) =====
//
// The plan is a FLAT NODE TABLE (`IrGraph.nodes`) keyed by stable, unique node ids; control
// flow is expressed as node-id edges (`next`, branch targets), NOT nested nodes — so `IrNode`
// is not self-recursive through control flow, and the graph stays a finite value. Only remote
// `NOperation` nodes are durable suspension points; every other node is pure control flow that
// a restarted worker re-derives by replay. Structural validation (unique ids, valid targets, no
// remote op inside a loop, finite-loop shape, result-by-id) is a SEPARATE chunk; so is execution.

// An EXPRESSION — the closed V1 leaf source set. Determinism is structural: the only sources are
// pinned constants, durable arguments, settled Operation results (by node id), and Let/loop-bound
// locals. No clock/random/env/fs/net/live-config. (Derived operators — comparisons, arithmetic —
// are a deliberate follow-up introduced with the interpreter; V1 keeps the source set closed.)
// `path` projects into a JSON object/array by successive keys ([] = the whole value).
//
// EConst's `canonical_json` MUST already be canonical (key-ordered compact, per `canonical_json`):
// `graph_canonical` hashes it VERBATIM, so a non-canonical literal (reordered keys / whitespace)
// would create a false revision change once the graph is authoritative. Producers canonicalize at
// construction — `flat_to_graph` does so; any other constructor (loop init, return value, NCase
// `match_const`) must pass a `canonical_json`-normalized string.
pub variant IrExpr {
	EConst(canonical_json: String),                  // pinned constant: a CANONICAL JSON literal (see above)
	EArg(path: Array<String>),                       // durable arguments, projected by path
	EResult(node: String, path: Array<String>),      // a prior Operation node's settled result
	ELocal(name: String, path: Array<String>)        // a Let-bound local / loop element / accumulator
}

// V1 loops are FINITE array transforms over a finite collection — never a `while` cycle.
pub variant LoopKind { LMap, LFilter, LFold }

// One arm of an NCase: branch to `target` when the scrutinee equals `match_const` (a CANONICAL
// JSON literal — same contract as EConst; producer-normalized via `canonical_json`). Arms are
// encoded order-independently (sorted by `match_const`).
pub struct IrCaseArm {
	pub match_const: String,
	pub target: String
}

// A graph NODE. `id` is this node's stable unique key; edges (`next`, `then_node`, `else_node`,
// arm `target`s, `default_node`) reference other nodes by id. A loop's body is a pure `IrExpr`
// over its element/accumulator locals — which structurally forbids a remote operation inside a
// loop (no `IrExpr` arm can be an operation). For NLoop, `acc` is the result-binding local name
// (the downstream local the loop result binds to) — for `LFold` it is ALSO the in-body accumulator
// threaded from `init`; `LMap`/`LFilter` thread no accumulator, so their `init = EConst("null")`.
pub variant IrNode {
	NOperation(id: String, operation: String, input: IrExpr, next: String),   // remote op; result bound to `id`
	NLet(id: String, name: String, value: IrExpr, next: String),              // bind a pure derived local
	NIf(id: String, cond: IrExpr, then_node: String, else_node: String),      // `cond` is Bool-valued
	NCase(id: String, scrutinee: IrExpr, arms: Array<IrCaseArm>, default_node: String),
	NLoop(id: String, kind: LoopKind, source: IrExpr, elem: String, acc: String, init: IrExpr, body: IrExpr, next: String),
	NReturn(id: String, value: IrExpr)                                        // terminal: the workflow result
}

pub struct IrGraph {
	pub nodes: Array<IrNode>,   // flat node table (ids unique — validated in the execution chunk)
	pub entry: String           // entry node id
}

// One flat plan step (operation + its literal input), as the runner's flat plan carries it —
// the input domain to `flat_to_graph`. Kept here so ir owns the flat→graph mapping without
// importing runner types.
pub struct FlatStep {
	pub operation: String,
	pub input_json: String
}

// Re-express today's flat operation plan as a DEGENERATE straight-line graph: each step becomes
// an `NOperation` whose input is the step's literal JSON constant, chained `n0 -> n1 -> … -> nN`,
// terminating in an `NReturn` (the flat plan declares no explicit result, so it returns unit
// `null`). Behavior-preserving: the same ordered operation sequence, just graph-shaped.
//
// Each step's input is CANONICALIZED (key-ordered compact) so the `EConst` literal is genuinely
// canonical and key order/whitespace in config can never produce a false revision change. A
// malformed input constant -> Err (the only expected failure); unexpected encode defects fail
// loudly (not mapped to Err).
pub fn flat_to_graph(steps: &Array<FlatStep>) -> core.Result<IrGraph, IrError> {
	var nodes: Array<IrNode> = [];
	val n = steps.len;
	var i = 0;
	while i < n {
		var canon: String = "";
		match canonical_json(&steps[i].input_json) {
			core.Result::Ok(c) => { canon = move c; },
			core.Result::Err(e) => { return core.Result<IrGraph, IrError>::Err(move e); }
		}
		nodes.push(IrNode::NOperation(
			id = _nid(i),
			operation = _dup(&steps[i].operation),
			input = IrExpr::EConst(canonical_json = move canon),
			next = _nid(i + 1)
		));
		i = i + 1;
	}
	nodes.push(IrNode::NReturn(id = _nid(n), value = IrExpr::EConst(canonical_json = "null")));
	return core.Result<IrGraph, IrError>::Ok(IrGraph(nodes = move nodes, entry = _nid(0)));
}

fn _nid(i: Int) nothrow -> String { return "n" + fmt.format_int(i); }

// ----- manual-IR GRAPH config -> IrGraph (intentionally small; no parser/DSL) -----
//
// A directly-authored control-flow graph (the "graph" config key), for non-degenerate shapes the
// flat plan can't express. Encoding (JSON):
//   {"entry":"n0","nodes":[ <node>, ... ]}
//   <node> = {"kind":"operation","id":...,"operation":...,"input":<expr>,"next":...}
//          | {"kind":"if","id":...,"cond":<expr>,"then":...,"else":...}
//          | {"kind":"let","id":...,"name":...,"value":<expr>,"next":...}
//          | {"kind":"return","id":...,"value":<expr>}
//          | {"kind":"map"|"filter","id":...,"source":<expr>,"elem":NAME,"as":NAME,"body":<expr>,"next":...}
//          | {"kind":"fold","id":...,"source":<expr>,"elem":NAME,"as":NAME,"init":<expr>,"body":<expr>,"next":...}
//          | {"kind":"case","id":...,"scrutinee":<expr>,"arms":[{"match":<json>,"target":...},...],"default":...}
//   <expr> = {"const":<json>} | {"arg":[seg,...]} | {"result":{"node":...,"path":[seg,...]}}
//          | {"local":{"name":...,"path":[seg,...]}}     ("path" optional, default [])
// `const` and case-arm `match` values are canonicalized into a CANONICAL JSON literal. map/filter/
// fold are FINITE ARRAY EXPRESSIONS (NLoop): the result binds to local `as`, the body is a pure
// IrExpr (no remote ops). `case` (NCase) selects the arm whose `match` equals the scrutinee, else
// `default`. Returns a Result (IrError caught HERE) so callers in other modules need no
// error-type-qualified catch.
pub fn parse_graph(node: &json.JsonNode) -> core.Result<IrGraph, IrError> {
	try {
		val g = _parse_graph_throwing(node);
		return core.Result<IrGraph, IrError>::Ok(move g);
	} catch IrError(e) {
		return core.Result<IrGraph, IrError>::Err(IrError(message = e.message));
	}
}

fn _parse_graph_throwing(node: &json.JsonNode) -> IrGraph {
	_reject_extra(_obj_len(node), 2);   // exactly {entry, nodes} — unknown keys rejected
	val entry = _req_str(node, &"entry");
	var nodes: Array<IrNode> = [];
	match node.get(&"nodes") {
		Optional::Some(nn) => {
			match nn.as_array() {
				Optional::Some(arr) => {
					var i = 0;
					while i < arr.len { nodes.push(_parse_node(&arr[i])); i = i + 1; }
				},
				Optional::None => { throw IrError(message = "graph 'nodes' must be an array"); }
			}
		},
		Optional::None => { throw IrError(message = "graph missing 'nodes'"); }
	}
	if nodes.len == 0 { throw IrError(message = "graph 'nodes' must not be empty"); }
	return IrGraph(nodes = move nodes, entry = entry);
}

// Each node kind has EXACTLY its allowed keys — unknown/extra keys are rejected (the graph is
// content-hashed executable identity; a typo'd key must fail validation, not be silently dropped).
fn _parse_node(n: &json.JsonNode) -> IrNode {
	val nkeys = _obj_len(n);
	val kind = _req_str(n, &"kind");
	val id = _req_str(n, &"id");
	if _str_eq(&kind, &"operation") {
		val op = _req_str(n, &"operation");
		val next = _req_str(n, &"next");
		val input = _parse_expr_at(n, &"input");
		_reject_extra(nkeys, 5);   // kind, id, operation, input, next
		return IrNode::NOperation(id = move id, operation = move op, input = move input, next = move next);
	}
	if _str_eq(&kind, &"if") {
		val then_n = _req_str(n, &"then");
		val else_n = _req_str(n, &"else");
		val cond = _parse_expr_at(n, &"cond");
		_reject_extra(nkeys, 5);   // kind, id, cond, then, else
		return IrNode::NIf(id = move id, cond = move cond, then_node = move then_n, else_node = move else_n);
	}
	if _str_eq(&kind, &"let") {
		val name = _req_str(n, &"name");
		val next = _req_str(n, &"next");
		val value = _parse_expr_at(n, &"value");
		_reject_extra(nkeys, 5);   // kind, id, name, value, next
		return IrNode::NLet(id = move id, name = move name, value = move value, next = move next);
	}
	if _str_eq(&kind, &"return") {
		val value = _parse_expr_at(n, &"value");
		_reject_extra(nkeys, 3);   // kind, id, value
		return IrNode::NReturn(id = move id, value = move value);
	}
	// Finite array expressions (map/filter/fold over a finite array source). The result binds to
	// a downstream local named `as`; the body is a pure IrExpr over `elem` (+ the `as` accumulator
	// for fold), so it can never dispatch a remote operation. map/filter carry no accumulator (the
	// init is implicitly the unit null); fold threads `as` from `init` through the body.
	if _str_eq(&kind, &"map") or _str_eq(&kind, &"filter") {
		val source = _parse_expr_at(n, &"source");
		val elem = _req_str(n, &"elem");
		val as_name = _req_str(n, &"as");
		val body = _parse_expr_at(n, &"body");
		val next = _req_str(n, &"next");
		_reject_extra(nkeys, 7);   // kind, id, source, elem, as, body, next
		var lk = LoopKind::LMap();
		if _str_eq(&kind, &"filter") { lk = LoopKind::LFilter(); }
		return IrNode::NLoop(id = move id, kind = move lk, source = move source, elem = move elem,
		                     acc = move as_name, init = IrExpr::EConst(canonical_json = "null"),
		                     body = move body, next = move next);
	}
	if _str_eq(&kind, &"fold") {
		val source = _parse_expr_at(n, &"source");
		val elem = _req_str(n, &"elem");
		val as_name = _req_str(n, &"as");
		val init = _parse_expr_at(n, &"init");
		val body = _parse_expr_at(n, &"body");
		val next = _req_str(n, &"next");
		_reject_extra(nkeys, 8);   // kind, id, source, elem, as, init, body, next
		return IrNode::NLoop(id = move id, kind = LoopKind::LFold(), source = move source, elem = move elem,
		                     acc = move as_name, init = move init, body = move body, next = move next);
	}
	// case: branch on the scrutinee value. `arms` map a CANONICAL match constant to a target node;
	// `default` (required) is taken when no arm matches. Pure control flow (no durable boundary).
	// validate_graph enforces canonical/valid match constants and rejects duplicate arm constants;
	// op_depth keeps every arm + default uniform.
	if _str_eq(&kind, &"case") {
		val scrutinee = _parse_expr_at(n, &"scrutinee");
		val default_n = _req_str(n, &"default");
		var arms: Array<IrCaseArm> = [];
		match n.get(&"arms") {
			Optional::Some(an) => {
				match an.as_array() {
					Optional::Some(arr) => {
						var i = 0;
						while i < arr.len { arms.push(_parse_case_arm(&arr[i])); i = i + 1; }
					},
					Optional::None => { throw IrError(message = "case 'arms' must be an array"); }
				}
			},
			Optional::None => { throw IrError(message = "case missing 'arms'"); }
		}
		_reject_extra(nkeys, 5);   // kind, id, scrutinee, arms, default
		return IrNode::NCase(id = move id, scrutinee = move scrutinee, arms = move arms, default_node = move default_n);
	}
	throw IrError(message = "unknown graph node kind: " + _dup(&kind));
}

// Parse one case arm: exactly {match, target}. `match` is a JSON value canonicalized into the
// match constant (so {"a":1,"b":2} and {"b":2,"a":1} collapse to one arm, caught as a duplicate);
// `target` is the destination node id. Unknown/missing keys are rejected.
fn _parse_case_arm(n: &json.JsonNode) -> IrCaseArm {
	val target = _req_str(n, &"target");
	var mc: String = "";
	match n.get(&"match") {
		Optional::Some(m) => { mc = _canon_node(m); },
		Optional::None => { throw IrError(message = "case arm missing 'match'"); }
	}
	_reject_extra(_obj_len(n), 2);   // match, target
	return IrCaseArm(match_const = move mc, target = move target);
}

// Parse the expression at object key `key` (required).
fn _parse_expr_at(n: &json.JsonNode, key: &String) -> IrExpr {
	match n.get(key) {
		Optional::Some(e) => { return _parse_expr(e); },
		Optional::None => { throw IrError(message = "node missing expression field '" + _dup(key) + "'"); }
	}
}

// An expression is EXACTLY ONE variant: const | arg | result | local. Multiple keys (which would
// silently resolve by priority) or unknown keys are rejected.
fn _parse_expr(e: &json.JsonNode) -> IrExpr {
	_reject_extra(_obj_len(e), 1);   // at most one variant key; 0 falls through to the throw below
	match e.get(&"const") {
		Optional::Some(c) => { return IrExpr::EConst(canonical_json = _canon_node(c)); },
		Optional::None => {}
	}
	match e.get(&"arg") {
		Optional::Some(p) => { return IrExpr::EArg(path = _parse_path(p)); },
		Optional::None => {}
	}
	match e.get(&"result") {
		Optional::Some(r) => {
			_reject_unknown_opt_path(r, &"node");   // exactly {node, path?}
			val rnode = _req_str(r, &"node");
			return IrExpr::EResult(node = move rnode, path = _parse_path_opt(r, &"path"));
		},
		Optional::None => {}
	}
	match e.get(&"local") {
		Optional::Some(l) => {
			_reject_unknown_opt_path(l, &"name");   // exactly {name, path?}
			val lname = _req_str(l, &"name");
			return IrExpr::ELocal(name = move lname, path = _parse_path_opt(l, &"path"));
		},
		Optional::None => {}
	}
	throw IrError(message = "expression must be exactly one of: const, arg, result, local");
}

fn _parse_path(p: &json.JsonNode) -> Array<String> {
	var out: Array<String> = [];
	match p.as_array() {
		Optional::Some(arr) => {
			var i = 0;
			while i < arr.len {
				match arr[i].as_string() {
					Optional::Some(s) => { out.push(move s); },
					Optional::None => { throw IrError(message = "path segment must be a string"); }
				}
				i = i + 1;
			}
		},
		Optional::None => { throw IrError(message = "path must be an array of strings"); }
	}
	return move out;
}

fn _parse_path_opt(n: &json.JsonNode, key: &String) -> Array<String> {
	match n.get(key) {
		Optional::Some(p) => { return _parse_path(p); },
		Optional::None => { var empty: Array<String> = []; return move empty; }
	}
}

// Canonical compact JSON: parse strictly + re-encode with lexicographic UTF-8 key ordering, so a
// value's identity is independent of key spelling/order/whitespace. The IR home's definition of
// "canonical JSON literal" (EConst / IrCaseArm.match_const); the runner's `_canonical_json` uses
// the same scheme and may later delegate here. Err(IrError) on malformed input.
pub fn canonical_json(text: &String) nothrow -> core.Result<String, IrError> {
	val cfg = json.JsonConfig(key_order = json.JsonKeyOrder::OrderedLexUtf8());
	match json.parse_strict(text) {
		core.Result::Ok(n) => { return core.Result<String, IrError>::Ok(json.encode_compact_with_config(&n, &cfg)); },
		core.Result::Err(_) => { return core.Result<String, IrError>::Err(IrError(message = "constant is not valid JSON")); }
	}
}

// A constant string must be VALID and already CANONICAL JSON (key-ordered compact) — so replay
// never Faults on EConst, and NCase matching compares canonical-vs-canonical (not raw spelling).
fn _check_const(text: &String) nothrow -> Optional<String> {
	match canonical_json(text) {
		core.Result::Ok(c) => {
			if !_str_eq(&c, text) { return Optional<String>::Some("constant is not canonical JSON: " + _dup(text)); }
			return Optional<String>::None();
		},
		core.Result::Err(e) => { return Optional<String>::Some("constant is not valid JSON: " + _dup(text)); }
	}
}

// ----- deterministic canonical encoding of a graph (for the FUTURE content_hash). Captures the
// full graph shape: entry, every node (kind + id + fields + edges by id), branch targets, loop
// bodies, and per-operation node name + input expression. Node order is normalized to sorted-by-id
// and NCase arms to sorted-by-match_const, so declaration order never affects identity. The
// runner composes this with its per-operation RESOLVED bindings (schema_version + participant)
// and compensation bindings + the declared argument type when it adopts the graph as authoritative
// (a separate chunk). All fields are length-prefixed so distinct graphs never collide. -----
pub fn graph_canonical(g: &IrGraph) nothrow -> String {
	val order = _node_order_by_id(&g.nodes);
	var s: String = "G{" + _lp(&g.entry) + "|";
	var k = 0;
	while k < order.len {
		s = s + _node_canonical(&g.nodes[order[k]]) + ";";
		k = k + 1;
	}
	return s + "}";
}

// Operation NAMES of the graph's NOperation nodes, in the SAME canonical order `graph_canonical`
// uses (sorted by node id). A caller that composes per-operation RESOLUTION bindings (resolved
// schema_version + participant + compensation) must iterate in THIS order, so the binding suffix
// is declaration-order-independent and matches the node ordering inside `graph_canonical` — two
// equivalent graphs with reordered node tables then hash identically.
pub fn operation_names(g: &IrGraph) nothrow -> Array<String> {
	val order = _node_order_by_id(&g.nodes);
	var out: Array<String> = [];
	var k = 0;
	while k < order.len {
		match &g.nodes[order[k]] {
			IrNode::NOperation(id, operation, input, next) => { out.push(_dup(operation)); },
			default => {}
		}
		k = k + 1;
	}
	return move out;
}

fn _node_canonical(n: &IrNode) nothrow -> String {
	match n {
		IrNode::NOperation(id, operation, input, next) => {
			return "P" + _lp(id) + _lp(operation) + _expr_canonical(input) + _lp(next);
		},
		IrNode::NLet(id, name, value, next) => {
			return "L" + _lp(id) + _lp(name) + _expr_canonical(value) + _lp(next);
		},
		IrNode::NIf(id, cond, then_node, else_node) => {
			return "I" + _lp(id) + _expr_canonical(cond) + _lp(then_node) + _lp(else_node);
		},
		IrNode::NCase(id, scrutinee, arms, default_node) => {
			return "C" + _lp(id) + _expr_canonical(scrutinee) + _arms_canonical(arms) + _lp(default_node);
		},
		IrNode::NLoop(id, kind, source, elem, acc, init, body, next) => {
			return "O" + _lp(id) + _loopkind_tag(kind) + _expr_canonical(source)
			     + _lp(elem) + _lp(acc) + _expr_canonical(init) + _expr_canonical(body) + _lp(next);
		},
		IrNode::NReturn(id, value) => {
			return "R" + _lp(id) + _expr_canonical(value);
		}
	}
}

fn _expr_canonical(e: &IrExpr) nothrow -> String {
	match e {
		IrExpr::EConst(canonical_json) => { return "k" + _lp(canonical_json); },
		IrExpr::EArg(path) => { return "a" + _path_canonical(path); },
		IrExpr::EResult(node, path) => { return "r" + _lp(node) + _path_canonical(path); },
		IrExpr::ELocal(name, path) => { return "l" + _lp(name) + _path_canonical(path); }
	}
}

fn _path_canonical(p: &Array<String>) nothrow -> String {
	var s: String = "[";
	var i = 0;
	while i < p.len { s = s + _lp(&p[i]); i = i + 1; }
	return s + "]";
}

fn _loopkind_tag(k: &LoopKind) nothrow -> String {
	match k {
		LoopKind::LMap() => { return "m"; },
		LoopKind::LFilter() => { return "f"; },
		LoopKind::LFold() => { return "d"; }
	}
}

// NCase arms encoded order-independently (sorted by match_const).
fn _arms_canonical(arms: &Array<IrCaseArm>) nothrow -> String {
	var order = _arm_order(arms);
	var s: String = "[";
	var k = 0;
	while k < order.len {
		s = s + _lp(&arms[order[k]].match_const) + _lp(&arms[order[k]].target);
		k = k + 1;
	}
	return s + "]";
}

fn _arm_order(arms: &Array<IrCaseArm>) nothrow -> Array<Int> {
	var idx: Array<Int> = [];
	var i = 0;
	while i < arms.len { idx.push(i); i = i + 1; }
	var a = 1;
	while a < idx.len {
		var b = a;
		while b > 0 and _str_lt(&arms[idx[b]].match_const, &arms[idx[b - 1]].match_const) {
			idx.swap(b, b - 1);
			b = b - 1;
		}
		a = a + 1;
	}
	return move idx;
}

// Node indices sorted by node id (declaration-order-independent canonical).
fn _node_order_by_id(nodes: &Array<IrNode>) nothrow -> Array<Int> {
	var idx: Array<Int> = [];
	var i = 0;
	while i < nodes.len { idx.push(i); i = i + 1; }
	var a = 1;
	while a < idx.len {
		var b = a;
		var cont = true;
		while cont and b > 0 {
			val ia = _node_id(&nodes[idx[b]]);
			val ib = _node_id(&nodes[idx[b - 1]]);
			if _str_lt(&ia, &ib) { idx.swap(b, b - 1); b = b - 1; }
			else { cont = false; }
		}
		a = a + 1;
	}
	return move idx;
}

fn _node_id(n: &IrNode) nothrow -> String {
	match n {
		IrNode::NOperation(id, operation, input, next) => { return _dup(id); },
		IrNode::NLet(id, name, value, next) => { return _dup(id); },
		IrNode::NIf(id, cond, then_node, else_node) => { return _dup(id); },
		IrNode::NCase(id, scrutinee, arms, default_node) => { return _dup(id); },
		IrNode::NLoop(id, kind, source, elem, acc, init, body, next) => { return _dup(id); },
		IrNode::NReturn(id, value) => { return _dup(id); }
	}
}

// ===== pure-control-flow interpreter (Step 1b(ii) chunk 2) =====
//
// `advance` REPLAYS the graph's pure control flow from the durable arguments + the settled
// remote-operation results, and STOPS at the next durable boundary: either the next UNSETTLED
// `NOperation` (returns `NeedOperation` with that operation's input as canonical JSON) or the
// terminal `NReturn` (returns `Completed` with the workflow result). Pure nodes (`NLet`/`NIf`/
// `NCase`) are evaluated to thread locals + choose branches; a SETTLED operation contributes its
// result (available to later `EResult`) and replay continues past it. Persistence is unchanged:
// only `NOperation` is a durable boundary — pure control flow is always re-derived by replay, so
// a restarted worker calling `advance` with the same (args, settled) reaches the same next step.
//
// Replay is deterministic and structural (no clock/random/etc.). Call it on a VALIDATED graph
// (see `validate_graph`); `Fault` is a defensive surface for a malformed graph or a value-shape
// mismatch, never expected on the validated path.
//
// `NLoop` is a finite array expression (map/filter/fold): `advance` EVALUATES it as a pure value
// step (source must be a finite array; body is a pure `IrExpr`) and binds the result to the loop's
// `acc` local — no durable boundary, recomputed on replay like any other pure control flow.

// A settled remote-operation result fed into replay: node id -> its canonical JSON result.
pub struct OpResult {
	pub node_id: String,
	pub result_json: String
}

// The outcome of advancing to the next durable boundary.
pub variant StepOutcome {
	NeedOperation(node_id: String, operation: String, input_json: String),   // next unsettled remote op
	Completed(result_json: String),                                          // reached NReturn
	Fault(message: String)                                                   // defensive (validate first)
}

pub fn advance(g: &IrGraph, arguments: &String, settled: &Array<OpResult>) nothrow -> StepOutcome {
	var args_ok = false;
	var args_node = json.new_object().to_node();
	match json.parse_strict(arguments) {
		core.Result::Ok(n) => { args_node = move n; args_ok = true; },
		core.Result::Err(_) => {}
	}
	if !args_ok { return StepOutcome::Fault(message = "arguments are not valid JSON"); }

	var local_names: Array<String> = [];
	var local_vals: Array<json.JsonNode> = [];

	var cur = _dup(&g.entry);
	var steps = 0;
	val budget = g.nodes.len + 4;
	while steps < budget {
		steps = steps + 1;
		val idx = _find_node(g, &cur);
		if idx < 0 { return StepOutcome::Fault(message = "node not found during replay: " + _dup(&cur)); }
		match &g.nodes[idx] {
			IrNode::NReturn(id, value) => {
				match _eval(g, value, &args_node, settled, &local_names, &local_vals) {
					core.Result::Ok(n) => { return StepOutcome::Completed(result_json = _canon_node(&n)); },
					core.Result::Err(e) => { return StepOutcome::Fault(message = e.message); }
				}
			},
			IrNode::NOperation(id, operation, input, next) => {
				match _find_settled(settled, id) {
					Optional::Some(_) => { cur = _dup(next); },   // settled: continue past it
					Optional::None => {
						match _eval(g, input, &args_node, settled, &local_names, &local_vals) {
							core.Result::Ok(n) => { return StepOutcome::NeedOperation(node_id = _dup(id), operation = _dup(operation), input_json = _canon_node(&n)); },
							core.Result::Err(e) => { return StepOutcome::Fault(message = e.message); }
						}
					}
				}
			},
			IrNode::NLet(id, name, value, next) => {
				match _eval(g, value, &args_node, settled, &local_names, &local_vals) {
					core.Result::Ok(n) => { local_names.push(_dup(name)); local_vals.push(move n); cur = _dup(next); },
					core.Result::Err(e) => { return StepOutcome::Fault(message = e.message); }
				}
			},
			IrNode::NIf(id, cond, then_node, else_node) => {
				match _eval(g, cond, &args_node, settled, &local_names, &local_vals) {
					core.Result::Ok(n) => {
						match n.as_bool() {
							Optional::Some(b) => { if b { cur = _dup(then_node); } else { cur = _dup(else_node); } },
							Optional::None => { return StepOutcome::Fault(message = "NIf condition is not a bool"); }
						}
					},
					core.Result::Err(e) => { return StepOutcome::Fault(message = e.message); }
				}
			},
			IrNode::NCase(id, scrutinee, arms, default_node) => {
				match _eval(g, scrutinee, &args_node, settled, &local_names, &local_vals) {
					core.Result::Ok(n) => {
						val v = _canon_node(&n);
						var tgt = _dup(default_node);
						var matched = false;
						var a = 0;
						while a < arms.len {
							if !matched and _str_eq(&arms[a].match_const, &v) { tgt = _dup(&arms[a].target); matched = true; }
							a = a + 1;
						}
						cur = move tgt;
					},
					core.Result::Err(e) => { return StepOutcome::Fault(message = e.message); }
				}
			},
			IrNode::NLoop(id, kind, source, elem, acc, init, body, next) => {
				// Finite array expression: evaluate the source (must be a finite array), run the
				// pure body per element (map/filter/fold), and bind the result to local `acc` — just
				// like an NLet. NO operation seq, NO durable write: a loop is recomputed on replay
				// from the same durable args/results/locals, so it is deterministic.
				match _eval(g, source, &args_node, settled, &local_names, &local_vals) {
					core.Result::Ok(sn) => {
						match sn.as_array() {
							Optional::Some(arr) => {
								match _eval_loop(g, kind, arr, elem, acc, init, body, &args_node, settled, &local_names, &local_vals) {
									core.Result::Ok(rn) => {
										local_names.push(_dup(acc));
										local_vals.push(move rn);
										cur = _dup(next);
									},
									core.Result::Err(e) => { return StepOutcome::Fault(message = e.message); }
								}
							},
							Optional::None => { return StepOutcome::Fault(message = "loop source is not an array: " + _dup(id)); }
						}
					},
					core.Result::Err(e) => { return StepOutcome::Fault(message = e.message); }
				}
			}
		}
	}
	return StepOutcome::Fault(message = "replay step budget exceeded (graph may be cyclic — validate first)");
}

// Evaluate an expression against (durable args, settled results, locals) to a JSON value.
fn _eval(g: &IrGraph, e: &IrExpr, args: &json.JsonNode, settled: &Array<OpResult>,
         lnames: &Array<String>, lvals: &Array<json.JsonNode>) nothrow -> core.Result<json.JsonNode, IrError> {
	match e {
		IrExpr::EConst(canonical_json) => {
			match json.parse_strict(canonical_json) {
				core.Result::Ok(n) => { return core.Result<json.JsonNode, IrError>::Ok(move n); },
				core.Result::Err(_) => { return _ev_err(&"EConst is not valid JSON"); }
			}
		},
		IrExpr::EArg(path) => {
			match _project(args, path) {
				Optional::Some(n) => { return core.Result<json.JsonNode, IrError>::Ok(move n); },
				Optional::None => { return _ev_err(&"EArg path not found"); }
			}
		},
		IrExpr::EResult(node, path) => {
			match _find_settled(settled, node) {
				Optional::Some(rj) => {
					match json.parse_strict(rj) {
						core.Result::Ok(rn) => {
							match _project(&rn, path) {
								Optional::Some(n) => { return core.Result<json.JsonNode, IrError>::Ok(move n); },
								Optional::None => { return _ev_err(&"EResult path not found"); }
							}
						},
						core.Result::Err(_) => { return _ev_err(&"settled result is not valid JSON"); }
					}
				},
				Optional::None => { return _ev_err(&"EResult references an unsettled operation"); }
			}
		},
		IrExpr::ELocal(name, path) => {
			var k = 0;
			while k < lnames.len {
				if _str_eq(&lnames[k], name) {
					match _project(&lvals[k], path) {
						Optional::Some(n) => { return core.Result<json.JsonNode, IrError>::Ok(move n); },
						Optional::None => { return _ev_err(&"ELocal path not found"); }
					}
				}
				k = k + 1;
			}
			return _ev_err(&"ELocal references an unbound local");
		}
	}
}

fn _ev_err(m: &String) nothrow -> core.Result<json.JsonNode, IrError> {
	return core.Result<json.JsonNode, IrError>::Err(IrError(message = _dup(m)));
}

fn _is_filter(k: &LoopKind) nothrow -> Bool {
	match k { LoopKind::LFilter() => { return true; }, default => { return false; } }
}

// Evaluate a finite array expression (map/filter/fold) over `arr`, returning the result value:
//   map    -> array of body results (one per element)
//   filter -> array of the ORIGINAL elements for which the body evaluated to `true`
//   fold   -> the accumulator threaded from `init` through the body (the final value)
// The body is a pure IrExpr evaluated in the OUTER scope augmented with `elem` (the current
// element) and, for fold, `acc` (the running accumulator). No remote dispatch is possible.
fn _eval_loop(g: &IrGraph, kind: &LoopKind, arr: &Array<json.JsonNode>, elem: &String, acc: &String,
              init: &IrExpr, body: &IrExpr, args: &json.JsonNode, settled: &Array<OpResult>,
              outer_names: &Array<String>, outer_vals: &Array<json.JsonNode>) nothrow -> core.Result<json.JsonNode, IrError> {
	val is_fold = _is_fold(kind);
	val is_filter = _is_filter(kind);
	// fold's initial accumulator is `init` evaluated in the OUTER scope (no elem/acc visible).
	var fold_acc = json.JsonNode::Null();
	if is_fold {
		match _eval(g, init, args, settled, outer_names, outer_vals) {
			core.Result::Ok(iv) => { fold_acc = move iv; },
			core.Result::Err(e) => { return core.Result<json.JsonNode, IrError>::Err(IrError(message = e.message)); }
		}
	}
	var out = json.new_array();
	var e = 0;
	while e < arr.len {
		// Body scope = outer locals + element (+ running accumulator for fold). Rebuilt per element
		// (clone_deep of the outer locals) so no element/accumulator slot is mutated in place.
		var bnames: Array<String> = [];
		var bvals: Array<json.JsonNode> = [];
		var k = 0;
		while k < outer_names.len { bnames.push(_dup(&outer_names[k])); bvals.push(outer_vals[k].clone_deep()); k = k + 1; }
		bnames.push(_dup(elem));
		bvals.push(arr[e].clone_deep());
		if is_fold { bnames.push(_dup(acc)); bvals.push(fold_acc.clone_deep()); }
		match _eval(g, body, args, settled, &bnames, &bvals) {
			core.Result::Ok(rv) => {
				if is_fold {
					fold_acc = move rv;
				} else {
					if is_filter {
						match rv.as_bool() {
							Optional::Some(keep) => { if keep { out.push(arr[e].clone_deep()); } },
							Optional::None => { return _ev_err(&"filter body did not evaluate to a bool"); }
						}
					} else {
						out.push(move rv);   // map
					}
				}
			},
			core.Result::Err(e2) => { return core.Result<json.JsonNode, IrError>::Err(IrError(message = e2.message)); }
		}
		e = e + 1;
	}
	if is_fold { return core.Result<json.JsonNode, IrError>::Ok(move fold_acc); }
	return core.Result<json.JsonNode, IrError>::Ok(out.to_node());
}

// Project `path` (object keys; [] = the whole value) into a JSON value, returning an owned copy.
fn _project(node: &json.JsonNode, path: &Array<String>) nothrow -> Optional<json.JsonNode> {
	if path.len == 0 { return Optional<json.JsonNode>::Some(node.clone_deep()); }
	match node.get_path(path) {
		Optional::Some(n) => { return Optional<json.JsonNode>::Some(n.clone_deep()); },
		Optional::None => { return Optional<json.JsonNode>::None(); }
	}
}

fn _find_settled(settled: &Array<OpResult>, id: &String) nothrow -> Optional<&String> {
	var i = 0;
	while i < settled.len {
		if _str_eq(&settled[i].node_id, id) { return Optional<&String>::Some(&settled[i].result_json); }
		i = i + 1;
	}
	return Optional<&String>::None();
}

fn _canon_node(n: &json.JsonNode) nothrow -> String {
	val cfg = json.JsonConfig(key_order = json.JsonKeyOrder::OrderedLexUtf8());
	return json.encode_compact_with_config(n, &cfg);
}

// ===== structural validation (Step 1b(ii) chunk 2: the graph is authoritative) =====
//
// `validate_graph` returns None when the graph is well-formed, or Some(message) on the first
// structural defect. Enforced (a workflow must never execute an ill-formed graph):
//   - at least one node and a unique id per node;
//   - `entry` names an existing node;
//   - every edge (next / branch targets / arm targets / default) targets an existing node;
//   - control flow is ACYCLIC (V1 loops are finite array expressions, NOT back-edges) so replay
//     terminates; every reachable sink is an `NReturn` (valid terminal shape);
//   - every `EResult(node)` names an `NOperation` that DOMINATES the referencing node (always
//     settled before it executes — never a forward/self/cross-branch result reference);
//   - every graph-level `ELocal(name)` is bound by a dominating `NLet` OR a dominating `NLoop`
//     result (`acc`) (loop body exprs may also use the loop's `elem`/`acc`); and
//   - every `NLoop` has a valid finite shape (kind in {map,filter,fold}; result name `acc` is
//     present and distinct from `elem`; map/filter thread no accumulator, so their `init` is the
//     unit null). A loop body is a pure `IrExpr`, so a remote operation inside a loop is
//     structurally impossible — nothing to check.
// Dominance is computed simply (graphs are tiny): X dominates Y iff Y is reachable from `entry`
// but becomes unreachable once X is removed.
pub fn validate_graph(g: &IrGraph) nothrow -> Optional<String> {
	val nn = g.nodes.len;
	if nn == 0 { return Optional<String>::Some("graph has no nodes"); }

	// unique ids
	var i = 0;
	while i < nn {
		var j = i + 1;
		val idi = _node_id(&g.nodes[i]);
		while j < nn {
			val idj = _node_id(&g.nodes[j]);
			if _str_eq(&idi, &idj) { return Optional<String>::Some("duplicate node id: " + _dup(&idi)); }
			j = j + 1;
		}
		i = i + 1;
	}

	// entry exists
	if _find_node(g, &g.entry) < 0 { return Optional<String>::Some("entry node not found: " + _dup(&g.entry)); }

	// every edge targets an existing node
	i = 0;
	while i < nn {
		var succs: Array<String> = [];
		_succs(&g.nodes[i], &mut succs);
		var s = 0;
		while s < succs.len {
			if _find_node(g, &succs[s]) < 0 {
				return Optional<String>::Some("edge target not found: " + _dup(&succs[s]));
			}
			s = s + 1;
		}
		i = i + 1;
	}

	// acyclic control flow (DFS back-edge detection over reachable nodes)
	var color: Array<Int> = [];   // 0=white 1=gray 2=black
	i = 0; while i < nn { color.push(0); i = i + 1; }
	val entry_idx = _find_node(g, &g.entry);
	if _has_cycle(g, entry_idx, &mut color) {
		return Optional<String>::Some("control-flow cycle (loops must be finite array expressions, not back-edges)");
	}

	// reject UNREACHABLE nodes: `graph_canonical` includes every node, so dead code would
	// otherwise affect revision identity while escaping the per-node checks below. Requiring
	// full reachability also means every node is validated.
	val reach = _reachable_without(g, -1);
	i = 0;
	while i < nn {
		if !reach[i] { return Optional<String>::Some("unreachable node: " + _dup(&_node_id(&g.nodes[i]))); }
		i = i + 1;
	}

	// terminal shape: every sink (no successors) must be an NReturn.
	i = 0;
	while i < nn {
		var succs: Array<String> = [];
		_succs(&g.nodes[i], &mut succs);
		if succs.len == 0 and !_is_return(&g.nodes[i]) {
			return Optional<String>::Some("non-terminal node has no successor: " + _dup(&_node_id(&g.nodes[i])));
		}
		i = i + 1;
	}

	// V1: local binding names (NLet names + NLoop result names) are globally UNIQUE. Replay resolves
	// a local by its (single) binding; allowing two same-named dominating binders would make
	// shadowing declaration-order-sensitive.
	match _dup_let_name(g) {
		Optional::Some(nm) => { return Optional<String>::Some("duplicate local binding name: " + move nm); },
		Optional::None => {}
	}

	// per-node: expression ref checks + loop shape + NCase arm checks (all nodes reachable here).
	i = 0;
	while i < nn {
		match _check_node(g, i) {
			Optional::Some(m) => { return Optional<String>::Some(move m); },
			Optional::None => {}
		}
		i = i + 1;
	}

	return Optional<String>::None();
}

// First duplicated local binding name — an NLet name or an NLoop result name (Some(name)), or None.
fn _dup_let_name(g: &IrGraph) nothrow -> Optional<String> {
	var names: Array<String> = [];
	var i = 0;
	while i < g.nodes.len {
		match &g.nodes[i] {
			IrNode::NLet(id, name, value, next) => {
				if _contains_str(&names, name) { return Optional<String>::Some(_dup(name)); }
				names.push(_dup(name));
			},
			IrNode::NLoop(id, kind, source, elem, acc, init, body, next) => {
				if _contains_str(&names, acc) { return Optional<String>::Some(_dup(acc)); }
				names.push(_dup(acc));
			},
			default => {}
		}
		i = i + 1;
	}
	return Optional<String>::None();
}

// First duplicated NCase match_const (Some(const)), or None.
fn _dup_case_const(arms: &Array<IrCaseArm>) nothrow -> Optional<String> {
	var i = 0;
	while i < arms.len {
		var j = i + 1;
		while j < arms.len {
			if _str_eq(&arms[i].match_const, &arms[j].match_const) { return Optional<String>::Some(_dup(&arms[i].match_const)); }
			j = j + 1;
		}
		i = i + 1;
	}
	return Optional<String>::None();
}

// Index of the node with id `id`, or -1.
fn _find_node(g: &IrGraph, id: &String) nothrow -> Int {
	var i = 0;
	while i < g.nodes.len {
		val nid = _node_id(&g.nodes[i]);
		if _str_eq(&nid, id) { return i; }
		i = i + 1;
	}
	return -1;
}

// Append a node's successor ids (control-flow out-edges) to `out`.
fn _succs(n: &IrNode, out: &mut Array<String>) nothrow -> Void {
	match n {
		IrNode::NOperation(id, operation, input, next) => { out.push(_dup(next)); },
		IrNode::NLet(id, name, value, next) => { out.push(_dup(next)); },
		IrNode::NIf(id, cond, then_node, else_node) => { out.push(_dup(then_node)); out.push(_dup(else_node)); },
		IrNode::NCase(id, scrutinee, arms, default_node) => {
			var a = 0;
			while a < arms.len { out.push(_dup(&arms[a].target)); a = a + 1; }
			out.push(_dup(default_node));
		},
		IrNode::NLoop(id, kind, source, elem, acc, init, body, next) => { out.push(_dup(next)); },
		IrNode::NReturn(id, value) => {}
	}
}

fn _is_return(n: &IrNode) nothrow -> Bool {
	match n { IrNode::NReturn(id, value) => { return true; }, default => { return false; } }
}

fn _is_operation(n: &IrNode) nothrow -> Bool {
	match n { IrNode::NOperation(id, operation, input, next) => { return true; }, default => { return false; } }
}

// DFS back-edge detection from `idx` over the (already target-checked) graph.
fn _has_cycle(g: &IrGraph, idx: Int, color: &mut Array<Int>) nothrow -> Bool {
	color[idx] = 1;   // gray
	var succs: Array<String> = [];
	_succs(&g.nodes[idx], &mut succs);
	var s = 0;
	while s < succs.len {
		val t = _find_node(g, &succs[s]);
		if t >= 0 {
			if color[t] == 1 { return true; }              // back-edge into a gray node
			if color[t] == 0 and _has_cycle(g, t, color) { return true; }
		}
		s = s + 1;
	}
	color[idx] = 2;   // black
	return false;
}

// Reachability flags from `entry`, optionally treating node `removed` (index, or -1) as absent
// (used for dominance: X dominates Y iff Y is reachable normally but not with X removed).
fn _reachable_without(g: &IrGraph, removed: Int) nothrow -> Array<Bool> {
	var reach: Array<Bool> = [];
	var i = 0; while i < g.nodes.len { reach.push(false); i = i + 1; }
	val entry_idx = _find_node(g, &g.entry);
	if entry_idx < 0 or entry_idx == removed { return move reach; }
	var work: Array<Int> = [];
	work.push(entry_idx);
	reach[entry_idx] = true;
	var h = 0;
	while h < work.len {
		val cur = work[h];
		h = h + 1;
		var succs: Array<String> = [];
		_succs(&g.nodes[cur], &mut succs);
		var s = 0;
		while s < succs.len {
			val t = _find_node(g, &succs[s]);
			if t >= 0 and t != removed and !reach[t] { reach[t] = true; work.push(t); }
			s = s + 1;
		}
	}
	return move reach;
}

// X (index x) dominates Y (index y): x != y, y reachable, y unreachable once x removed.
fn _dominates(g: &IrGraph, x: Int, y: Int) nothrow -> Bool {
	if x == y { return false; }
	val with = _reachable_without(g, -1);
	if !with[y] { return false; }
	val without = _reachable_without(g, x);
	return !without[y];
}

// True iff some reachable NLet binding `name` dominates node `y`.
fn _has_dominating_let(g: &IrGraph, name: &String, y: Int) nothrow -> Bool {
	var i = 0;
	while i < g.nodes.len {
		match &g.nodes[i] {
			IrNode::NLet(id, lname, value, next) => {
				if _str_eq(lname, name) and _dominates(g, i, y) { return true; }
			},
			default => {}
		}
		i = i + 1;
	}
	return false;
}

// True iff `name` is ANY local binding name in the graph — an NLet name or an NLoop result (`acc`).
// These are exactly the names that can appear in the interpreter's local table at runtime, so a
// loop element sharing one of them would shadow it on some path. Path-INSENSITIVE by design (see
// the loop element-name check): a binder on a non-dominating branch still collides at runtime.
fn _is_binder_name(g: &IrGraph, name: &String) nothrow -> Bool {
	var i = 0;
	while i < g.nodes.len {
		match &g.nodes[i] {
			IrNode::NLet(id, lname, value, next) => { if _str_eq(lname, name) { return true; } },
			IrNode::NLoop(id, kind, source, elem, acc, init, body, next) => { if _str_eq(acc, name) { return true; } },
			default => {}
		}
		i = i + 1;
	}
	return false;
}

// True iff some reachable NLoop whose RESULT binds `name` (its `acc`) dominates node `y` — a loop
// result is a downstream local exactly like an NLet binding.
fn _has_dominating_loop_result(g: &IrGraph, name: &String, y: Int) nothrow -> Bool {
	var i = 0;
	while i < g.nodes.len {
		match &g.nodes[i] {
			IrNode::NLoop(id, kind, source, elem, acc, init, body, next) => {
				if _str_eq(acc, name) and _dominates(g, i, y) { return true; }
			},
			default => {}
		}
		i = i + 1;
	}
	return false;
}

// Validate one node's expressions + (for NLoop) its finite shape.
fn _check_node(g: &IrGraph, idx: Int) nothrow -> Optional<String> {
	var no_locals: Array<String> = [];
	match &g.nodes[idx] {
		IrNode::NOperation(id, operation, input, next) => { return _check_expr(g, input, idx, &no_locals); },
		IrNode::NLet(id, name, value, next) => { return _check_expr(g, value, idx, &no_locals); },
		IrNode::NIf(id, cond, then_node, else_node) => { return _check_expr(g, cond, idx, &no_locals); },
		IrNode::NCase(id, scrutinee, arms, default_node) => {
			// Each arm constant must be valid + canonical (checked FIRST, so the duplicate check
			// below compares canonical forms rather than raw spelling).
			var a = 0;
			while a < arms.len {
				match _check_const(&arms[a].match_const) {
					Optional::Some(m) => { return Optional<String>::Some(move m); },
					Optional::None => {}
				}
				a = a + 1;
			}
			// Reject duplicate arm constants: replay takes the first match while canonical sorts
			// arms by match_const, so duplicates make branch selection ambiguous/order-sensitive.
			match _dup_case_const(arms) {
				Optional::Some(c) => { return Optional<String>::Some("duplicate NCase match_const: " + move c); },
				Optional::None => {}
			}
			return _check_expr(g, scrutinee, idx, &no_locals);
		},
		IrNode::NReturn(id, value) => { return _check_expr(g, value, idx, &no_locals); },
		IrNode::NLoop(id, kind, source, elem, acc, init, body, next) => {
			// The result binds to a downstream local named `acc` (for fold it is ALSO the in-body
			// accumulator). It must be named and distinct from the element binding.
			if acc.byte_length() == 0 { return Optional<String>::Some("loop must name its result binding ('as'): " + _dup(id)); }
			if elem.byte_length() == 0 { return Optional<String>::Some("loop must name its element ('elem'): " + _dup(id)); }
			if _str_eq(elem, acc) { return Optional<String>::Some("loop element and result names must differ: " + _dup(id)); }
			// The element name must NOT collide with ANY local binding name in the graph (NLet name or
			// loop result). V1 forbids shadowing: `_eval` resolves a local by first match over [outer
			// locals, elem, acc], and `local_vals` at runtime holds exactly the NLet/loop-result
			// bindings — so any same-named binder reachable on some path (even one that doesn't
			// DOMINATE the loop, e.g. bound on only one branch) would mask the element, making the
			// body read the OUTER value while validation (extra-locals-first) expects the element.
			// Rejecting against every binder name (not just dominating ones) keeps validation and
			// execution in agreement regardless of path.
			if _is_binder_name(g, elem) {
				return Optional<String>::Some("loop element name collides with a local binding name (rename it): " + _dup(elem));
			}
			val is_fold = _is_fold(kind);
			// map/filter carry NO accumulator to thread: init is unused (the unit null), and the
			// body sees only `elem`. fold threads `acc` from `init` through the body.
			if !is_fold {
				if !_is_const_null(init) { return Optional<String>::Some("map/filter loop init must be null: " + _dup(id)); }
			}
			match _check_expr(g, source, idx, &no_locals) { Optional::Some(m) => { return Optional<String>::Some(move m); }, Optional::None => {} }
			match _check_expr(g, init, idx, &no_locals) { Optional::Some(m) => { return Optional<String>::Some(move m); }, Optional::None => {} }
			// body locals: the element, plus the accumulator for fold.
			var locals: Array<String> = [];
			locals.push(_dup(elem));
			if is_fold { locals.push(_dup(acc)); }
			return _check_expr(g, body, idx, &locals);
		}
	}
}

fn _is_fold(k: &LoopKind) nothrow -> Bool {
	match k { LoopKind::LFold() => { return true; }, default => { return false; } }
}

fn _is_const_null(e: &IrExpr) nothrow -> Bool {
	match e { IrExpr::EConst(canonical_json) => { return _str_eq(canonical_json, &"null"); }, default => { return false; } }
}

// Validate every EResult/ELocal reference inside `e` against node `idx`'s scope. `extra_locals`
// are names additionally in scope (a loop body's element/accumulator).
fn _check_expr(g: &IrGraph, e: &IrExpr, idx: Int, extra_locals: &Array<String>) nothrow -> Optional<String> {
	match e {
		IrExpr::EConst(canonical_json) => { return _check_const(canonical_json); },
		IrExpr::EArg(path) => { return Optional<String>::None(); },
		IrExpr::EResult(node, path) => {
			val t = _find_node(g, node);
			if t < 0 { return Optional<String>::Some("EResult references missing node: " + _dup(node)); }
			if !_is_operation(&g.nodes[t]) { return Optional<String>::Some("EResult must reference an NOperation: " + _dup(node)); }
			if t == idx { return Optional<String>::Some("EResult references its own node: " + _dup(node)); }
			if !_dominates(g, t, idx) { return Optional<String>::Some("EResult references a non-prior operation: " + _dup(node)); }
			return Optional<String>::None();
		},
		IrExpr::ELocal(name, path) => {
			if _contains_str(extra_locals, name) { return Optional<String>::None(); }
			if _has_dominating_let(g, name, idx) { return Optional<String>::None(); }
			if _has_dominating_loop_result(g, name, idx) { return Optional<String>::None(); }
			return Optional<String>::Some("ELocal references an unbound/non-prior local: " + _dup(name));
		}
	}
}

fn _contains_str(xs: &Array<String>, x: &String) nothrow -> Bool {
	var i = 0;
	while i < xs.len { if _str_eq(&xs[i], x) { return true; } i = i + 1; }
	return false;
}

// ===== op-depth (uniform per-path NOperation count) =====
//
// The durable layer assigns each executed operation a sequence number = its EXECUTION POSITION
// (1st op = seq 1, …) and derives finality as `seq == plan_length`. For that to hold under
// branching, EVERY root->NReturn path must traverse the SAME number of NOperation nodes — then
// the final op of any path lands at seq == plan_length. `op_depth` returns that uniform count
// (the runner's plan_length), or Err if paths disagree (an op-unbalanced branch). Assumes a
// graph already accepted by `validate_graph` (acyclic, all nodes reachable, sinks are NReturn).
// depth(node) = number of NOperations strictly before `node`; computed in topological order
// (Kahn) so every predecessor contributes before a node is finalized.
// Per-node op-depth (number of NOperations strictly before each node), in topological order from
// `entry` (Kahn). Unreachable nodes keep depth -1. Err on an op-unbalanced branch (a node reached
// via paths with differing operation counts). The shared core of op_depth / nonfinal_operations.
fn _node_depths(g: &IrGraph) nothrow -> core.Result<Array<Int>, IrError> {
	val nn = g.nodes.len;
	var depth: Array<Int> = [];
	var indeg: Array<Int> = [];
	var i = 0;
	while i < nn { depth.push(-1); indeg.push(0); i = i + 1; }

	i = 0;
	while i < nn {
		var succs: Array<String> = [];
		_succs(&g.nodes[i], &mut succs);
		var s = 0;
		while s < succs.len {
			val t = _find_node(g, &succs[s]);
			if t >= 0 { indeg[t] = indeg[t] + 1; }
			s = s + 1;
		}
		i = i + 1;
	}

	val entry_idx = _find_node(g, &g.entry);
	if entry_idx < 0 { return core.Result<Array<Int>, IrError>::Err(IrError(message = "entry not found")); }

	var queue: Array<Int> = [];
	var qh = 0;
	depth[entry_idx] = 0;
	queue.push(entry_idx);
	while qh < queue.len {
		val u = queue[qh];
		qh = qh + 1;
		var inc = 0;
		if _is_operation(&g.nodes[u]) { inc = 1; }
		val ud = depth[u] + inc;
		var succs: Array<String> = [];
		_succs(&g.nodes[u], &mut succs);
		var s = 0;
		while s < succs.len {
			val v = _find_node(g, &succs[s]);
			if v >= 0 {
				if depth[v] < 0 { depth[v] = ud; }
				else { if depth[v] != ud { return core.Result<Array<Int>, IrError>::Err(IrError(message = "op-unbalanced branch (paths reach a node with differing operation counts)")); } }
				indeg[v] = indeg[v] - 1;
				if indeg[v] == 0 { queue.push(v); }
			}
			s = s + 1;
		}
	}
	return core.Result<Array<Int>, IrError>::Ok(move depth);
}

// plan_length: the uniform NReturn op-depth (all reachable terminals agree), or Err.
pub fn op_depth(g: &IrGraph) nothrow -> core.Result<Int, IrError> {
	var depth: Array<Int> = [];
	match _node_depths(g) {
		core.Result::Ok(d) => { depth = move d; },
		core.Result::Err(e) => { return core.Result<Int, IrError>::Err(IrError(message = e.message)); }
	}
	var pl = -1;
	var i = 0;
	while i < g.nodes.len {
		if depth[i] >= 0 and _is_return(&g.nodes[i]) {
			if pl < 0 { pl = depth[i]; }
			else { if pl != depth[i] { return core.Result<Int, IrError>::Err(IrError(message = "op-unbalanced branch (terminal paths have differing operation counts)")); } }
		}
		i = i + 1;
	}
	if pl < 0 { return core.Result<Int, IrError>::Err(IrError(message = "no reachable terminal")); }
	return core.Result<Int, IrError>::Ok(pl);
}

// Operation NAMES of NOperation nodes that are NON-FINAL — they execute at a position strictly
// before the final one (seq < plan_length) on their (uniform-length) path, so a later operation
// can still fail and trigger reversal. Such operations MUST be compensable; the caller checks each
// against the registry. Err if op-unbalanced (same shape op_depth rejects).
pub fn nonfinal_operations(g: &IrGraph) nothrow -> core.Result<Array<String>, IrError> {
	var depth: Array<Int> = [];
	match _node_depths(g) {
		core.Result::Ok(d) => { depth = move d; },
		core.Result::Err(e) => { return core.Result<Array<String>, IrError>::Err(IrError(message = e.message)); }
	}
	var pl = -1;
	var i = 0;
	while i < g.nodes.len {
		if depth[i] >= 0 and _is_return(&g.nodes[i]) {
			if pl < 0 { pl = depth[i]; }
			else { if pl != depth[i] { return core.Result<Array<String>, IrError>::Err(IrError(message = "op-unbalanced branch (terminal paths have differing operation counts)")); } }
		}
		i = i + 1;
	}
	if pl < 0 { return core.Result<Array<String>, IrError>::Err(IrError(message = "no reachable terminal")); }
	var out: Array<String> = [];
	i = 0;
	while i < g.nodes.len {
		if depth[i] >= 0 {
			match &g.nodes[i] {
				IrNode::NOperation(id, operation, input, next) => {
					// seq = depth + 1; non-final iff seq < plan_length.
					if depth[i] + 1 < pl { out.push(_dup(operation)); }
				},
				default => {}
			}
		}
		i = i + 1;
	}
	return core.Result<Array<String>, IrError>::Ok(move out);
}

// ===== helpers =====

// Number of keys in a declaration object (0 if not an object).
fn _obj_len(node: &json.JsonNode) nothrow -> Int {
	match node.as_object() { Optional::Some(o) => { return o.len(); }, Optional::None => { return 0; } }
}

// A declaration carries exactly its allowed keys; more than `allowed` means an unknown key.
fn _reject_extra(actual: Int, allowed: Int) -> Void {
	if actual > allowed { throw IrError(message = "unknown key in type/field declaration"); }
}

// A `result`/`local` expression object carries exactly `required` plus an OPTIONAL "path" —
// nothing else. A count-only bound (<= 2) would admit {required, <unknown>} when "path" is
// omitted, silently dropping the unknown key. So when two keys are present the second MUST be
// "path"; `required`'s presence is enforced by the caller's _req_str.
fn _reject_unknown_opt_path(n: &json.JsonNode, required: &String) -> Void {
	_reject_extra(_obj_len(n), 2);
	if _obj_len(n) == 2 {
		match n.get(&"path") {
			Optional::Some(_) => {},
			Optional::None => { throw IrError(message = "unknown key in expression (only '" + _dup(required) + "' and 'path' allowed)"); }
		}
	}
}

// A JSON number literal is FLOAT-shaped iff its raw text carries a fractional point or an
// exponent ('.', 'e', or 'E'); otherwise it is integer-shaped. (No numeric coercion: Int and
// Float partition number literals by shape.)
fn _is_float_shaped(raw: &String) nothrow -> Bool {
	var i = 0;
	while i < raw.byte_length() {
		val c = raw.byte_at(i);
		if c == 46 or c == 101 or c == 69 { return true; }   // '.', 'e', 'E'
		i = i + 1;
	}
	return false;
}

fn _is_optional(ty: &IrType) nothrow -> Bool {
	match ty { IrType::TOptional(_) => { return true; }, default => { return false; } }
}

fn _req_str(node: &json.JsonNode, key: &String) -> String {
	match node.get(key) {
		Optional::Some(v) => {
			match v.as_string() {
				Optional::Some(s) => { return move s; },
				Optional::None => { throw IrError(message = "field '" + _dup(key) + "' must be a string"); }
			}
		},
		Optional::None => { throw IrError(message = "missing field '" + _dup(key) + "'"); }
	}
}

// Length-prefix a field name: "{byte_length}:{name};" — so concatenated names can't collide.
fn _lp(s: &String) nothrow -> String {
	return fmt.format_int(s.byte_length()) + ":" + _dup(s) + ";";
}

fn _sort_fields(fields: &mut Array<IrField>) nothrow -> Void {
	// Insertion sort by name (field counts are small).
	var i = 1;
	while i < fields.len {
		var j = i;
		while j > 0 and _str_lt(&fields[j].name, &fields[j - 1].name) {
			fields.swap(j, j - 1);
			j = j - 1;
		}
		i = i + 1;
	}
}

fn _check_no_dup_fields(fields: &Array<IrField>) -> Void {
	var i = 1;
	while i < fields.len {
		if _str_eq(&fields[i].name, &fields[i - 1].name) {
			throw IrError(message = "duplicate object field '" + _dup(&fields[i].name) + "'");
		}
		i = i + 1;
	}
}

fn _str_eq(a: &String, b: &String) nothrow -> Bool {
	if a.byte_length() != b.byte_length() { return false; }
	var i = 0;
	while i < a.byte_length() {
		if a.byte_at(i) != b.byte_at(i) { return false; }
		i = i + 1;
	}
	return true;
}

// Unsigned-byte lexicographic less-than.
fn _str_lt(a: &String, b: &String) nothrow -> Bool {
	val na = a.byte_length();
	val nb = b.byte_length();
	var i = 0;
	while i < na and i < nb {
		val ca = a.byte_at(i);
		val cb = b.byte_at(i);
		if ca < cb { return true; }
		if ca > cb { return false; }
		i = i + 1;
	}
	return na < nb;
}

fn _dup(s: &String) nothrow -> String {
	val n = s.byte_length();
	var buf = io.buffer(n);
	var i = 0;
	while i < n { io.buffer_write(&mut buf, i, s.byte_at(i)); i = i + 1; }
	return core.string_from_utf8_bytes(io.buffer_ptr(&buf), n);
}
