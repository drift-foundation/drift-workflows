// Microflows textual frontend — parser slices 1 + 2a + 2b (straight-line + if/case + let/refs).
//
// This module is a PURE FRONT END: it lowers `.mf` source text into the SAME config the manual IR
// already executes and hashes — a flat `"plan"` (straight-line) or a control-flow `"graph"`
// (if/case/fail), plus `"argument_type"` + per-operation `input_type`/`result_type` contracts — reusing
// the runner's existing `_build_plan` / `parse_graph` / `validate_graph` / `type_check_graph` /
// `content_hash` machinery. Slices 1–2 added NO IR nodes and NO runtime semantics (pure LOWERING
// PARITY — a parser-emitted config and the hand-authored manual config for the same workflow produce
// the identical content_hash and run outcome). Step 5 extended if/case selectors to settled-RESULT /
// LOCAL paths and added the authored `fail` terminal (an `NFail` node); those semantics live in the
// IR — the parser still only LOWERS to config the IR executes + hashes. Branch/case selection comes
// from a path selector over durable args, settled results, or locals.
//
// Composition slice 1a adds the `call <child>@<plan_version> { … } [compensation …]` step, lowered to a
// new `call` graph node (IR `NCallWorkflow`). This is FRONTEND-ONLY: the node parses, validates, hashes,
// and renders, but has no runtime — op-depth/registry build REJECTS a reachable call until slice 1b, and
// `compensation` is build-rejected until slice 1c (`on failed` / `fan` are not parsed yet).
//
// Parse failures are STRUCTURED diagnostics — `ParseError` carries a stable kebab-case `code` + a
// source position (byte_offset/line/column) + optional expected/found (mirroring std.source's and
// drift-web's structured-error convention). `render_diagnostic` formats one for human CLI output
// (code + line/column + a caret excerpt); the runner also emits it as a std.log event.
//
// Surface:
//   args { name: <type>, ... }                  -> the closed-object argument_type
//   op <name> { input: <type>  result: <type> } -> operation input/result CONTRACTS (both optional)
//   steps { <stmt> ... }                         -> the workflow body (>=1 statement)
//   // ... line comments to end of line; /* … */ block comments (C-family; there is NO `#` comment)
//
//   <stmt> := <op> <expr>                                   (an operation step; input is an expression)
//           | let <ident> = <expr>                          (a pure-value binding -> NLet; slice 2b-i)
//           | let <ident> = <op> <expr>                     (a NAMED op; <ident> aliases its RESULT; 2b-ii-a)
//           | let <ident> = <loop>                          (a finite array expression -> NLoop; 2b-iii)
//           | if <selector> { <stmt>* } [ else { <stmt>* } ] [ merge <ident> = <expr> '|' <expr> ]   (selector -> Bool)
//           | case <selector> { (<json-value> { <stmt>* })* default { <stmt>* } } [ merge <ident> = <expr> ('|' <expr>)* ]
//           | fail <reason>                                   (authored terminal failure -> reversal; NFail)
//   <loop> := (map|filter) <expr> each <ident> <expr>       (the body is a pure expr over local <elem>)
//           | fold <expr> from <expr> each <ident> <expr>   (the body is a pure expr over local <elem>/<as>)
//   <expr> := { …json-object… }   (const object) | const <json-value> | arg <arg-path>
//           | local <ident> ('.' <ident>)*    (a let/merge binding ref, optionally projected)
//           | result <ident> ('.' <ident>)*   (a NAMED op's result, optionally projected; 2b-ii-a)
//   <selector> := arg <arg-path> | result <ident>('.'<ident>)* | local <ident>('.'<ident>)* | <arg-path>
//                 (a path expression; a BARE path is `arg`; arg/result/local are reserved selector heads)
//   <reason> := <string-literal> | <string-typed selector>   (a machine-readable String reason code, <=190 bytes)
//   <type> := int | float | bool | string | null
//           | { <ident>: <type>, ... }   (object; trailing/optional commas tolerated)
//           | [ <type> ]                  (array)
//           | <type> ?                    (optional; postfix, repeatable)
//
// if/case lower to operation/if/case/return graph nodes with PRE-ORDER ids ("n0","n1",…); branch
// bodies re-converge at the following statement (the join). Conditions/scrutinees are PATH SELECTORS
// (arg/result/local; a result/local must DOMINATE the branch — settled/bound on every path in, or it
// is rejected at build). The uniform-op-depth rule rejects op-imbalanced RETURN paths; a `fail` path
// may be shorter, and an op at plan_length whose result branches to `fail` is checkpointed (not
// completed) so compensation includes it.
// `result <name>` resolves through a parser symbol table (result-name -> the named op's id) — node
// ids are STABLE under source formatting; cross-branch/undominated refs are rejected by validate_graph.
//
// `merge` is a CONTEXTUAL keyword: after an if/else OR a case it opens a merge clause ONLY when shaped
// `merge <ident> =` (a 2-token lookahead). An operation literally named `merge` (`merge { … }`,
// `merge arg x`, …) is unaffected — its input expression never starts with `<ident> =`.
//
// The `merge` clause selects a branch-local op RESULT at a JOIN (NMerge). ALIAS RULE: result aliases
// are GLOBALLY UNIQUE (the parser symbol table is global), so the merge arms reference DISTINCT
// branch-local result names (`result a | result b | …`); validate_graph enforces that each arm's value
// is available after its predecessor branch and that the merge is TOTAL + UNAMBIGUOUS over its
// incoming edges. Two forms, both lowering to the SAME NMerge:
//   - if-join (2b-ii-b): `if … else … merge n = <then> | <else>` — 2 sources, both branches
//     non-empty + single-exit.
//   - case-join: `case … { arms… default {…} } merge n = <v1> | … | <vN> | <default>` — one source
//     per arm PLUS the default (value list is arm-order with the default LAST; every arm + default
//     non-empty + single-exit). The merge id is allocated AFTER all arm/default bodies (pre-order).
//
// `map`/`filter`/`fold` are contextual keywords in let-RHS position (`let ys = map …`); an op of that
// name is still usable as a bare op step. The loop body is expression-only, so no remote op can appear
// inside iteration (the side-effect-free-loop invariant holds structurally).
//
// This parser — grammar, lowering, AND diagnostics — is entirely LOCAL to this module. It does NOT
// depend on `../drift-lang` or any sibling checkout. If a frontend utility is genuinely worth reusing
// later, it must arrive as a versioned package dependency or explicitly vendored code with local
// ownership in THIS repo (or be requested from the compiler team as a supported package) — never a
// sibling-repo path. (Remaining nicety, same approach: none — the V1 surface + both merge forms land.)
//
// Standalone & dependency-light: imports only std.* plus the runner-owned `ir` (unused at runtime),
// so the unit test compiles it with src/ir.drift, no DB.

module microflows.runner.parser;

import std.core as core;
import std.json as json;
import std.text as text;
import std.format as fmt;
import std.iter as iter;
use trait iter.SinglePassIterator;

export {
	ParseError,
	ContractDecl,
	ParsedWorkflow,
	parse_source,
	lower,
	render_diagnostic
};

// A STRUCTURED parse/lowering failure (developer-facing source diagnostic). `code` is a stable,
// kebab-case, machine-readable identifier (tests pin it); `byte_offset`/`line`/`column` locate the
// offending byte (1-based line/column, column counting UTF-8 scalars — std.source's convention);
// `expected`/`found` carry the relevant tokens when applicable (else ""); `message` is a SHORT human
// description (secondary — wording may change). All fields are SCALAR so a typed `catch ParseError(e)`
// can project them. `render_diagnostic` formats one for human CLI output. (Lowering/config errors that
// have no source position use byte_offset = -1.)
pub error ParseError {
	code: String,
	byte_offset: Int,
	line: Int,
	column: Int,
	expected: String,
	found: String,
	message: String
}

// One operation's declared CONTRACT, lowered to the config type encoding. Both optional: an `op`
// that declares neither input nor result adds no contract (the operation stays unchecked).
pub struct ContractDecl {
	pub name: String,
	pub input_type: Optional<json.JsonNode>,
	pub result_type: Optional<json.JsonNode>
}

// The workflow-level config pieces a `.mf` source lowers to. `body` is EITHER a flat `"plan"`
// array of `{operation, input}` steps (a straight-line workflow — slice 1) OR a control-flow
// `"graph"` object (`{entry, nodes}`) when the source uses `if`/`case` (slice 2a); `is_graph`
// selects the config key. `arg_type` is the closed-object argument_type encoding (None => the
// script declares none); `contracts` overlay input/result types onto the operations registry.
pub struct ParsedWorkflow {
	pub body: json.JsonNode,
	pub is_graph: Bool,
	pub arg_type: Optional<json.JsonNode>,
	pub contracts: Array<ContractDecl>
}

// ----- statement AST (slice 2a: straight-line + if/case) -----
//
// Parsing builds this small tree, assigning each statement node a STABLE pre-order id ("n0","n1",…)
// AT PARSE TIME (source order), so lowering is a single forward pass and the emitted graph ids are
// predictable (the parity tests author the matching hand-written graph against the same scheme).
struct Stmt {
	id: String,
	kind: StmtKind
}
variant StmtKind {
	KOp(name: String, input: json.JsonNode),                                  // an operation step; `input` is an EXPRESSION json
	KNamedOp(bind: String, op: String, input: json.JsonNode),                 // let <bind> = <op> <input> — a NAMED op (result aliased by <bind>); slice 2b-ii-a
	KLet(name: String, value: json.JsonNode),                                 // let <name> = <expr> (a pure-value binding -> NLet)
	KLoop(as_name: String, kind: String, source: json.JsonNode, elem: String, init: Optional<json.JsonNode>, body: json.JsonNode), // let <as> = map/filter/fold … -> NLoop; 2b-iii
	KIf(cond: json.JsonNode, then_body: Array<Stmt>, else_body: Array<Stmt>, merge: Optional<MergeSpec>), // if … else … [merge …] — cond = lowered selector expr
	KCase(scrut: json.JsonNode, arms: Array<SCaseArm>, default_body: Array<Stmt>, merge: Optional<CaseMergeSpec>), // case … [merge …] — scrut = lowered selector expr
	KFail(reason: json.JsonNode),                                             // authored fail — terminal; reason = lowered String expr
	KCall(bind: Optional<String>, child: String, plan_version: String, input: json.JsonNode, comp: Optional<CompRef>), // workflow call — `[let <bind> =] call <child>@<ver> { <input> } [compensation <wf>@<ver>]` (composition slice 1a)
	KReturn(value: json.JsonNode)                                             // `return <expr>` — the value the workflow EXPORTS (composition 1b.0a); terminal. Validated vs the declared return_type.
}
// A parsed `compensation <wf>@<plan_version>` clause on a call (composition slice 1a). PARSED here but
// the IR build REJECTS it until slice 1c — captured so the rejection can name the child + version.
struct CompRef {
	child: String,
	plan_version: String
}
struct SCaseArm {
	match_json: json.JsonNode,
	body: Array<Stmt>
}
// An `if`'s optional trailing `merge <name> = <then-value> | <else-value>` clause (slice 2b-ii-b).
// The merge node (its own pre-order id, allocated AFTER both branches) is the if's JOIN: each branch
// flows into it, and it binds `name` to the value selected by which branch was taken (NMerge).
struct MergeSpec {
	merge_id: String,
	name: String,
	then_value: json.JsonNode,
	else_value: json.JsonNode
}
// A `case`'s optional trailing `merge <name> = <v1> | … | <vN> | <default-value>` clause (the
// case-join form). The merge node (its own pre-order id, allocated AFTER all arm + default bodies) is
// the case's JOIN: every arm AND the default flow into it, and it binds `name` to the value selected by
// which predecessor (arm/default) control arrived from (the same NMerge, just with N sources). `values`
// is parallel to the arms IN SOURCE ORDER, with the DEFAULT value LAST — so `values.len == arms.len+1`.
struct CaseMergeSpec {
	merge_id: String,
	name: String,
	values: Array<json.JsonNode>
}

// ===== public entry points =====

// Parse `.mf` source into its workflow-level config pieces. The structured error is caught HERE
// (where ParseError is a local type) and reconstructed as a movable native value, so callers in
// other modules need no error-type-qualified catch (errors-as-values; mirrors ir.parse_object_type).
pub fn parse_source(source: &String) -> core.Result<ParsedWorkflow, ParseError> {
	var rn0: Array<String> = [];
	var ri0: Array<String> = [];
	var c = Cursor(src = _dup(source), pos = 0, node_count = 0, res_names = move rn0, res_ids = move ri0, open_comment_at = -1);
	val uc_code: String = "unterminated-block-comment";
	val uc_msg: String = "unterminated block comment ('/*' without a closing '*/')";
	val empty: String = "";
	try {
		val pw = _parse(c);
		if c.open_comment_at >= 0 {
			return core.Result<ParsedWorkflow, ParseError>::Err(_finalize(source, uc_code, c.open_comment_at, empty, empty, uc_msg));
		}
		return core.Result<ParsedWorkflow, ParseError>::Ok(move pw);
	} catch ParseError(e) {
		// An unterminated `/*` consumes to EOF, so the parse fails late with a generic error; prefer the
		// precise comment diagnostic when one was recorded. Otherwise fill line/column from the byte
		// offset ONCE here (the source is in scope) and return a movable error value.
		if c.open_comment_at >= 0 {
			return core.Result<ParsedWorkflow, ParseError>::Err(_finalize(source, uc_code, c.open_comment_at, empty, empty, uc_msg));
		}
		return core.Result<ParsedWorkflow, ParseError>::Err(_finalize(source, e.code, e.byte_offset, e.expected, e.found, e.message));
	}
}

// Lower `.mf` source into a COMPLETE runnable config: the `base` deployment config (db +
// participants + operations routing) with `"plan"` + `"argument_type"` set from source and the
// source-declared input/result contracts OVERLAID onto the matching operations. The result is the
// identical config shape the manual IR consumes, so the existing runner path runs it unchanged.
// A `base` without an "operations" registry, or a contract for an operation absent from it, is a
// lowering error (surfaced before any DB/dispatch).
pub fn lower(source: &String, base: &json.JsonNode) -> core.Result<json.JsonNode, ParseError> {
	var rn0: Array<String> = [];
	var ri0: Array<String> = [];
	var c = Cursor(src = _dup(source), pos = 0, node_count = 0, res_names = move rn0, res_ids = move ri0, open_comment_at = -1);
	val uc_code: String = "unterminated-block-comment";
	val uc_msg: String = "unterminated block comment ('/*' without a closing '*/')";
	val empty: String = "";
	try {
		val pw = _parse(c);
		if c.open_comment_at >= 0 {
			return core.Result<json.JsonNode, ParseError>::Err(_finalize(source, uc_code, c.open_comment_at, empty, empty, uc_msg));
		}
		val merged = _merge(base, pw);
		return core.Result<json.JsonNode, ParseError>::Ok(move merged);
	} catch ParseError(e) {
		if c.open_comment_at >= 0 {
			return core.Result<json.JsonNode, ParseError>::Err(_finalize(source, uc_code, c.open_comment_at, empty, empty, uc_msg));
		}
		return core.Result<json.JsonNode, ParseError>::Err(_finalize(source, e.code, e.byte_offset, e.expected, e.found, e.message));
	}
}

// ===== cursor over the source bytes =====

struct Cursor {
	src: String,
	pos: Int,
	node_count: Int,        // pre-order graph-node id allocator (slice 2a)
	res_names: Array<String>,  // source result-name -> op node id (slice 2b-ii-a); parallel arrays
	res_ids: Array<String>,
	open_comment_at: Int    // byte offset of the first unterminated `/*`, or -1 (set by _skip_ws, nothrow)
}

fn _eof(c: &Cursor) nothrow -> Bool { return c.pos >= c.src.byte_length(); }

// Byte at a PROVEN-IN-RANGE index (0.33.88: `byte_at` returns Result — bounds failure is data).
// Every caller below guards with `_eof` / `i < n` FIRST (the cursor invariant), so the Err arm is
// unreachable; it FAILS CLOSED via `assert` (aborts with the message) — the trailing return exists
// only for typing and is never reached.
fn _byte(s: &String, i: Int) nothrow -> Byte {
	match s.byte_at(i) {
		core.Result::Ok(b) => { return b; },
		core.Result::Err(_) => {
			assert(false, "internal: proven-range String.byte_at failed");
			return cast<Byte>(0);   // unreachable: the assert above aborts
		}
	}
}

// Skip whitespace AND comments. Comment syntax is C-family: `//` to end-of-line and `/* … */`
// (non-nesting). There is NO `#` comment. An unterminated `/*` is recorded on the cursor
// (open_comment_at) and surfaced as a precise error by parse_source/lower — `_skip_ws` stays nothrow.
fn _skip_ws(c: &mut Cursor) nothrow -> Void {
	val n = c.src.byte_length();
	while !_eof(c) {
		val b = _byte(c.src, c.pos);
		if text.is_space(b) {
			c.pos = c.pos + 1;
		} else if cast<Int>(b) == 47 {   // '/': maybe a `//` line or `/*` block comment
			if c.pos + 1 < n and cast<Int>(_byte(c.src, c.pos + 1)) == 47 {
				// `//` line comment -> skip to end of line
				c.pos = c.pos + 2;
				while !_eof(c) and cast<Int>(_byte(c.src, c.pos)) != 10 { c.pos = c.pos + 1; }
			} else if c.pos + 1 < n and cast<Int>(_byte(c.src, c.pos + 1)) == 42 {
				// `/* … */` block comment (non-nesting)
				val start = c.pos;
				c.pos = c.pos + 2;
				var closed = false;
				while !_eof(c) {
					if cast<Int>(_byte(c.src, c.pos)) == 42 and c.pos + 1 < n and cast<Int>(_byte(c.src, c.pos + 1)) == 47 {
						c.pos = c.pos + 2;
						closed = true;
						break;
					}
					c.pos = c.pos + 1;
				}
				if !closed {
					if c.open_comment_at < 0 { c.open_comment_at = start; }
					return;
				}
			} else {
				// a lone `/` is not a comment -> let the caller's token read report it
				return;
			}
		} else {
			return;
		}
	}
}

fn _is_ident_start(b: Byte) nothrow -> Bool {
	return text.is_alpha(b) or cast<Int>(b) == 95;   // letter or '_'
}
fn _is_ident_char(b: Byte) nothrow -> Bool {
	return text.is_alnum(b) or cast<Int>(b) == 95 or cast<Int>(b) == 45;   // letter/digit/'_'/'-'
}

// Read an identifier ([A-Za-z_][A-Za-z0-9_-]*) after skipping leading whitespace.
fn _read_ident(c: &mut Cursor) -> String {
	_skip_ws(c);
	if _eof(c) or !_is_ident_start(_byte(c.src, c.pos)) {
		throw ParseError(code = "expected-identifier", byte_offset = c.pos, line = 0, column = 0, expected = "", found = "", message = "expected an identifier");
	}
	val start = c.pos;
	while !_eof(c) and _is_ident_char(_byte(c.src, c.pos)) { c.pos = c.pos + 1; }
	return _slice(c, start, c.pos - start);
}

// Require the next non-whitespace byte to equal `code` (a single-char token); consume it.
fn _expect(c: &mut Cursor, code: Int, what: &String) -> Void {
	_skip_ws(c);
	if _eof(c) or cast<Int>(_byte(c.src, c.pos)) != code {
		throw ParseError(code = "expected-token", byte_offset = c.pos, line = 0, column = 0, expected = _dup(what), found = "", message = "expected " + _dup(what));
	}
	c.pos = c.pos + 1;
}

// Consume the next non-whitespace byte iff it equals `code`; report whether it did.
fn _accept(c: &mut Cursor, code: Int) nothrow -> Bool {
	_skip_ws(c);
	if !_eof(c) and cast<Int>(_byte(c.src, c.pos)) == code { c.pos = c.pos + 1; return true; }
	return false;
}

fn _slice(c: &Cursor, start: Int, len: Int) -> String {
	match text.substring(c.src, start, len) {
		core.Result::Ok(s) => { return move s; },
		core.Result::Err(_) => { throw ParseError(code = "internal", byte_offset = -1, line = 0, column = 0, expected = "", found = "", message = "internal: bad source slice"); }
	}
}

// ===== grammar =====

// file := item* ; item := args_decl | op_decl | steps_decl. Exactly one optional `args`, zero or
// more `op`, exactly one `steps` (required).
fn _parse(c: &mut Cursor) -> ParsedWorkflow {
	var arg_type: Optional<json.JsonNode> = Optional<json.JsonNode>::None();
	var contracts: Array<ContractDecl> = [];
	var body: json.JsonNode = json.new_array().to_node();
	var is_graph = false;
	var seen_args = false;
	var seen_steps = false;

	_skip_ws(c);
	while !_eof(c) {
		val kw_start = c.pos;
		val kw = _read_ident(c);
		if _str_eq(kw, "args") {
			if seen_args { throw ParseError(code = "duplicate-block", byte_offset = kw_start, line = 0, column = 0, expected = "", found = "", message = "duplicate 'args' block"); }
			seen_args = true;
			arg_type = Optional<json.JsonNode>::Some(_parse_object_type(c));
		} else if _str_eq(kw, "op") {
			val cd = _parse_op_decl(c, contracts);
			contracts.push(move cd);
		} else if _str_eq(kw, "steps") {
			if seen_steps { throw ParseError(code = "duplicate-block", byte_offset = kw_start, line = 0, column = 0, expected = "", found = "", message = "duplicate 'steps' block"); }
			seen_steps = true;
			val stmts = _parse_steps(c);
			// A purely straight-line workflow lowers to a flat "plan" (slice-1 output unchanged);
			// any `if`/`case` makes it a control-flow "graph". Both produce config the manual IR
			// already executes + hashes, so identity/parity is preserved either way.
			if _all_plain_ops(stmts) {
				body = _build_plan_body(stmts);
				is_graph = false;
			} else {
				body = _build_graph_body(stmts, c.node_count);
				is_graph = true;
			}
		} else {
			throw ParseError(code = "unknown-keyword", byte_offset = kw_start, line = 0, column = 0, expected = "args/op/steps", found = _dup(kw), message = "unknown top-level keyword '" + _dup(kw) + "'");
		}
		_skip_ws(c);
	}
	if !seen_steps { throw ParseError(code = "missing-steps", byte_offset = c.pos, line = 0, column = 0, expected = "", found = "", message = "missing 'steps' block"); }
	return ParsedWorkflow(body = move body, is_graph = is_graph, arg_type = move arg_type, contracts = move contracts);
}

// type := base ('?')* ; the postfix '?' wraps in an optional encoding (repeatable).
fn _parse_type(c: &mut Cursor) -> json.JsonNode {
	var base = _parse_base_type(c);
	while _accept(c, 63) {   // '?'
		var o = json.new_object();
		o.set("type", _jstr("optional"));
		o.set("inner", move base);
		base = o.to_node();
	}
	return move base;
}

// base := scalar-keyword | object-type | array-type
fn _parse_base_type(c: &mut Cursor) -> json.JsonNode {
	_skip_ws(c);
	if _eof(c) { throw ParseError(code = "expected-type", byte_offset = c.pos, line = 0, column = 0, expected = "", found = "", message = "expected a type"); }
	val b = _byte(c.src, c.pos);
	if cast<Int>(b) == 123 { return _parse_object_type(c); }   // '{'
	if cast<Int>(b) == 91 {                                     // '[' array
		c.pos = c.pos + 1;
		val elem = _parse_type(c);
		_expect(c, 93, "']'");
		var o = json.new_object();
		o.set("type", _jstr("array"));
		o.set("elem", move elem);
		return o.to_node();
	}
	val kw_start = c.pos;
	var kw = _read_ident(c);
	if _str_eq(kw, "int") or _str_eq(kw, "float") or _str_eq(kw, "bool")
	   or _str_eq(kw, "string") or _str_eq(kw, "null") {
		var o = json.new_object();
		o.set("type", _jstr(move kw));
		return o.to_node();
	}
	throw ParseError(code = "unknown-type", byte_offset = kw_start, line = 0, column = 0, expected = "int/float/bool/string/null/{…}/[…]", found = _dup(kw), message = "unknown type '" + _dup(kw) + "'");
}

// object-type := '{' (ident ':' type (','? ident ':' type)* ','?)? '}' — lowered to the config
// `{"type":"object","fields":[{"name","type"}...]}` encoding (parse_type later sorts fields, so
// declaration order is irrelevant to identity).
fn _parse_object_type(c: &mut Cursor) -> json.JsonNode {
	_expect(c, 123, "'{'");
	var fields = json.new_array();
	while !_accept(c, 125) {   // until '}'
		if _eof(c) { throw ParseError(code = "unterminated-type", byte_offset = c.pos, line = 0, column = 0, expected = "", found = "", message = "unterminated object type"); }
		var name = _read_ident(c);
		_expect(c, 58, "':'");
		val fty = _parse_type(c);
		var fo = json.new_object();
		fo.set("name", _jstr(move name));
		fo.set("type", move fty);
		fields.push(fo.to_node());
		val _ = _accept(c, 44);   // optional ','
	}
	var o = json.new_object();
	o.set("type", _jstr("object"));
	o.set("fields", fields.to_node());
	return o.to_node();
}

// op_decl := 'op' ident '{' (('input'|'result') ':' type)* '}'. The leading 'op' is already
// consumed by the caller. Each clause is unique; the op name must be unique across the file.
fn _parse_op_decl(c: &mut Cursor, existing: &Array<ContractDecl>) -> ContractDecl {
	val name_start = c.pos;
	var name = _read_ident(c);
	var i = 0;
	while i < existing.len {
		if _str_eq(existing[i].name, name) { throw ParseError(code = "duplicate-op", byte_offset = name_start, line = 0, column = 0, expected = "", found = "", message = "duplicate 'op' declaration for '" + _dup(name) + "'"); }
		i = i + 1;
	}
	_expect(c, 123, "'{'");
	var input_t: Optional<json.JsonNode> = Optional<json.JsonNode>::None();
	var result_t: Optional<json.JsonNode> = Optional<json.JsonNode>::None();
	var has_input = false;
	var has_result = false;
	while !_accept(c, 125) {   // until '}'
		if _eof(c) { throw ParseError(code = "unterminated-op", byte_offset = c.pos, line = 0, column = 0, expected = "", found = "", message = "unterminated 'op' block for '" + _dup(name) + "'"); }
		val clause_start = c.pos;
		val clause = _read_ident(c);
		_expect(c, 58, "':'");
		if _str_eq(clause, "input") {
			if has_input { throw ParseError(code = "duplicate-clause", byte_offset = clause_start, line = 0, column = 0, expected = "", found = "", message = "duplicate 'input' in op '" + _dup(name) + "'"); }
			has_input = true;
			input_t = Optional<json.JsonNode>::Some(_parse_type(c));
		} else if _str_eq(clause, "result") {
			if has_result { throw ParseError(code = "duplicate-clause", byte_offset = clause_start, line = 0, column = 0, expected = "", found = "", message = "duplicate 'result' in op '" + _dup(name) + "'"); }
			has_result = true;
			result_t = Optional<json.JsonNode>::Some(_parse_type(c));
		} else {
			throw ParseError(code = "unknown-op-clause", byte_offset = clause_start, line = 0, column = 0, expected = "", found = "", message = "unknown op clause '" + _dup(clause) + "' (expected input/result)");
		}
		val _ = _accept(c, 44);   // optional ','
	}
	return ContractDecl(name = move name, input_type = move input_t, result_type = move result_t);
}

// steps := 'steps' '{' (ident json-object)* '}'. The leading 'steps' is already consumed. Each
// step is an operation name followed by a CONSTANT JSON object literal (its request input). The
// JSON object is grabbed as a balanced-brace span and parsed by the strict JSON parser, so the
// emitted plan input is byte-identical in meaning to a hand-authored flat-plan step.
// steps := 'steps' '{' stmt+ '}'. The leading 'steps' is already consumed. At least one statement.
fn _parse_steps(c: &mut Cursor) -> Array<Stmt> {
	_expect(c, 123, "'{'");
	var stmts: Array<Stmt> = [];
	while !_accept(c, 125) {   // until '}'
		if _eof(c) { throw ParseError(code = "unterminated-block", byte_offset = c.pos, line = 0, column = 0, expected = "", found = "", message = "unterminated 'steps' block"); }
		val s = _parse_stmt(c);
		stmts.push(move s);
	}
	if stmts.len == 0 { throw ParseError(code = "empty-steps", byte_offset = c.pos, line = 0, column = 0, expected = "", found = "", message = "'steps' block must declare at least one step"); }
	return move stmts;
}

// block := '{' stmt* '}' (a body for an if/else/case-arm/default — may be empty: control flows
// straight to the join continuation).
fn _parse_block(c: &mut Cursor) -> Array<Stmt> {
	_expect(c, 123, "'{'");
	var stmts: Array<Stmt> = [];
	while !_accept(c, 125) {
		if _eof(c) { throw ParseError(code = "unterminated-block", byte_offset = c.pos, line = 0, column = 0, expected = "", found = "", message = "unterminated block"); }
		val s = _parse_stmt(c);
		stmts.push(move s);
	}
	return move stmts;
}

// stmt := if_stmt | case_stmt | op_step. Each statement is exactly one graph node; its id is
// allocated HERE (pre-order, source order) before parsing any children.
fn _parse_stmt(c: &mut Cursor) -> Stmt {
	val kw = _read_ident(c);
	var id = _alloc_id(c);
	if _str_eq(kw, "if") { return _parse_if(c, move id); }
	if _str_eq(kw, "case") { return _parse_case(c, move id); }
	if _str_eq(kw, "let") { return _parse_let(c, move id); }
	if _str_eq(kw, "fail") { return _parse_fail(c, move id); }
	if _str_eq(kw, "call") { return _parse_call(c, move id, Optional<String>::None()); }
	if _str_eq(kw, "return") { return _parse_return(c, move id); }
	if _str_eq(kw, "fan") { throw ParseError(code = "unsupported-in-release", byte_offset = c.pos, line = 0, column = 0, expected = "", found = "fan", message = "`fan` (fan-out) is not in this release (composition slice 3)"); }
	// op_step: `kw` is the operation name, followed by an INPUT EXPRESSION (a `{…}` const object,
	// or `const`/`arg`/`local` — slice 2b-i). The runtime requires the op input to be an object;
	// a non-object expression is caught by the build-time type check, not here.
	val input = _parse_value_expr(c);
	return Stmt(id = move id, kind = StmtKind::KOp(name = move kw, input = move input));
}

// let_stmt := 'let' ident '=' ( <expr> | <loop> | <op> <expr> ).
//   - RHS an EXPRESSION (a `{…}` object or `const`/`arg`/`local`/`result`) -> a pure-value NLet.
//   - RHS a LOOP (`map`/`filter`/`fold` …) -> a finite array expression NLoop (2b-iii).
//   - RHS an OPERATION call (`<op-name> <input-expr>`) -> a NAMED OPERATION: the op node keeps a
//     parser-generated id, and <bind> aliases its RESULT (referenced downstream as `result <bind>`).
// The disambiguator is the first RHS token: `{`/expr-keyword => expression; map/filter/fold => loop;
// any other identifier => the operation name. (NLet/NLoop are pure value steps; a named op is durable.)
// fail_stmt := 'fail' <reason> — a terminal node that durably enters reversal. <reason> is a STRING
// expression: a string LITERAL (`fail "payment_declined"`) or a path selector (`fail result auth.status`,
// `fail local code`). Non-string / >190 is rejected at type-check/lower (literal) or fails the drive
// deterministically (dynamic). `fail` is a reserved statement keyword (never an operation name).
fn _parse_fail(c: &mut Cursor, var id: String) -> Stmt {
	val reason = _parse_fail_reason(c);
	return Stmt(id = move id, kind = StmtKind::KFail(reason = move reason));
}

// return_stmt := 'return' <expr> — the value the workflow EXPORTS to its caller (composition 1b.0a). A
// TERMINAL statement (like `fail`): no successor; statements after it in the same block are unreachable.
// `<expr>` is any value expression (const / arg / local / result / object / array).
//
// UN-GATED (1b.0a step 6): the durable workflow-return store + atomic final settle + terminal replay
// landed in step 3, and the per-expression structural check (an explicit return's VALUE matching the
// declared `return_type`'s object shape) landed as a step-3 follow-up — both `_registry_build` steps
// this lowering feeds. `return` is no longer parse-rejected; it lowers to `_return_value_node` exactly
// like `fail` lowers to a terminal node. `<expr>` forces `_all_plain_ops` to treat the workflow as a
// control-flow "graph" (a `KReturn` statement never matches the `KOp` arm), so `_merge` always emits a
// real `NReturn(value=<expr>)` — never the flat-plan's auto-generated implicit-unit terminal — whenever
// an explicit `return` appears anywhere in the source. `return` is a reserved statement keyword (never
// an operation name).
fn _parse_return(c: &mut Cursor, var id: String) -> Stmt {
	val value = _parse_value_expr(c);
	return Stmt(id = move id, kind = StmtKind::KReturn(value = move value));
}

fn _parse_fail_reason(c: &mut Cursor) -> json.JsonNode {
	_skip_ws(c);
	if _eof(c) {
		throw ParseError(code = "expected-fail-reason", byte_offset = c.pos, line = 0, column = 0, expected = "", found = "", message = "expected a fail reason (string literal or result/local path)");
	}
	val b = cast<Int>(_byte(c.src, c.pos));
	if b == 34 {   // '"' — a JSON string literal, lowered as a const expression
		val v = _parse_json_value(c);
		var o = json.new_object();
		o.set("const", move v);
		return o.to_node();
	}
	// otherwise a path selector (arg/result/local or bare arg-path), evaluated to a String at drive.
	return _parse_selector(c);
}

fn _parse_let(c: &mut Cursor, var id: String) -> Stmt {
	val bind = _read_ident(c);
	_expect(c, 61, "'='");   // '='
	_skip_ws(c);
	var is_expr = false;
	if !_eof(c) and cast<Int>(_byte(c.src, c.pos)) == 123 { is_expr = true; }   // '{'
	else {
		val w = _peek_ident(c);
		if _is_expr_keyword(w) { is_expr = true; }
	}
	if is_expr {
		val value = _parse_value_expr(c);
		return Stmt(id = move id, kind = StmtKind::KLet(name = move bind, value = move value));
	}
	val w2 = _peek_ident(c);
	if _is_loop_keyword(w2) { return _parse_loop(c, move id, move bind); }
	// workflow call: `let <bind> = call <child>@<ver> { … }` — <bind> aliases the child's RESULT (slice 1a)
	if _str_eq(w2, "call") {
		val _ = _read_ident(c);   // consume 'call'
		return _parse_call(c, move id, Optional<String>::Some(move bind));
	}
	// named operation: `let <bind> = <op-name> <input-expr>`
	val op = _read_ident(c);
	val input = _parse_value_expr(c);
	_res_bind(c, bind, id);   // record <bind> -> this op's node id (rejects a duplicate result name)
	return Stmt(id = move id, kind = StmtKind::KNamedOp(bind = move bind, op = move op, input = move input));
}

// call_stmt := 'call' <child-ident> '@' <plan_version> <input-object> [ 'compensation' <wf-ident> '@' <plan_version> ]
// The leading 'call' is already consumed by the caller. `bind` (Some when `let <x> = call …`) aliases the
// child's RESULT downstream (`result <x>`), recorded in the symbol table AFTER the input/comp parse (so the
// input cannot reference its own result — same discipline as a named op). Composition slice 1a: the grammar
// PARSES `compensation` in full, but the IR build REJECTS it until slice 1c; `on failed` (slice 3) is
// rejected here with a clear "not in this release".
fn _parse_call(c: &mut Cursor, var id: String, var bind: Optional<String>) -> Stmt {
	val child = _read_ident(c);
	_expect(c, 64, "'@'");   // '@'
	val ver = _parse_plan_version(c);
	_skip_ws(c);
	if _eof(c) or cast<Int>(_byte(c.src, c.pos)) != 123 {   // '{'
		throw ParseError(code = "expected-call-input", byte_offset = c.pos, line = 0, column = 0, expected = "{", found = "", message = "`call` requires an input object `{ … }`");
	}
	val input = _parse_value_expr(c);
	var comp: Optional<CompRef> = Optional<CompRef>::None();
	if _accept_keyword(c, "compensation") {
		val cwf = _read_ident(c);
		_expect(c, 64, "'@'");
		val cver = _parse_plan_version(c);
		comp = Optional<CompRef>::Some(CompRef(child = move cwf, plan_version = move cver));
	}
	// `on failed { … }` is a slice-3 form — reject clearly rather than silently leaving it for the next stmt.
	val nxt = _peek_ident(c);
	if _str_eq(nxt, "on") {
		throw ParseError(code = "unsupported-in-release", byte_offset = c.pos, line = 0, column = 0, expected = "", found = "on", message = "`on failed` is not in this release (composition slice 3)");
	}
	match &bind {
		Optional::Some(b) => { _res_bind(c, b, id); },
		Optional::None => {}
	}
	return Stmt(id = move id, kind = StmtKind::KCall(bind = move bind, child = move child, plan_version = move ver, input = move input, comp = move comp));
}

// plan_version := <uint> '.' <uint> '.' <uint> — a semantic version token (major.minor.patch). Leading
// whitespace tolerated; each segment is one or more ASCII digits. (Composition slice 1a.)
fn _parse_plan_version(c: &mut Cursor) -> String {
	val maj = _read_uint_str(c);
	_expect(c, 46, "'.'");   // '.'
	val min = _read_uint_str(c);
	_expect(c, 46, "'.'");   // '.'
	val pat = _read_uint_str(c);
	return maj + "." + min + "." + pat;
}

fn _read_uint_str(c: &mut Cursor) -> String {
	_skip_ws(c);
	if _eof(c) or !_is_digit_b(_byte(c.src, c.pos)) {
		throw ParseError(code = "expected-plan-version", byte_offset = c.pos, line = 0, column = 0, expected = "", found = "", message = "expected a semantic plan version (major.minor.patch)");
	}
	val start = c.pos;
	while !_eof(c) and _is_digit_b(_byte(c.src, c.pos)) { c.pos = c.pos + 1; }
	return _slice(c, start, c.pos - start);
}

fn _is_digit_b(b: Byte) nothrow -> Bool { val v = cast<Int>(b); return v >= 48 and v <= 57; }

fn _is_expr_keyword(w: &String) nothrow -> Bool {
	return _str_eq(w, "const") or _str_eq(w, "arg") or _str_eq(w, "local") or _str_eq(w, "result");
}

fn _is_loop_keyword(w: &String) nothrow -> Bool {
	return _str_eq(w, "map") or _str_eq(w, "filter") or _str_eq(w, "fold");
}

// loop := ('map'|'filter') <source-expr> 'each' <elem> <body-expr>
//       | 'fold' <source-expr> 'from' <init-expr> 'each' <elem> <body-expr>
// A finite array expression (NLoop). The `let` name is the NLoop result binding (`as`). The body is
// a PURE expression over `local <elem>` (and `local <as>` for the fold accumulator) — no remote op
// can appear (it's an expression, not a statement), so iteration is side-effect-free by construction.
fn _parse_loop(c: &mut Cursor, var id: String, var as_name: String) -> Stmt {
	val kind = _read_ident(c);   // map / filter / fold
	val source = _parse_value_expr(c);
	var init: Optional<json.JsonNode> = Optional<json.JsonNode>::None();
	if _str_eq(kind, "fold") {
		if !_accept_keyword(c, "from") { throw ParseError(code = "expected-from", byte_offset = c.pos, line = 0, column = 0, expected = "", found = "", message = "`fold` requires `from <init>`"); }
		init = Optional<json.JsonNode>::Some(_parse_value_expr(c));
	}
	if !_accept_keyword(c, "each") { throw ParseError(code = "expected-each", byte_offset = c.pos, line = 0, column = 0, expected = "", found = "", message = "loop requires `each <elem> <body>`"); }
	val elem = _read_ident(c);
	val body = _parse_value_expr(c);
	return Stmt(id = move id, kind = StmtKind::KLoop(as_name = move as_name, kind = move kind, source = move source, elem = move elem, init = move init, body = move body));
}

// Non-consuming lookahead: true iff the upcoming tokens are `merge <ident> =` (a merge clause). Used
// so that an operation literally named `merge` after an if/else isn't swallowed as a merge clause.
fn _peek_merge_clause(c: &mut Cursor) nothrow -> Bool {
	val save = c.pos;
	val w1 = _peek_ident(c);
	if !_str_eq(w1, "merge") { c.pos = save; return false; }
	// advance past 'merge' (c.pos is at the ident start after _peek_ident's skip_ws)
	while !_eof(c) and _is_ident_char(_byte(c.src, c.pos)) { c.pos = c.pos + 1; }
	val w2 = _peek_ident(c);
	if w2.byte_length() == 0 { c.pos = save; return false; }
	while !_eof(c) and _is_ident_char(_byte(c.src, c.pos)) { c.pos = c.pos + 1; }
	_skip_ws(c);
	val ok = !_eof(c) and cast<Int>(_byte(c.src, c.pos)) == 61;   // '='
	c.pos = save;
	return ok;
}

// Peek the upcoming identifier WITHOUT consuming it (leading whitespace is skipped). Returns "" if
// the next token is not an identifier.
fn _peek_ident(c: &mut Cursor) nothrow -> String {
	_skip_ws(c);
	if _eof(c) or !_is_ident_start(_byte(c.src, c.pos)) { return ""; }
	val start = c.pos;
	var i = c.pos;
	val n = c.src.byte_length();
	while i < n and _is_ident_char(_byte(c.src, i)) { i = i + 1; }
	match text.substring(c.src, start, i - start) {
		core.Result::Ok(s) => { return move s; },
		core.Result::Err(_) => { return ""; }
	}
}

// Record a source result-name -> op node id; a duplicate result-name is rejected (the table can't
// resolve two), keeping `result <name>` unambiguous.
fn _res_bind(c: &mut Cursor, name: &String, id: &String) -> Void {
	var i = 0;
	while i < c.res_names.len {
		if _str_eq(c.res_names[i], name) { throw ParseError(code = "duplicate-result-name", byte_offset = c.pos, line = 0, column = 0, expected = "", found = "", message = "duplicate result name '" + _dup(name) + "'"); }
		i = i + 1;
	}
	c.res_names.push(_dup(name));
	c.res_ids.push(_dup(id));
}

fn _res_lookup(c: &Cursor, name: &String) nothrow -> Optional<String> {
	var i = 0;
	while i < c.res_names.len {
		if _str_eq(c.res_names[i], name) { return Optional<String>::Some(_dup(c.res_ids[i])); }
		i = i + 1;
	}
	return Optional<String>::None();
}

// expr := '{' (key ':' value-expr)* '}'  (object construction; folds to {const} when ALL fields const)
//       | '[' (value-expr)* ']'           (array construction; folds to {const} when ALL elems const)
//       | 'const' <json-value>            (an explicit constant of any JSON shape -> {const: <value>})
//       | 'arg' <arg-path>                (durable argument ref -> {arg: [...]})
//       | 'local' <name> <path>           (a let/loop/merge binding ref -> {local: {name, path?}})
//       | 'result' <name> <path>          (a NAMED op's result -> {result: {node, path?}})
//
// Object/array literals may carry EXPRESSION-valued fields/elements (e.g.
// `{ customer: arg c.id, amount: arg order.amount }`), lowering to {object:…}/{array:…} (EObject/
// EArray). A FULLY-CONSTANT literal folds to {const: …} — byte-identical to the former const-object
// shorthand, so existing content_hashes are unchanged (the IR re-canonicalizes the const anyway).
fn _parse_value_expr(c: &mut Cursor) -> json.JsonNode {
	_skip_ws(c);
	if _eof(c) { throw ParseError(code = "expected-expression", byte_offset = c.pos, line = 0, column = 0, expected = "", found = "", message = "expected an expression"); }
	val b0 = cast<Int>(_byte(c.src, c.pos));
	if b0 == 123 { return _parse_object_construction(c); }   // '{'
	if b0 == 91 { return _parse_array_construction(c); }     // '['
	if !_is_ident_start(_byte(c.src, c.pos)) { throw ParseError(code = "expected-expression", byte_offset = c.pos, line = 0, column = 0, expected = "", found = "", message = "expected an expression"); }
	val kw_start = c.pos;
	val kw = _read_ident(c);
	if _str_eq(kw, "const") {
		val v = _parse_json_value(c);
		var o = json.new_object();
		o.set("const", move v);
		return o.to_node();
	}
	if _str_eq(kw, "arg") {
		val path = _parse_arg_path(c);
		return _arg_expr(path);
	}
	if _str_eq(kw, "local") {
		val segs = _parse_arg_path(c);   // segs[0] = binding name; segs[1..] = projection path
		return _local_expr(segs);
	}
	if _str_eq(kw, "result") {
		val segs = _parse_arg_path(c);   // segs[0] = result name; segs[1..] = projection path
		match _res_lookup(c, segs[0]) {
			Optional::Some(rid) => { return _result_expr(rid, segs); },
			Optional::None => { throw ParseError(code = "unknown-result-name", byte_offset = kw_start, line = 0, column = 0, expected = "", found = "", message = "unknown result name '" + _dup(segs[0]) + "' (declare it with `let <name> = <op> …` before referencing)"); }
		}
	}
	throw ParseError(code = "expected-expression", byte_offset = kw_start, line = 0, column = 0, expected = "", found = "", message = "expected an expression (const / arg / local / result / a {…} object / a […] array), got '" + _dup(kw) + "'");
}

// `{ (key ':' value-expr (',' …)*)? }`. Keys are a JSON string ("k") or a bare identifier (k). Each
// value is a CONSTRUCTION VALUE (nested {…}/[…], an expression keyword, or a bare JSON literal). If
// every field value is constant, folds to {const: {…}} (hash-stable); else emits {object: {…}}.
fn _parse_object_construction(c: &mut Cursor) -> json.JsonNode {
	_expect(c, 123, "'{'");   // '{'
	var keys: Array<String> = [];
	var vals: Array<json.JsonNode> = [];
	_skip_ws(c);
	if !_accept(c, 125) {   // not immediately '}'
		var more = true;
		while more {
			val key = _parse_field_key(c);
			var d = 0;
			while d < keys.len { if _str_eq(keys[d], key) { throw ParseError(code = "duplicate-field", byte_offset = c.pos, line = 0, column = 0, expected = "", found = "", message = "duplicate object field '" + _dup(key) + "'"); } d = d + 1; }
			_expect(c, 58, "':'");   // ':'
			val v = _parse_constr_value(c);
			keys.push(move key);
			vals.push(move v);
			_skip_ws(c);
			if _accept(c, 44) { more = true; }       // ','
			else { _expect(c, 125, "'}'"); more = false; }   // '}'
		}
	}
	var all_const = true;
	var i = 0;
	while i < vals.len { if !_is_const_expr(vals[i]) { all_const = false; } i = i + 1; }
	if all_const {
		var obj = json.new_object();
		var j = 0;
		while j < vals.len { obj.set(_dup(keys[j]), _const_inner(vals[j])); j = j + 1; }
		var o = json.new_object();
		o.set("const", obj.to_node());
		return o.to_node();
	}
	var inner = json.new_object();
	var k = 0;
	while k < vals.len { inner.set(_dup(keys[k]), vals[k].clone_deep()); k = k + 1; }
	var oo = json.new_object();
	oo.set("object", inner.to_node());
	return oo.to_node();
}

// `[ (value-expr (',' …)*)? ]`. Folds to {const: [...]} when every element is constant; else {array: [...]}.
fn _parse_array_construction(c: &mut Cursor) -> json.JsonNode {
	_expect(c, 91, "'['");   // '['
	var vals: Array<json.JsonNode> = [];
	_skip_ws(c);
	if !_accept(c, 93) {   // not immediately ']'
		var more = true;
		while more {
			val v = _parse_constr_value(c);
			vals.push(move v);
			_skip_ws(c);
			if _accept(c, 44) { more = true; }       // ','
			else { _expect(c, 93, "']'"); more = false; }   // ']'
		}
	}
	var all_const = true;
	var i = 0;
	while i < vals.len { if !_is_const_expr(vals[i]) { all_const = false; } i = i + 1; }
	if all_const {
		var arr = json.new_array();
		var j = 0;
		while j < vals.len { arr.push(_const_inner(vals[j])); j = j + 1; }
		var o = json.new_object();
		o.set("const", arr.to_node());
		return o.to_node();
	}
	var inner = json.new_array();
	var k = 0;
	while k < vals.len { inner.push(vals[k].clone_deep()); k = k + 1; }
	var oo = json.new_object();
	oo.set("array", inner.to_node());
	return oo.to_node();
}

// A field/element value: a nested {…}/[…] construction, an expression keyword (const/arg/local/
// result), or a bare JSON literal (string/number/true/false/null) treated as a constant.
fn _parse_constr_value(c: &mut Cursor) -> json.JsonNode {
	_skip_ws(c);
	if _eof(c) { throw ParseError(code = "expected-expression", byte_offset = c.pos, line = 0, column = 0, expected = "", found = "", message = "expected a value"); }
	val b = cast<Int>(_byte(c.src, c.pos));
	if b == 123 { return _parse_object_construction(c); }   // '{'
	if b == 91 { return _parse_array_construction(c); }     // '['
	if _is_ident_start(_byte(c.src, c.pos)) {
		val kw_start = c.pos;
		val kw = _read_ident(c);
		if _str_eq(kw, "const") { val v = _parse_json_value(c); var o = json.new_object(); o.set("const", move v); return o.to_node(); }
		if _str_eq(kw, "arg") { val path = _parse_arg_path(c); return _arg_expr(path); }
		if _str_eq(kw, "local") { val segs = _parse_arg_path(c); return _local_expr(segs); }
		if _str_eq(kw, "result") {
			val segs = _parse_arg_path(c);
			match _res_lookup(c, segs[0]) {
				Optional::Some(rid) => { return _result_expr(rid, segs); },
				Optional::None => { throw ParseError(code = "unknown-result-name", byte_offset = kw_start, line = 0, column = 0, expected = "", found = "", message = "unknown result name '" + _dup(segs[0]) + "'"); }
			}
		}
		if _str_eq(kw, "true") or _str_eq(kw, "false") or _str_eq(kw, "null") {
			match json.parse(kw) {
				core.Result::Ok(n) => { var o = json.new_object(); o.set("const", move n); return o.to_node(); },
				core.Result::Err(_) => { throw ParseError(code = "invalid-json", byte_offset = kw_start, line = 0, column = 0, expected = "", found = "", message = "invalid JSON literal"); }
			}
		}
		throw ParseError(code = "expected-expression", byte_offset = kw_start, line = 0, column = 0, expected = "", found = "", message = "expected a value (const / arg / local / result / {…} / […] / JSON literal), got '" + _dup(kw) + "'");
	}
	// a bare JSON scalar (string / number)
	val v = _parse_json_value(c);
	var o = json.new_object();
	o.set("const", move v);
	return o.to_node();
}

// An object field KEY: a JSON string ("name") or a bare identifier (name).
fn _parse_field_key(c: &mut Cursor) -> String {
	_skip_ws(c);
	if _eof(c) { throw ParseError(code = "expected-field-key", byte_offset = c.pos, line = 0, column = 0, expected = "", found = "", message = "expected an object field name"); }
	if cast<Int>(_byte(c.src, c.pos)) == 34 {   // '"' quoted key
		val v = _parse_json_value(c);
		match v.as_string() {
			Optional::Some(s) => { return move s; },
			Optional::None => { throw ParseError(code = "expected-field-key", byte_offset = c.pos, line = 0, column = 0, expected = "", found = "", message = "object field key must be a string"); }
		}
	}
	if _is_ident_start(_byte(c.src, c.pos)) { return _read_ident(c); }
	throw ParseError(code = "expected-field-key", byte_offset = c.pos, line = 0, column = 0, expected = "", found = "", message = "expected an object field name (identifier or \"string\")");
}

// Is `n` a {const: …} expression node?
fn _is_const_expr(n: &json.JsonNode) nothrow -> Bool {
	match n.get("const") { Optional::Some(_) => { return true; }, Optional::None => { return false; } }
}

// The inner value of a {const: V} node (deep-cloned). Only called when `_is_const_expr` is true.
fn _const_inner(n: &json.JsonNode) -> json.JsonNode {
	match n.get("const") {
		Optional::Some(v) => { return v.clone_deep(); },
		Optional::None => { throw ParseError(code = "internal", byte_offset = -1, line = 0, column = 0, expected = "", found = "", message = "const-fold of a non-const expression"); }
	}
}

// {"result": {"node": <id>, "path"?: [segs[1..]]}}
fn _result_expr(id: &String, segs: &Array<String>) -> json.JsonNode {
	var ro = json.new_object();
	ro.set("node", _jstr(_dup(id)));
	if segs.len > 1 {
		var pa = json.new_array();
		var i = 1;
		while i < segs.len { pa.push(_jstr(_dup(segs[i]))); i = i + 1; }
		ro.set("path", pa.to_node());
	}
	var o = json.new_object();
	o.set("result", ro.to_node());
	return o.to_node();
}

// {"local": {"name": <segs[0]>, "path"?: [segs[1..]]}}
fn _local_expr(segs: &Array<String>) -> json.JsonNode {
	var lo = json.new_object();
	lo.set("name", _jstr(_dup(segs[0])));
	if segs.len > 1 {
		var pa = json.new_array();
		var i = 1;
		while i < segs.len { pa.push(_jstr(_dup(segs[i]))); i = i + 1; }
		lo.set("path", pa.to_node());
	}
	var o = json.new_object();
	o.set("local", lo.to_node());
	return o.to_node();
}

// if_stmt := 'if' selector block ('else' block)? ('merge' ident '=' <expr> '|' <expr>)?
// The condition is a PATH SELECTOR — arg/result/local (a bare path is arg); the runtime requires it
// to be Bool. A branch-local result/local must be merge-carried to dominate the branch. 'else' is
// optional. An
// optional trailing `merge` clause makes the join an NMerge that binds <name> to the then-value (when
// control came from the then-branch) or the else-value (else-branch). Merge requires BOTH branches
// non-empty and ending in a single-exit statement (op/let), so each contributes one merge source.
// A branch selector (if/case) is a PATH expression ONLY: `arg <path>` | `result <name>[.path]` |
// `local <name>[.path]`, or a BARE <arg-path> (= arg, back-compat). NOT an object/array/const — a
// branch tests a scalar path value (`if` -> Bool). Returns the lowered config expr; the IR's
// _check_expr (dominance) then rejects a branch-local result/local that no merge carries.
fn _parse_selector(c: &mut Cursor) -> json.JsonNode {
	_skip_ws(c);
	if _eof(c) or !_is_ident_start(_byte(c.src, c.pos)) {
		throw ParseError(code = "expected-selector", byte_offset = c.pos, line = 0, column = 0, expected = "", found = "", message = "expected a branch selector (arg/result/local path)");
	}
	val save = c.pos;
	val kw = _read_ident(c);
	// A selector KEYWORD (`arg`/`result`/`local`) applies ONLY when a path identifier follows it
	// (`if result auth.status`). If the word stands alone or is dotted (`if result {`, `if result.x`),
	// it is a durable-arg FIELD literally named result/local/arg — fall back to a bare arg-path. This
	// keeps pre-Step-5 scripts using such field names parsing as before.
	if _selector_path_follows(c) {
		if _str_eq(kw, "result") {
			val segs = _parse_arg_path(c);
			match _res_lookup(c, segs[0]) {
				Optional::Some(rid) => { return _result_expr(rid, segs); },
				Optional::None => { throw ParseError(code = "unknown-result-name", byte_offset = save, line = 0, column = 0, expected = "", found = "", message = "unknown result name '" + _dup(segs[0]) + "' (declare it with `let <name> = <op> …` before referencing)"); }
			}
		}
		if _str_eq(kw, "local") { val segs = _parse_arg_path(c); return _local_expr(segs); }
		if _str_eq(kw, "arg") { val path = _parse_arg_path(c); return _arg_expr(path); }
	}
	// bare arg-path (back-compat): rewind and parse the whole dotted path as a durable-arg ref.
	c.pos = save;
	val path = _parse_arg_path(c);
	return _arg_expr(path);
}

// After a selector keyword, does a path identifier follow (so the keyword is a selector head, not an
// arg field literally named arg/result/local)? Peeks past whitespace WITHOUT consuming.
fn _selector_path_follows(c: &mut Cursor) nothrow -> Bool {
	val save = c.pos;
	_skip_ws(c);
	var r = false;
	if !_eof(c) and _is_ident_start(_byte(c.src, c.pos)) { r = true; }
	c.pos = save;
	return r;
}

fn _parse_if(c: &mut Cursor, var id: String) -> Stmt {
	val cond = _parse_selector(c);
	val then_body = _parse_block(c);
	var else_body: Array<Stmt> = [];
	var has_else = false;
	if _accept_keyword(c, "else") { else_body = _parse_block(c); has_else = true; }
	var merge: Optional<MergeSpec> = Optional<MergeSpec>::None();
	// `merge` is a CONTEXTUAL keyword: it opens a merge clause ONLY when shaped `merge <ident> =`.
	// An operation literally named `merge` after an if/else (`merge { … }`, `merge arg x`, …) is NOT
	// that shape (an op input expression never starts with `<ident> =`), so it parses as an op step.
	if _peek_merge_clause(c) {
		val _ = _accept_keyword(c, "merge");
		if !has_else { throw ParseError(code = "merge-requires-else", byte_offset = c.pos, line = 0, column = 0, expected = "", found = "", message = "`merge` requires an `else` branch"); }
		_require_merge_branch(c, then_body, "then");
		_require_merge_branch(c, else_body, "else");
		val mname = _read_ident(c);
		_expect(c, 61, "'='");   // '='
		val then_val = _parse_value_expr(c);
		_expect(c, 124, "'|'");  // '|'
		val else_val = _parse_value_expr(c);
		val mid = _alloc_id(c);   // merge node id — allocated AFTER both branches (pre-order)
		merge = Optional<MergeSpec>::Some(MergeSpec(merge_id = move mid, name = move mname, then_value = move then_val, else_value = move else_val));
	}
	return Stmt(id = move id, kind = StmtKind::KIf(cond = move cond, then_body = move then_body, else_body = move else_body, merge = move merge));
}

// A merge branch must be non-empty and end in a SINGLE-EXIT statement (operation/let), so it
// contributes exactly one immediate predecessor (one merge source). A nested if/case ending a branch
// would create multiple predecessors — out of scope for this minimum form (rejected here).
fn _require_merge_branch(c: &Cursor, body: &Array<Stmt>, which: &String) -> Void {
	if body.len == 0 { throw ParseError(code = "merge-branch-empty", byte_offset = c.pos, line = 0, column = 0, expected = "", found = "", message = "`merge` " + _dup(which) + "-branch must not be empty"); }
	var single = false;
	match &body[body.len - 1].kind {
		StmtKind::KOp(_, _) => { single = true; },
		StmtKind::KNamedOp(_, _, _) => { single = true; },
		StmtKind::KLet(_, _) => { single = true; },
		StmtKind::KCall(_, _, _, _, _) => { single = true; },
		default => {}
	}
	if !single { throw ParseError(code = "merge-branch-not-single-exit", byte_offset = c.pos, line = 0, column = 0, expected = "", found = "", message = "`merge` " + _dup(which) + "-branch must end in an operation or let (not nested if/case)"); }
}

// case_stmt := 'case' selector '{' (json-value block)* 'default' block '}' — the scrutinee is a
// PATH SELECTOR (arg/result/local; bare = arg) over a scalar value; each arm matches a constant JSON
// value; 'default' (required) is taken when no arm matches.
fn _parse_case(c: &mut Cursor, var id: String) -> Stmt {
	val scrut = _parse_selector(c);
	_expect(c, 123, "'{'");
	var arms: Array<SCaseArm> = [];
	var default_body: Array<Stmt> = [];
	var has_default = false;
	while !_accept(c, 125) {
		if _eof(c) { throw ParseError(code = "unterminated-block", byte_offset = c.pos, line = 0, column = 0, expected = "", found = "", message = "unterminated 'case' block"); }
		val arm_start = c.pos;
		if _accept_keyword(c, "default") {
			if has_default { throw ParseError(code = "duplicate-default", byte_offset = arm_start, line = 0, column = 0, expected = "", found = "", message = "duplicate 'default' arm in case"); }
			has_default = true;
			default_body = _parse_block(c);
		} else {
			// `default` must be LAST (grammar: (json-value block)* default block). An arm after it
			// would lower BEFORE the default but read as a fallthrough in source — reject the
			// misleading ordering rather than silently reorder.
			if has_default { throw ParseError(code = "case-arm-after-default", byte_offset = arm_start, line = 0, column = 0, expected = "", found = "", message = "case arm after 'default' (default must be the last arm)"); }
			val mv = _parse_json_value(c);
			val body = _parse_block(c);
			arms.push(SCaseArm(match_json = move mv, body = move body));
		}
	}
	if arms.len == 0 { throw ParseError(code = "case-missing-arm", byte_offset = c.pos, line = 0, column = 0, expected = "", found = "", message = "case must declare at least one arm"); }
	if !has_default { throw ParseError(code = "case-missing-default", byte_offset = c.pos, line = 0, column = 0, expected = "", found = "", message = "case requires a 'default' arm"); }
	// Optional trailing case-JOIN merge: `merge <name> = <v1> | … | <vN> | <default-value>`. Same
	// contextual-keyword lookahead as the if form (`merge <ident> =`), so an op literally named `merge`
	// after a case is unaffected. Each arm AND the default must be a single-exit branch (one merge
	// source apiece), and the value list must be exactly one-per-arm + the default (LAST).
	var merge: Optional<CaseMergeSpec> = Optional<CaseMergeSpec>::None();
	if _peek_merge_clause(c) {
		val _ = _accept_keyword(c, "merge");
		var k = 0;
		while k < arms.len { _require_merge_branch(c, arms[k].body, "case-arm"); k = k + 1; }
		_require_merge_branch(c, default_body, "default");
		val mname = _read_ident(c);
		_expect(c, 61, "'='");   // '='
		var values: Array<json.JsonNode> = [];
		values.push(_parse_value_expr(c));
		while _accept(c, 124) { values.push(_parse_value_expr(c)); }   // '|'-separated
		// One value per arm, plus the default (last). The arm count is fixed by the source above.
		if values.len != arms.len + 1 {
			throw ParseError(code = "case-merge-arity", byte_offset = c.pos, line = 0, column = 0, expected = "", found = "",
				message = "case `merge` needs one value per arm plus the default (" + fmt.format_int(arms.len + 1) + " expected, got " + fmt.format_int(values.len) + ")");
		}
		val mid = _alloc_id(c);   // merge node id — allocated AFTER all arm + default bodies (pre-order)
		merge = Optional<CaseMergeSpec>::Some(CaseMergeSpec(merge_id = move mid, name = move mname, values = move values));
	}
	return Stmt(id = move id, kind = StmtKind::KCase(scrut = move scrut, arms = move arms, default_body = move default_body, merge = move merge));
}

// arg-path := ident ('.' ident)* — a path into the durable arguments (lowered to {"arg":[…]}).
fn _parse_arg_path(c: &mut Cursor) -> Array<String> {
	var path: Array<String> = [];
	val first = _read_ident(c);
	path.push(move first);
	while _accept(c, 46) {   // '.'
		val seg = _read_ident(c);
		path.push(move seg);
	}
	return move path;
}

// Consume the upcoming identifier iff it equals `kw` (else leave the cursor untouched). Lets `else`
// / `default` be recognized WITHOUT being reserved against operation names elsewhere.
fn _accept_keyword(c: &mut Cursor, kw: &String) nothrow -> Bool {
	val save = c.pos;
	_skip_ws(c);
	if _eof(c) or !_is_ident_start(_byte(c.src, c.pos)) { c.pos = save; return false; }
	val start = c.pos;
	while !_eof(c) and _is_ident_char(_byte(c.src, c.pos)) { c.pos = c.pos + 1; }
	var matched = false;
	match text.substring(c.src, start, c.pos - start) {
		core.Result::Ok(s) => { if _str_eq(s, kw) { matched = true; } },
		core.Result::Err(_) => {}
	}
	if !matched { c.pos = save; }
	return matched;
}

// Allocate the next pre-order graph-node id ("n0","n1",…).
fn _alloc_id(c: &mut Cursor) nothrow -> String {
	val id = "n" + fmt.format_int(c.node_count);
	c.node_count = c.node_count + 1;
	return move id;
}

// Parse a CONSTANT JSON value (case-arm match): string / number / bool / null / object / array.
fn _parse_json_value(c: &mut Cursor) -> json.JsonNode {
	_skip_ws(c);
	if _eof(c) { throw ParseError(code = "expected-json-value", byte_offset = c.pos, line = 0, column = 0, expected = "", found = "", message = "expected a JSON value"); }
	val start = c.pos;
	val end = _scan_json_value(c);
	val raw = _slice(c, start, end - start);
	match json.parse(raw) {
		core.Result::Ok(n) => { return move n; },
		core.Result::Err(_) => { throw ParseError(code = "invalid-json", byte_offset = start, line = 0, column = 0, expected = "", found = "", message = "invalid JSON value in case arm 'match'"); }
	}
}

// Scan a single JSON value span from c.pos: a balanced object/array, a string, or a bare token
// (number/true/false/null up to whitespace or a structural byte). Advances the cursor past it.
fn _scan_json_value(c: &mut Cursor) -> Int {
	val b = cast<Int>(_byte(c.src, c.pos));
	if b == 123 or b == 91 { return _scan_balanced(c); }   // '{' or '['
	if b == 34 { return _scan_string(c); }                 // '"'
	val n = c.src.byte_length();
	var i = c.pos;
	while i < n {
		val ch = cast<Int>(_byte(c.src, i));
		if text.is_space(_byte(c.src, i)) or ch == 123 or ch == 125 or ch == 44 or ch == 93 or ch == 91 { break; }
		i = i + 1;
	}
	if i == c.pos { throw ParseError(code = "empty-json-value", byte_offset = c.pos, line = 0, column = 0, expected = "", found = "", message = "empty JSON value"); }
	c.pos = i;
	return i;
}

// Scan a balanced object/array (braces AND brackets), skipping string contents. c.pos is '{' or '['.
fn _scan_balanced(c: &mut Cursor) -> Int {
	val n = c.src.byte_length();
	var i = c.pos;
	var depth = 0;
	var in_str = false;
	var esc = false;
	while i < n {
		val ch = cast<Int>(_byte(c.src, i));
		if in_str {
			if esc { esc = false; }
			else if ch == 92 { esc = true; }
			else if ch == 34 { in_str = false; }
		} else {
			if ch == 34 { in_str = true; }
			else if ch == 123 or ch == 91 { depth = depth + 1; }
			else if ch == 125 or ch == 93 {
				depth = depth - 1;
				if depth == 0 { c.pos = i + 1; return i + 1; }
			}
		}
		i = i + 1;
	}
	throw ParseError(code = "unterminated-json", byte_offset = c.pos, line = 0, column = 0, expected = "", found = "", message = "unterminated JSON value");
}

// Scan a quoted string span (c.pos is the opening '"'), honoring backslash escapes.
fn _scan_string(c: &mut Cursor) -> Int {
	val n = c.src.byte_length();
	var i = c.pos + 1;
	var esc = false;
	while i < n {
		val ch = cast<Int>(_byte(c.src, i));
		if esc { esc = false; }
		else if ch == 92 { esc = true; }
		else if ch == 34 { c.pos = i + 1; return i + 1; }
		i = i + 1;
	}
	throw ParseError(code = "unterminated-string", byte_offset = c.pos, line = 0, column = 0, expected = "", found = "", message = "unterminated string");
}

// ===== lowering the statement AST to a config body =====

// True when every top-level statement is a plain operation whose input is a CONSTANT OBJECT (no
// `let`, no `if`/`case`, no arg/local input). Such a workflow lowers to a flat "plan" (slice-1
// output, byte-for-byte); anything richer lowers to a "graph".
fn _all_plain_ops(stmts: &Array<Stmt>) nothrow -> Bool {
	var i = 0;
	while i < stmts.len {
		var ok = false;
		match &stmts[i].kind {
			StmtKind::KOp(_, input) => { ok = _is_const_object_expr(input); },
			default => {}
		}
		if !ok { return false; }
		i = i + 1;
	}
	return true;
}

// An expression is a const-object iff it is `{const: <object>}` (the bare-`{…}` op-input shorthand).
// `arg`/`local`/`const <non-object>` are not — they force the "graph" lowering.
fn _is_const_object_expr(expr: &json.JsonNode) nothrow -> Bool {
	match expr.get("const") {
		Optional::Some(c) => {
			match c.as_object() { Optional::Some(_) => { return true; }, Optional::None => { return false; } }
		},
		Optional::None => { return false; }
	}
}

// Build a flat "plan" array (straight-line) — identical to slice 1's emission. Each op input is the
// const object UNWRAPPED from its `{const: <obj>}` expression (the plan stores the raw request body).
fn _build_plan_body(stmts: &Array<Stmt>) -> json.JsonNode {
	var plan = json.new_array();
	var i = 0;
	while i < stmts.len {
		match &stmts[i].kind {
			StmtKind::KOp(name, input) => {
				var step = json.new_object();
				step.set("operation", _jstr(_dup(name)));
				match input.get("const") {
					Optional::Some(obj) => { step.set("input", obj.clone_deep()); },
					Optional::None => { throw ParseError(code = "internal", byte_offset = -1, line = 0, column = 0, expected = "", found = "", message = "internal: plan op input is not a const object"); }
				}
				plan.push(step.to_node());
			},
			default => { throw ParseError(code = "internal", byte_offset = -1, line = 0, column = 0, expected = "", found = "", message = "internal: non-operation in straight-line plan"); }
		}
		i = i + 1;
	}
	return plan.to_node();
}

// Build a control-flow "graph" object `{entry, nodes}`. The return node gets the id AFTER all
// statements (node_count); each statement node is emitted with edges to the next sibling / the join.
// Does control reach the implicit exit (the unit `return`) after this statement list? False when the
// last statement is `fail` (or an if/case whose every path is terminal) — then the trailing return
// would be unreachable, which validate_graph rejects, so we omit it.
fn _stmts_fall_through(stmts: &Array<Stmt>) nothrow -> Bool {
	if stmts.len == 0 { return true; }
	return _stmt_falls_through(stmts[stmts.len - 1]);
}

fn _stmt_falls_through(s: &Stmt) nothrow -> Bool {
	match &s.kind {
		StmtKind::KFail(reason) => { return false; },
		StmtKind::KReturn(value) => { return false; },   // terminal: an explicit `return` exports the value (no fall-through)
		StmtKind::KIf(cond, then_body, else_body, merge) => {
			match merge { Optional::Some(ms) => { return true; }, Optional::None => {} }
			if else_body.len == 0 { return true; }   // no else: the false path falls through
			return _stmts_fall_through(then_body) or _stmts_fall_through(else_body);
		},
		StmtKind::KCase(scrut, arms, default_body, merge) => {
			match merge { Optional::Some(cms) => { return true; }, Optional::None => {} }
			if _stmts_fall_through(default_body) { return true; }
			var i = 0;
			while i < arms.len { if _stmts_fall_through(arms[i].body) { return true; } i = i + 1; }
			return false;
		},
		default => { return true; }   // op / named-op / let / loop fall through
	}
}

fn _build_graph_body(stmts: &Array<Stmt>, node_count: Int) -> json.JsonNode {
	val return_id = "n" + fmt.format_int(node_count);
	var nodes = json.new_array();
	// Only emit the implicit return when some path can reach it; an all-terminal body (ends in fail)
	// leaves it unreachable.
	if _stmts_fall_through(stmts) { nodes.push(_return_node(return_id)); }
	_lower_stmts(stmts, return_id, nodes);
	var entry: String = _dup(return_id);
	if stmts.len > 0 { entry = _dup(stmts[0].id); }
	var g = json.new_object();
	g.set("entry", _jstr(move entry));
	g.set("nodes", nodes.to_node());
	return g.to_node();
}

// Lower a statement list whose exit (after the last statement) is `exit_succ`. Each statement's
// successor is the next sibling's entry, or `exit_succ` for the last.
fn _lower_stmts(stmts: &Array<Stmt>, exit_succ: &String, out: &mut json.JsonArray) -> Void {
	var i = 0;
	while i < stmts.len {
		var next_id: String = _dup(exit_succ);
		if i + 1 < stmts.len { next_id = _dup(stmts[i + 1].id); }
		_lower_one(stmts[i], next_id, out);
		i = i + 1;
	}
}

// Emit the node(s) for one statement; branch bodies re-converge at `succ` (the statement's exit).
fn _lower_one(stmt: &Stmt, succ: &String, out: &mut json.JsonArray) -> Void {
	match &stmt.kind {
		StmtKind::KOp(name, input) => {
			out.push(_op_node(stmt.id, name, input, succ));
		},
		StmtKind::KNamedOp(bind, op, input) => {
			// A named op lowers to a plain NOperation; `bind` was only the parse-time result alias.
			out.push(_op_node(stmt.id, op, input, succ));
		},
		StmtKind::KLet(name, value) => {
			out.push(_let_node(stmt.id, name, value, succ));
		},
		StmtKind::KFail(reason) => {
			// Terminal: NFail has no successor (`succ` ignored). Any statement after `fail` in the same
			// block is unreachable; the graph reachability check surfaces it.
			out.push(_fail_node(stmt.id, reason));
		},
		StmtKind::KReturn(value) => {
			// Terminal: an explicit `return <expr>` is an NReturn carrying the exported value (`succ`
			// ignored). Same node kind as the implicit unit terminal, just a non-unit value. Composition 1b.0a.
			out.push(_return_value_node(stmt.id, value));
		},
		StmtKind::KCall(bind, child, plan_version, input, comp) => {
			// A workflow call is one forward step (like a named op); the binder was only the parse-time
			// result alias, so it is not carried into the node. Composition slice 1a.
			val _ = bind;
			out.push(_call_node(stmt.id, child, plan_version, input, comp, succ));
		},
		StmtKind::KLoop(as_name, kind, source, elem, init, body) => {
			out.push(_loop_node(stmt.id, kind, source, elem, as_name, init, body, succ));
		},
		StmtKind::KIf(cond, then_body, else_body, merge) => {
			match merge {
				Optional::Some(ms) => {
					// The MERGE node is the if's join: each branch flows INTO it, and it then flows to
					// `succ`. Source `from` = each branch's last node (its single immediate predecessor).
					val then_entry = _entry_of(then_body, ms.merge_id);
					val else_entry = _entry_of(else_body, ms.merge_id);
					out.push(_if_node(stmt.id, cond, then_entry, else_entry));
					_lower_stmts(then_body, ms.merge_id, out);
					_lower_stmts(else_body, ms.merge_id, out);
					val then_pred = _exit_of(then_body);
					val else_pred = _exit_of(else_body);
					out.push(_merge_node(ms.merge_id, ms.name, then_pred, ms.then_value, else_pred, ms.else_value, succ));
				},
				Optional::None => {
					val then_entry = _entry_of(then_body, succ);
					val else_entry = _entry_of(else_body, succ);
					out.push(_if_node(stmt.id, cond, then_entry, else_entry));
					_lower_stmts(then_body, succ, out);
					_lower_stmts(else_body, succ, out);
				}
			}
		},
		StmtKind::KCase(scrut, arms, default_body, merge) => {
			match merge {
				Optional::Some(cms) => {
					// Case-JOIN: every arm AND the default flow INTO the merge node (their bodies' exit
					// is `merge_id`), and the merge then flows to `succ`. Sources are arm-order then the
					// default LAST — parallel to `cms.values` — each `from` = that body's single exit node.
					var arms_arr = json.new_array();
					var a = 0;
					while a < arms.len {
						val tgt = _entry_of(arms[a].body, cms.merge_id);
						var arm_o = json.new_object();
						arm_o.set("match", arms[a].match_json.clone_deep());
						arm_o.set("target", _jstr(_dup(tgt)));
						arms_arr.push(arm_o.to_node());
						a = a + 1;
					}
					val default_entry = _entry_of(default_body, cms.merge_id);
					out.push(_case_node(stmt.id, scrut, arms_arr.to_node(), default_entry));
					var a2 = 0;
					while a2 < arms.len { _lower_stmts(arms[a2].body, cms.merge_id, out); a2 = a2 + 1; }
					_lower_stmts(default_body, cms.merge_id, out);
					// Predecessors parallel to cms.values: arm exits in order, then the default exit.
					var preds: Array<String> = [];
					var a3 = 0;
					while a3 < arms.len { preds.push(_exit_of(arms[a3].body)); a3 = a3 + 1; }
					preds.push(_exit_of(default_body));
					out.push(_merge_node_multi(cms.merge_id, cms.name, preds, cms.values, succ));
				},
				Optional::None => {
					var arms_arr = json.new_array();
					var a = 0;
					while a < arms.len {
						val tgt = _entry_of(arms[a].body, succ);
						var arm_o = json.new_object();
						arm_o.set("match", arms[a].match_json.clone_deep());
						arm_o.set("target", _jstr(_dup(tgt)));
						arms_arr.push(arm_o.to_node());
						a = a + 1;
					}
					val default_entry = _entry_of(default_body, succ);
					out.push(_case_node(stmt.id, scrut, arms_arr.to_node(), default_entry));
					var a2 = 0;
					while a2 < arms.len { _lower_stmts(arms[a2].body, succ, out); a2 = a2 + 1; }
					_lower_stmts(default_body, succ, out);
				}
			}
		}
	}
}

// The entry id of a body: its first statement's id, or `succ` when the body is empty.
fn _entry_of(body: &Array<Stmt>, succ: &String) nothrow -> String {
	if body.len > 0 { return _dup(body[0].id); }
	return _dup(succ);
}

// The exit id of a NON-EMPTY merge branch: its last statement's node id (the single immediate
// predecessor of the merge). `_require_merge_branch` guarantees non-empty + single-exit.
fn _exit_of(body: &Array<Stmt>) nothrow -> String {
	return _dup(body[body.len - 1].id);
}

// {"kind":"merge","id","name","sources":[{from,value}×2],"next"} — a phi binding `name` to the value
// selected by which predecessor (branch) control arrived from.
fn _merge_node(id: &String, name: &String, then_pred: &String, then_val: &json.JsonNode,
               else_pred: &String, else_val: &json.JsonNode, next: &String) -> json.JsonNode {
	var sources = json.new_array();
	var s0 = json.new_object();
	s0.set("from", _jstr(_dup(then_pred)));
	s0.set("value", then_val.clone_deep());
	sources.push(s0.to_node());
	var s1 = json.new_object();
	s1.set("from", _jstr(_dup(else_pred)));
	s1.set("value", else_val.clone_deep());
	sources.push(s1.to_node());
	var o = json.new_object();
	o.set("kind", _jstr("merge"));
	o.set("id", _jstr(_dup(id)));
	o.set("name", _jstr(_dup(name)));
	o.set("sources", sources.to_node());
	o.set("next", _jstr(_dup(next)));
	return o.to_node();
}

// {"kind":"merge","id","name","sources":[{from,value}×N],"next"} — the N-source phi for a case-join.
// `preds` and `values` are PARALLEL (same length): source k binds `name` to `values[k]` when control
// arrived from predecessor `preds[k]`. Same node shape as `_merge_node`, just N sources instead of 2.
fn _merge_node_multi(id: &String, name: &String, preds: &Array<String>, values: &Array<json.JsonNode>, next: &String) -> json.JsonNode {
	var sources = json.new_array();
	var i = 0;
	while i < preds.len {
		var s = json.new_object();
		s.set("from", _jstr(_dup(preds[i])));
		s.set("value", values[i].clone_deep());
		sources.push(s.to_node());
		i = i + 1;
	}
	var o = json.new_object();
	o.set("kind", _jstr("merge"));
	o.set("id", _jstr(_dup(id)));
	o.set("name", _jstr(_dup(name)));
	o.set("sources", sources.to_node());
	o.set("next", _jstr(_dup(next)));
	return o.to_node();
}

// `input` is already the full input EXPRESSION json ({const:…}/{arg:…}/{local:…}).
fn _op_node(id: &String, name: &String, input: &json.JsonNode, next: &String) -> json.JsonNode {
	var o = json.new_object();
	o.set("kind", _jstr("operation"));
	o.set("id", _jstr(_dup(id)));
	o.set("operation", _jstr(_dup(name)));
	o.set("input", input.clone_deep());
	o.set("next", _jstr(_dup(next)));
	return o.to_node();
}

fn _let_node(id: &String, name: &String, value: &json.JsonNode, next: &String) -> json.JsonNode {
	var o = json.new_object();
	o.set("kind", _jstr("let"));
	o.set("id", _jstr(_dup(id)));
	o.set("name", _jstr(_dup(name)));
	o.set("value", value.clone_deep());
	o.set("next", _jstr(_dup(next)));
	return o.to_node();
}

// {"kind":<map|filter|fold>, "id", "source", "elem", "as":<result name>, ["init",] "body", "next"}.
// `as` is the result binding (and, for fold, also the accumulator); map/filter omit `init` (the IR
// defaults it to the unit null).
fn _loop_node(id: &String, kind: &String, source: &json.JsonNode, elem: &String, as_name: &String,
              init: &Optional<json.JsonNode>, body: &json.JsonNode, next: &String) -> json.JsonNode {
	var o = json.new_object();
	o.set("kind", _jstr(_dup(kind)));
	o.set("id", _jstr(_dup(id)));
	o.set("source", source.clone_deep());
	o.set("elem", _jstr(_dup(elem)));
	o.set("as", _jstr(_dup(as_name)));
	match init { Optional::Some(n) => { o.set("init", n.clone_deep()); }, Optional::None => {} }
	o.set("body", body.clone_deep());
	o.set("next", _jstr(_dup(next)));
	return o.to_node();
}

fn _if_node(id: &String, cond_expr: &json.JsonNode, then_id: &String, else_id: &String) -> json.JsonNode {
	var o = json.new_object();
	o.set("kind", _jstr("if"));
	o.set("id", _jstr(_dup(id)));
	o.set("cond", cond_expr.clone_deep());
	o.set("then", _jstr(_dup(then_id)));
	o.set("else", _jstr(_dup(else_id)));
	return o.to_node();
}

fn _fail_node(id: &String, reason_expr: &json.JsonNode) -> json.JsonNode {
	var o = json.new_object();
	o.set("kind", _jstr("fail"));
	o.set("id", _jstr(_dup(id)));
	o.set("reason", reason_expr.clone_deep());
	return o.to_node();
}

// {"kind":"call","id","child","plan_version","input":<expr>,"next", "compensation":{"child","plan_version"}?}
// The binder is NOT stored (like a named op, it is only the parse-time result alias → this node id;
// downstream `result <bind>` resolves through the symbol table to this id). The `compensation` clause is
// carried so the IR build can REJECT it until slice 1c (parse-but-reject). Composition slice 1a.
fn _call_node(id: &String, child: &String, plan_version: &String, input: &json.JsonNode, comp: &Optional<CompRef>, next: &String) -> json.JsonNode {
	var o = json.new_object();
	o.set("kind", _jstr("call"));
	o.set("id", _jstr(_dup(id)));
	o.set("child", _jstr(_dup(child)));
	o.set("plan_version", _jstr(_dup(plan_version)));
	o.set("input", input.clone_deep());
	o.set("next", _jstr(_dup(next)));
	match comp {
		Optional::Some(cr) => {
			var co = json.new_object();
			co.set("child", _jstr(_dup(cr.child)));
			co.set("plan_version", _jstr(_dup(cr.plan_version)));
			o.set("compensation", co.to_node());
		},
		Optional::None => {}
	}
	return o.to_node();
}

fn _case_node(id: &String, scrut_expr: &json.JsonNode, arms_node: json.JsonNode, default_id: &String) -> json.JsonNode {
	var o = json.new_object();
	o.set("kind", _jstr("case"));
	o.set("id", _jstr(_dup(id)));
	o.set("scrutinee", scrut_expr.clone_deep());
	o.set("arms", move arms_node);
	o.set("default", _jstr(_dup(default_id)));
	return o.to_node();
}

fn _return_node(id: &String) -> json.JsonNode {
	var o = json.new_object();
	o.set("kind", _jstr("return"));
	o.set("id", _jstr(_dup(id)));
	var ce = json.new_object();
	ce.set("const", json.JsonNode::Null());
	o.set("value", ce.to_node());
	return o.to_node();
}

// An explicit `return <expr>` node: the same `{"kind":"return","id","value"}` shape as the implicit unit
// terminal, but carrying the parsed value EXPRESSION (already a {const:…}/{arg:…}/{local:…}/{result:…}/
// {object:…}/{array:…} node). Composition 1b.0a.
fn _return_value_node(id: &String, value: &json.JsonNode) -> json.JsonNode {
	var o = json.new_object();
	o.set("kind", _jstr("return"));
	o.set("id", _jstr(_dup(id)));
	o.set("value", value.clone_deep());
	return o.to_node();
}

// An {"arg": [seg, …]} expression from a parsed argument path.
fn _arg_expr(path: &Array<String>) -> json.JsonNode {
	var arr = json.new_array();
	var i = 0;
	while i < path.len { arr.push(_jstr(_dup(path[i]))); i = i + 1; }
	var o = json.new_object();
	o.set("arg", arr.to_node());
	return o.to_node();
}

// ===== lowering: merge the parsed pieces into the base deployment config =====

fn _merge(base: &json.JsonNode, pw: &ParsedWorkflow) -> json.JsonNode {
	var out = json.new_object();
	var has_ops = false;
	var it = base.entries();
	var done = false;
	while !done {
		match it.next() {
			Optional::Some(entry) => {
				val k = entry.key;
				// We author plan + argument_type ourselves; drop any base "plan"/"graph"/
				// "argument_type" so the lowered config is unambiguously the parsed workflow.
				if _str_eq(k, "plan") or _str_eq(k, "graph") or _str_eq(k, "argument_type") {
				} else if _str_eq(k, "operations") {
					has_ops = true;
					out.set(_dup(k), _overlay_operations(entry.value, pw));
				} else {
					out.set(_dup(k), entry.value.clone_deep());
				}
			},
			Optional::None => { done = true; }
		}
	}
	if !has_ops and pw.contracts.len > 0 {
		throw ParseError(code = "no-operations-registry", byte_offset = -1, line = 0, column = 0, expected = "", found = "", message = "config has no 'operations' registry to attach contracts to");
	}
	// Straight-line lowers to "plan"; an if/case workflow lowers to a control-flow "graph".
	if pw.is_graph {
		out.set("graph", pw.body.clone_deep());
	} else {
		out.set("plan", pw.body.clone_deep());
	}
	match &pw.arg_type {
		Optional::Some(at) => { out.set("argument_type", at.clone_deep()); },
		Optional::None => {}
	}
	// PROVENANCE marker (1b.0a step 6): this config was produced by `.mf` SOURCE lowering, not
	// hand-authored as a raw "graph"/"plan" JSON config. `_registry_build` uses this to apply
	// user-facing strictness that the general-purpose manual-graph testing surface must NOT get (a
	// `.mf` author's explicit non-unit `return <expr>` under an undeclared/unit `returns.type` is a
	// build error there, whereas a hand-authored manual "graph" config keeps the existing
	// compatibility normalization to `{}` — see `_registry_build`'s `mf_source` check). Survives
	// however many process boundaries the emitted config crosses afterward (e.g. `--lower-source`
	// writing it to a file that a LATER, separate process runs) because it is baked into the config
	// itself, not carried as caller context.
	out.set("mf_source", json.JsonNode::Bool(true));
	return out.to_node();
}

// Rebuild the operations array, overlaying each source contract's input/result type onto the
// matching operation entry. A contract whose operation is absent from the registry is a lowering
// error (it would silently vanish, and a dropped contract is absent from content_hash).
fn _overlay_operations(opsnode: &json.JsonNode, pw: &ParsedWorkflow) -> json.JsonNode {
	match opsnode.as_array() {
		Optional::Some(items) => {
			var matched: Array<Bool> = [];
			var ci = 0;
			while ci < pw.contracts.len { matched.push(false); ci = ci + 1; }
			var arr = json.new_array();
			var i = 0;
			while i < items.len {
				val nm = _op_name(items[i]);
				// SOURCE is the sole authority on contracts: strip any input_type/result_type the
				// base routing config might carry, then re-add ONLY the source-declared ones. Without
				// this, a base contract would leak into the emitted config + content_hash, making
				// source identity depend on non-source data (a `op x {}` could inherit a stale type).
				var o = _op_strip_contracts(items[i]);
				val ix = _find_contract(pw, nm);
				if ix >= 0 {
					matched[ix] = true;
					match &pw.contracts[ix].input_type { Optional::Some(t) => { o.set("input_type", t.clone_deep()); }, Optional::None => {} }
					match &pw.contracts[ix].result_type { Optional::Some(t) => { o.set("result_type", t.clone_deep()); }, Optional::None => {} }
				}
				arr.push(o.to_node());
				i = i + 1;
			}
			var k = 0;
			while k < pw.contracts.len {
				if !matched[k] { throw ParseError(code = "unknown-operation", byte_offset = -1, line = 0, column = 0, expected = "", found = "", message = "op '" + _dup(pw.contracts[k].name) + "' declared in source but absent from the operations registry"); }
				k = k + 1;
			}
			return arr.to_node();
		},
		Optional::None => { throw ParseError(code = "operations-not-array", byte_offset = -1, line = 0, column = 0, expected = "", found = "", message = "config 'operations' must be a JSON array"); }
	}
}

fn _op_name(item: &json.JsonNode) -> String {
	match item.get("name") {
		Optional::Some(n) => {
			match n.as_string() { Optional::Some(s) => { return move s; }, Optional::None => { throw ParseError(code = "operation-name-not-string", byte_offset = -1, line = 0, column = 0, expected = "", found = "", message = "operation 'name' must be a string"); } }
		},
		Optional::None => { throw ParseError(code = "operation-missing-name", byte_offset = -1, line = 0, column = 0, expected = "", found = "", message = "operation entry missing 'name'"); }
	}
}

fn _find_contract(pw: &ParsedWorkflow, name: &String) nothrow -> Int {
	var i = 0;
	while i < pw.contracts.len {
		if _str_eq(pw.contracts[i].name, name) { return i; }
		i = i + 1;
	}
	return -1;
}

// Copy an operation entry into a fresh object, DROPPING any input_type/result_type — so the only
// contracts in the emitted config are the source-declared ones re-added by the caller.
fn _op_strip_contracts(item: &json.JsonNode) -> json.JsonObject {
	var o = json.new_object();
	var it = item.entries();
	var done = false;
	while !done {
		match it.next() {
			Optional::Some(entry) => {
				val k = entry.key;
				if _str_eq(k, "input_type") or _str_eq(k, "result_type") {
					// drop: a base contract is not source identity
				} else {
					o.set(_dup(k), entry.value.clone_deep());
				}
			},
			Optional::None => { done = true; }
		}
	}
	return move o;
}

// ===== small helpers =====

fn _jstr(s: String) nothrow -> json.JsonNode { return json.JsonNode::String(value = move s); }

fn _str_eq(a: &String, b: &String) nothrow -> Bool {
	return *a == *b;
}

fn _dup(s: &String) nothrow -> String {
	return s.clone();
}

// ===== structured source diagnostics =====
//
// A parse failure is a STRUCTURED event: a stable kebab-case `code` + a source position
// (`byte_offset`/`line`/`column`, mirroring std.source's convention) + optional `expected`/`found`
// tokens. `message` is a short human description (SECONDARY — wording may change; tests pin the code
// + position, not the prose). All fields are scalar so a typed `catch ParseError(e)` can project them.
// `render_diagnostic` turns one into a human CLI string (with a caret excerpt) at the boundary.

// Fill in 1-based line/column on a thrown ParseError from its `byte_offset` + the original source
// (column counts UTF-8 scalars, not bytes — a non-continuation byte starts a scalar). Throw sites
// carry code + byte_offset + expected/found/message (line/column = 0 placeholders); this runs ONCE at
// the parse boundary. A config/lowering error (byte_offset < 0) keeps line = column = 0.
// Takes the error's SCALAR fields (a typed-catch binder is a read-only view — only scalar fields are
// projectable, so we pass them rather than the binder).
fn _finalize(source: &String, code: &String, off: Int, expected: &String, found: &String, msg: &String) nothrow -> ParseError {
	var line = 0;
	var col = 0;
	if off >= 0 {
		val n = source.byte_length();
		var p = off;
		if p > n { p = n; }
		line = 1;
		var line_start = 0;
		var i = 0;
		while i < p {
			if cast<Int>(_byte(source, i)) == 10 { line = line + 1; line_start = i + 1; }   // '\n'
			i = i + 1;
		}
		col = 1;
		var j = line_start;
		while j < p {
			val b = cast<Int>(_byte(source, j));
			if b < 128 or b >= 192 { col = col + 1; }   // count scalar starts (skip 0b10xxxxxx continuation bytes)
			j = j + 1;
		}
	}
	return ParseError(code = _dup(code), byte_offset = off, line = line, column = col,
	                  expected = _dup(expected), found = _dup(found), message = _dup(msg));
}

// Render a structured ParseError as a human CLI diagnostic: a header line with the code + position,
// then the offending source line and a caret. The `source` is the original `.mf` text.
pub fn render_diagnostic(source: &String, e: &ParseError) nothrow -> String {
	// A NO-POSITION diagnostic (byte_offset < 0 — a config/lowering error, not a `.mf` text location):
	// render just the header, no source excerpt or caret (clamping to byte 0 would be misleading).
	if e.byte_offset < 0 {
		var h = "parse error [" + _dup(e.code) + "]: " + _dup(e.message);
		if e.expected.byte_length() > 0 { h = h + " — expected " + _dup(e.expected); }
		return move h;
	}
	val n = source.byte_length();
	var p = e.byte_offset;
	if p > n { p = n; }
	var line_start = 0;
	var i = 0;
	while i < p {
		if cast<Int>(_byte(source, i)) == 10 { line_start = i + 1; }
		i = i + 1;
	}
	var line_end = line_start;
	while line_end < n and cast<Int>(_byte(source, line_end)) != 10 { line_end = line_end + 1; }
	var excerpt: String = "";
	match text.substring(source, line_start, line_end - line_start) {
		core.Result::Ok(s) => { excerpt = move s; },
		core.Result::Err(_) => {}
	}
	var head = "parse error [" + _dup(e.code) + "]: " + _dup(e.message)
		+ " at line " + fmt.format_int(e.line) + ", column " + fmt.format_int(e.column)
		+ " (byte " + fmt.format_int(e.byte_offset) + ")";
	if e.expected.byte_length() > 0 { head = head + " — expected " + _dup(e.expected); }
	return head + "\n  " + excerpt + "\n  " + _spaces(e.column - 1) + "^";
}

fn _spaces(k: Int) nothrow -> String {
	var s: String = "";
	var i = 0;
	while i < k { s = s + " "; i = i + 1; }
	return move s;
}
