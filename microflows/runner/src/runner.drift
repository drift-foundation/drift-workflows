// Microflows coordinator runner — first dispatch slice (manual IR).
//
// Drives ONE GENERIC operation through the dispatch-gap recovery loop, proving
// the central property without the language frontend:
//
//   persist operation request + suspended continuation (BEFORE dispatch) ->
//   HTTP PUT -> [lost response] -> GET by stable operation id -> persist success
//   + Checkpoint + advanced continuation -> workflow done
//
// The operation is DATA-DRIVEN: its name, input, and pinned schema_version come
// from the persisted request (the durable authority on resume) or, for a fresh
// submission, from --operation/--input. The participant transport is resolved
// from the TRUSTED config registry (participants + operations), never from
// workflow input. Manual IR: workflow `protocol_spike` rev 1, one operation seq.
//
// Two enforced runner requirements:
//   1. on operation_settle AlreadySettled, the returned stored result is
//      AUTHORITATIVE — we use it, never our submitted result.
//   2. on operation_request FenceLost, STOP immediately — do NOT dispatch.
//
// One-shot CLI: runs the slice for one workflow id and prints a result JSON.
//   --config FILE  (db + participants + operations registries)
//   --workflow-id HEX  [--operation NAME (fresh submit only)]  [--input JSON]

module microflows.runner;

import std.core as core;
import std.core.arc as arc;
import std.console as console;
import std.json as json;
import std.format as fmt;
import std.concurrent as conc;
import std.io as io;
import std.cli as cli;
import std.codec as codec;
import std.uuid as uuid;
import std.crypto as crypto;
import microflows.host as mf;
import web.client as client;

const SCRIPT_NAME: String = "protocol_spike";
// Legacy single-op pin (tb_mf_workflow.script_revision); the plan model keys on a
// semantic version instead (PLAN_VERSION_DEFAULT, overridable via config "plan_version").
const SCRIPT_REVISION: Int = 1;
// Default immutable plan version (major.minor.patch) for the configured generation when
// config omits "plan_version". A process loads ONE generation; selection is exact-match.
const PLAN_VERSION_DEFAULT: String = "1.0.0";
const OPERATION_SEQ: Int = 1;
const CHECKPOINT_SEQ: Int = 1;
const LEASE_SECONDS: Int = 30;
// Pending-retry policy (relative): how soon a durably-deferred pending operation
// becomes due again. Independent of LEASE_SECONDS — retry scheduling must NOT be
// coupled to lease duration. The DB clock turns this into an ABSOLUTE deadline.
const PENDING_RETRY_SECONDS: Int = 1;
// Backoff for a durable OPERATIONAL deferral (repairable config state, e.g. a
// pinned binding temporarily unavailable). Longer than the pending poll: we are
// waiting on an operator to repair configuration, not on a remote participant.
const DISPATCH_DEFER_SECONDS: Int = 5;
const PUT_IO_TIMEOUT_MS: Int = 3000;
const RECONCILE_IO_TIMEOUT_MS: Int = 8000;

// microflows.state terminal storage codes.
const STATE_REVERSING: Int = 2;
const STATE_COMPLETED: Int = 4;
const STATE_REVERSED: Int = 5;
const STATE_RESOLVED_EXCEPTION: Int = 6;

pub error RunnerError { message: String }

// A resolved transport target for one operation. The dispatcher depends ONLY on
// this — never on the config JSON shape, the participant registry, or workflow
// input. `base_url` is the endpoint chosen by ordered selection. `participant_id` is
// the LOGICAL participant binding (pinned in the plan hash); endpoint/auth resolution
// stays dynamic.
struct ResolvedOperation {
	operation_name: String,
	schema_version: Int,
	participant_id: String,
	base_url: String
}

// Manual-IR compensation binding: a forward operation's declared REVERSE operation
// (name + pinned schema_version). The reverse INPUT for this slice is the forward
// checkpoint payload (design §6).
struct CompensationBinding {
	op_name: String,
	schema_version: Int
}

// One step of the manual-IR forward PLAN: an operation name (resolved through the
// registry to a participant + pinned schema_version) and the literal input for this
// invocation. The plan is a flat, ordered sequence — no loops or branches. It lives
// in config (the manual IR), so a restarted worker re-derives the same plan and uses
// the durable operation/checkpoint state to decide where to resume.
struct PlanStep {
	operation: String,
	input_json: String
}

// ===== ScriptRegistry (milestone-1: in-process, immutable, manually-built IR) =====
//
// A plan REVISION is the immutable unit a workflow pins, identified by a SEMANTIC
// VERSION (major.minor.patch). Its `content_hash` is a versioned, collision-resistant
// digest (0x01 ‖ SHA-256 over the canonical IR) the runner verifies against the durable
// pin — it never substitutes a different plan. v1 loads ONE configured generation per
// process and selects by EXACT MATCH on (version AND content_hash); semver RANGES,
// multi-version retention, and activation/reload are a future evolution, not built here.
struct ScriptRevision {
	name: String,
	version: String,             // immutable semver: major.minor.patch
	plan: Array<PlanStep>,
	content_hash: Array<Byte>,   // 33 bytes: scheme tag + SHA-256
	plan_length: Int
}

struct ScriptRegistry {
	revisions: Array<ScriptRevision>
}

// The durable pin as the runner carries it past the storage read (item-1 storage-first):
// the workflow's MODE (planned when present) and its pinned identity come from STORAGE,
// not current config. `present=false` means no durable pin (fresh or legacy).
struct PinView {
	present: Bool,
	name: String,
	version: String,
	hash_hex: String,
	plan_length: Int
}

// One step of the reverse loop: Continue (descend to the next checkpoint) or
// Terminal with the process exit code (reversed / deferred / blocked / fenced).
variant CompStep {
	Continue,
	Terminal(exit_code: Int)
}

fn main(argv: Array<String>) nothrow -> Int {
	var p = cli.parser("microflows-runner", "0.1.0", "Microflows coordinator runner (first slice)");
	val _ = p.option_string("config", "c", "FILE", "JSON config: db + participants + operations registries", true);
	val _ = p.option_string("workflow-id", "w", "HEX", "32-hex-char workflow id", true);
	val _ = p.option_string("operation", "o", "NAME", "operation to submit (required ONLY for a fresh workflow; a resume uses the durable request)", false);
	val _ = p.option_string("input", "i", "JSON", "operation input (JSON object; default {}); fresh workflow only", false);

	var config_path: String = "";
	var workflow_hex: String = "";
	var operation_name: String = "";
	var input_json: String = "{}";

	match p.parse(argv) {
		core.Result::Ok(parsed) => {
			match parsed.get_string("config", p) { Some(v) => { config_path = _dup(v); }, None => {} }
			match parsed.get_string("workflow-id", p) { Some(v) => { workflow_hex = _dup(v); }, None => {} }
			match parsed.get_string("operation", p) { Some(v) => { operation_name = _dup(v); }, None => {} }
			match parsed.get_string("input", p) { Some(v) => { input_json = _dup(v); }, None => {} }
		},
		core.Result::Err(_) => {
			console.eprintln("runner: bad arguments");
			return 2;
		}
	}
	if config_path.byte_length() == 0 or workflow_hex.byte_length() != 32 {
		console.eprintln("runner: --config and a 32-hex --workflow-id are required");
		return 2;
	}

	return try _run(&config_path, &workflow_hex, &operation_name, &input_json) catch {
		console.eprintln("runner: fatal");
		1
	};
}

fn _run(config_path: &String, workflow_hex: &String,
        operation_name: &String, input_json: &String) throws -> Int {
	val cfg = _load_config_json(config_path);
	val db_sub = _require_db(&cfg);
	val worker_id = _config_str(&cfg, &"worker_id", "runner-1");

	// NOTE: the participant/operation registry is validated LAZILY — only on a path that
	// actually needs it (fresh create, a claimed forward/reverse dispatch, or the legacy
	// single-op path). It is deliberately NOT validated here so that TERMINAL REPLAY of a
	// completed/planned workflow (which reports from durable state) stays registry- and
	// config-independent.

	val identity = mf.identity_from_worker_name(&worker_id);
	var b = mf.new_host_builder();
	mf.with_json(&mut b, &db_sub);
	mf.with_identity(&mut b, move identity);
	val host = _build_host(move b);

	val workflow_id = _hex_to_bytes(workflow_hex);
	// Derive the operation id from the CANONICAL lowercase hex of the decoded
	// workflow bytes (not the supplied hex spelling), so upper/lower spellings
	// of the same workflow yield the same operation id.
	val workflow_canon_hex = _bytes_to_hex(&workflow_id);

	// STORAGE-FIRST mode selection (static-review item 1): the workflow's MODE
	// (planned vs legacy) and its pinned plan come from the DURABLE pin, NOT from
	// whatever plan the current config happens to carry. So an existing planned
	// workflow whose pinned plan is absent/changed in this generation is still routed
	// to the planned path (→ resolve → revision_unavailable defer), never misrouted to
	// the legacy single-op path. Only a workflow with NO durable pin consults config to
	// decide fresh-planned (config has a plan) vs legacy (no plan).
	var pin = PinView(present = false, name = "", version = "", hash_hex = "", plan_length = 0);
	match host.get().plan_get(&workflow_id) {
		mf.PlanGetOutcome::Found(p) => {
			pin = PinView(present = true, name = _dup(&p.script_name), version = _dup(&p.plan_version),
			              hash_hex = _dup(&p.content_hash), plan_length = p.plan_length);
		},
		mf.PlanGetOutcome::NotFound => {}
	}
	if pin.present {
		return _run_planned(host.get(), &cfg, &workflow_id, &workflow_canon_hex, &pin);
	}
	// No durable pin: fresh-or-legacy. A config "plan" => a fresh PLANNED workflow
	// (_run_planned validates the registry + plan and creates+pins the active
	// generation); otherwise the legacy single-op path below.
	match _build_plan(&cfg) {
		Optional::Some(_) => {
			return _run_planned(host.get(), &cfg, &workflow_id, &workflow_canon_hex, &pin);
		},
		Optional::None => {}
	}

	// Legacy single-op path: validate the registry now (it routes the single dispatch).
	_validate_registry(&cfg);

	// CLI-derived request fields are the DEFAULT for a FRESH workflow. On resume
	// they are replaced by the durable persisted request, which is authoritative
	// — a restarted standalone worker must NOT depend on CLI input.
	var eff_operation_name: String = _dup(operation_name);
	var eff_input_json: String = _dup(input_json);
	var eff_schema_version: Int = 0;
	var operation_id: Array<Byte> = _operation_id(&workflow_canon_hex, OPERATION_SEQ);
	var operation_id_hex: String = _bytes_to_hex(&operation_id);
	var input_hash: String = _input_hash(&eff_input_json);

	// Is this a fresh SUBMISSION (--operation given) or a resume by id alone?
	val fresh: Bool = operation_name.byte_length() > 0;

	// --- pre-claim recovery probe (read-only; takes NO lease). BEST-EFFORT ONLY —
	// NOT authoritative: a request can be persisted between this read and our claim
	// (see the post-claim reload). It lets us skip create for a resume and
	// pre-validate a fresh submission cheaply. ---
	var recovered: Bool = false;
	match host.get().operation_request_get(&workflow_id, OPERATION_SEQ) {
		mf.OperationRequestGetOutcome::Found(rec) => {
			recovered = true;
			eff_operation_name = _dup(&rec.operation_name);
			eff_input_json = _dup(&rec.input_json);
			eff_schema_version = rec.schema_version;
			operation_id = _copy_bytes(&rec.operation_id);
			operation_id_hex = _bytes_to_hex(&operation_id);
			input_hash = _dup(&rec.input_hash);
		},
		mf.OperationRequestGetOutcome::NotFound => {}
	}

	// --- FRESH submission: validate --operation resolves BEFORE create/claim so a
	// bad submission takes no lease and creates no row. A RESUME by id does NOT
	// pre-reject here — its authoritative decision is post-claim, which avoids the
	// race where the durable request lands just after our probe. ---
	var base_url: String = "";
	if fresh and !recovered {
		var ok = false;
		try {
			val r = _resolve_operation(&cfg, &eff_operation_name, Optional<Int>::None());
			eff_schema_version = r.schema_version;
			base_url = _dup(&r.base_url);
			ok = true;
		} catch RunnerError(e) {
			console.eprintln(e.message);
		}
		if !ok {
			console.println("{\"workflow\":\"aborted\",\"reason\":\"operation_unresolvable\"}");
			return 2;
		}
	}

	// --- 1. create workflow — ONLY for a fresh submission. A resume's workflow
	// must already exist; claim_by_id authoritatively returns NotFound otherwise,
	// so a resume-by-id of a non-existent workflow never creates a row. ---
	if fresh {
		val t_create = _now(host.get());
		match host.get().create_workflow(&workflow_id, &SCRIPT_NAME, SCRIPT_REVISION,
		                                 &t_create, &t_create, &"{\"pos\":\"start\"}", &"{}") {
			mf.CreateOutcome::Created => {},
			mf.CreateOutcome::Exists => {}
		}
	}

	// --- 2. claim THIS workflow by id (never a different instance) ---
	val clock = _clock(host.get());
	var fencing_token: Int = 0;
	var claimed_state: Int = 0;
	match host.get().claim_workflow(&workflow_id, &clock.now, &clock.deadline) {
		mf.ClaimByIdOutcome::Claimed(wf) => { fencing_token = wf.fencing_token; claimed_state = wf.state_code; },
		mf.ClaimByIdOutcome::NotFound => {
			if fresh {
				throw RunnerError(message = "workflow absent after create");
			}
			// Resume by id, but the workflow does not exist -> nothing to resume.
			// Authoritative (a non-existent workflow has no in-flight request, so
			// this is NOT the probe race). No lease was taken.
			console.println("{\"workflow\":\"aborted\",\"reason\":\"operation_required\"}");
			return 2;
		},
		mf.ClaimByIdOutcome::NotClaimable => {
			// Not claimable: INSPECT to distinguish terminal / active / deferred.
			return _inspect_report(host.get(), &workflow_id, &operation_id_hex, OPERATION_SEQ);
		}
	}

	// A claimed REVERSING workflow (state 2) drives the compensation UNWIND, not the
	// forward dispatch. claim_by_id claims state IN (1,2); the reverse loop reads the
	// authoritative checkpoint stack (reverse_head), never the continuation.
	if claimed_state == STATE_REVERSING {
		return _run_reversal(host.get(), &cfg, &workflow_id, &workflow_canon_hex, fencing_token);
	}

	// --- 2a. AUTHORITATIVE post-claim reload (closes the probe/claim race). Now
	// that we hold the lease the durable request — if any — is authoritative: a
	// request may have been persisted by another executor between our probe and
	// our claim. Adopting it flips a would-be "fresh" run to a resume so CLI-derived
	// fields cannot drive a spurious operation_conflict, AND prevents a resume-by-id
	// from spuriously aborting operation_required. ---
	match host.get().operation_request_get(&workflow_id, OPERATION_SEQ) {
		mf.OperationRequestGetOutcome::Found(rec) => {
			recovered = true;
			eff_operation_name = _dup(&rec.operation_name);
			eff_input_json = _dup(&rec.input_json);
			eff_schema_version = rec.schema_version;
			operation_id = _copy_bytes(&rec.operation_id);
			operation_id_hex = _bytes_to_hex(&operation_id);
			input_hash = _dup(&rec.input_hash);
		},
		mf.OperationRequestGetOutcome::NotFound => {}
	}

	// --- 2b. Post-claim precondition: claimed, but there is no durable request and
	// no --operation to submit. DURABLY DEFER (lease cleared + audit event) rather
	// than hold the lease — a re-submit with --operation, or a concurrently
	// persisting request, auto-recovers it on the next poll. ---
	if !recovered and !fresh {
		return _defer_dispatch(host.get(), &workflow_id, fencing_token, "operation_request_absent");
	}

	// --- 2c. RESUME resolution, AFTER claim (only when claimable). The durable
	// schema_version is PINNED: the registry binding must still offer exactly that
	// version, else the operation is unresolvable (binding removed or version
	// changed under a persisted request). This is a REPAIRABLE configuration state,
	// not a participant failure — DURABLY DEFER (state stays forward, status stays
	// requested, continuation preserved, lease cleared, an
	// 'operation_dispatch_deferred' audit event with reason
	// pinned_contract_unavailable appended on entry), so restoring config
	// auto-recovers it on the next poll. ---
	if recovered {
		var ok = false;
		try {
			val r = _resolve_operation(&cfg, &eff_operation_name, Optional<Int>::Some(eff_schema_version));
			base_url = _dup(&r.base_url);
			ok = true;
		} catch RunnerError(e) {
			console.eprintln(e.message);
		}
		if !ok {
			return _defer_dispatch(host.get(), &workflow_id, fencing_token, "pinned_contract_unavailable");
		}
	}

	// --- 3. persist operation request + suspended continuation BEFORE dispatch ---
	val t_req = _now(host.get());
	match host.get().operation_request(&workflow_id, fencing_token, OPERATION_SEQ, &operation_id,
	                                   &eff_operation_name, eff_schema_version, &eff_input_json, &input_hash,
	                                   &"{\"pos\":\"op:1:dispatched\",\"operation_seq\":1}", &t_req, &"{}") {
		mf.OperationRequestOutcome::Requested(_) => {},
		mf.OperationRequestOutcome::Exists(_) => {},
		mf.OperationRequestOutcome::FenceLost => {
			// Requirement 2: lost the fence -> STOP, do NOT dispatch.
			console.println("{\"workflow\":\"aborted\",\"reason\":\"request_fence_lost\"}");
			return 3;
		},
		mf.OperationRequestOutcome::OperationConflict => {
			console.println("{\"workflow\":\"aborted\",\"reason\":\"operation_conflict\"}");
			return 3;
		},
		mf.OperationRequestOutcome::EventTimeSkew(defer_until) => {
			// Non-increasing timestamp = clock skew: release/defer until the last
			// accepted event time + margin, don't retry now.
			return _defer(host.get(), &workflow_id, fencing_token, &defer_until, "request_event_time_skew");
		},
		default => {
			throw RunnerError(message = "operation_request unexpected outcome");
		}
	}

	// --- 4/5. dispatch (PUT), classifying the outcome (§5.2). 200 -> result;
	// 202/working or participant-unreachable -> PENDING, durably defer (release
	// the lease) until the next poll, never throw while holding it; 400/409 ->
	// definite rejection (abort, no poll/resubmit); transport/5xx -> reconcile. ---
	var result_json: String = "";
	match _classify_dispatch(&base_url, &eff_operation_name, &operation_id_hex, &eff_input_json) {
		DispatchResult::Done(r) => { result_json = move r; },
		DispatchResult::Pending => {
			// Not terminal yet: release the lease and become due again to re-poll.
			return _defer_pending(host.get(), &workflow_id, fencing_token);
		},
		DispatchResult::Rejected(reason) => {
			// Definite rejection is NON-RETRYABLE: persist the failure (forward ->
			// blocked_resolution, lease cleared) so the workflow stops advancing and
			// cannot repeat after lease expiry. Never exit still forward/requested.
			return _fail_operation(host.get(), &workflow_id, fencing_token, &operation_id, move reason);
		}
	}

	// --- 6. persist success + checkpoint + advanced continuation (workflow done) ---
	val t_settle = _now(host.get());
	var final_result: String = result_json.clone();
	match host.get().operation_settle(&workflow_id, fencing_token, OPERATION_SEQ, &operation_id, CHECKPOINT_SEQ,
	                                  &result_json, &result_json, &"{\"pos\":\"complete\"}", &t_settle, &"{}", true) {
		mf.OperationSettleOutcome::Settled(r) => { final_result = move r; },
		mf.OperationSettleOutcome::AlreadySettled(r) => {
			// Requirement 1: the stored result is AUTHORITATIVE.
			final_result = move r;
		},
		mf.OperationSettleOutcome::FenceLost => {
			console.println("{\"workflow\":\"aborted\",\"reason\":\"settle_fence_lost\"}");
			return 3;
		},
		mf.OperationSettleOutcome::EventTimeSkew(defer_until) => {
			return _defer(host.get(), &workflow_id, fencing_token, &defer_until, "settle_event_time_skew");
		},
		default => {
			throw RunnerError(message = "operation_settle unexpected outcome");
		}
	}

	console.println("{\"workflow\":\"completed\",\"operation_id\":\"" + operation_id_hex + "\",\"result\":" + final_result + "}");
	return 0;
}

// ===== manual-IR forward PLAN execution (multi-operation) =====

// Run a workflow whose forward path is a manual-IR PLAN, loading the IR from the
// ScriptRegistry by the workflow's PINNED plan. State-sensitive ordering: the DURABLE
// pin was read STORAGE-FIRST by the caller; a FRESH submission validates+builds the
// registry to create+pin the active generation; then claim. TERMINAL REPLAY (a
// NotClaimable existing workflow) reports from durable state and is RESOLVED BEFORE the
// registry is ever built or validated — so a completed workflow replays its result even
// when current participant/operation config is absent or malformed. Only a CLAIMED
// workflow builds+validates the registry to resolve+verify its pinned plan; a claimed
// REVERSING workflow unwinds instead.
fn _run_planned(host: &mf.MicroflowsHost, cfg: &json.JsonNode, workflow_id: &Array<Byte>,
                workflow_canon_hex: &String, storage_pin: &PinView) -> Int {
	var pin_name: String = _dup(&storage_pin.name);
	var pin_version: String = _dup(&storage_pin.version);
	var pin_hash_hex: String = _dup(&storage_pin.hash_hex);
	var pin_len: Int = storage_pin.plan_length;

	// The registry is built LAZILY — never before terminal replay. `reg_ready` tracks
	// whether `reg` holds the validated generation.
	var reg_empty: Array<ScriptRevision> = [];
	var reg = ScriptRegistry(revisions = move reg_empty);
	var reg_ready = false;

	// 1. ABSENT -> fresh submission: validate + build the registry (a fresh submit
	//    legitimately requires valid config) and create + pin the ACTIVE generation. The
	//    create RESOLVES THE RACE — a concurrent creator that won returns the WINNING
	//    durable pin (Exists), which we adopt verbatim and then exact-match-resolve below.
	if !storage_pin.present {
		_validate_registry(cfg);
		_validate_plan(cfg);
		reg = _registry_build(cfg);
		reg_ready = true;
		// Resolve the active generation by the CONFIGURED plan name (not a constant), so
		// any configured name (e.g. checkout-v1) can create workflows.
		val active_name = _config_str(cfg, &"script_name", _dup(&SCRIPT_NAME));
		var has_active = false;
		var aidx = 0;
		match _registry_active(&reg, &active_name) { Optional::Some(i) => { aidx = i; has_active = true; }, Optional::None => {} }
		if !has_active {
			console.println("{\"workflow\":\"aborted\",\"reason\":\"no_active_revision\"}");
			return 2;
		}
		val t_create = _now(host);
		match host.create_planned(workflow_id, &reg.revisions[aidx].name, &reg.revisions[aidx].version,
		                          &t_create, &t_create, &"{\"pos\":\"start\"}", &"{}",
		                          &reg.revisions[aidx].content_hash, reg.revisions[aidx].plan_length) {
			mf.CreatePlannedOutcome::Created(p) => { pin_name = _dup(&p.script_name); pin_version = _dup(&p.plan_version); pin_hash_hex = _dup(&p.content_hash); pin_len = p.plan_length; },
			mf.CreatePlannedOutcome::Exists(p) => { pin_name = _dup(&p.script_name); pin_version = _dup(&p.plan_version); pin_hash_hex = _dup(&p.content_hash); pin_len = p.plan_length; },
			mf.CreatePlannedOutcome::PlanConflict(_) => {
				// The workflow_id exists under a CONTRADICTORY identity — a legacy non-plan
				// workflow, OR a DIFFERENT plan name (id collision across plans). No pin to
				// adopt; no lease taken; report + stop.
				console.println("{\"workflow\":\"deferred\",\"reason\":\"plan_conflict\"}");
				return 9;
			}
		}
	}

	// 2. claim — now we hold a fence for any durable defer below.
	val clock = _clock(host);
	var fencing_token: Int = 0;
	var claimed_state: Int = 0;
	match host.claim_workflow(workflow_id, &clock.now, &clock.deadline) {
		mf.ClaimByIdOutcome::Claimed(wf) => { fencing_token = wf.fencing_token; claimed_state = wf.state_code; },
		mf.ClaimByIdOutcome::NotFound => { throw RunnerError(message = "workflow absent after create"); },
		mf.ClaimByIdOutcome::NotClaimable => {
			// TERMINAL REPLAY / leased / deferred: report from DURABLE state — the pinned
			// `plan_length` gives the final operation seq. Reached BEFORE any registry build
			// or `_validate_registry`, so it never depends on current participant/operation
			// config being present or valid.
			val last_hex = _bytes_to_hex(&_operation_id(workflow_canon_hex, pin_len));
			return _inspect_report(host, workflow_id, &last_hex, pin_len);
		}
	}

	// 3. CLAIMED: NOW build + validate the registry (deferred past terminal replay). For a
	//    fresh create we already did; this covers the existing-claimed path. We hold the
	//    lease, so a MALFORMED/incomplete registry config MUST NOT leak it: catch the
	//    failure and durably defer `revision_unavailable` (lease released, recoverable),
	//    exactly as an absent pinned plan does — never exit still holding the lease.
	if !reg_ready {
		var ok = false;
		try {
			_validate_registry(cfg);
			reg = _registry_build(cfg);
			ok = true;
		} catch RunnerError(e) {
			console.eprintln(e.message);
		}
		if !ok {
			return _defer_dispatch(host, workflow_id, fencing_token, "revision_unavailable");
		}
		reg_ready = true;
	}

	// 4. EXACT-MATCH resolve + verify the PINNED plan BEFORE choosing a direction
	//    (static-review item 3): resolve (name, plan_version) and verify content_hash AND
	//    length against the pin. Absent / mismatched -> durable revision_unavailable defer
	//    (we hold a fence), NEVER substitute — for BOTH forward and reverse, so a
	//    reversing workflow can never unwind compensation under a plan that isn't its
	//    pinned one. Under v1's single verified generation, cfg IS the pinned plan, so the
	//    forward dispatcher + reverse unwind below read compensation from the plan the pin
	//    guarantees.
	var has_rev = false;
	var ridx = 0;
	match _registry_resolve(&reg, &pin_name, &pin_version) { Optional::Some(i) => { ridx = i; has_rev = true; }, Optional::None => {} }
	if !has_rev {
		return _defer_dispatch(host, workflow_id, fencing_token, "revision_unavailable");
	}
	val rev_hash_hex = _bytes_to_hex(&reg.revisions[ridx].content_hash);
	if !_str_eq(&rev_hash_hex, &pin_hash_hex) or reg.revisions[ridx].plan_length != pin_len {
		return _defer_dispatch(host, workflow_id, fencing_token, "revision_unavailable");
	}

	// Pinned plan verified. A claimed REVERSING workflow unwinds; otherwise dispatch
	// forward. Both bind their operations from the verified pinned plan.
	if claimed_state == STATE_REVERSING {
		return _run_reversal(host, cfg, workflow_id, workflow_canon_hex, fencing_token);
	}
	return _run_forward(host, cfg, workflow_id, workflow_canon_hex, fencing_token, &reg.revisions[ridx].plan);
}

// ===== ScriptRegistry build + lookup (v1: one configured generation per process) =====

// Build the in-process registry from config: ONE generation, a single revision
// `(script_name, plan_version)` whose IR is the config plan. The name + version come
// from config ("script_name" / "plan_version", defaulting to SCRIPT_NAME /
// PLAN_VERSION_DEFAULT) so different deployments genuinely carry different generations.
// The version is validated as an immutable semver (major.minor.patch). v1 does NOT
// retain multiple revisions — that, plus activation/reload, is a future evolution.
fn _registry_build(cfg: &json.JsonNode) -> ScriptRegistry {
	var revs: Array<ScriptRevision> = [];
	match _build_plan(cfg) {
		Optional::Some(plan) => {
			val name = _config_str(cfg, &"script_name", _dup(&SCRIPT_NAME));
			val version = _config_str(cfg, &"plan_version", _dup(&PLAN_VERSION_DEFAULT));
			_validate_semver(&version);
			val ch = _content_hash(cfg, &plan);
			val len = plan.len;
			revs.push(ScriptRevision(name = move name, version = move version,
			                         plan = move plan, content_hash = ch, plan_length = len));
		},
		Optional::None => {}
	}
	return ScriptRegistry(revisions = move revs);
}

// The active generation for a script (v1: the single built revision matching the name).
fn _registry_active(reg: &ScriptRegistry, name: &String) -> Optional<Int> {
	var i = 0;
	while i < reg.revisions.len {
		if _str_eq(&reg.revisions[i].name, name) { return Optional<Int>::Some(i); }
		i = i + 1;
	}
	return Optional<Int>::None();
}

// EXACT-MATCH resolve a pinned plan by (name, version). v1 selection is exact-match on
// the version string (no semver ranges yet); the caller additionally verifies
// content_hash + length. None -> revision_unavailable.
fn _registry_resolve(reg: &ScriptRegistry, name: &String, version: &String) -> Optional<Int> {
	var i = 0;
	while i < reg.revisions.len {
		if _str_eq(&reg.revisions[i].name, name) and _str_eq(&reg.revisions[i].version, version) {
			return Optional<Int>::Some(i);
		}
		i = i + 1;
	}
	return Optional<Int>::None();
}

// Validate an immutable plan version is a well-formed semantic version
// major.minor.patch: exactly three dot-separated, non-empty, all-numeric components (no
// pre-release / build-metadata labels in v1). Throws RunnerError on a malformed version.
fn _validate_semver(version: &String) -> Void {
	val n = version.byte_length();
	var dots = 0;
	var comp_len = 0;   // bytes in the current component
	var i = 0;
	while i < n {
		val c = version.byte_at(i);
		if c == 46 {        // '.'
			if comp_len == 0 { throw RunnerError(message = "invalid plan_version (empty component): " + _dup(version)); }
			dots = dots + 1;
			comp_len = 0;
		} else if c >= 48 and c <= 57 {   // '0'..'9'
			comp_len = comp_len + 1;
		} else {
			throw RunnerError(message = "invalid plan_version (non-numeric component): " + _dup(version));
		}
		i = i + 1;
	}
	if dots != 2 or comp_len == 0 {
		throw RunnerError(message = "invalid plan_version (need major.minor.patch): " + _dup(version));
	}
}

// `content_hash` = collision-resistant, versioned digest of a revision's IR: a 1-byte
// scheme tag (0x01) followed by SHA-256 over the canonical encoding = 33 bytes. This is
// the immutable identity the runner verifies against the durable pin ("never
// substitute"). NOT the per-operation `input_hash` (UUID-v3, participant idempotency).
fn _content_hash(cfg: &json.JsonNode, plan: &Array<PlanStep>) -> Array<Byte> {
	val canonical = _plan_canonical(cfg, plan);
	val msg = _str_bytes(&canonical);
	val digest = crypto.sha256(&msg);   // 32 bytes
	var out: Array<Byte> = [];
	// Scheme tag 0x01 (versioned digest scheme), built via hex_decode so we never push
	// an Int literal into Array<Byte>.
	match codec.hex_decode(&"01") {
		core.Result::Ok(tag) => { out.push(tag[0]); },
		core.Result::Err(_) => { throw RunnerError(message = "content-hash scheme tag decode failed"); }
	}
	var i = 0;
	while i < digest.len { out.push(digest[i]); i = i + 1; }
	return move out;
}

// Canonical encoding of the plan's FULL executable semantics. Per step: operation name
// + CANONICAL input + the RESOLVED operation (schema_version + logical participant id) +
// the compensation binding (operation + version + participant id). Length-prefixed per
// field so distinct revisions never collide.
fn _plan_canonical(cfg: &json.JsonNode, plan: &Array<PlanStep>) -> String {
	var s: String = "";
	var i = 0;
	while i < plan.len {
		val r = _resolve_operation(cfg, &plan[i].operation, Optional<Int>::None());
		var comp_op: String = "";
		var comp_sv: Int = 0;
		var comp_part: String = "";
		match _compensation_for(cfg, &plan[i].operation) {
			Optional::Some(c) => {
				comp_op = _dup(&c.op_name); comp_sv = c.schema_version;
				comp_part = _dup(&_resolve_operation(cfg, &comp_op, Optional<Int>::None()).participant_id);
			},
			Optional::None => {}   // a final / single-op step may have no compensation.
		}
		val sv_str = fmt.format_int(r.schema_version);
		val comp_sv_str = fmt.format_int(comp_sv);
		// CANONICAL input (static-review item 4): hash the recursively key-ordered compact
		// form, so JSON objects that differ only in key ORDER produce the SAME content_hash
		// (no false revision_unavailable). Same ordering `_input_hash` uses.
		val canon_input = _canonical_json(&plan[i].input_json);
		s = s + _lp(&plan[i].operation) + _lp(&canon_input)
		      + _lp(&sv_str) + _lp(&r.participant_id)
		      + _lp(&comp_op) + _lp(&comp_sv_str) + _lp(&comp_part);
		i = i + 1;
	}
	return move s;
}

// Canonical compact JSON: parse + re-encode with lexicographic UTF-8 key ordering, so a
// value's identity is independent of key spelling/order in config.
fn _canonical_json(input_json: &String) -> String {
	val cfg = json.JsonConfig(key_order = json.JsonKeyOrder::OrderedLexUtf8());
	match json.parse(input_json) {
		core.Result::Ok(n) => { return json.encode_compact_with_config(&n, &cfg); },
		core.Result::Err(_) => { throw RunnerError(message = "plan step input is not valid JSON"); }
	}
}

fn _str_bytes(s: &String) nothrow -> Array<Byte> {
	val n = s.byte_length();
	var out: Array<Byte> = [];
	var i = 0;
	while i < n { out.push(s.byte_at(i)); i = i + 1; }
	return move out;
}

// Length-prefix one field: "{byte_length}:{value};" — so concatenated fields can't
// collide across a hashed tuple.
fn _lp(s: &String) nothrow -> String {
	return fmt.format_int(s.byte_length()) + ":" + _dup(s) + ";";
}

// Drive the forward plan: for each step (operation_seq = index + 1) recover-or-fresh
// from durable state, persist the request, dispatch via the GENERIC dispatcher, and
// settle (intermediate or final). A definite rejection of ANY operation BEGINS
// reversal and unwinds in the same drive: any prior compensable checkpoints are
// compensated, and with none (e.g. the FIRST operation rejected) it reaches `reversed`
// immediately — never `blocked_resolution` for a definite forward rejection.
fn _run_forward(host: &mf.MicroflowsHost, cfg: &json.JsonNode, workflow_id: &Array<Byte>,
                workflow_canon_hex: &String, fencing_token: Int, plan: &Array<PlanStep>) -> Int {
	val n = plan.len;
	var final_result: String = "{}";
	var last_op_id_hex: String = "";
	var i = 0;
	while i < n {
		val seq = i + 1;
		var is_final = false;
		if seq == n { is_final = true; }

		// Already settled (resume): skip to the next operation. A claimed forward
		// workflow always has at least its LAST operation unsettled, so the loop never
		// completes purely by skipping.
		var settled = false;
		match host.operation_result(workflow_id, seq) {
			mf.OperationResultOutcome::Succeeded(r) => { final_result = move r; last_op_id_hex = _bytes_to_hex(&_operation_id(workflow_canon_hex, seq)); settled = true; },
			mf.OperationResultOutcome::Requested => {},
			mf.OperationResultOutcome::NotFound => {}
		}
		if settled { i = i + 1; continue; }

		// Recover the durable request for this seq, or derive it fresh from the plan
		// step. The durable request (if any) is authoritative — a restarted worker
		// must not depend on re-deriving identical fields.
		var op_name: String = "";
		var input_json: String = "";
		var schema_version: Int = 0;
		var operation_id: Array<Byte> = _operation_id(workflow_canon_hex, seq);
		var input_hash: String = "";
		var recovered = false;
		match host.operation_request_get(workflow_id, seq) {
			mf.OperationRequestGetOutcome::Found(rec) => {
				recovered = true;
				op_name = _dup(&rec.operation_name);
				input_json = _dup(&rec.input_json);
				schema_version = rec.schema_version;
				operation_id = _copy_bytes(&rec.operation_id);
				input_hash = _dup(&rec.input_hash);
			},
			mf.OperationRequestGetOutcome::NotFound => {
				op_name = _dup(&plan[i].operation);
				input_json = _dup(&plan[i].input_json);
				input_hash = _input_hash(&input_json);
			}
		}
		val operation_id_hex = _bytes_to_hex(&operation_id);

		// Resolve the operation; pin the durable schema_version on a resume.
		var base_url: String = "";
		var ok = false;
		var pinned: Optional<Int> = Optional<Int>::None();
		if recovered { pinned = Optional<Int>::Some(schema_version); }
		try {
			val r = _resolve_operation(cfg, &op_name, pinned);
			schema_version = r.schema_version;
			base_url = _dup(&r.base_url);
			ok = true;
		} catch RunnerError(e) { console.eprintln(e.message); }
		if !ok {
			return _defer_dispatch(host, workflow_id, fencing_token, "pinned_contract_unavailable");
		}

		// Persist the request (idempotent: a resume re-requests the same identity and
		// gets Exists) + the suspended continuation BEFORE dispatch.
		val cont_dispatch = "{\"pos\":\"op:" + fmt.format_int(seq) + ":dispatched\",\"operation_seq\":" + fmt.format_int(seq) + "}";
		val t_req = _now(host);
		match host.operation_request(workflow_id, fencing_token, seq, &operation_id,
		                             &op_name, schema_version, &input_json, &input_hash,
		                             &cont_dispatch, &t_req, &"{}") {
			mf.OperationRequestOutcome::Requested(_) => {},
			mf.OperationRequestOutcome::Exists(_) => {},
			mf.OperationRequestOutcome::FenceLost => {
				console.println("{\"workflow\":\"aborted\",\"reason\":\"request_fence_lost\"}");
				return 3;
			},
			mf.OperationRequestOutcome::OperationConflict => {
				console.println("{\"workflow\":\"aborted\",\"reason\":\"operation_conflict\"}");
				return 3;
			},
			mf.OperationRequestOutcome::PlanViolation(reason) => {
				// The request is out of the pinned plan (seq range / predecessor not
				// settled). Stop BEFORE dispatch — never a remote side effect out of order.
				console.println("{\"workflow\":\"aborted\",\"reason\":\"request_plan_violation:" + move reason + "\"}");
				return 8;
			},
			mf.OperationRequestOutcome::EventTimeSkew(defer_until) => {
				return _defer(host, workflow_id, fencing_token, &defer_until, "request_event_time_skew");
			},
			default => {
				throw RunnerError(message = "operation_request unexpected outcome");
			}
		}

		// Dispatch through the generic dispatcher. A RECOVERED request (durable from a
		// prior drive) reconciles GET-first; a FRESH request is PUT-first.
		match _dispatch_or_reconcile(recovered, &base_url, &op_name, &operation_id_hex, &input_json) {
			DispatchResult::Done(r) => {
				// Checkpoint payload = the operation INPUT (what compensation needs to
				// reverse it); the result is recorded separately.
				val t_settle = _now(host);
				var cont_settle = "{\"pos\":\"complete\"}";
				if !is_final { cont_settle = "{\"pos\":\"op:" + fmt.format_int(seq) + ":settled\",\"next_operation_seq\":" + fmt.format_int(seq + 1) + "}"; }
				match host.operation_settle(workflow_id, fencing_token, seq, &operation_id, seq,
				                            &r, &input_json, &cont_settle, &t_settle, &"{}", is_final) {
					mf.OperationSettleOutcome::Settled(res) => { final_result = move res; last_op_id_hex = _dup(&operation_id_hex); },
					mf.OperationSettleOutcome::AlreadySettled(res) => { final_result = move res; last_op_id_hex = _dup(&operation_id_hex); },
					mf.OperationSettleOutcome::FenceLost => {
						console.println("{\"workflow\":\"aborted\",\"reason\":\"settle_fence_lost\"}");
						return 3;
					},
					mf.OperationSettleOutcome::PlanViolation(reason) => {
						// The settle is outside the pinned plan (seq/checkpoint/finality): a
						// runner/plan inconsistency, never silently settle. Stop and report.
						console.println("{\"workflow\":\"aborted\",\"reason\":\"settle_plan_violation:" + move reason + "\"}");
						return 8;
					},
					mf.OperationSettleOutcome::EventTimeSkew(defer_until) => {
						return _defer(host, workflow_id, fencing_token, &defer_until, "settle_event_time_skew");
					},
					default => {
						throw RunnerError(message = "operation_settle unexpected outcome");
					}
				}
			},
			DispatchResult::Pending => {
				return _defer_pending(host, workflow_id, fencing_token);
			},
			DispatchResult::Rejected(reason) => {
				// A DEFINITE forward rejection ALWAYS begins reversal (the model: every
				// definite forward failure reverses). begin_reversal unwinds any prior
				// compensable checkpoints; with NONE (e.g. the first operation rejected) it
				// reaches `reversed` immediately. Never `blocked_resolution` for a definite
				// forward rejection — that is reserved for an UNCERTAIN forward outcome.
				return _begin_reversal_unwind(host, cfg, workflow_id, workflow_canon_hex, fencing_token, seq, &operation_id, move reason);
			}
		}
		i = i + 1;
	}

	console.println("{\"workflow\":\"completed\",\"operation_id\":\"" + last_op_id_hex + "\",\"result\":" + final_result + "}");
	return 0;
}

// A definite forward failure with a compensable checkpoint stack: transition
// forward -> reversing (or straight to reversed when nothing is compensable) via the
// existing begin_reversal transition, then drive the unwind in the SAME claim. The
// trigger operation is still status=requested (rejected, never settled), which
// begin_reversal requires.
fn _begin_reversal_unwind(host: &mf.MicroflowsHost, cfg: &json.JsonNode, workflow_id: &Array<Byte>,
                          workflow_canon_hex: &String, fencing_token: Int, operation_seq: Int,
                          operation_id: &Array<Byte>, reason: String) -> Int {
	val t = _now(host);
	match host.begin_reversal(workflow_id, fencing_token, operation_seq, operation_id, &t, &reason) {
		mf.BeginReversalOutcome::Reversing(_) => {
			return _run_reversal(host, cfg, workflow_id, workflow_canon_hex, fencing_token);
		},
		mf.BeginReversalOutcome::Reversed => {
			// No active checkpoints: a trivial unwind (nothing to compensate).
			console.println("{\"workflow\":\"reversed\"}");
			return 0;
		},
		mf.BeginReversalOutcome::AlreadyBegun(state) => {
			// Idempotent replay of a committed begin: resume from the recorded state.
			if state == STATE_REVERSING {
				return _run_reversal(host, cfg, workflow_id, workflow_canon_hex, fencing_token);
			}
			if state == STATE_REVERSED {
				console.println("{\"workflow\":\"reversed\"}");
				return 0;
			}
			console.println("{\"workflow\":\"blocked\",\"direction\":\"reverse\"}");
			return 3;
		},
		mf.BeginReversalOutcome::FenceLost => {
			console.println("{\"workflow\":\"reverse_aborted\",\"reason\":\"begin_reversal_fence_lost\"}");
			return 7;
		},
		mf.BeginReversalOutcome::EventTimeSkew(defer_until) => {
			return _defer(host, workflow_id, fencing_token, &defer_until, "begin_reversal_skew");
		},
		default => {
			// trigger_mismatch / operation_not_found / operation_conflict /
			// operation_not_failed / not_found: a durable-state inconsistency, not a
			// retryable condition. Report and stop.
			console.println("{\"workflow\":\"reverse_aborted\",\"reason\":\"begin_reversal_precondition\"}");
			return 8;
		}
	}
}

// ===== HTTP dispatch =====

// A PUT either gets an HTTP response (any status) or fails at the transport
// level (timeout / disconnect) — a genuinely uncertain outcome: the participant
// MAY have committed. TransportFailed -> reconcile by GET.
pub variant PutOutcome { Responded(status: Int, body: String), TransportFailed }

// A GET observes the durable participant state, classified by status — only
// 202 is pending; 400/409 are definite rejections; 5xx/unreadable/unreachable
// are transport-uncertain.
pub variant GetOutcome {
	Terminal(result: String),    // 200 terminal result
	Pending,                     // 202 accepted / working, not terminal
	Unknown,                     // 404 no record
	Rejected(reason: String),    // 400 / 409 definite protocol rejection
	TransportFailed              // 5xx / unreadable body / unreachable
}

// The classified dispatch result fed back to the workflow loop:
//   Done     -> a terminal result to settle
//   Pending  -> not terminal (or unreachable); durably defer and re-poll later
//   Rejected -> definite protocol rejection; abort
pub variant DispatchResult { Done(result: String), Pending, Rejected(reason: String) }

fn _op_url(base: &String, operation_name: &String, operation_id_hex: &String) nothrow -> String {
	return _dup(base) + "/microflows/v1/operations/" + _dup(operation_name) + "/" + _dup(operation_id_hex);
}

fn _dispatch_put(base: &String, operation_name: &String, operation_id_hex: &String,
                 input_json: &String, io_timeout_ms: Int) nothrow -> PutOutcome {
	val url = _op_url(base, operation_name, operation_id_hex);
	var cfg = client.new_client_config();
	client.with_io_timeout(&mut cfg, io_timeout_ms);
	var session = client.new_session(move cfg);
	var req = client.new_request("PUT", move url);
	client.set_json_body(&mut req, _dup(input_json));
	match client.send(&session, move req) {
		core.Result::Ok(resp) => {
			match client.response_body_string(&resp) {
				core.Result::Ok(body) => { return PutOutcome::Responded(resp.status, move body); },
				// An unreadable response body is NOT a known response: the outcome
				// is uncertain -> TransportFailed (reconcile), never Responded("").
				core.Result::Err(_) => { return PutOutcome::TransportFailed(); }
			}
		},
		core.Result::Err(_) => { return PutOutcome::TransportFailed(); }
	}
}

// Classify the PUT outcome (§5.2). 200 success; 202 pending (defer + re-poll);
// 400 invalid; 409 conflict; 5xx/other/transport-failure -> uncertain ->
// reconcile by GET.
fn _classify_dispatch(base: &String, operation_name: &String, operation_id_hex: &String, input_json: &String) -> DispatchResult {
	match _dispatch_put(base, operation_name, operation_id_hex, input_json, PUT_IO_TIMEOUT_MS) {
		PutOutcome::Responded(status, body) => {
			if status == 200 { return DispatchResult::Done(_extract_result(&body)); }
			if status == 202 { return DispatchResult::Pending(); }
			if status == 400 { return DispatchResult::Rejected("participant_invalid_request"); }
			if status == 409 { return DispatchResult::Rejected("participant_identity_conflict"); }
			return _reconcile(base, operation_name, operation_id_hex, input_json);
		},
		PutOutcome::TransportFailed => {
			return _reconcile(base, operation_name, operation_id_hex, input_json);
		}
	}
}

fn _get_op(base: &String, operation_name: &String, operation_id_hex: &String) nothrow -> GetOutcome {
	val url = _op_url(base, operation_name, operation_id_hex);
	var cfg = client.new_client_config();
	client.with_io_timeout(&mut cfg, RECONCILE_IO_TIMEOUT_MS);
	var session = client.new_session(move cfg);
	var req = client.new_request("GET", move url);
	match client.send(&session, move req) {
		core.Result::Ok(resp) => {
			if resp.status == 404 { return GetOutcome::Unknown(); }
			if resp.status == 202 { return GetOutcome::Pending(); }
			if resp.status == 400 { return GetOutcome::Rejected("participant_invalid_request"); }
			if resp.status == 409 { return GetOutcome::Rejected("participant_identity_conflict"); }
			if resp.status == 200 {
				match client.response_body_string(&resp) {
					core.Result::Ok(body) => {
						match _try_extract_result(&body) {
							Optional::Some(r) => { return GetOutcome::Terminal(move r); },
							Optional::None => { return GetOutcome::TransportFailed(); }
						}
					},
					core.Result::Err(_) => { return GetOutcome::TransportFailed(); }
				}
			}
			// 5xx or any other status: unreachable / uncertain.
			return GetOutcome::TransportFailed();
		},
		core.Result::Err(_) => { return GetOutcome::TransportFailed(); }
	}
}

// Reconcile an uncertain outcome by GET on the stable operation id. Terminal ->
// Done; 202/working or unreachable -> Pending (defer); 400/409 -> Rejected; a
// 404 means the participant has no record -> safe re-PUT the identical request
// under the same id, then GET again (effectively-once replay).
fn _reconcile(base: &String, operation_name: &String, operation_id_hex: &String, input_json: &String) -> DispatchResult {
	match _get_op(base, operation_name, operation_id_hex) {
		GetOutcome::Terminal(r) => { return DispatchResult::Done(move r); },
		GetOutcome::Pending => { return DispatchResult::Pending(); },
		GetOutcome::Rejected(reason) => { return DispatchResult::Rejected(move reason); },
		GetOutcome::TransportFailed => {
			// Unreachable/uncertain -> defer + retry later; never throw holding the lease.
			return DispatchResult::Pending();
		},
		GetOutcome::Unknown => {
			// 404-reconcile: participant has no record -> resubmit identical PUT.
			match _dispatch_put(base, operation_name, operation_id_hex, input_json, RECONCILE_IO_TIMEOUT_MS) {
				PutOutcome::Responded(status, body) => {
					if status == 200 { return DispatchResult::Done(_extract_result(&body)); }
					if status == 202 { return DispatchResult::Pending(); }
					if status == 400 { return DispatchResult::Rejected("participant_invalid_request"); }
					if status == 409 { return DispatchResult::Rejected("participant_identity_conflict"); }
					return _reconcile_after_resubmit(base, operation_name, operation_id_hex);
				},
				PutOutcome::TransportFailed => { return _reconcile_after_resubmit(base, operation_name, operation_id_hex); }
			}
		}
	}
}

fn _reconcile_after_resubmit(base: &String, operation_name: &String, operation_id_hex: &String) -> DispatchResult {
	match _get_op(base, operation_name, operation_id_hex) {
		GetOutcome::Terminal(r) => { return DispatchResult::Done(move r); },
		GetOutcome::Rejected(reason) => { return DispatchResult::Rejected(move reason); },
		// Still not terminal (pending / unreachable / 404 again) -> defer + retry.
		default => { return DispatchResult::Pending(); }
	}
}

// Workflow not claimable: inspect to distinguish terminal / active / deferred,
// and report. Terminal -> replay the LOCAL authoritative result (Microflows
// already persisted it; no dependency on the participant being reachable).
fn _inspect_report(host: &mf.MicroflowsHost, workflow_id: &Array<Byte>, operation_id_hex: &String, result_seq: Int) -> Int {
	val now = _now(host);
	match host.inspect_workflow(workflow_id, &now) {
		mf.WorkflowInspectOutcome::Found(snap) => {
			if snap.is_terminal {
				return _report_terminal(host, workflow_id, &snap, operation_id_hex, result_seq);
			}
			if snap.leased {
				console.println("{\"workflow\":\"active\",\"reason\":\"leased_by_another\"}");
				return 4;
			}
			console.println("{\"workflow\":\"deferred\",\"reason\":\"not_yet_due_or_blocked\"}");
			return 5;
		},
		mf.WorkflowInspectOutcome::NotFound => {
			throw RunnerError(message = "workflow vanished during inspect");
		}
	}
}

// Branch by terminal state: ONLY `completed` carries a successful operation
// result; `reversed` and `resolved_exception` are terminal WITHOUT a forward
// success, so they must not assume one.
fn _report_terminal(host: &mf.MicroflowsHost, workflow_id: &Array<Byte>,
                    snap: &mf.WorkflowSnapshot, operation_id_hex: &String, result_seq: Int) -> Int {
	if snap.state_code == STATE_COMPLETED {
		// The authoritative completed result is the LAST operation's (the plan may
		// have run several); a single-op workflow's last seq is 1.
		match host.operation_result(workflow_id, result_seq) {
			mf.OperationResultOutcome::Succeeded(r) => {
				console.println("{\"workflow\":\"already_terminal\",\"operation_id\":\"" + _dup(operation_id_hex) + "\",\"result\":" + r + "}");
				return 0;
			},
			mf.OperationResultOutcome::Requested => {
				// COMPLETED but the operation has only a request, no settled result:
				// inconsistent durable state. A completed workflow MUST carry its
				// forward result — this is an error, not a success.
				console.println("{\"workflow\":\"error\",\"reason\":\"completed_operation_unsettled\"}");
				return 10;
			},
			mf.OperationResultOutcome::NotFound => {
				// COMPLETED but no operation row at all: corrupted durable state.
				console.println("{\"workflow\":\"error\",\"reason\":\"completed_without_operation\"}");
				return 10;
			}
		}
	}
	if snap.state_code == STATE_REVERSED {
		console.println("{\"workflow\":\"reversed\"}");
		return 0;
	}
	if snap.state_code == STATE_RESOLVED_EXCEPTION {
		console.println("{\"workflow\":\"resolved_exception\"}");
		return 0;
	}
	console.println("{\"workflow\":\"terminal\",\"state\":" + fmt.format_int(snap.state_code) + "}");
	return 0;
}

// Operation pending (202/working) or participant unreachable: durably defer by
// releasing the lease with a near-term next-attempt, so the workflow becomes
// due again and re-polls. Reports only on a committed release (else a distinct
// defer_failed outcome — never claim a transition that did not happen).
fn _defer_pending(host: &mf.MicroflowsHost, workflow_id: &Array<Byte>, fencing_token: Int) -> Int {
	// Schedule the next attempt PENDING_RETRY_SECONDS out (NOT the lease window):
	// the DB clock returns this as an absolute next-attempt deadline.
	val clock = host.clock_read(PENDING_RETRY_SECONDS);
	match host.release(workflow_id, fencing_token, &clock.now, &clock.deadline) {
		mf.ReleaseOutcome::Released => {
			console.println("{\"workflow\":\"pending\",\"reason\":\"operation_pending\",\"defer_until\":\"" + _dup(&clock.deadline) + "\"}");
			return 9;
		},
		mf.ReleaseOutcome::FenceLost => {
			console.println("{\"workflow\":\"defer_failed\",\"reason\":\"release_fence_lost\"}");
			return 7;
		},
		mf.ReleaseOutcome::NotFound => {
			console.println("{\"workflow\":\"defer_failed\",\"reason\":\"release_not_found\"}");
			return 8;
		}
	}
}

// Clock skew (non-increasing event_ts): release/defer the workflow until the
// LAST ACCEPTED event time + margin (defer_until), rather than adjusting the
// timestamp or retrying immediately. The deferral is only reported once the
// release actually COMMITS; a failed release yields a distinct outcome (never
// claim a durable transition that did not happen).
fn _defer(host: &mf.MicroflowsHost, workflow_id: &Array<Byte>, fencing_token: Int,
          defer_until: &String, reason: String) -> Int {
	val clock = host.clock_read(LEASE_SECONDS);
	match host.release(workflow_id, fencing_token, &clock.now, defer_until) {
		mf.ReleaseOutcome::Released => {
			console.println("{\"workflow\":\"deferred\",\"reason\":\"" + move reason + "\",\"defer_until\":\"" + _dup(defer_until) + "\"}");
			return 6;
		},
		mf.ReleaseOutcome::FenceLost => {
			console.println("{\"workflow\":\"defer_failed\",\"reason\":\"release_fence_lost\"}");
			return 7;
		},
		mf.ReleaseOutcome::NotFound => {
			console.println("{\"workflow\":\"defer_failed\",\"reason\":\"release_not_found\"}");
			return 8;
		}
	}
}

// Durable OPERATIONAL deferral of a dispatch for a REPAIRABLE reason (e.g. a
// pinned binding temporarily unavailable in config). The workflow stays forward
// and claimable; sp_mf_operation_dispatch_defer clears the lease, sets an
// absolute future next_attempt, and appends an 'operation_dispatch_deferred'
// audit event with the reason on ENTRY into the wait condition (deduped on
// retry), so restoring config auto-recovers it — NOT a failure, NOT blocked.
fn _defer_dispatch(host: &mf.MicroflowsHost, workflow_id: &Array<Byte>, fencing_token: Int, reason: String) -> Int {
	val clock = host.clock_read(DISPATCH_DEFER_SECONDS);
	match host.defer_dispatch(workflow_id, fencing_token, &clock.now, &clock.deadline, &clock.now, &reason) {
		mf.ReleaseOutcome::Released => {
			console.println("{\"workflow\":\"deferred\",\"reason\":\"" + move reason + "\",\"defer_until\":\"" + _dup(&clock.deadline) + "\"}");
			return 9;
		},
		mf.ReleaseOutcome::FenceLost => {
			console.println("{\"workflow\":\"defer_failed\",\"reason\":\"defer_fence_lost\"}");
			return 7;
		},
		mf.ReleaseOutcome::NotFound => {
			console.println("{\"workflow\":\"defer_failed\",\"reason\":\"defer_not_found\"}");
			return 8;
		}
	}
}

// Durable non-retryable failure on a definite participant rejection. Without
// this the runner would exit while still forward/requested AND holding the
// lease; after lease expiry the workflow becomes claimable again and repeats
// the rejected dispatch indefinitely. operation_fail atomically transitions
// forward(1) -> blocked_resolution(3) (disposition failed) and clears the lease,
// so the workflow stops advancing forward. Idempotent (AlreadyBlocked).
fn _fail_operation(host: &mf.MicroflowsHost, workflow_id: &Array<Byte>, fencing_token: Int,
                   operation_id: &Array<Byte>, reason: String) -> Int {
	val t = _now(host);
	val cont = "{\"pos\":\"op:1:failed\"}";
	val payload = "{\"reason\":\"" + _dup(&reason) + "\",\"kind\":\"non_retryable_failure\"}";
	match host.operation_fail(workflow_id, fencing_token, OPERATION_SEQ, operation_id, &cont, &t, &payload) {
		mf.OperationFailOutcome::Blocked => {
			console.println("{\"workflow\":\"failed\",\"reason\":\"" + move reason + "\",\"disposition\":\"blocked_resolution\"}");
			return 3;
		},
		mf.OperationFailOutcome::AlreadyBlocked => {
			// Idempotent replay of the same non-retryable failure.
			console.println("{\"workflow\":\"failed\",\"reason\":\"" + move reason + "\",\"disposition\":\"blocked_resolution\"}");
			return 3;
		},
		mf.OperationFailOutcome::FenceLost => {
			console.println("{\"workflow\":\"fail_aborted\",\"reason\":\"fail_fence_lost\"}");
			return 7;
		},
		mf.OperationFailOutcome::OperationConflict => {
			console.println("{\"workflow\":\"fail_aborted\",\"reason\":\"fail_operation_conflict\"}");
			return 7;
		},
		mf.OperationFailOutcome::NotFound => {
			console.println("{\"workflow\":\"fail_aborted\",\"reason\":\"fail_workflow_not_found\"}");
			return 8;
		},
		mf.OperationFailOutcome::OperationNotFound => {
			console.println("{\"workflow\":\"fail_aborted\",\"reason\":\"fail_operation_not_found\"}");
			return 8;
		},
		mf.OperationFailOutcome::EventTimeSkew(defer_until) => {
			return _defer(host, workflow_id, fencing_token, &defer_until, "fail_event_time_skew");
		}
	}
}

// ===== reversal / compensation unwind (reverse direction) =====
//
// Stable reverse-invocation id, DERIVED deterministically from (workflow, seq) in a
// space DISTINCT from forward operation ids, so recovery re-derives the same id.
fn _reverse_id(workflow_hex: &String, seq: Int) nothrow -> Array<Byte> {
	val rev = fmt.format_int(SCRIPT_REVISION);
	val s = fmt.format_int(seq);
	val seed = _join3(workflow_hex, &rev, &s) + "reverse:1";
	val u = uuid.v3_from_string(&seed);
	return uuid.to_bytes(&u);
}

// Manual-IR compensation binding for a forward operation (None if it declares no
// compensation — then its checkpoint cannot be auto-unwound).
fn _compensation_for(cfg: &json.JsonNode, fwd_op: &String) -> Optional<CompensationBinding> {
	match cfg.get(&"operations") {
		Optional::Some(on) => {
			match on.as_array() {
				Optional::Some(items) => {
					var i = 0;
					while i < items.len {
						val nm = _req_str(&items[i], &"name", "operation.name");
						if _str_eq(&nm, fwd_op) {
							match items[i].get(&"compensation") {
								Optional::Some(c) => {
									val cop = _req_str(c, &"operation", "compensation.operation");
									val csv = _req_int(c, &"schema_version", "compensation.schema_version");
									return Optional<CompensationBinding>::Some(CompensationBinding(op_name = move cop, schema_version = csv));
								},
								Optional::None => { return Optional<CompensationBinding>::None(); }
							}
						}
						i = i + 1;
					}
				},
				Optional::None => {}
			}
		},
		Optional::None => {}
	}
	return Optional<CompensationBinding>::None();
}

// Enter blocked_resolution (reverse direction) when a compensation cannot continue.
fn _reverse_block(host: &mf.MicroflowsHost, workflow_id: &Array<Byte>, fencing_token: Int,
                  seq: Int, rev_id: &Array<Byte>, reason: String) -> Int {
	val ts = _now(host);
	match host.reverse_block(workflow_id, fencing_token, seq, rev_id, 2, &reason, &ts) {
		mf.ReverseBlockOutcome::Blocked => {
			console.println("{\"workflow\":\"blocked\",\"direction\":\"reverse\",\"reason\":\"" + move reason + "\"}");
			return 3;
		},
		mf.ReverseBlockOutcome::AlreadyBlocked => {
			console.println("{\"workflow\":\"blocked\",\"direction\":\"reverse\",\"reason\":\"" + move reason + "\"}");
			return 3;
		},
		mf.ReverseBlockOutcome::FenceLost => {
			console.println("{\"workflow\":\"reverse_aborted\",\"reason\":\"block_fence_lost\"}");
			return 7;
		},
		mf.ReverseBlockOutcome::EventTimeSkew(defer_until) => {
			// Time-disciplined like every transition: defer to the supplied deadline
			// rather than reporting failure with the lease still held.
			return _defer(host, workflow_id, fencing_token, &defer_until, "reverse_block_skew");
		},
		default => {
			console.println("{\"workflow\":\"reverse_aborted\",\"reason\":\"reverse_block_failed\"}");
			return 8;
		}
	}
}

// Dispatch ONE compensation (generic dispatcher) + settle/defer/block. Returns
// Continue to descend to the next checkpoint, or Terminal with the exit code.
// A RECOVERED durable request (forward OR reverse) is reconciled GET-first: the
// request was already durably issued in a prior drive, so observe its outcome by GET
// on the stable id and only re-PUT if the participant has no record (404). A FRESH
// request is dispatched PUT-first. Selecting here keeps recovery from blindly
// re-PUTting a request the participant may already have committed.
fn _dispatch_or_reconcile(recover: Bool, base: &String, operation_name: &String,
                          operation_id_hex: &String, input_json: &String) -> DispatchResult {
	if recover {
		return _reconcile(base, operation_name, operation_id_hex, input_json);
	}
	return _classify_dispatch(base, operation_name, operation_id_hex, input_json);
}

fn _compensate(host: &mf.MicroflowsHost, workflow_id: &Array<Byte>, fencing_token: Int,
               seq: Int, comp_op: &String, base: &String, rev_id: &Array<Byte>,
               rev_id_hex: &String, rev_input: &String, recover: Bool) -> CompStep {
	match _dispatch_or_reconcile(recover, base, comp_op, rev_id_hex, rev_input) {
		DispatchResult::Done(result) => {
			val ts = _now(host);
			match host.reverse_settle(workflow_id, fencing_token, seq, rev_id, &result, &ts) {
				mf.ReverseSettleOutcome::Reversed => {
					console.println("{\"workflow\":\"reversed\"}");
					return CompStep::Terminal(0);
				},
				mf.ReverseSettleOutcome::Reversing(_) => { return CompStep::Continue(); },
				mf.ReverseSettleOutcome::AlreadyReversed => { return CompStep::Continue(); },
				mf.ReverseSettleOutcome::FenceLost => {
					console.println("{\"workflow\":\"reverse_aborted\",\"reason\":\"settle_fence_lost\"}");
					return CompStep::Terminal(7);
				},
				mf.ReverseSettleOutcome::EventTimeSkew(defer_until) => {
					return CompStep::Terminal(_defer(host, workflow_id, fencing_token, &defer_until, "reverse_settle_skew"));
				},
				default => {
					console.println("{\"workflow\":\"reverse_aborted\",\"reason\":\"reverse_settle_failed\"}");
					return CompStep::Terminal(8);
				}
			}
		},
		DispatchResult::Pending => {
			return CompStep::Terminal(_defer_dispatch(host, workflow_id, fencing_token, "compensation_pending"));
		},
		DispatchResult::Rejected(reason) => {
			// Persist the CLASSIFIED participant reason as blocked-resolution evidence.
			return CompStep::Terminal(_reverse_block(host, workflow_id, fencing_token, seq, rev_id, move reason));
		}
	}
}

// Drive the compensation UNWIND of a reversing workflow: the checkpoint stack
// (reverse_head) is authoritative. Top active checkpoint -> derive + persist the
// compensation binding (pending) or reconcile the persisted one (dispatched) ->
// dispatch via the generic dispatcher -> settle/descend, defer on pending, block on
// definite rejection. Terminal reversed clears the lease.
fn _run_reversal(host: &mf.MicroflowsHost, cfg: &json.JsonNode, workflow_id: &Array<Byte>,
                 workflow_canon_hex: &String, fencing_token: Int) -> Int {
	while true {
		match host.reverse_head(workflow_id) {
			mf.ReverseHeadOutcome::NoneActive => {
				// A reversing workflow with NO active checkpoint is an inconsistency (a
				// fully-compensated workflow would be reversed). Do NOT exit holding the
				// lease with no record — that recurs after lease expiry. Durably DEFER
				// with an audit reason: the lease is released, a deduped diagnostic event
				// is recorded, and the state is observable rather than silently pinning a
				// worker until expiry.
				return _defer_dispatch(host, workflow_id, fencing_token, "reverse_no_active_checkpoint");
			},
			mf.ReverseHeadOutcome::Pending(seq, forward_operation_name, forward_payload) => {
				val rev_id = _reverse_id(workflow_canon_hex, seq);
				val rev_id_hex = _bytes_to_hex(&rev_id);
				var comp_op: String = "";
				var comp_sv: Int = 0;
				match _compensation_for(cfg, &forward_operation_name) {
					Optional::Some(c) => { comp_op = _dup(&c.op_name); comp_sv = c.schema_version; },
					Optional::None => {
						// PRE-dispatch resolution failure: nothing was dispatched, so
						// reverse_block (which requires a persisted reverse id) cannot
						// apply and would leave the lease held. Durably DEFER as a
						// repairable config state — restoring the binding resumes the unwind.
						return _defer_dispatch(host, workflow_id, fencing_token, "no_compensation_binding");
					}
				}
				val rev_input = _dup(&forward_payload);
				val rev_hash = _input_hash(&rev_input);
				// resolve the pinned reverse contract (registry, not workflow input)
				var base: String = "";
				var rok = false;
				try {
					val r = _resolve_operation(cfg, &comp_op, Optional<Int>::Some(comp_sv));
					base = _dup(&r.base_url);
					rok = true;
				} catch RunnerError(e) { console.eprintln(e.message); }
				if !rok {
					return _defer_dispatch(host, workflow_id, fencing_token, "pinned_contract_unavailable");
				}
				// persist the binding BEFORE dispatch (crash-safe)
				val treq = _now(host);
				var ready = false;
				match host.reverse_request(workflow_id, fencing_token, seq, &rev_id, &comp_op, comp_sv,
				                           &rev_input, &rev_hash, &treq) {
					mf.ReverseRequestOutcome::Requested(_) => { ready = true; },
					mf.ReverseRequestOutcome::AlreadyRequested(_, _, _, _, _) => { ready = true; },
					mf.ReverseRequestOutcome::BindingConflict => {},   // persisted binding wins -> re-read head
					mf.ReverseRequestOutcome::CheckpointInactive(_) => {},  // already advanced -> re-read head
					mf.ReverseRequestOutcome::FenceLost => {
						console.println("{\"workflow\":\"reverse_aborted\",\"reason\":\"reverse_request_fence_lost\"}");
						return 7;
					},
					mf.ReverseRequestOutcome::EventTimeSkew(defer_until) => {
						return _defer(host, workflow_id, fencing_token, &defer_until, "reverse_request_skew");
					},
					default => {
						console.println("{\"workflow\":\"reverse_aborted\",\"reason\":\"reverse_request_failed\"}");
						return 8;
					}
				}
				if ready {
					// Fresh dispatch of a just-persisted binding: PUT-first.
					match _compensate(host, workflow_id, fencing_token, seq, &comp_op, &base, &rev_id, &rev_id_hex, &rev_input, false) {
						CompStep::Continue => {},
						CompStep::Terminal(code) => { return code; }
					}
				}
			},
			mf.ReverseHeadOutcome::Dispatched(seq, forward_operation_name, reverse_invocation_id, reverse_operation_name, reverse_schema_version, reverse_input_json, reverse_input_hash) => {
				val _ = forward_operation_name; val _ = reverse_input_hash;
				val rev_op = _dup(&reverse_operation_name);
				val rev_sv = reverse_schema_version;
				val rev_input = _dup(&reverse_input_json);
				// USE the DURABLE persisted reverse id (decode it) for dispatch + settle,
				// never a re-derived one — so recovery targets exactly the recorded
				// invocation even if derivation changes or seeded state is inconsistent.
				val rev_id = _hex_to_bytes(&reverse_invocation_id);
				val rev_id_hex = _dup(&reverse_invocation_id);
				var base: String = "";
				var rok = false;
				try {
					val r = _resolve_operation(cfg, &rev_op, Optional<Int>::Some(rev_sv));
					base = _dup(&r.base_url);
					rok = true;
				} catch RunnerError(e) { console.eprintln(e.message); }
				if !rok {
					return _defer_dispatch(host, workflow_id, fencing_token, "pinned_contract_unavailable");
				}
				// Durable binding already dispatched (recovery): GET-first reconcile,
				// never a blind re-PUT.
				match _compensate(host, workflow_id, fencing_token, seq, &rev_op, &base, &rev_id, &rev_id_hex, &rev_input, true) {
					CompStep::Continue => {},
					CompStep::Terminal(code) => { return code; }
				}
			}
		}
	}
}

// Extract the participant envelope's `result` object as compact JSON text.
fn _extract_result(envelope: &String) -> String {
	match _try_extract_result(envelope) {
		Optional::Some(r) => { return move r; },
		Optional::None => { throw RunnerError(message = "participant response has no result"); }
	}
}

fn _try_extract_result(envelope: &String) nothrow -> Optional<String> {
	match json.parse(envelope) {
		core.Result::Ok(n) => {
			match n.get(&"result") {
				Optional::Some(r) => { return Optional<String>::Some(json.encode_compact(r)); },
				Optional::None => { return Optional<String>::None(); }
			}
		},
		core.Result::Err(_) => { return Optional<String>::None(); }
	}
}

// ===== time =====

fn _clock(host: &mf.MicroflowsHost) -> mf.ClockReading {
	return host.clock_read(LEASE_SECONDS);
}

fn _now(host: &mf.MicroflowsHost) -> String {
	return host.clock_read(LEASE_SECONDS).now;
}

// ===== identity / hashing =====

fn _join3(a: &String, b: &String, c: &String) nothrow -> String {
	return fmt.format_int(a.byte_length()) + ":" + _dup(a) + ";"
	     + fmt.format_int(b.byte_length()) + ":" + _dup(b) + ";"
	     + fmt.format_int(c.byte_length()) + ":" + _dup(c) + ";";
}

fn _operation_id(workflow_hex: &String, operation_seq: Int) nothrow -> Array<Byte> {
	val rev = fmt.format_int(SCRIPT_REVISION);
	val seq = fmt.format_int(operation_seq);
	// invocation = 1 (first occurrence of this static call site).
	val seed = _join3(workflow_hex, &rev, &seq) + "inv:1";
	val u = uuid.v3_from_string(&seed);
	return uuid.to_bytes(&u);
}

fn _input_hash(input_json: &String) -> String {
	val cfg = json.JsonConfig(key_order = json.JsonKeyOrder::OrderedLexUtf8());
	match json.parse(input_json) {
		core.Result::Ok(n) => {
			val compact = json.encode_compact_with_config(&n, &cfg);
			val u = uuid.v3_from_string(&compact);
			val bytes = uuid.to_bytes(&u);
			return _bytes_to_hex(&bytes);
		},
		core.Result::Err(_) => { throw RunnerError(message = "input is not valid JSON"); }
	}
}

// ===== participant / operation registry (trusted deployment config) =====
//
// `participants` is the LASTING deployment boundary: a logical id -> transport
// policy. `operations` is a TEMPORARY manual-IR registry: op -> participant +
// schema_version, shaped like future compiler output. Resolution sits behind this
// boundary — the dispatcher consumes only a ResolvedOperation. Routing and
// credentials come ONLY from this trusted config, never from workflow input;
// credentials are never persisted in operation requests.

// Validate the WHOLE registry at startup, before any execution.
fn _validate_registry(cfg: &json.JsonNode) -> Void {
	val ids = _validate_participants(cfg);
	_validate_operations(cfg, &ids);
}

// Validate every participant's transport; return the owned set of participant ids.
fn _validate_participants(cfg: &json.JsonNode) -> Array<String> {
	var ids: Array<String> = [];
	match cfg.get(&"participants") {
		Optional::Some(pn) => {
			match pn.as_array() {
				Optional::Some(items) => {
					var i = 0;
					while i < items.len {
						val pid = _req_str(&items[i], &"id", "participant.id");
						if _contains(&ids, &pid) { throw RunnerError(message = "duplicate participant id: " + _dup(&pid)); }
						_validate_transport(&items[i], &pid);
						ids.push(move pid);
						i = i + 1;
					}
				},
				Optional::None => { throw RunnerError(message = "config: 'participants' must be a JSON array"); }
			}
		},
		Optional::None => { throw RunnerError(message = "config: missing 'participants'"); }
	}
	return move ids;
}

fn _validate_operations(cfg: &json.JsonNode, ids: &Array<String>) -> Void {
	var names: Array<String> = [];
	var svs: Array<Int> = [];
	match cfg.get(&"operations") {
		Optional::Some(on) => {
			match on.as_array() {
				Optional::Some(items) => {
					var i = 0;
					while i < items.len {
						val nm = _req_str(&items[i], &"name", "operation.name");
						if !_is_op_name_safe(&nm) { throw RunnerError(message = "operation name is empty or not a URI-safe segment: '" + _dup(&nm) + "' (allowed: A-Z a-z 0-9 . _ -)"); }
						if _contains(&names, &nm) { throw RunnerError(message = "duplicate operation binding: " + _dup(&nm)); }
						val pref = _req_str(&items[i], &"participant", "operation.participant");
						if !_contains(ids, &pref) { throw RunnerError(message = "operation '" + _dup(&nm) + "' references unknown participant '" + _dup(&pref) + "'"); }
						val sv = _req_int(&items[i], &"schema_version", "operation.schema_version");
						if sv < 1 { throw RunnerError(message = "operation '" + _dup(&nm) + "' has invalid schema_version"); }
						svs.push(sv);
						names.push(move nm);
						i = i + 1;
					}
					// Second pass: validate optional compensation bindings now that all
					// names are known (a compensation must reference a registered op).
					var k = 0;
					while k < items.len {
						match items[k].get(&"compensation") {
							Optional::Some(c) => {
								val cop = _req_str(c, &"operation", "compensation.operation");
								if !_contains(&names, &cop) {
									throw RunnerError(message = "compensation references unknown operation '" + _dup(&cop) + "'");
								}
								val csv = _req_int(c, &"schema_version", "compensation.schema_version");
								if csv < 1 { throw RunnerError(message = "compensation for an operation has invalid schema_version"); }
								// The pinned compensation version must MATCH the referenced
								// operation's registered version — reject an inconsistent
								// registry at startup, not by deferring during execution.
								var reg_sv = 0;
								var fi = 0;
								while fi < names.len {
									if _str_eq(&names[fi], &cop) { reg_sv = svs[fi]; }
									fi = fi + 1;
								}
								if reg_sv != csv {
									throw RunnerError(message = "compensation pins schema_version " + fmt.format_int(csv)
										+ " but operation '" + _dup(&cop) + "' offers version " + fmt.format_int(reg_sv));
								}
							},
							Optional::None => {}
						}
						k = k + 1;
					}
				},
				Optional::None => { throw RunnerError(message = "config: 'operations' must be a JSON array"); }
			}
		},
		Optional::None => { throw RunnerError(message = "config: missing 'operations'"); }
	}
}

// Build the forward PLAN from config "plan" (the manual IR). None when absent (the
// legacy single --operation path). Each step is {operation: string, input: object};
// the input is normalized to compact JSON text for stable hashing + storage.
fn _build_plan(cfg: &json.JsonNode) -> Optional<Array<PlanStep>> {
	match cfg.get(&"plan") {
		Optional::Some(pn) => {
			match pn.as_array() {
				Optional::Some(items) => {
					var steps: Array<PlanStep> = [];
					var i = 0;
					while i < items.len {
						val op = _req_str(&items[i], &"operation", "plan.operation");
						// The input is the operation request body; the operation layer
						// requires a JSON OBJECT. Reject a scalar/array at STARTUP (before
						// any claim) so a bad plan can't fail post-claim and strand the lease.
						var input: String = "{}";
						match items[i].get(&"input") {
							Optional::Some(inode) => {
								match inode.as_object() {
									Optional::Some(_) => { input = json.encode_compact(inode); },
									Optional::None => { throw RunnerError(message = "plan step input must be a JSON object"); }
								}
							},
							Optional::None => {}
						}
						steps.push(PlanStep(operation = move op, input_json = move input));
						i = i + 1;
					}
					if steps.len == 0 { throw RunnerError(message = "config: 'plan' must not be empty"); }
					return Optional<Array<PlanStep>>::Some(move steps);
				},
				Optional::None => { throw RunnerError(message = "config: 'plan' must be a JSON array"); }
			}
		},
		Optional::None => { return Optional<Array<PlanStep>>::None(); }
	}
}

// Validate the forward plan at startup (a bad plan fails BEFORE any
// create/claim/execution): every step's operation must resolve in the registry, and
// every step that can PRECEDE a later (potentially failing) step must declare a
// compensation binding. Only the FINAL step needs none: if it succeeds the workflow
// completes (nothing reverses it); if it fails it leaves no checkpoint and the PRIOR
// steps compensate. A single-operation plan therefore requires no compensation.
fn _validate_plan(cfg: &json.JsonNode) -> Void {
	match _build_plan(cfg) {
		Optional::Some(plan) => {
			val last = plan.len - 1;
			var i = 0;
			while i < plan.len {
				val _ = _resolve_operation(cfg, &plan[i].operation, Optional<Int>::None());
				// Steps before the last could be a "prior success" when a later step fails,
				// so they must be compensable. The last step never needs compensation.
				if i < last {
					match _compensation_for(cfg, &plan[i].operation) {
						Optional::Some(_) => {},
						Optional::None => {
							throw RunnerError(message = "plan operation '" + _dup(&plan[i].operation)
								+ "' (not the final step) has no compensation binding — it must be reversible");
						}
					}
				}
				i = i + 1;
			}
		},
		Optional::None => {}
	}
}

fn _validate_transport(part: &json.JsonNode, pid: &String) -> Void {
	match part.get(&"transport") {
		Optional::Some(tr) => {
			val kind = _req_str(tr, &"kind", "transport.kind");
			if kind != "http" { throw RunnerError(message = "participant '" + _dup(pid) + "' unsupported transport kind: " + kind); }
			val sel = _req_str(tr, &"selection", "transport.selection");
			if sel != "ordered_failover" { throw RunnerError(message = "participant '" + _dup(pid) + "' unsupported selection: " + sel); }
			match tr.get(&"endpoints") {
				Optional::Some(epn) => {
					match epn.as_array() {
						Optional::Some(eps) => {
							if eps.len == 0 { throw RunnerError(message = "participant '" + _dup(pid) + "' has an empty endpoint list"); }
							// This slice resolves a SINGLE endpoint (ordered selection over a
							// one-element list). Multi-endpoint ordered_failover is not
							// implemented yet, so reject >1 rather than silently ignore the rest.
							if eps.len > 1 { throw RunnerError(message = "participant '" + _dup(pid) + "' declares " + fmt.format_int(eps.len) + " endpoints; multi-endpoint ordered_failover is not implemented in this slice (use exactly one)"); }
							var k = 0;
							while k < eps.len {
								match eps[k].as_string() {
									Optional::Some(u) => { if !_is_http_url(&u) { throw RunnerError(message = "participant '" + _dup(pid) + "' invalid endpoint URL: " + u); } },
									Optional::None => { throw RunnerError(message = "participant '" + _dup(pid) + "' endpoint is not a string"); }
								}
								k = k + 1;
							}
						},
						Optional::None => { throw RunnerError(message = "participant '" + _dup(pid) + "' endpoints must be a JSON array"); }
					}
				},
				Optional::None => { throw RunnerError(message = "participant '" + _dup(pid) + "' missing endpoints"); }
			}
		},
		Optional::None => { throw RunnerError(message = "participant '" + _dup(pid) + "' missing transport"); }
	}
	// Only a null/absent auth_profile is supported in this slice; ANY non-null
	// value (object, string, boolean, number, array) is an unsupported credential
	// mechanism -> fail. Check is_null() directly so no JSON type slips through.
	match part.get(&"auth_profile") {
		Optional::Some(ap) => {
			if !ap.is_null() { throw RunnerError(message = "participant '" + _dup(pid) + "' has an unsupported auth_profile (only null/absent supported in this slice)"); }
		},
		Optional::None => {}
	}
}

// Resolve op_name -> {schema_version, base_url}. Ordered selection picks the first
// endpoint. `pinned` is the durable contract version on RESUME: the registry's
// binding MUST still offer exactly that version, else the pinned contract is
// unavailable and we fail safely rather than dispatch a persisted request through
// a different (e.g. upgraded) binding. Throws if the operation or its participant
// is absent. Resolution is thus by (operation_name, schema_version) on resume.
fn _resolve_operation(cfg: &json.JsonNode, op_name: &String, pinned: Optional<Int>) -> ResolvedOperation {
	match cfg.get(&"operations") {
		Optional::Some(on) => {
			match on.as_array() {
				Optional::Some(items) => {
					var i = 0;
					while i < items.len {
						val nm = _req_str(&items[i], &"name", "operation.name");
						if _str_eq(&nm, op_name) {
							val pref = _req_str(&items[i], &"participant", "operation.participant");
							val sv = _req_int(&items[i], &"schema_version", "operation.schema_version");
							match pinned {
								Optional::Some(req) => {
									if sv != req {
										throw RunnerError(message = "pinned contract version " + fmt.format_int(req)
											+ " for operation '" + _dup(op_name) + "' is unavailable (registry offers version "
											+ fmt.format_int(sv) + ")");
									}
								},
								Optional::None => {}
							}
							val base = _participant_base_url(cfg, &pref);
							return ResolvedOperation(operation_name = _dup(op_name), schema_version = sv, participant_id = _dup(&pref), base_url = move base);
						}
						i = i + 1;
					}
				},
				Optional::None => {}
			}
		},
		Optional::None => {}
	}
	throw RunnerError(message = "operation not registered: " + _dup(op_name));
}

fn _participant_base_url(cfg: &json.JsonNode, pid: &String) -> String {
	match cfg.get(&"participants") {
		Optional::Some(pn) => {
			match pn.as_array() {
				Optional::Some(items) => {
					var i = 0;
					while i < items.len {
						val id = _req_str(&items[i], &"id", "participant.id");
						if _str_eq(&id, pid) {
							return _first_endpoint(&items[i], pid);
						}
						i = i + 1;
					}
				},
				Optional::None => {}
			}
		},
		Optional::None => {}
	}
	throw RunnerError(message = "unknown participant: " + _dup(pid));
}

fn _first_endpoint(part: &json.JsonNode, pid: &String) -> String {
	match part.get(&"transport") {
		Optional::Some(tr) => {
			match tr.get(&"endpoints") {
				Optional::Some(epn) => {
					match epn.as_array() {
						Optional::Some(eps) => {
							if eps.len == 0 { throw RunnerError(message = "participant '" + _dup(pid) + "' has no endpoints"); }
							match eps[0].as_string() {
								Optional::Some(u) => { return move u; },
								Optional::None => { throw RunnerError(message = "participant '" + _dup(pid) + "' endpoint is not a string"); }
							}
						},
						Optional::None => { throw RunnerError(message = "participant '" + _dup(pid) + "' endpoints must be a JSON array"); }
					}
				},
				Optional::None => { throw RunnerError(message = "participant '" + _dup(pid) + "' missing endpoints"); }
			}
		},
		Optional::None => { throw RunnerError(message = "participant '" + _dup(pid) + "' missing transport"); }
	}
}

fn _req_str(n: &json.JsonNode, key: &String, what: String) -> String {
	match n.get(key) {
		Optional::Some(v) => {
			match v.as_string() {
				Optional::Some(s) => { return move s; },
				Optional::None => { throw RunnerError(message = what + " must be a string"); }
			}
		},
		Optional::None => { throw RunnerError(message = "missing " + what); }
	}
}

fn _req_int(n: &json.JsonNode, key: &String, what: String) -> Int {
	match n.get(key) {
		Optional::Some(v) => {
			match v.as_int() {
				Optional::Some(x) => { return x; },
				Optional::None => { throw RunnerError(message = what + " must be an integer"); }
			}
		},
		Optional::None => { throw RunnerError(message = "missing " + what); }
	}
}

fn _contains(arr: &Array<String>, s: &String) nothrow -> Bool {
	var i = 0;
	while i < arr.len { if _str_eq(&arr[i], s) { return true; } i = i + 1; }
	return false;
}

fn _str_eq(a: &String, b: &String) nothrow -> Bool {
	val n = a.byte_length();
	if n != b.byte_length() { return false; }
	var i = 0;
	while i < n { if a.byte_at(i) != b.byte_at(i) { return false; } i = i + 1; }
	return true;
}

fn _starts_with(s: &String, prefix: &String) nothrow -> Bool {
	val pn = prefix.byte_length();
	if s.byte_length() < pn { return false; }
	var i = 0;
	while i < pn { if s.byte_at(i) != prefix.byte_at(i) { return false; } i = i + 1; }
	return true;
}

fn _is_http_url(s: &String) nothrow -> Bool {
	if _starts_with(s, &"https://") and s.byte_length() > 8 { return true; }
	if _starts_with(s, &"http://") and s.byte_length() > 7 { return true; }
	return false;
}

// A non-empty URI path-SEGMENT-safe operation name (the name is interpolated raw
// into the dispatch URL). Allowed: A-Z a-z 0-9 . _ - — no '/', spaces, or other
// reserved/percent-requiring characters. Rejecting empty here also keeps an empty
// registry name from ever matching an omitted --operation.
fn _is_op_name_safe(s: &String) nothrow -> Bool {
	val n = s.byte_length();
	if n == 0 { return false; }
	// Reject the dot-segments "." and ".." — even though their bytes are in the
	// allowed set, as a whole URL path segment they are normalized away / climb the
	// path, which would change the route.
	if _str_eq(s, &".") or _str_eq(s, &"..") { return false; }
	var i = 0;
	while i < n {
		val b = s.byte_at(i);
		val ok: Bool = (b >= 48 and b <= 57)        // 0-9
		            or (b >= 65 and b <= 90)        // A-Z
		            or (b >= 97 and b <= 122)       // a-z
		            or b == 46 or b == 95 or b == 45;   // . _ -
		if !ok { return false; }
		i = i + 1;
	}
	return true;
}

// ===== config =====

fn _build_host(b: mf.HostBuilder) -> arc.Arc<mf.MicroflowsHost> {
	match mf.build_host(move b) {
		core.Result::Ok(h) => { return move h; },
		core.Result::Err(_) => { throw RunnerError(message = "microflows host build failed"); }
	}
}

fn _require_db(cfg: &json.JsonNode) -> json.JsonNode {
	match cfg.get(&"db") {
		Optional::Some(n) => { return n.clone_deep(); },
		Optional::None => { throw RunnerError(message = "config: missing 'db' subtree"); }
	}
}

fn _load_config_json(path: &String) throws -> json.JsonNode {
	val timeout = conc.Duration(millis = 5000);
	match io.file_builder(_dup(path)).read(true).timeout(timeout).build() {
		core.Result::Ok(file) => {
			val text = _drain(move file);
			match json.parse(&text) {
				core.Result::Ok(n) => { return move n; },
				core.Result::Err(_) => { throw RunnerError(message = "config: JSON parse failed"); }
			}
		},
		core.Result::Err(_) => { throw RunnerError(message = "config: cannot open " + _dup(path)); }
	}
}

fn _drain(var f: io.ConfiguredFile) throws -> String {
	var out: String = "";
	var buf = io.buffer(4096);
	var done = false;
	while !done {
		match f.read(&mut buf) {
			core.Result::Ok(n) => {
				if n == 0 { done = true; }
				else { out = out + core.string_from_utf8_bytes(io.buffer_ptr(&buf), n); }
			},
			core.Result::Err(_) => { val _ = f.close(); throw RunnerError(message = "config: read error"); }
		}
	}
	val _ = f.close();
	return move out;
}

fn _config_str(cfg: &json.JsonNode, key: &String, default_val: String) nothrow -> String {
	match cfg.get(key) {
		Optional::Some(n) => { match n.as_string() { Optional::Some(s) => { if s.byte_length() > 0 { return move s; } }, Optional::None => {} } },
		Optional::None => {}
	}
	return move default_val;
}

// ===== bytes / hex =====

fn _hex_to_bytes(hex: &String) -> Array<Byte> {
	match codec.hex_decode(hex) {
		core.Result::Ok(b) => { if b.len == 16 { return move b; } throw RunnerError(message = "workflow-id must be 16 bytes"); },
		core.Result::Err(_) => { throw RunnerError(message = "workflow-id not valid hex"); }
	}
}

fn _bytes_to_hex(b: &Array<Byte>) nothrow -> String {
	return codec.hex_encode(b);
}

fn _copy_bytes(b: &Array<Byte>) nothrow -> Array<Byte> {
	var out: Array<Byte> = Array<type Byte>::with_capacity(b.len);
	var i = 0;
	while i < b.len { out.push(b[i]); i = i + 1; }
	return move out;
}

fn _dup(s: &String) nothrow -> String {
	val n = s.byte_length();
	var buf = io.buffer(n);
	var i = 0;
	while i < n { io.buffer_write(&mut buf, i, s.byte_at(i)); i = i + 1; }
	return core.string_from_utf8_bytes(io.buffer_ptr(&buf), n);
}
