// Microflows coordinator runner — first dispatch slice (manual IR).
//
// Drives ONE GENERIC operation through the dispatch-gap recovery loop, proving
// the central property without the language frontend:
//
//   persist operation request + suspended continuation (BEFORE dispatch) ->
//   HTTP PUT -> [lost response] -> GET by stable operation id -> persist success
//   + Checkpoint + advanced continuation -> workflow done
//
// The operation is DATA-DRIVEN: its name, input, and pinned schema_version come
// from the persisted request (the durable authority on resume) or, for a fresh
// submission, from --operation/--input. The participant transport is resolved
// from the TRUSTED config registry (participants + operations), never from
// workflow input. Manual IR: workflow `protocol_spike` rev 1, one operation seq.
//
// Two enforced runner requirements:
//   1. on operation_settle AlreadySettled, the returned stored result is
//      AUTHORITATIVE — we use it, never our submitted result.
//   2. on operation_request FenceLost, STOP immediately — do NOT dispatch.
//
// One-shot CLI: runs the slice for one workflow id and prints a result JSON.
//   --config FILE  (db + participants + operations registries)
//   --workflow-id HEX  [--operation NAME (fresh submit only)]  [--input JSON]

module microflows.runner;

import std.core as core;
import std.core.arc as arc;
import std.console as console;
import std.json as json;
import std.format as fmt;
import std.concurrent as conc;
import std.io as io;
import std.cli as cli;
import std.codec as codec;
import std.uuid as uuid;
import std.crypto as crypto;
import std.log as log;
import std.time as time;
import std.text as txt;
import microflows.runner.logging as logging;
import microflows.host as mf;
import microflows.runner.ir as ir;
import microflows.runner.parser as parser;
import web.client as client;
import web.rest as rest;
import std.env as env;
import std.iter as iter;
use trait iter.SinglePassIterator;

const SCRIPT_NAME: String = "protocol_spike";
// Legacy single-op pin (tb_mf_workflow.script_revision); the plan model keys on a
// semantic version instead (PLAN_VERSION_DEFAULT, overridable via config "plan_version").
const SCRIPT_REVISION: Int = 1;
// Default immutable plan version (major.minor.patch) for the configured generation when
// config omits "plan_version". A process loads ONE generation; selection is exact-match.
const PLAN_VERSION_DEFAULT: String = "1.0.0";
const OPERATION_SEQ: Int = 1;
const CHECKPOINT_SEQ: Int = 1;
const LEASE_SECONDS: Int = 30;
// Pending-retry policy (relative): how soon a durably-deferred pending operation
// becomes due again. Independent of LEASE_SECONDS — retry scheduling must NOT be
// coupled to lease duration. The DB clock turns this into an ABSOLUTE deadline.
const PENDING_RETRY_SECONDS: Int = 1;
// Backoff for a durable OPERATIONAL deferral (repairable config state, e.g. a
// pinned binding temporarily unavailable). Longer than the pending poll: we are
// waiting on an operator to repair configuration, not on a remote participant.
const DISPATCH_DEFER_SECONDS: Int = 5;
const PUT_IO_TIMEOUT_MS: Int = 3000;
const RECONCILE_IO_TIMEOUT_MS: Int = 8000;

// ===== Admission control (slice 2: draining / reload / graceful shutdown) =====
//
// Admission is an INPUT to the drive boundary (`_run`, the future `drive_workflow(...) -> Outcome`
// coordinator-library entry point — see roadmap.md item 2.5). The CLI/front-door determines the
// admission state and passes it in; the library never decides it. Behavior:
//   - Accepting  : current behavior (the default).
//   - Draining   : a FRESH submission (creating a brand-new workflow) is REFUSED before any
//                  create/claim/dispatch — `{"workflow":"refused","reason":"draining"}`, nonzero
//                  exit. Resumes/reasserts of EXISTING work proceed so the drain converges, BUT a
//                  resume that would need to defer/retry returns `pending_restart` instead of
//                  scheduling new retry work (so the drain stops generating "come back later" work).
//   - Stopped    : same as Draining for this slice (refuse fresh; suppress new defers).
// Reuse: the same gate serves config reload AND graceful shutdown. The future front-door SERVICE
// maps a `refused`/`pending_restart` admission outcome to HTTP 503 (no Retry-After yet).
//
// Source: the CLI reads the `MICROFLOWS_ADMISSION` environment variable once at the front door
// (`_admission_from_env`, in `main`) — "draining" | "stopped"; anything else, or unset, is accepting.
// Admission is then THREADED as a parameter through the whole drive (`_run` → `_run_planned` /
// `_run_forward` / `_run_reversal` and the `_defer*` helpers): the library never reads the
// environment, so a caller passing `AdmissionState::Draining` is honored unconditionally. Roadmap item
// 2.5 (the `drive_workflow -> Outcome` extraction) only changes how the OUTCOME is returned — admission
// already crosses the boundary as a parameter, so that refactor is mechanical, not a redesign.
variant AdmissionState { Accepting, Draining, Stopped }

const ADMISSION_REFUSED_EXIT: Int = 10;          // a fresh submission refused while draining/stopped
const ADMISSION_PENDING_RESTART_EXIT: Int = 11;  // an in-flight resume could not finish during drain

fn _admission_from_env() nothrow -> AdmissionState {
	match env.get("MICROFLOWS_ADMISSION") {
		Optional::Some(v) => {
			if _str_eq(&v, &"draining") { return AdmissionState::Draining(); }
			if _str_eq(&v, &"stopped") { return AdmissionState::Stopped(); }
			return AdmissionState::Accepting();
		},
		Optional::None => { return AdmissionState::Accepting(); }
	}
}
fn _admission_accepting(a: &AdmissionState) nothrow -> Bool {
	match a { AdmissionState::Accepting() => { return true; }, default => { return false; } }
}
fn _admission_label(a: &AdmissionState) nothrow -> String {
	match a {
		AdmissionState::Draining() => { return "draining"; },
		AdmissionState::Stopped() => { return "stopped"; },
		default => { return "accepting"; }
	}
}

// ===== Outcome: the structured drive result (roadmap item 2.5) =====
//
// Every terminal status the drive can produce is a typed `Outcome`. `_oc_render` is the SINGLE source
// of the machine-readable JSON; `_oc_exit` the single source of the process exit code. The drive
// functions return an `Outcome` (no inline `console.println`); the CLI adapter (`main`) renders it
// once. A future SERVICE renders the same `Outcome` to HTTP. Arms carry an explicit `code` where the
// exit varies independently of the status (e.g. an `aborted` is 2 / 3 / 8 by cause). JSON shape and
// exit codes are byte-compatible with the prior inline form (pinned by the integration suite).
variant Outcome {
	Completed(operation_id: String, result: String),       // exit 0
	AlreadyTerminal(operation_id: String, result: String), // exit 0
	Reversed,                                              // exit 0
	ResolvedException,                                     // exit 0
	TerminalState(state: Int),                             // exit 0
	Active(reason: String),                                // exit 4
	Pending(reason: String, defer_until: String),          // exit 9
	PendingRestart(reason: String),                        // exit 11
	Refused(reason: String),                               // exit 10
	Error(reason: String),                                 // exit 10
	Failed(reason: String),                                // exit 3 (disposition blocked_resolution)
	Aborted(reason: String, code: Int),                    // exit 2 / 3 / 8
	Deferred(reason: String, defer_until: String, code: Int), // defer_until "" -> omitted; exit 5 / 6 / 9
	DeferFailed(reason: String, code: Int),                // exit 7 / 8
	Blocked(reason: String),                               // direction reverse; reason "" -> omitted; exit 3
	ReverseAborted(reason: String, code: Int),             // exit 7 / 8
	FailAborted(reason: String, code: Int)                 // exit 7 / 8
}

fn _oc_render(o: &Outcome) nothrow -> String {
	match o {
		Outcome::Completed(operation_id, result) => { return "{\"workflow\":\"completed\",\"operation_id\":\"" + _dup(operation_id) + "\",\"result\":" + _dup(result) + "}"; },
		Outcome::AlreadyTerminal(operation_id, result) => { return "{\"workflow\":\"already_terminal\",\"operation_id\":\"" + _dup(operation_id) + "\",\"result\":" + _dup(result) + "}"; },
		Outcome::Reversed() => { return "{\"workflow\":\"reversed\"}"; },
		Outcome::ResolvedException() => { return "{\"workflow\":\"resolved_exception\"}"; },
		Outcome::TerminalState(state) => { return "{\"workflow\":\"terminal\",\"state\":" + fmt.format_int(state) + "}"; },
		Outcome::Active(reason) => { return "{\"workflow\":\"active\",\"reason\":\"" + _dup(reason) + "\"}"; },
		Outcome::Pending(reason, defer_until) => { return "{\"workflow\":\"pending\",\"reason\":\"" + _dup(reason) + "\",\"defer_until\":\"" + _dup(defer_until) + "\"}"; },
		Outcome::PendingRestart(reason) => { return "{\"workflow\":\"pending_restart\",\"reason\":\"" + _dup(reason) + "\"}"; },
		Outcome::Refused(reason) => { return "{\"workflow\":\"refused\",\"reason\":\"" + _dup(reason) + "\"}"; },
		Outcome::Error(reason) => { return "{\"workflow\":\"error\",\"reason\":\"" + _dup(reason) + "\"}"; },
		Outcome::Failed(reason) => { return "{\"workflow\":\"failed\",\"reason\":\"" + _dup(reason) + "\",\"disposition\":\"blocked_resolution\"}"; },
		Outcome::Aborted(reason, code) => { return "{\"workflow\":\"aborted\",\"reason\":\"" + _dup(reason) + "\"}"; },
		Outcome::Deferred(reason, defer_until, code) => {
			if defer_until.byte_length() == 0 { return "{\"workflow\":\"deferred\",\"reason\":\"" + _dup(reason) + "\"}"; }
			return "{\"workflow\":\"deferred\",\"reason\":\"" + _dup(reason) + "\",\"defer_until\":\"" + _dup(defer_until) + "\"}";
		},
		Outcome::DeferFailed(reason, code) => { return "{\"workflow\":\"defer_failed\",\"reason\":\"" + _dup(reason) + "\"}"; },
		Outcome::Blocked(reason) => {
			if reason.byte_length() == 0 { return "{\"workflow\":\"blocked\",\"direction\":\"reverse\"}"; }
			return "{\"workflow\":\"blocked\",\"direction\":\"reverse\",\"reason\":\"" + _dup(reason) + "\"}";
		},
		Outcome::ReverseAborted(reason, code) => { return "{\"workflow\":\"reverse_aborted\",\"reason\":\"" + _dup(reason) + "\"}"; },
		Outcome::FailAborted(reason, code) => { return "{\"workflow\":\"fail_aborted\",\"reason\":\"" + _dup(reason) + "\"}"; }
	}
}

fn _oc_exit(o: &Outcome) nothrow -> Int {
	match o {
		Outcome::Completed(operation_id, result) => { return 0; },
		Outcome::AlreadyTerminal(operation_id, result) => { return 0; },
		Outcome::Reversed() => { return 0; },
		Outcome::ResolvedException() => { return 0; },
		Outcome::TerminalState(state) => { return 0; },
		Outcome::Active(reason) => { return 4; },
		Outcome::Pending(reason, defer_until) => { return 9; },
		Outcome::PendingRestart(reason) => { return ADMISSION_PENDING_RESTART_EXIT; },
		Outcome::Refused(reason) => { return ADMISSION_REFUSED_EXIT; },
		Outcome::Error(reason) => { return 10; },
		Outcome::Failed(reason) => { return 3; },
		Outcome::Aborted(reason, code) => { return code; },
		Outcome::Deferred(reason, defer_until, code) => { return code; },
		Outcome::DeferFailed(reason, code) => { return code; },
		Outcome::Blocked(reason) => { return 3; },
		Outcome::ReverseAborted(reason, code) => { return code; },
		Outcome::FailAborted(reason, code) => { return code; }
	}
}

// PASS-A adapter: render the outcome and return its exit code, preserving the prior inline behavior
// EXACTLY. (Pass B moves the render to `main` and lets the drive functions return `Outcome` directly.)
fn _emit(o: Outcome) nothrow -> Int {
	console.println(_oc_render(&o));
	return _oc_exit(&o);
}

// While draining/stopped, a resume that cannot finish RELEASES the lease at `now` (no future retry
// scheduled) and reports a clear `pending_restart` outcome — so the drain does not keep generating
// retry work. The workflow stays in its durable state, resumable once admission returns to accepting.
fn _drain_release(host: &mf.MicroflowsHost, workflow_id: &Array<Byte>, fencing_token: Int, a: &AdmissionState) -> Outcome {
	val clock = host.clock_read(LEASE_SECONDS);
	match host.release(workflow_id, fencing_token, &clock.now, &clock.now) {
		mf.ReleaseOutcome::Released => {
			return Outcome::PendingRestart(reason = _admission_label(a));
		},
		mf.ReleaseOutcome::FenceLost => {
			return Outcome::DeferFailed(reason = "release_fence_lost", code = 7);
		},
		default => {
			return Outcome::DeferFailed(reason = "release_not_found", code = 7);
		}
	}
}

// microflows.state terminal storage codes.
const STATE_REVERSING: Int = 2;
const STATE_COMPLETED: Int = 4;
const STATE_REVERSED: Int = 5;
const STATE_RESOLVED_EXCEPTION: Int = 6;

pub error RunnerError { message: String }

// A resolved transport target for one operation. The dispatcher depends ONLY on
// this — never on the config JSON shape, the participant registry, or workflow
// input. `base_url` is the endpoint chosen by ordered selection. `participant_id` is
// the LOGICAL participant binding (pinned in the plan hash); endpoint/auth resolution
// stays dynamic.
struct ResolvedOperation {
	operation_name: String,
	schema_version: Int,
	participant_id: String,
	base_url: String
}

// Manual-IR compensation binding: a forward operation's declared REVERSE operation
// (name + pinned schema_version). The reverse INPUT for this slice is the forward
// checkpoint payload (design §6).
struct CompensationBinding {
	op_name: String,
	schema_version: Int
}

// One step of the manual-IR forward PLAN: an operation name (resolved through the
// registry to a participant + pinned schema_version) and the literal input for this
// invocation. The plan is a flat, ordered sequence — no loops or branches. It lives
// in config (the manual IR), so a restarted worker re-derives the same plan and uses
// the durable operation/checkpoint state to decide where to resume.
struct PlanStep {
	operation: String,
	input_json: String
}

// ===== ScriptRegistry (milestone-1: in-process, immutable, manually-built IR) =====
//
// A plan REVISION is the immutable unit a workflow pins, identified by a SEMANTIC
// VERSION (major.minor.patch). Its `content_hash` is a versioned, collision-resistant
// digest (0x01 ‖ SHA-256 over the canonical IR) the runner verifies against the durable
// pin — it never substitutes a different plan. v1 loads ONE configured generation per
// process and selects by EXACT MATCH on (version AND content_hash); semver RANGES,
// multi-version retention, and activation/reload are a future evolution, not built here.
struct ScriptRevision {
	name: String,
	version: String,             // immutable semver: major.minor.patch
	graph: ir.IrGraph,           // the authoritative control-flow graph; drives forward execution
	arg_type: ir.IrType,         // declared closed-object argument type (part of content_hash)
	content_hash: Array<Byte>,   // 33 bytes: scheme tag + SHA-256 over GRAPH identity
	plan_length: Int             // number of NOperation nodes (== flat plan length)
}

struct ScriptRegistry {
	revisions: Array<ScriptRevision>
}

// The durable pin as the runner carries it past the storage read (item-1 storage-first):
// the workflow's MODE (planned when present) and its pinned identity come from STORAGE,
// not current config. `present=false` means no durable pin (fresh or legacy).
struct PinView {
	present: Bool,
	name: String,
	version: String,
	hash_hex: String,
	plan_length: Int
}

// One step of the reverse loop: Continue (descend to the next checkpoint) or
// Terminal with the process exit code (reversed / deferred / blocked / fenced).
variant CompStep {
	Continue,
	Terminal(exit_code: Outcome)
}

fn main(argv: Array<String>) nothrow -> Int {
	var p = cli.parser("microflows-runner", "0.1.0", "Microflows coordinator runner (first slice)");
	val _ = p.option_string("config", "c", "FILE", "JSON config: db + participants + operations registries (or use --manifest)", false);
	val _ = p.option_string("workflow-id", "w", "HEX", "32-hex-char workflow id", false);
	val _ = p.option_string("operation", "o", "NAME", "operation to submit (required ONLY for a fresh LEGACY workflow; a resume uses the durable request)", false);
	val _ = p.option_string("input", "i", "JSON", "operation input (JSON object; default {}); fresh legacy workflow only", false);
	val _ = p.option_string("arguments", "a", "JSON", "instance arguments (JSON object) for a PLANNED workflow SUBMISSION; supplying it creates/reasserts (and conflicts on changed args), omitting it RESUMES", false);
	val _ = p.flag("emit-content-hash", "", "build the registry from --config and print the active revision's content_hash (hex), then exit; no DB or --workflow-id needed (used to (re)compute fixtures)");
	val _ = p.option_string("lower-source", "", "FILE", "lower a .mf source file into a runnable config: use --config as the base routing registry, print the merged config JSON to stdout, then exit (no DB/dispatch; the textual frontend)", false);
	val _ = p.option_string("parse-check", "", "FILE", "parse a .mf source and print a CANONICAL JSON outcome (status/is_graph/canonical/validate/type_check, or status/code/position for a parse error) to stdout, then exit 0; DB-free, no routing registry — the parser/IR test driver (golden-fixture tooling)", false);
	val _ = p.option_string("manifest", "m", "FILE", "deployment manifest (named scripts + shared deployment routing). Compiles+validates EVERY declared script at startup; a SUBMISSION names a script via --script, a RESUME drives by the durable pin. Alternative to --config", false);
	val _ = p.option_string("script", "s", "NAME", "the manifest script to SUBMIT (manifest mode, fresh submission only; a resume uses the durable pin)", false);

	var config_path: String = "";
	var workflow_hex: String = "";
	var operation_name: String = "";
	var input_json: String = "{}";
	var arguments_json: String = "";
	var has_arguments: Bool = false;
	var emit_hash: Bool = false;
	var lower_source_path: String = "";
	var parse_check_path: String = "";
	var manifest_path: String = "";
	var script_name: String = "";
	var has_script: Bool = false;

	match p.parse(argv) {
		core.Result::Ok(parsed) => {
			match parsed.get_string("config", p) { Some(v) => { config_path = _dup(v); }, None => {} }
			match parsed.get_string("workflow-id", p) { Some(v) => { workflow_hex = _dup(v); }, None => {} }
			match parsed.get_string("operation", p) { Some(v) => { operation_name = _dup(v); }, None => {} }
			match parsed.get_string("input", p) { Some(v) => { input_json = _dup(v); }, None => {} }
			match parsed.get_string("arguments", p) { Some(v) => { arguments_json = _dup(v); has_arguments = true; }, None => {} }
			match parsed.get_string("lower-source", p) { Some(v) => { lower_source_path = _dup(v); }, None => {} }
				match parsed.get_string("parse-check", p) { Some(v) => { parse_check_path = _dup(v); }, None => {} }
			match parsed.get_string("manifest", p) { Some(v) => { manifest_path = _dup(v); }, None => {} }
			match parsed.get_string("script", p) { Some(v) => { script_name = _dup(v); has_script = true; }, None => {} }
			emit_hash = parsed.has_flag("emit-content-hash", p);
		},
		core.Result::Err(_) => {
			console.eprintln("runner: bad arguments");
			return 2;
		}
	}
	// Parser/IR test-driver mode: parse a .mf source and print a canonical JSON outcome, then exit.
	// DB-free and registry-free — the golden-fixture driver for the parser unit suite.
	if parse_check_path.byte_length() != 0 {
		return try _parse_check(&parse_check_path) catch { console.eprintln("runner: parse-check failed"); 1 };
	}
	// Frontend mode: lower a .mf source file into a runnable config (base routing from --config),
	// print the merged config JSON, then exit. Pure front end — no DB, no claim, no dispatch.
	if lower_source_path.byte_length() != 0 {
		if config_path.byte_length() == 0 { console.eprintln("runner: --config (base routing) required for --lower-source"); return 2; }
		return try _lower_source(&lower_source_path, &config_path) catch { console.eprintln("runner: lower-source failed"); 1 };
	}
	// Fixture-tooling mode: print the active revision's content_hash for --config, then exit.
	if emit_hash {
		if config_path.byte_length() == 0 { console.eprintln("runner: --config required for --emit-content-hash"); return 2; }
		return try _emit_content_hash(&config_path) catch { console.eprintln("runner: emit-content-hash failed"); 1 };
	}
	val manifest_mode = manifest_path.byte_length() != 0;
	if workflow_hex.byte_length() != 32 or (!manifest_mode and config_path.byte_length() == 0) {
		console.eprintln("runner: a 32-hex --workflow-id and either --config or --manifest are required");
		return 2;
	}

	// The CLI (front-door stand-in) reads the admission state from the environment and passes it to
	// the drive boundary. A future service would translate admission into HTTP 503 and own reload/
	// shutdown; it calls the same `_run`/drive_workflow boundary with admission as a parameter.
	// The drive RETURNS a structured `Outcome`; the CLI adapter renders it (machine-readable JSON to
	// stdout + a process exit code) exactly once here. A service would render the same Outcome to HTTP.
	// `--manifest` selects the named-script registry path (item 3a); `--config` the single-config path.
	val admission = _admission_from_env();
	var outcome: Outcome = Outcome::Error(reason = "runner-fatal");
	try {
		if manifest_mode {
			outcome = _run_manifest(&manifest_path, &workflow_hex, &script_name, has_script, &operation_name, &input_json, &arguments_json, has_arguments, &admission);
		} else {
			outcome = _run(&config_path, &workflow_hex, &operation_name, &input_json, &arguments_json, has_arguments, &admission);
		}
	} catch unexpected {
		console.eprintln("runner: fatal");
		return 1;
	}
	return _emit(outcome);
}

// Build the registry from --config and print the active revision's content_hash (hex). DB-free
// and config-only: lets fixtures be (re)computed from the ACTUAL hashing algorithm rather than a
// reimplementation. Validates the registry first so an emit over a bad config fails loudly.
fn _emit_content_hash(config_path: &String) throws -> Int {
	val cfg = _load_config_json(config_path);
	_validate_registry(&cfg);
	val reg = _registry_build(&cfg);
	if reg.revisions.len == 0 {
		console.eprintln("runner: --config has no 'plan' (nothing to hash)");
		return 2;
	}
	console.println(_bytes_to_hex(&reg.revisions[0].content_hash));
	return 0;
}

// Parser/IR test-driver: parse a `.mf` source and emit a CANONICAL JSON outcome to stdout (exit 0;
// the outcome — success or failure — is in the JSON, so golden comparison is a plain stdout diff).
// DB-free, registry-free: this is the legitimate replacement for the old compiled-in parser_test
// (which baked ~60 scenarios into one driftc translation unit and cost multiple GB to build). The
// scenarios are now data files; this built binary reads them. Emits, on a parse error,
// {status:"parse-error", code, byte_offset, line, column, expected, found}; otherwise
// {status:"ok", is_graph, canonical, validate, type_check} where `canonical` is the IR graph_canonical
// identity (the exact thing the old parity checks compared), `validate` reflects validate_graph, and
// `type_check` reflects type_check_graph over the source-declared contracts + argument_type.
fn _parse_check(source_path: &String) -> Int {
	val source = _read_text(source_path);
	match parser.parse_source(&source) {
		core.Result::Err(e) => {
			var o = json.new_object();
			o.set("status", json.JsonNode::String(value = "parse-error"));
			o.set("code", json.JsonNode::String(value = _dup(&e.code)));
			o.set("byte_offset", json.JsonNode::Number(raw = fmt.format_int(e.byte_offset)));
			o.set("line", json.JsonNode::Number(raw = fmt.format_int(e.line)));
			o.set("column", json.JsonNode::Number(raw = fmt.format_int(e.column)));
			o.set("expected", json.JsonNode::String(value = _dup(&e.expected)));
			o.set("found", json.JsonNode::String(value = _dup(&e.found)));
			val node = o.to_node();
			console.println(json.encode_compact(&node));
			return 0;
		},
		core.Result::Ok(pw) => {
			var o = json.new_object();
			o.set("status", json.JsonNode::String(value = "ok"));
			o.set("is_graph", json.JsonNode::Bool(value = pw.is_graph));
			o.set("canonical", json.JsonNode::String(value = _pc_canon(&pw.body, pw.is_graph)));
			o.set("validate", json.JsonNode::String(value = _pc_validate(&pw.body, pw.is_graph)));
			o.set("type_check", json.JsonNode::String(value = _pc_typecheck(&pw)));
			val node = o.to_node();
			console.println(json.encode_compact(&node));
			return 0;
		}
	}
}

// Canonical IR identity of a parsed body — a "graph" via parse_graph, a flat "plan" lifted through
// flat_to_graph (the degenerate-graph identity the runner pins). Mirrors the old test helpers.
fn _pc_canon(body: &json.JsonNode, is_graph: Bool) -> String {
	if is_graph {
		match ir.parse_graph(body) {
			core.Result::Ok(g) => { return ir.graph_canonical(&g); },
			core.Result::Err(_) => { return "<bad-graph>"; }
		}
	}
	var steps: Array<ir.FlatStep> = [];
	match body.as_array() {
		Optional::Some(items) => {
			var i = 0;
			while i < items.len {
				var op: String = "";
				match items[i].get(&"operation") { Optional::Some(n) => { match n.as_string() { Optional::Some(s) => { op = move s; }, Optional::None => {} } }, Optional::None => {} }
				var inp: String = "{}";
				match items[i].get(&"input") { Optional::Some(n) => { inp = json.encode_compact(n); }, Optional::None => {} }
				steps.push(ir.FlatStep(operation = move op, input_json = move inp));
				i = i + 1;
			}
		},
		Optional::None => {}
	}
	match ir.flat_to_graph(&steps) {
		core.Result::Ok(g) => { return ir.graph_canonical(&g); },
		core.Result::Err(_) => { return "<err>"; }
	}
}

// "ok" / "reject" (validate_graph) / "bad-graph" — plans are structurally trivial ("ok").
fn _pc_validate(body: &json.JsonNode, is_graph: Bool) -> String {
	if !is_graph { return "ok"; }
	match ir.parse_graph(body) {
		core.Result::Ok(g) => {
			match ir.validate_graph(&g) { Optional::Some(_) => { return "reject"; }, Optional::None => { return "ok"; } }
		},
		core.Result::Err(_) => { return "bad-graph"; }
	}
}

// "ok" / "reject" (type_check_graph) / "n/a" (no graph, or not structurally valid). Builds the
// argument_type + per-op contracts from the SOURCE's own declarations (what `lower` would overlay).
fn _pc_typecheck(pw: &parser.ParsedWorkflow) -> String {
	if !pw.is_graph { return "n/a"; }
	match ir.parse_graph(&pw.body) {
		core.Result::Ok(g) => {
			match ir.validate_graph(&g) { Optional::Some(_) => { return "n/a"; }, Optional::None => {} }
			var at = ir.empty_object_type();
			match &pw.arg_type {
				Optional::Some(n) => { match ir.parse_object_type(n) { core.Result::Ok(t) => { at = move t; }, core.Result::Err(_) => { return "n/a"; } } },
				Optional::None => {}
			}
			var ocs: Array<ir.OpContract> = [];
			var i = 0;
			while i < pw.contracts.len {
				var inty: Optional<ir.IrType> = Optional<ir.IrType>::None();
				match &pw.contracts[i].input_type { Optional::Some(n) => { inty = Optional<ir.IrType>::Some(ir.parse_type(n)); }, Optional::None => {} }
				var outy: Optional<ir.IrType> = Optional<ir.IrType>::None();
				match &pw.contracts[i].result_type { Optional::Some(n) => { outy = Optional<ir.IrType>::Some(ir.parse_type(n)); }, Optional::None => {} }
				ocs.push(ir.OpContract(name = _dup(&pw.contracts[i].name), input_type = move inty, result_type = move outy));
				i = i + 1;
			}
			match ir.type_check_graph(&g, &at, &ocs) { Optional::Some(_) => { return "reject"; }, Optional::None => { return "ok"; } }
		},
		core.Result::Err(_) => { return "n/a"; }
	}
}

// Frontend mode: lower a `.mf` source file into a COMPLETE runnable config. The `--config` file is
// the base deployment routing (db + participants + operations registry); the parser emits the
// `"plan"` + `"argument_type"` + operation contract overlays from source, producing the identical
// config shape the manual IR consumes. Pure front end: it reads two files and prints JSON — no DB,
// no claim, no dispatch. A malformed source (or a contract for an unknown operation) fails HERE,
// before anything durable happens. The printed config is itself runnable / hashable unchanged.
fn _lower_source(source_path: &String, config_path: &String) throws -> Int {
	val source = _read_text(source_path);
	val base = _load_config_json(config_path);
	match parser.lower(&source, &base) {
		core.Result::Ok(merged) => {
			// VALIDATE the lowered config through the SAME build path a real run/--emit-content-hash
			// uses (registry + graph structure + types + contracts + compensation), so a semantically
			// invalid source/config combination (e.g. a step op absent from the registry, a duplicate
			// args field, a type-contract error) fails HERE — still DB-free, no claim, no dispatch —
			// rather than emitting a config that only blows up later. Only then is the printed config
			// genuinely "runnable / hashable unchanged".
			val ok = try _validate_lowered(&merged) catch RunnerError(e) {
				console.eprintln("runner: lower-source: invalid lowered config: " + e.message);
				false
			};
			if !ok { return 3; }
			console.println(json.encode_compact(&merged));
			return 0;
		},
		core.Result::Err(e) => {
			// The parser returns a STRUCTURED diagnostic event. Emit it through std.log (stable code +
			// position fields — the machine-readable log, mirroring the bookkeeper logging pattern), and
			// ALSO print a concise human render (code + line/column + caret excerpt) for the CLI user.
			_log_parse_diagnostic(&e);
			console.eprintln(parser.render_diagnostic(&source, &e));
			return 3;
		}
	}
}

// Emit a parser diagnostic as a STRUCTURED log event via std.log (stderr sink, JSON/ISO-8601
// formatter — the same facility/pattern as the bookkeeper service). The stable `code` and the source
// position (byte_offset/line/column) plus expected/found/message are fields, so logs are
// machine-parseable rather than ad hoc prose. (The human caret render is printed separately.)
fn _log_parse_diagnostic(e: &parser.ParseError) nothrow -> Void {
	var cfgb = log.config_builder();
	cfgb.sink(log.stderr_sink());
	cfgb.min_level(log.Level::Info());
	cfgb.formatter(log.FormatterKind::JsonIso8601());
	val logger = log.create_logger("microflows-runner", cfgb.build());
	logger.error("lower-source-parse-error", {
		"code": _dup(&e.code),
		"byte_offset": fmt.format_int(e.byte_offset),
		"line": fmt.format_int(e.line),
		"column": fmt.format_int(e.column),
		"expected": _dup(&e.expected),
		"found": _dup(&e.found),
		"message": _dup(&e.message)
	});
	val _ = logger.flush(conc.Duration(millis = 1000));
}

// Run the build-time validation path over a lowered config (no DB, no dispatch). Throws RunnerError
// on any build-time rejection; returns true when the config builds to exactly one revision.
fn _validate_lowered(merged: &json.JsonNode) throws -> Bool {
	_validate_registry(merged);
	val reg = _registry_build(merged);
	if reg.revisions.len == 0 { throw RunnerError(message = "lowered config has no 'plan'"); }
	return true;
}

// Read a file's full contents as UTF-8 text (no JSON parse) — for `.mf` source.
fn _read_text(path: &String) throws -> String {
	val timeout = conc.Duration(millis = 5000);
	match io.file_builder(_dup(path)).read(true).timeout(timeout).build() {
		core.Result::Ok(file) => { return _drain(move file); },
		core.Result::Err(_) => { throw RunnerError(message = "cannot open source " + _dup(path)); }
	}
}

// Build a host (its own internally-pooled DB connections) from the config and drive once. The
// one-shot CLI path: a fresh host per invocation. The long-running SERVICE instead builds ONE host
// at startup and calls `_run_core` directly per request (sharing the pool across concurrent drives;
// per-workflow leases/fencing keep them safe).
fn _run_cfg(cfg: &json.JsonNode, workflow_hex: &String,
        operation_name: &String, input_json: &String,
        arguments_json: &String, has_arguments: Bool, admission: &AdmissionState) throws -> Outcome {
	val db_sub = _require_db(cfg);
	val worker_id = _config_str(cfg, &"worker_id", "runner-1");
	val identity = mf.identity_from_worker_name(&worker_id);
	var b = mf.new_host_builder();
	mf.with_json(&mut b, &db_sub);
	mf.with_identity(&mut b, move identity);
	val host = _build_host(move b);
	return _run_core(&host, cfg, workflow_hex, operation_name, input_json, arguments_json, has_arguments, admission);
}

// The drive core, given an already-built (shared) host. Reused by the CLI (`_run_cfg`) and the
// long-running service. The participant/operation registry is validated LAZILY — only on a path that
// actually needs it — so TERMINAL REPLAY of a completed/planned workflow (which reports from durable
// state) stays registry- and config-independent.
fn _run_core(host: &arc.Arc<mf.MicroflowsHost>, cfg: &json.JsonNode, workflow_hex: &String,
        operation_name: &String, input_json: &String,
        arguments_json: &String, has_arguments: Bool, admission: &AdmissionState) throws -> Outcome {
	val workflow_id = _hex_to_bytes(workflow_hex);
	// Derive the operation id from the CANONICAL lowercase hex of the decoded
	// workflow bytes (not the supplied hex spelling), so upper/lower spellings
	// of the same workflow yield the same operation id.
	val workflow_canon_hex = _bytes_to_hex(&workflow_id);

	// STORAGE-FIRST mode selection (static-review item 1): the workflow's MODE
	// (planned vs legacy) and its pinned plan come from the DURABLE pin, NOT from
	// whatever plan the current config happens to carry. So an existing planned
	// workflow whose pinned plan is absent/changed in this generation is still routed
	// to the planned path (→ resolve → revision_unavailable defer), never misrouted to
	// the legacy single-op path. Only a workflow with NO durable pin consults config to
	// decide fresh-planned (config has a plan) vs legacy (no plan).
	var pin = PinView(present = false, name = "", version = "", hash_hex = "", plan_length = 0);
	match host.get().plan_get(&workflow_id) {
		mf.PlanGetOutcome::Found(p) => {
			pin = PinView(present = true, name = _dup(&p.script_name), version = _dup(&p.plan_version),
			              hash_hex = _dup(&p.content_hash), plan_length = p.plan_length);
		},
		mf.PlanGetOutcome::NotFound => {}
	}
	// SUBMISSION vs RESUME is signalled by --arguments: supplied => a planned SUBMISSION
	// (create/reassert the workflow with those instance arguments — and conflict if a
	// reused id carries different args); omitted => a RESUME (drive from durable state, never
	// re-create, never re-check args).
	val is_submission = has_arguments;
	// ADMISSION GATE (slice 2): while draining/stopped, REFUSE a fresh submission (creating a
	// brand-new workflow — a submission with NO durable pin) BEFORE any create/claim/dispatch, so a
	// drain/reload/shutdown admits no new work. Existing work (pin present: a resume OR a reassert)
	// proceeds below so the drain can converge. The front-door maps this `refused` outcome to HTTP
	// 503. This is the boundary the future `drive_workflow` library exposes (see the AdmissionState
	// note above).
	if !_admission_accepting(admission) and is_submission and !pin.present {
		return Outcome::Refused(reason = _admission_label(admission));
	}
	if pin.present {
		// Existing planned workflow: resume, or REASSERT if this is a submission (so a reused
		// id with changed arguments surfaces workflow_conflict instead of silently resuming).
		return _run_planned(host.get(), cfg, &workflow_id, &workflow_canon_hex, &pin, is_submission, arguments_json, admission);
	}
	if is_submission {
		// Fresh planned SUBMISSION: requires a planned config — a flat "plan" OR a manual-IR
		// "graph" (the legacy single-op path takes --operation, not --arguments).
		if _is_planned_config(cfg) {
			return _run_planned(host.get(), cfg, &workflow_id, &workflow_canon_hex, &pin, true, arguments_json, admission);
		}
		return Outcome::Aborted(reason = "arguments_require_planned_config", code = 2);
	}
	// No durable pin and no --arguments: a RESUME (or legacy). A planned config ("plan" or
	// "graph") => a resume of a planned workflow (which, absent a pin, claim resolves to
	// not_found); otherwise the legacy single-op path below.
	if _is_planned_config(cfg) {
		return _run_planned(host.get(), cfg, &workflow_id, &workflow_canon_hex, &pin, false, arguments_json, admission);
	}

	// Legacy single-op path: validate the registry now (it routes the single dispatch).
	_validate_registry(cfg);

	// CLI-derived request fields are the DEFAULT for a FRESH workflow. On resume
	// they are replaced by the durable persisted request, which is authoritative
	// — a restarted standalone worker must NOT depend on CLI input.
	var eff_operation_name: String = _dup(operation_name);
	var eff_input_json: String = _dup(input_json);
	var eff_schema_version: Int = 0;
	var operation_id: Array<Byte> = _operation_id(&workflow_canon_hex, OPERATION_SEQ);
	var operation_id_hex: String = _bytes_to_hex(&operation_id);
	var input_hash: String = _input_hash(&eff_input_json);

	// Is this a fresh SUBMISSION (--operation given) or a resume by id alone?
	val fresh: Bool = operation_name.byte_length() > 0;

	// --- pre-claim recovery probe (read-only; takes NO lease). BEST-EFFORT ONLY —
	// NOT authoritative: a request can be persisted between this read and our claim
	// (see the post-claim reload). It lets us skip create for a resume and
	// pre-validate a fresh submission cheaply. ---
	var recovered: Bool = false;
	match host.get().operation_request_get(&workflow_id, OPERATION_SEQ) {
		mf.OperationRequestGetOutcome::Found(rec) => {
			recovered = true;
			eff_operation_name = _dup(&rec.operation_name);
			eff_input_json = _dup(&rec.input_json);
			eff_schema_version = rec.schema_version;
			operation_id = _copy_bytes(&rec.operation_id);
			operation_id_hex = _bytes_to_hex(&operation_id);
			input_hash = _dup(&rec.input_hash);
		},
		mf.OperationRequestGetOutcome::NotFound => {}
	}

	// --- FRESH submission: validate --operation resolves BEFORE create/claim so a
	// bad submission takes no lease and creates no row. A RESUME by id does NOT
	// pre-reject here — its authoritative decision is post-claim, which avoids the
	// race where the durable request lands just after our probe. ---
	var base_url: String = "";
	if fresh and !recovered {
		var ok = false;
		try {
			val r = _resolve_operation(cfg, &eff_operation_name, Optional<Int>::None());
			eff_schema_version = r.schema_version;
			base_url = _dup(&r.base_url);
			ok = true;
		} catch RunnerError(e) {
			console.eprintln(e.message);
		}
		if !ok {
			return Outcome::Aborted(reason = "operation_unresolvable", code = 2);
		}
	}

	// --- 1. create workflow — ONLY for a fresh submission. A resume's workflow
	// must already exist; claim_by_id authoritatively returns NotFound otherwise,
	// so a resume-by-id of a non-existent workflow never creates a row. ---
	if fresh {
		val t_create = _now(host.get());
		match host.get().create_workflow(&workflow_id, &SCRIPT_NAME, SCRIPT_REVISION,
		                                 &t_create, &t_create, &"{\"pos\":\"start\"}", &"{}") {
			mf.CreateOutcome::Created => {},
			mf.CreateOutcome::Exists => {}
		}
	}

	// --- 2. claim THIS workflow by id (never a different instance) ---
	val clock = _clock(host.get());
	var fencing_token: Int = 0;
	var claimed_state: Int = 0;
	match host.get().claim_workflow(&workflow_id, &clock.now, &clock.deadline) {
		mf.ClaimByIdOutcome::Claimed(wf) => { fencing_token = wf.fencing_token; claimed_state = wf.state_code; },
		mf.ClaimByIdOutcome::NotFound => {
			if fresh {
				throw RunnerError(message = "workflow absent after create");
			}
			// Resume by id, but the workflow does not exist -> nothing to resume.
			// Authoritative (a non-existent workflow has no in-flight request, so
			// this is NOT the probe race). No lease was taken.
			return Outcome::Aborted(reason = "operation_required", code = 2);
		},
		mf.ClaimByIdOutcome::NotClaimable => {
			// Not claimable: INSPECT to distinguish terminal / active / deferred.
			return _inspect_report(host.get(), &workflow_id, &operation_id_hex, OPERATION_SEQ);
		}
	}

	// A claimed REVERSING workflow (state 2) drives the compensation UNWIND, not the
	// forward dispatch. claim_by_id claims state IN (1,2); the reverse loop reads the
	// authoritative checkpoint stack (reverse_head), never the continuation.
	if claimed_state == STATE_REVERSING {
		return _run_reversal(host.get(), cfg, &workflow_id, &workflow_canon_hex, fencing_token, admission);
	}

	// --- 2a. AUTHORITATIVE post-claim reload (closes the probe/claim race). Now
	// that we hold the lease the durable request — if any — is authoritative: a
	// request may have been persisted by another executor between our probe and
	// our claim. Adopting it flips a would-be "fresh" run to a resume so CLI-derived
	// fields cannot drive a spurious operation_conflict, AND prevents a resume-by-id
	// from spuriously aborting operation_required. ---
	match host.get().operation_request_get(&workflow_id, OPERATION_SEQ) {
		mf.OperationRequestGetOutcome::Found(rec) => {
			recovered = true;
			eff_operation_name = _dup(&rec.operation_name);
			eff_input_json = _dup(&rec.input_json);
			eff_schema_version = rec.schema_version;
			operation_id = _copy_bytes(&rec.operation_id);
			operation_id_hex = _bytes_to_hex(&operation_id);
			input_hash = _dup(&rec.input_hash);
		},
		mf.OperationRequestGetOutcome::NotFound => {}
	}

	// --- 2b. Post-claim precondition: claimed, but there is no durable request and
	// no --operation to submit. DURABLY DEFER (lease cleared + audit event) rather
	// than hold the lease — a re-submit with --operation, or a concurrently
	// persisting request, auto-recovers it on the next poll. ---
	if !recovered and !fresh {
		return _defer_dispatch(host.get(), &workflow_id, fencing_token, "operation_request_absent", admission);
	}

	// --- 2c. RESUME resolution, AFTER claim (only when claimable). The durable
	// schema_version is PINNED: the registry binding must still offer exactly that
	// version, else the operation is unresolvable (binding removed or version
	// changed under a persisted request). This is a REPAIRABLE configuration state,
	// not a participant failure — DURABLY DEFER (state stays forward, status stays
	// requested, continuation preserved, lease cleared, an
	// 'operation_dispatch_deferred' audit event with reason
	// pinned_contract_unavailable appended on entry), so restoring config
	// auto-recovers it on the next poll. ---
	if recovered {
		var ok = false;
		try {
			val r = _resolve_operation(cfg, &eff_operation_name, Optional<Int>::Some(eff_schema_version));
			base_url = _dup(&r.base_url);
			ok = true;
		} catch RunnerError(e) {
			console.eprintln(e.message);
		}
		if !ok {
			return _defer_dispatch(host.get(), &workflow_id, fencing_token, "pinned_contract_unavailable", admission);
		}
	}

	// --- 3. persist operation request + suspended continuation BEFORE dispatch ---
	val t_req = _now(host.get());
	match host.get().operation_request(&workflow_id, fencing_token, OPERATION_SEQ, &operation_id,
	                                   &eff_operation_name, eff_schema_version, &eff_input_json, &input_hash,
	                                   &"{\"pos\":\"op:1:dispatched\",\"operation_seq\":1}", &t_req, &"{}") {
		mf.OperationRequestOutcome::Requested(_) => {},
		mf.OperationRequestOutcome::Exists(_) => {},
		mf.OperationRequestOutcome::FenceLost => {
			// Requirement 2: lost the fence -> STOP, do NOT dispatch.
			return Outcome::Aborted(reason = "request_fence_lost", code = 3);
		},
		mf.OperationRequestOutcome::OperationConflict => {
			return Outcome::Aborted(reason = "operation_conflict", code = 3);
		},
		mf.OperationRequestOutcome::EventTimeSkew(defer_until) => {
			// Non-increasing timestamp = clock skew: release/defer until the last
			// accepted event time + margin, don't retry now.
			return _defer(host.get(), &workflow_id, fencing_token, &defer_until, "request_event_time_skew", admission);
		},
		default => {
			throw RunnerError(message = "operation_request unexpected outcome");
		}
	}

	// --- 4/5. dispatch (PUT), classifying the outcome (§5.2). 200 -> result;
	// 202/working or participant-unreachable -> PENDING, durably defer (release
	// the lease) until the next poll, never throw while holding it; 400/409 ->
	// definite rejection (abort, no poll/resubmit); transport/5xx -> reconcile. ---
	var result_json: String = "";
	match _classify_dispatch(&base_url, &eff_operation_name, &operation_id_hex, &eff_input_json) {
		DispatchResult::Done(r) => { result_json = move r; },
		DispatchResult::Pending => {
			// Not terminal yet: release the lease and become due again to re-poll.
			return _defer_pending(host.get(), &workflow_id, fencing_token, admission);
		},
		DispatchResult::Rejected(reason) => {
			// Definite rejection is NON-RETRYABLE: persist the failure (forward ->
			// blocked_resolution, lease cleared) so the workflow stops advancing and
			// cannot repeat after lease expiry. Never exit still forward/requested.
			return _fail_operation(host.get(), &workflow_id, fencing_token, &operation_id, move reason, admission);
		}
	}

	// --- 6. persist success + checkpoint + advanced continuation (workflow done) ---
	val t_settle = _now(host.get());
	var final_result: String = result_json.clone();
	match host.get().operation_settle(&workflow_id, fencing_token, OPERATION_SEQ, &operation_id, CHECKPOINT_SEQ,
	                                  &result_json, &result_json, &"{\"pos\":\"complete\"}", &t_settle, &"{}", true) {
		mf.OperationSettleOutcome::Settled(r) => { final_result = move r; },
		mf.OperationSettleOutcome::AlreadySettled(r) => {
			// Requirement 1: the stored result is AUTHORITATIVE.
			final_result = move r;
		},
		mf.OperationSettleOutcome::FenceLost => {
			return Outcome::Aborted(reason = "settle_fence_lost", code = 3);
		},
		mf.OperationSettleOutcome::EventTimeSkew(defer_until) => {
			return _defer(host.get(), &workflow_id, fencing_token, &defer_until, "settle_event_time_skew", admission);
		},
		default => {
			throw RunnerError(message = "operation_settle unexpected outcome");
		}
	}

	return Outcome::Completed(operation_id = _dup(&operation_id_hex), result = _dup(&final_result));
}

// Thin wrapper: load the single `--config` and drive (the original CLI mode).
fn _run(config_path: &String, workflow_hex: &String,
        operation_name: &String, input_json: &String,
        arguments_json: &String, has_arguments: Bool, admission: &AdmissionState) throws -> Outcome {
	val cfg = _load_config_json(config_path);
	return _run_cfg(&cfg, workflow_hex, operation_name, input_json, arguments_json, has_arguments, admission);
}

// ===== manifest-driven ScriptRegistry (roadmap item 3a: named, pinned, validated deployments) =====
//
// A deployment manifest declares a shared routing/deployment block plus NAMED scripts (each a `.mf`
// source path). The runner COMPILES the WHOLE declared set at startup — lower every `.mf` over the
// deployment, build+validate each revision — and FAILS FAST if any script is missing/unreadable/
// invalid or any name duplicates (the §4.1 "compile the entire declared set; startup fails if any
// fails" contract). A SUBMISSION names a script (`--script`); creation PINS its resolved immutable
// identity (script name + plan version + content_hash + plan_length). A RESUME drives strictly by the
// DURABLE pin — the script matching the pin's (name, version) — never the manifest's current active
// version (no silent substitution). One deployment block for now (per-script routing is a later
// refinement); atomic fleet/service activation is item 3b (the long-running service), not built here.
//
// Manifest shape:
//   { "deployment": { …db, participants, operations… },
//     "scripts": [ { "name": "checkout-v1", "version": "1.0.0", "path": "workflows/checkout.mf" }, … ] }
struct ManifestScript {
	pub name: String,
	pub version: String,
	pub cfg: json.JsonNode,          // lowered+merged runnable config (deployment ‖ plan/graph ‖ name/version)
	pub content_hash_hex: String,
	pub plan_length: Int
}
struct ManifestSet {
	pub deployment: json.JsonNode,
	pub scripts: Array<ManifestScript>
}

// The directory portion of a path (everything up to the last '/'), or "" if the path has no '/'.
fn _dirname(path: &String) nothrow -> String {
	val n = path.byte_length();
	var last = -1;
	var i = 0;
	while i < n { if cast<Int>(path.byte_at(i)) == 47 { last = i; } i = i + 1; }   // '/'
	if last <= 0 { if last == 0 { return "/"; } return ""; }
	var buf = io.buffer(last);
	var j = 0;
	while j < last { io.buffer_write(&mut buf, j, path.byte_at(j)); j = j + 1; }
	val ptr = io.buffer_ptr(&buf);
	return core.string_from_utf8_bytes(ptr, last);
}

// Resolve a manifest script path: an ABSOLUTE path (leading '/') is used as-is; a RELATIVE path is
// resolved against the MANIFEST FILE's directory (so a manifest is portable — not tied to the
// runner's cwd). A manifest with no directory component (bare name in cwd) leaves the path relative.
fn _resolve_script_path(manifest_path: &String, spath: &String) nothrow -> String {
	if spath.byte_length() > 0 and cast<Int>(spath.byte_at(0)) == 47 { return _dup(spath); }   // absolute
	val dir = _dirname(manifest_path);
	if dir.byte_length() == 0 { return _dup(spath); }
	return dir + "/" + _dup(spath);
}

// `base` with `script_name`/`plan_version` set to the manifest's declared identity, so the lowered
// config carries it into the revision + the durable pin. (A parsed JsonNode is immutable — rebuild.)
fn _deployment_for(base: &json.JsonNode, name: &String, version: &String) -> json.JsonNode {
	var o = json.new_object();
	var it = base.entries();
	var done = false;
	while !done {
		match it.next() {
			Optional::Some(entry) => {
				if !_str_eq(entry.key, &"script_name") and !_str_eq(entry.key, &"plan_version") {
					o.set(_dup(entry.key), entry.value.clone_deep());
				}
			},
			Optional::None => { done = true; }
		}
	}
	o.set("script_name", json.JsonNode::String(value = _dup(name)));
	o.set("plan_version", json.JsonNode::String(value = _dup(version)));
	return o.to_node();
}

// Load + COMPILE + VALIDATE the entire manifest. Fail-fast: a missing field, an unreadable/invalid
// script, or a duplicate name throws RunnerError (the caller surfaces it as a clean outcome).
fn _load_manifest(manifest_path: &String) throws -> ManifestSet {
	val raw = _read_text(manifest_path);
	var mjson = json.JsonNode::Null();
	match json.parse_strict(&raw) {
		core.Result::Ok(n) => { mjson = move n; },
		core.Result::Err(_) => { throw RunnerError(message = "manifest is not valid JSON"); }
	}
	var deployment = json.JsonNode::Null();
	match mjson.get(&"deployment") {
		Optional::Some(d) => { deployment = d.clone_deep(); },
		Optional::None => { throw RunnerError(message = "manifest missing 'deployment'"); }
	}
	var scripts: Array<ManifestScript> = [];
	match mjson.get(&"scripts") {
		Optional::Some(sn) => {
			match sn.as_array() {
				Optional::Some(arr) => {
					var i = 0;
					while i < arr.len {
						val name = _req_str(&arr[i], &"name", "script.name");
						val version = _req_str(&arr[i], &"version", "script.version");
						val spath = _req_str(&arr[i], &"path", "script.path");
						_validate_semver(&version);
						var d = 0;
						while d < scripts.len {
							if _str_eq(&scripts[d].name, &name) { throw RunnerError(message = "duplicate script name in manifest: " + _dup(&name)); }
							d = d + 1;
						}
						val rpath = _resolve_script_path(manifest_path, &spath);
						val source = _read_text(&rpath);
						val base2 = _deployment_for(&deployment, &name, &version);
						var merged = json.JsonNode::Null();
						match parser.lower(&source, &base2) {
							core.Result::Ok(m) => { merged = move m; },
							core.Result::Err(e) => { throw RunnerError(message = "script '" + _dup(&name) + "' failed to lower: " + _dup(&e.message)); }
						}
						_validate_registry(&merged);
						val reg = _registry_build(&merged);
						if reg.revisions.len == 0 { throw RunnerError(message = "script '" + _dup(&name) + "' produced no revision (empty plan/graph)"); }
						val chx = _bytes_to_hex(&reg.revisions[0].content_hash);
						val plen = reg.revisions[0].plan_length;
						scripts.push(ManifestScript(name = move name, version = move version, cfg = move merged, content_hash_hex = move chx, plan_length = plen));
						i = i + 1;
					}
				},
				Optional::None => { throw RunnerError(message = "manifest 'scripts' must be an array"); }
			}
		},
		Optional::None => { throw RunnerError(message = "manifest missing 'scripts'"); }
	}
	if scripts.len == 0 { throw RunnerError(message = "manifest declares no scripts"); }
	return ManifestSet(deployment = move deployment, scripts = move scripts);
}

fn _find_script(scripts: &Array<ManifestScript>, name: &String) nothrow -> Int {
	var i = 0;
	while i < scripts.len { if _str_eq(&scripts[i].name, name) { return i; } i = i + 1; }
	return -1;
}
fn _find_script_nv(scripts: &Array<ManifestScript>, name: &String, version: &String) nothrow -> Int {
	var i = 0;
	while i < scripts.len { if _str_eq(&scripts[i].name, name) and _str_eq(&scripts[i].version, version) { return i; } i = i + 1; }
	return -1;
}

// Resolve the ONE script a manifest request needs and drive it through `_run_core` (the shared-host
// boundary) — by `--script` for a SUBMISSION, or by the durable pin's (name, version) for a RESUME.
// Takes an already-built host + an already-loaded ManifestSet, so BOTH the one-shot CLI (`_run_manifest`)
// and the long-running service (which holds one shared host + an in-memory registry) reuse it.
fn _drive_manifest_request(host: &arc.Arc<mf.MicroflowsHost>, ms: &ManifestSet, workflow_hex: &String,
                           script_name: &String, has_script: Bool, operation_name: &String,
                           input_json: &String, arguments_json: &String, has_arguments: Bool,
                           admission: &AdmissionState) throws -> Outcome {
	if has_arguments {
		// SUBMISSION: name the script explicitly; creation pins its resolved identity.
		if !has_script { return Outcome::Aborted(reason = "script_required_for_submission", code = 2); }
		val sidx = _find_script(&ms.scripts, script_name);
		if sidx < 0 { return Outcome::Aborted(reason = "unknown_script", code = 2); }
		return _run_core(host, &ms.scripts[sidx].cfg, workflow_hex, operation_name, input_json, arguments_json, has_arguments, admission);
	}
	// RESUME: pick the script by the DURABLE pin (name, version) — never the active version.
	val workflow_id = _hex_to_bytes(workflow_hex);
	var pin_name = "";
	var pin_version = "";
	var pin_present = false;
	match host.get().plan_get(&workflow_id) {
		mf.PlanGetOutcome::Found(p) => { pin_name = _dup(&p.script_name); pin_version = _dup(&p.plan_version); pin_present = true; },
		mf.PlanGetOutcome::NotFound => {}
	}
	if !pin_present { return Outcome::Aborted(reason = "not_found", code = 2); }
	val ridx = _find_script_nv(&ms.scripts, &pin_name, &pin_version);
	if ridx < 0 {
		// The pinned revision is NOT in the current manifest. Do NOT short-circuit: drive the proven
		// STORAGE-FIRST planned path with the deployment-only config (no plan/graph), so the durable
		// pin governs state-sensitively — TERMINAL REPLAY reports from durable state
		// (registry-independent), and a CLAIMABLE workflow gets a DURABLE `revision_unavailable` defer
		// (lease cleared, admission-aware via _defer_dispatch), exactly as an absent pinned plan does on
		// the `--config` path. Never substitute.
		return _run_core(host, &ms.deployment, workflow_hex, operation_name, input_json, arguments_json, has_arguments, admission);
	}
	return _run_core(host, &ms.scripts[ridx].cfg, workflow_hex, operation_name, input_json, arguments_json, has_arguments, admission);
}

// Manifest mode (one-shot CLI): validate the whole set, build a host, then drive the one needed script.
// A bad manifest is a clean `invalid_manifest` outcome (exit 2).
fn _run_manifest(manifest_path: &String, workflow_hex: &String, script_name: &String, has_script: Bool,
                 operation_name: &String, input_json: &String, arguments_json: &String,
                 has_arguments: Bool, admission: &AdmissionState) throws -> Outcome {
	var ms_opt: Optional<ManifestSet> = Optional<ManifestSet>::None();
	try {
		ms_opt = Optional<ManifestSet>::Some(_load_manifest(manifest_path));
	} catch RunnerError(e) {
		console.eprintln("runner: invalid manifest: " + e.message);
		return Outcome::Aborted(reason = "invalid_manifest", code = 2);
	}
	match move ms_opt {
		Optional::Some(ms) => {
			val db_sub = _require_db(&ms.deployment);
			val worker_id = _config_str(&ms.deployment, &"worker_id", "runner-1");
			val identity = mf.identity_from_worker_name(&worker_id);
			var b = mf.new_host_builder();
			mf.with_json(&mut b, &db_sub);
			mf.with_identity(&mut b, move identity);
			val host = _build_host(move b);
			return _drive_manifest_request(&host, &ms, workflow_hex, script_name, has_script, operation_name, input_json, arguments_json, has_arguments, admission);
		},
		Optional::None => { return Outcome::Aborted(reason = "invalid_manifest", code = 2); }
	}
}

// ===== manual-IR forward PLAN execution (multi-operation) =====

// Run a workflow whose forward path is a manual-IR PLAN, loading the IR from the
// ScriptRegistry by the workflow's PINNED plan. State-sensitive ordering: the DURABLE
// pin was read STORAGE-FIRST by the caller. A SUBMISSION (--arguments supplied) validates+
// builds the registry and CREATES/REASSERTS the workflow with those instance arguments
// (an existing id with changed args → workflow_conflict). A RESUME (no --arguments) drives
// from the durable pin and never re-creates. TERMINAL REPLAY (a NotClaimable workflow)
// reports from durable state and is RESOLVED BEFORE the registry is ever built or validated
// — so a completed workflow replays its result even when current config is absent/malformed.
// Only a CLAIMED workflow builds+validates the registry to resolve+verify its pinned plan;
// a claimed REVERSING workflow unwinds instead.
fn _run_planned(host: &mf.MicroflowsHost, cfg: &json.JsonNode, workflow_id: &Array<Byte>,
                workflow_canon_hex: &String, storage_pin: &PinView,
                is_submission: Bool, args_json: &String, admission: &AdmissionState) -> Outcome {
	var pin_name: String = _dup(&storage_pin.name);
	var pin_version: String = _dup(&storage_pin.version);
	var pin_hash_hex: String = _dup(&storage_pin.hash_hex);
	var pin_len: Int = storage_pin.plan_length;
	// The pin is AUTHORITATIVE once it comes from a submission's create_planned (set below) or
	// a resume's storage-first read. A resume whose initial read found NO pin must RELOAD it
	// after claim (the plan_get→claim race), never resolve/report on an empty pin.
	var pin_loaded: Bool = is_submission or storage_pin.present;

	// The registry is built LAZILY — never before terminal replay. `reg_ready` tracks
	// whether `reg` holds the validated generation.
	var reg_empty: Array<ScriptRevision> = [];
	var reg = ScriptRegistry(revisions = move reg_empty);
	var reg_ready = false;

	// 1. SUBMISSION -> create/reassert: validate + build the registry (a submit legitimately
	//    requires valid config) and create + pin the ACTIVE generation with the supplied
	//    instance arguments. create_planned RESOLVES THE RACE (a concurrent winner returns its
	//    pin on Exists) AND enforces argument identity (workflow_conflict on changed args). A
	//    RESUME skips this entirely and drives from the durable pin.
	if is_submission {
		// Build + validate the active generation. A malformed deployment config (bad registry,
		// invalid plan, invalid/unknown-key argument_type, bad semver, ...) is reported as a
		// clean `invalid_config` (no durable state written) rather than a process-fatal crash —
		// distinguishable from unrelated faults.
		var cfg_ok = false;
		try {
			_validate_registry(cfg);
			_validate_plan(cfg);
			reg = _registry_build(cfg);
			cfg_ok = true;
		} catch RunnerError(e) {
			// EXPECTED config-validation failure (bad registry/plan/argument_type/semver). An
			// UNEXPECTED defect is NOT a RunnerError, so it propagates and fails loudly rather
			// than masquerading as invalid_config.
			console.eprintln(e.message);
		}
		if !cfg_ok {
			return Outcome::Aborted(reason = "invalid_config", code = 2);
		}
		reg_ready = true;
		// Resolve the active generation by the CONFIGURED plan name (not a constant), so
		// any configured name (e.g. checkout-v1) can create workflows.
		val active_name = _config_str(cfg, &"script_name", _dup(&SCRIPT_NAME));
		var has_active = false;
		var aidx = 0;
		match _registry_active(&reg, &active_name) { Optional::Some(i) => { aidx = i; has_active = true; }, Optional::None => {} }
		if !has_active {
			return Outcome::Aborted(reason = "no_active_revision", code = 2);
		}
		// VALIDATE the submitted instance arguments against the script's DECLARED argument type
		// BEFORE creating any durable state — but ONLY when creation may actually occur, i.e. a
		// FRESH submission (no durable pin). For an EXISTING workflow (reassertion), the
		// workflow is pinned to its OWN — possibly older — revision; validating against the
		// ACTIVE type would wrongly reject valid arguments after a rollout (v1 args vs v2 type).
		// Identity for an existing workflow is instead create_planned's byte-for-byte compare
		// against the DURABLE arguments (workflow_conflict on change).
		if !storage_pin.present {
			var args_err: Optional<String> = Optional<String>::None();
			// STRICT: a lenient parse keeps-last duplicate keys (so a duplicate could bypass the
			// type's field/closed-object checks) and accepts non-standard numbers.
			match json.parse_strict(args_json) {
				core.Result::Ok(node) => { args_err = ir.validate(&node, &reg.revisions[aidx].arg_type); },
				core.Result::Err(_) => { args_err = Optional<String>::Some("arguments are not valid JSON"); }
			}
			match args_err {
				Optional::Some(_) => {
					return Outcome::Aborted(reason = "invalid_arguments", code = 2);
				},
				Optional::None => {}
			}
		}
		val t_create = _now(host);
		// The submitted instance arguments (a validated JSON object). The host canonicalizes
		// them at the command boundary before storage/compare; their declared TYPE is already
		// folded into content_hash (the argument contract is part of revision identity).
		match host.create_planned(workflow_id, &reg.revisions[aidx].name, &reg.revisions[aidx].version,
		                          &t_create, &t_create, &"{\"pos\":\"start\"}", &"{}",
		                          &reg.revisions[aidx].content_hash, reg.revisions[aidx].plan_length,
		                          args_json) {
			mf.CreatePlannedOutcome::Created(p) => { pin_name = _dup(&p.script_name); pin_version = _dup(&p.plan_version); pin_hash_hex = _dup(&p.content_hash); pin_len = p.plan_length; },
			mf.CreatePlannedOutcome::Exists(p) => { pin_name = _dup(&p.script_name); pin_version = _dup(&p.plan_version); pin_hash_hex = _dup(&p.content_hash); pin_len = p.plan_length; },
			mf.CreatePlannedOutcome::PlanConflict(_) => {
				// The workflow_id exists under a CONTRADICTORY identity — a legacy non-plan
				// workflow, OR a DIFFERENT plan name (id collision across plans). No pin to
				// adopt; no lease taken; report + stop.
				return Outcome::Deferred(reason = "plan_conflict", defer_until = "", code = 9);
			},
			mf.CreatePlannedOutcome::WorkflowConflict(_) => {
				// Same plan name reused with DIFFERENT instance arguments — a different
				// instance, not an adoptable winner. No lease taken; report + stop.
				return Outcome::Deferred(reason = "workflow_conflict", defer_until = "", code = 9);
			}
		}
	}

	// 2. claim — now we hold a fence for any durable defer below.
	val clock = _clock(host);
	var fencing_token: Int = 0;
	var claimed_state: Int = 0;
	var not_claimable = false;
	match host.claim_workflow(workflow_id, &clock.now, &clock.deadline) {
		mf.ClaimByIdOutcome::Claimed(wf) => { fencing_token = wf.fencing_token; claimed_state = wf.state_code; },
		mf.ClaimByIdOutcome::NotFound => {
			// A submission just created (or adopted) the workflow, so absence here is a real
			// fault. A RESUME (no --arguments) of a workflow that does not exist is simply
			// not-found — report + stop, never create.
			if is_submission { throw RunnerError(message = "workflow absent after create"); }
			return Outcome::Aborted(reason = "not_found", code = 2);
		},
		mf.ClaimByIdOutcome::NotClaimable => { not_claimable = true; }
	}

	// RELOAD the authoritative pin when our initial read found none (the plan_get→claim race):
	// another executor may have created the workflow between our plan_get and our claim, so the
	// workflow now exists (we claimed it or saw it NotClaimable) but our pin is still empty.
	// Re-read it before any resolve/report — never use plan_length=0 or an empty pin.
	if !pin_loaded {
		match host.plan_get(workflow_id) {
			mf.PlanGetOutcome::Found(p) => {
				pin_name = _dup(&p.script_name); pin_version = _dup(&p.plan_version);
				pin_hash_hex = _dup(&p.content_hash); pin_len = p.plan_length; pin_loaded = true;
			},
			mf.PlanGetOutcome::NotFound => {
				// The workflow exists but carries no plan pin — a concurrently-created legacy /
				// non-plan workflow on this id. We cannot drive it as planned. If we hold a lease
				// from a SUCCESSFUL claim, RELEASE it (best-effort, with a near-term next-attempt
				// so a legacy worker reclaims it promptly) — never leak it. (A NotClaimable
				// observation took no lease.)
				if !not_claimable {
					val rclk = host.clock_read(PENDING_RETRY_SECONDS);
					match host.release(workflow_id, fencing_token, &rclk.now, &rclk.deadline) { default => {} }
				}
				return Outcome::Aborted(reason = "not_found", code = 2);
			}
		}
	}

	if not_claimable {
		// TERMINAL REPLAY / leased / deferred: report from DURABLE state — the (now reloaded)
		// pinned `plan_length` gives the final operation seq. Reached BEFORE any registry build
		// or `_validate_registry`, so it never depends on current participant/operation config.
		// node_id isn't available on this no-graph-walk path, so report the DURABLY-STORED final-op id
		// (node-address for planned, positional for legacy). Fall back to the positional derivation only
		// when the final op was never reached/stored (leased/deferred mid-flight) — a stable placeholder.
		var last_hex: String = "";
		match host.operation_request_get(workflow_id, pin_len) {
			mf.OperationRequestGetOutcome::Found(rec) => { last_hex = _bytes_to_hex(&rec.operation_id); },
			mf.OperationRequestGetOutcome::NotFound => { last_hex = _bytes_to_hex(&_operation_id(workflow_canon_hex, pin_len)); }
		}
		return _inspect_report(host, workflow_id, &last_hex, pin_len);
	}

	// 3. CLAIMED: NOW build + validate the registry (deferred past terminal replay). For a
	//    fresh create we already did; this covers the existing-claimed path. We hold the
	//    lease, so a MALFORMED/incomplete registry config MUST NOT leak it: catch the
	//    failure and durably defer `revision_unavailable` (lease released, recoverable),
	//    exactly as an absent pinned plan does — never exit still holding the lease.
	if !reg_ready {
		var ok = false;
		try {
			_validate_registry(cfg);
			reg = _registry_build(cfg);
			ok = true;
		} catch RunnerError(e) {
			// EXPECTED config-validation failure (malformed registry, bad semver, invalid
			// argument_type, ...) — we hold the lease, so durably defer revision_unavailable
			// (recoverable) rather than leak it. An UNEXPECTED defect is not a RunnerError and
			// propagates (fails loudly) instead of becoming an indefinite retry.
			console.eprintln(e.message);
		}
		if !ok {
			return _defer_dispatch(host, workflow_id, fencing_token, "revision_unavailable", admission);
		}
		reg_ready = true;
	}

	// 4. EXACT-MATCH resolve + verify the PINNED plan BEFORE choosing a direction
	//    (static-review item 3): resolve (name, plan_version) and verify content_hash AND
	//    length against the pin. Absent / mismatched -> durable revision_unavailable defer
	//    (we hold a fence), NEVER substitute — for BOTH forward and reverse, so a
	//    reversing workflow can never unwind compensation under a plan that isn't its
	//    pinned one. Under v1's single verified generation, cfg IS the pinned plan, so the
	//    forward dispatcher + reverse unwind below read compensation from the plan the pin
	//    guarantees.
	var has_rev = false;
	var ridx = 0;
	match _registry_resolve(&reg, &pin_name, &pin_version) { Optional::Some(i) => { ridx = i; has_rev = true; }, Optional::None => {} }
	if !has_rev {
		return _defer_dispatch(host, workflow_id, fencing_token, "revision_unavailable", admission);
	}
	val rev_hash_hex = _bytes_to_hex(&reg.revisions[ridx].content_hash);
	if !_str_eq(&rev_hash_hex, &pin_hash_hex) or reg.revisions[ridx].plan_length != pin_len {
		return _defer_dispatch(host, workflow_id, fencing_token, "revision_unavailable", admission);
	}

	// Pinned plan verified. A claimed REVERSING workflow unwinds; otherwise dispatch
	// forward. Both bind their operations from the verified pinned plan.
	if claimed_state == STATE_REVERSING {
		return _run_reversal(host, cfg, workflow_id, workflow_canon_hex, fencing_token, admission);
	}
	val ch_hex = _bytes_to_hex(&reg.revisions[ridx].content_hash);
	return _run_forward(host, cfg, workflow_id, workflow_canon_hex, fencing_token, &reg.revisions[ridx].graph, reg.revisions[ridx].plan_length, &ch_hex, admission);
}

// ===== ScriptRegistry build + lookup (v1: one configured generation per process) =====

// Build the in-process registry from config: ONE generation, a single revision
// `(script_name, plan_version)` whose IR is the config plan. The name + version come
// from config ("script_name" / "plan_version", defaulting to SCRIPT_NAME /
// PLAN_VERSION_DEFAULT) so different deployments genuinely carry different generations.
// The version is validated as an immutable semver (major.minor.patch). v1 does NOT
// retain multiple revisions — that, plus activation/reload, is a future evolution.
// A PLANNED config carries the IR as either a flat "plan" or a manual-IR "graph" (presence-only
// check; the actual parse/validate happens in _registry_build). Distinguishes planned workflows
// (which take --arguments + a content-hash-pinned revision) from the legacy single-op path.
fn _is_planned_config(cfg: &json.JsonNode) nothrow -> Bool {
	match cfg.get(&"graph") { Optional::Some(_) => { return true; }, Optional::None => {} }
	match cfg.get(&"plan") { Optional::Some(_) => { return true; }, Optional::None => {} }
	return false;
}

fn _registry_build(cfg: &json.JsonNode) -> ScriptRegistry {
	var revs: Array<ScriptRevision> = [];
	// The revision IR comes from EITHER an explicit manual-IR "graph" config (non-degenerate
	// shapes) OR the flat "plan" lifted to a degenerate straight-line graph. Neither present ->
	// no revision (legacy single-op path).
	var graph_opt: Optional<ir.IrGraph> = Optional<ir.IrGraph>::None();
	match cfg.get(&"graph") {
		Optional::Some(gnode) => {
			match ir.parse_graph(gnode) {
				core.Result::Ok(g) => { graph_opt = Optional<ir.IrGraph>::Some(move g); },
				core.Result::Err(e) => { throw RunnerError(message = "invalid graph config: " + e.message); }
			}
		},
		Optional::None => {
			match _build_plan(cfg) {
				Optional::Some(plan) => { graph_opt = Optional<ir.IrGraph>::Some(_build_graph(&plan)); },
				Optional::None => {}
			}
		}
	}
	match move graph_opt {
		Optional::Some(graph) => {
			val name = _config_str(cfg, &"script_name", _dup(&SCRIPT_NAME));
			val version = _config_str(cfg, &"plan_version", _dup(&PLAN_VERSION_DEFAULT));
			_validate_semver(&version);
			// The script's declared closed-object argument type (default the empty object).
			// It ALWAYS participates in content_hash (the argument contract is part of the
			// revision identity — never elided/conditional).
			val arg_type = _arg_type(cfg);
			// VALIDATE the graph. A malformed graph -> RunnerError, surfaced by the existing build
			// catches as invalid_config (submission, pre-claim) or revision_unavailable (resume,
			// post-claim) — never executing an ill-formed graph.
			match ir.validate_graph(&graph) {
				Optional::Some(m) => { throw RunnerError(message = "invalid graph: " + move m); },
				Optional::None => {}
			}
			// Reject non-executable shapes (loops; op-unbalanced branches) at build, BEFORE any
			// claim, and derive plan_length = the uniform per-path operation count.
			val plan_length = _assert_executable(&graph);
			// Reject non-reversible graphs: every non-final operation must be compensable (mirrors
			// the flat-plan rule, generalized over branches), so reversal can never strand.
			_assert_reversible(cfg, &graph);
			// TYPE-check the graph against the declared argument type + operation contracts. A type
			// error is a config error (invalid_config / revision_unavailable), never a dispatch.
			val contracts = _op_contracts(cfg);
			match ir.type_check_graph(&graph, &arg_type, &contracts) {
				Optional::Some(m) => { throw RunnerError(message = "graph type error: " + move m); },
				Optional::None => {}
			}
			// Compensation type cross-check is a NO-OP under the envelope model (E): a compensation receives
			// the standard forward-context envelope, not the forward op's input directly, so its declared
			// input type is not cross-linked to the forward op's (types still fold into the content_hash via
			// _content_hash). Call kept so the registry-build pipeline is unchanged.
			_assert_compensation_types(cfg, &graph);
			val ch = _content_hash(cfg, &graph, &arg_type);
			revs.push(ScriptRevision(name = move name, version = move version,
			                         graph = move graph, arg_type = move arg_type,
			                         content_hash = ch, plan_length = plan_length));
		},
		Optional::None => {}
	}
	return ScriptRegistry(revisions = move revs);
}

// The script's declared closed-object argument type, from config "argument_type" (a type
// encoding). Absent -> the empty closed object `{}`. A malformed declaration becomes a
// RunnerError (so the existing build catch surfaces/defers it, never leaking a lease).
fn _arg_type(cfg: &json.JsonNode) -> ir.IrType {
	match cfg.get(&"argument_type") {
		Optional::Some(n) => {
			match ir.parse_object_type(n) {
				core.Result::Ok(ty) => { return move ty; },
				core.Result::Err(_) => { throw RunnerError(message = "invalid argument_type"); }
			}
		},
		Optional::None => { return ir.empty_object_type(); }
	}
}

// Build the operation CONTRACTS (input/result types) from the config's operations registry. Each
// type is OPTIONAL — an operation that declares neither is unchecked (so untyped configs behave
// exactly as before). A malformed type declaration -> RunnerError (invalid_config / deferred).
fn _op_contracts(cfg: &json.JsonNode) -> Array<ir.OpContract> {
	var out: Array<ir.OpContract> = [];
	match cfg.get(&"operations") {
		Optional::Some(on) => {
			match on.as_array() {
				Optional::Some(items) => {
					var i = 0;
					while i < items.len {
						val nm = _req_str(&items[i], &"name", "operation.name");
						out.push(ir.OpContract(name = move nm,
						                       input_type = _op_type_opt(&items[i], &"input_type"),
						                       result_type = _op_type_opt(&items[i], &"result_type")));
						i = i + 1;
					}
				},
				Optional::None => {}
			}
		},
		Optional::None => {}
	}
	return move out;
}

// Parse an OPTIONAL declared type at `key` on an operation entry. Absent -> None. Malformed ->
// RunnerError (surfaced as invalid_config / revision_unavailable by the build catch).
fn _op_type_opt(item: &json.JsonNode, key: &String) -> Optional<ir.IrType> {
	match item.get(key) {
		Optional::Some(tn) => {
			var ty: ir.IrType = ir.empty_object_type();
			// parse_type throws ir.IrError; a typed catch can't project its `message` here, so use a
			// catch-all and re-raise as a RunnerError (surfaced as invalid_config / deferred).
			try { ty = ir.parse_type(tn); } catch { throw RunnerError(message = "invalid '" + _dup(key) + "' type declaration"); }
			return Optional<ir.IrType>::Some(move ty);
		},
		Optional::None => { return Optional<ir.IrType>::None(); }
	}
}

// The active generation for a script (v1: the single built revision matching the name).
fn _registry_active(reg: &ScriptRegistry, name: &String) -> Optional<Int> {
	var i = 0;
	while i < reg.revisions.len {
		if _str_eq(&reg.revisions[i].name, name) { return Optional<Int>::Some(i); }
		i = i + 1;
	}
	return Optional<Int>::None();
}

// EXACT-MATCH resolve a pinned plan by (name, version). v1 selection is exact-match on
// the version string (no semver ranges yet); the caller additionally verifies
// content_hash + length. None -> revision_unavailable.
fn _registry_resolve(reg: &ScriptRegistry, name: &String, version: &String) -> Optional<Int> {
	var i = 0;
	while i < reg.revisions.len {
		if _str_eq(&reg.revisions[i].name, name) and _str_eq(&reg.revisions[i].version, version) {
			return Optional<Int>::Some(i);
		}
		i = i + 1;
	}
	return Optional<Int>::None();
}

// Validate an immutable plan version is a well-formed semantic version
// major.minor.patch: exactly three dot-separated, non-empty, all-numeric components (no
// pre-release / build-metadata labels in v1). Throws RunnerError on a malformed version.
fn _validate_semver(version: &String) -> Void {
	val n = version.byte_length();
	var dots = 0;
	var comp_len = 0;   // bytes in the current component
	var i = 0;
	while i < n {
		val c = version.byte_at(i);
		if c == 46 {        // '.'
			if comp_len == 0 { throw RunnerError(message = "invalid plan_version (empty component): " + _dup(version)); }
			dots = dots + 1;
			comp_len = 0;
		} else if c >= 48 and c <= 57 {   // '0'..'9'
			comp_len = comp_len + 1;
		} else {
			throw RunnerError(message = "invalid plan_version (non-numeric component): " + _dup(version));
		}
		i = i + 1;
	}
	if dots != 2 or comp_len == 0 {
		throw RunnerError(message = "invalid plan_version (need major.minor.patch): " + _dup(version));
	}
}

// `content_hash` = collision-resistant, versioned digest of a revision's IR: a 1-byte
// scheme tag (0x01) followed by SHA-256 over the canonical encoding = 33 bytes. This is
// the immutable identity the runner verifies against the durable pin ("never substitute").
// NOT the per-operation `input_hash` (UUID-v3, participant idempotency).
//
// The hashed material is the GRAPH IDENTITY: `graph_canonical` (graph shape — node ids, edges,
// branch targets, loop bodies, per-op name + canonical input) ‖ the per-NOperation RESOLUTION
// bindings (schema_version + participant + compensation) ‖ the declared argument TYPE. Key order
// in input/arg JSON never affects it (everything is canonicalized), so identity tracks graph
// SEMANTICS, not raw spelling.
fn _content_hash(cfg: &json.JsonNode, graph: &ir.IrGraph, arg_type: &ir.IrType) -> Array<Byte> {
	val canonical = ir.graph_canonical(graph) + _graph_bindings(cfg, graph) + ir.canonical(arg_type);
	val msg = _str_bytes(&canonical);
	val digest = crypto.sha256(&msg);   // 32 bytes
	var out: Array<Byte> = [];
	// Scheme tag 0x01 (versioned digest scheme), built via hex_decode so we never push
	// an Int literal into Array<Byte>.
	match codec.hex_decode(&"01") {
		core.Result::Ok(tag) => { out.push(tag[0]); },
		core.Result::Err(_) => { throw RunnerError(message = "content-hash scheme tag decode failed"); }
	}
	var i = 0;
	while i < digest.len { out.push(digest[i]); i = i + 1; }
	return move out;
}

// Per-NOperation RESOLUTION bindings appended after `graph_canonical`: the RESOLVED operation
// (schema_version + logical participant id) + compensation binding (operation + version +
// participant id). `graph_canonical` already carries the op NAME + canonical input + structure;
// this adds the resolved deployment bindings that the config-only graph encoding cannot know.
// Iterated in `ir.operation_names` order — the SAME sorted-by-node-id order graph_canonical uses
// — so the suffix is declaration-order-independent and stays in sync with the graph encoding even
// when node tables are reordered (non-degenerate graphs).
fn _graph_bindings(cfg: &json.JsonNode, graph: &ir.IrGraph) -> String {
	val ops = ir.operation_names(graph);
	var s: String = "";
	var i = 0;
	while i < ops.len {
		val r = _resolve_operation(cfg, &ops[i], Optional<Int>::None());
		var comp_op: String = "";
		var comp_sv: Int = 0;
		var comp_part: String = "";
		match _compensation_for(cfg, &ops[i]) {
			Optional::Some(c) => {
				comp_op = _dup(&c.op_name); comp_sv = c.schema_version;
				comp_part = _dup(&_resolve_operation(cfg, &comp_op, Optional<Int>::None()).participant_id);
			},
			Optional::None => {}   // a final / single-op step may have no compensation.
		}
		val sv_str = fmt.format_int(r.schema_version);
		val comp_sv_str = fmt.format_int(comp_sv);
		s = s + _lp(&sv_str) + _lp(&r.participant_id)
		      + _lp(&comp_op) + _lp(&comp_sv_str) + _lp(&comp_part);
		// Declared TYPE contract participates in identity (so a changed type -> different hash ->
		// revision_unavailable on resume, never a silent substitution). Tagged + appended ONLY when
		// present, so an UNTYPED operation yields the identical binding string as before (existing
		// hashes — flat plans, untyped graphs — are unchanged). The COMPENSATION op's contract is
		// executable workflow semantics too, so its type tags are included (lowercase) when present.
		match _op_type_canon(cfg, &ops[i], &"input_type") { Optional::Some(c) => { s = s + "I" + _lp(&c); }, Optional::None => {} }
		match _op_type_canon(cfg, &ops[i], &"result_type") { Optional::Some(c) => { s = s + "R" + _lp(&c); }, Optional::None => {} }
		if comp_op.byte_length() > 0 {
			match _op_type_canon(cfg, &comp_op, &"input_type") { Optional::Some(c) => { s = s + "i" + _lp(&c); }, Optional::None => {} }
			match _op_type_canon(cfg, &comp_op, &"result_type") { Optional::Some(c) => { s = s + "r" + _lp(&c); }, Optional::None => {} }
		}
		i = i + 1;
	}
	return move s;
}

// Canonical encoding of an operation's OPTIONAL declared type at `key`, or None if undeclared.
// Malformed -> RunnerError (same surfacing as _op_type_opt).
fn _op_type_canon(cfg: &json.JsonNode, opname: &String, key: &String) -> Optional<String> {
	match cfg.get(&"operations") {
		Optional::Some(on) => {
			match on.as_array() {
				Optional::Some(items) => {
					var i = 0;
					while i < items.len {
						val nm = _req_str(&items[i], &"name", "operation.name");
						if _str_eq(&nm, opname) {
							match _op_type_opt(&items[i], key) {
								Optional::Some(ty) => { return Optional<String>::Some(ir.canonical(&ty)); },
								Optional::None => { return Optional<String>::None(); }
							}
						}
						i = i + 1;
					}
				},
				Optional::None => {}
			}
		},
		Optional::None => {}
	}
	return Optional<String>::None();
}

// E (envelope model): a compensation receives the standard forward-context envelope
// {forward:{input,result,...}}, NOT the forward op's input directly — so its declared input type is no
// longer cross-linked to the forward op's input type. Structural/opaque v1: the coordinator validates
// the envelope SHAPE at the boundary (and folds the comp's declared types into the content_hash, see
// _registry content_hash), but does NOT cross-check comp-input == forward-input. No-op, kept so the
// registry-build call site is unchanged.
fn _assert_compensation_types(cfg: &json.JsonNode, graph: &ir.IrGraph) -> Void {
	val _ = cfg;
	val _ = graph;
}

// Build the degenerate straight-line graph from the flat plan (inputs canonicalized into each
// EConst). A malformed input constant -> RunnerError (defensive: `_build_plan` already validated
// each input as a JSON object).
fn _build_graph(plan: &Array<PlanStep>) -> ir.IrGraph {
	var steps: Array<ir.FlatStep> = [];
	var i = 0;
	while i < plan.len {
		steps.push(ir.FlatStep(operation = _dup(&plan[i].operation), input_json = _dup(&plan[i].input_json)));
		i = i + 1;
	}
	match ir.flat_to_graph(&steps) {
		core.Result::Ok(g) => { return move g; },
		core.Result::Err(e) => { throw RunnerError(message = "graph build failed: " + e.message); }
	}
}

// The forward driver executes operation / let / if / case / return / loop nodes. NLoop is a FINITE
// ARRAY EXPRESSION (map/filter/fold): a pure, non-suspending value step (no operation seq, no
// durable write), so it does not affect the uniform per-path operation count. The driver requires
// that UNIFORM count so the durable execution-position seq lands the final op at seq ==
// plan_length (the storage layer's finality derivation). Returns plan_length (the uniform op
// count); throws RunnerError on an op-unbalanced branch. Called at registry build so rejection is
// BEFORE any claim (invalid_config / revision_unavailable, no lease leak).
fn _assert_executable(graph: &ir.IrGraph) -> Int {
	match ir.op_depth(graph) {
		core.Result::Ok(d) => { return d; },
		core.Result::Err(e) => { throw RunnerError(message = "graph not executable: " + e.message); }
	}
}

// Every NON-FINAL operation (one that executes before the final position on its path, so a later
// op can still fail and begin reversal) MUST declare a compensation binding — else a reversal
// would strand at no_compensation_binding. Mirrors _validate_plan's flat-plan rule, generalized
// over the graph (covers branches). Throws RunnerError at registry build (before any claim).
fn _assert_reversible(cfg: &json.JsonNode, graph: &ir.IrGraph) -> Void {
	match ir.nonfinal_operations(graph) {
		core.Result::Ok(ops) => {
			var i = 0;
			while i < ops.len {
				match _compensation_for(cfg, &ops[i]) {
					Optional::Some(_) => {},
					Optional::None => {
						throw RunnerError(message = "non-final operation '" + _dup(&ops[i])
							+ "' has no compensation binding — it must be reversible");
					}
				}
				i = i + 1;
			}
		},
		core.Result::Err(e) => { throw RunnerError(message = "graph reversibility check: " + e.message); }
	}
}

// Canonical compact JSON: parse + re-encode with lexicographic UTF-8 key ordering, so a
// value's identity is independent of key spelling/order in config.
fn _canonical_json(input_json: &String) -> String {
	val cfg = json.JsonConfig(key_order = json.JsonKeyOrder::OrderedLexUtf8());
	match json.parse_strict(input_json) {
		core.Result::Ok(n) => { return json.encode_compact_with_config(&n, &cfg); },
		core.Result::Err(_) => { throw RunnerError(message = "plan step input is not valid JSON"); }
	}
}

fn _str_bytes(s: &String) nothrow -> Array<Byte> {
	val n = s.byte_length();
	var out: Array<Byte> = [];
	var i = 0;
	while i < n { out.push(s.byte_at(i)); i = i + 1; }
	return move out;
}

// Length-prefix one field: "{byte_length}:{value};" — so concatenated fields can't
// collide across a hashed tuple.
fn _lp(s: &String) nothrow -> String {
	return fmt.format_int(s.byte_length()) + ":" + _dup(s) + ";";
}

// Drive the forward plan: for each step (operation_seq = index + 1) recover-or-fresh
// from durable state, persist the request, dispatch via the GENERIC dispatcher, and
// settle (intermediate or final). A definite rejection of ANY operation BEGINS
// reversal and unwinds in the same drive: any prior compensable checkpoints are
// compensated, and with none (e.g. the FIRST operation rejected) it reaches `reversed`
// immediately — never `blocked_resolution` for a definite forward rejection.
fn _run_forward(host: &mf.MicroflowsHost, cfg: &json.JsonNode, workflow_id: &Array<Byte>,
                workflow_canon_hex: &String, fencing_token: Int, graph: &ir.IrGraph, plan_length: Int, content_hash_hex: &String, admission: &AdmissionState) -> Outcome {
	val n = plan_length;
	var final_result: String = "{}";
	var last_op_id_hex: String = "";

	// Durable arguments. A planned workflow ALWAYS has its arguments child — create_planned writes
	// tb_mf_workflow_args atomically with the workflow. A MISSING args row is therefore
	// inconsistent durable state, NOT a valid empty-args object: never replay/dispatch on it.
	// Defer (release the lease — no dispatch, no lease leak) rather than silently use "{}".
	var args: String = "{}";
	var have_args = false;
	match host.args_get(workflow_id) {
		mf.ArgsGetOutcome::Found(a) => { args = move a; have_args = true; },
		mf.ArgsGetOutcome::NotFound => {}
	}
	if !have_args {
		return _defer_dispatch(host, workflow_id, fencing_token, "planned_args_missing", admission);
	}

	// Settled operation results, fed to `advance` so it replays past them. Built INCREMENTALLY as
	// replay reaches each operation: the durable seq is the EXECUTION POSITION (settled.len+1), and
	// the result is mapped back to whatever IR node id advance chose for THIS path — so branching
	// works without any positional node-id assumption.
	var settled: Array<ir.OpResult> = [];

	// REPLAY pure control flow to the next durable boundary, EXECUTE that operation, repeat until
	// replay reaches the terminal NReturn (`Completed`). The bound is purely defensive (a
	// validated graph is acyclic, so this terminates within plan_length steps).
	var guard = 0;
	while guard < n + 4 {
		guard = guard + 1;
		match ir.advance(graph, &args, &settled) {
			ir.StepOutcome::Completed(result) => {
				// All operations settled. Report completion per the existing final-op result
				// rules (the LAST settled op's result + its operation_id), NOT the graph's unit
				// return value.
				return Outcome::Completed(operation_id = _dup(&last_op_id_hex), result = _dup(&final_result));
			},
			ir.StepOutcome::Fault(m) => {
				// A validated graph should not Fault here. Treat defensively — never execute on a
				// broken replay; defer (release the lease) rather than corrupt durable state.
				console.eprintln("graph replay fault: " + m);
				return _defer_dispatch(host, workflow_id, fencing_token, "graph_replay_fault", admission);
			},
			ir.StepOutcome::NeedOperation(node_id, op, input) => {
				// Durable seq = EXECUTION POSITION on the taken path (settled.len+1); ops settle
				// contiguously (the DB enforces predecessor-settled). Build validation guarantees a
				// UNIFORM op count per path (op_depth == plan_length), so the path's final op lands
				// at seq == plan_length, matching the storage layer's finality derivation.
				val seq = settled.len + 1;
				// Already durably settled (resume)? Feed its result back into replay — keyed by the
				// node id advance chose for THIS execution position — and re-advance; never
				// re-dispatch. (Pure control flow before it is replayed, never persisted.)
				var prior_done = false;
				match host.operation_result(workflow_id, seq) {
					mf.OperationResultOutcome::Succeeded(r) => {
						// ADOPT the durably-stored operation id (authoritative), never re-derive: an op
						// settled under a PRIOR id scheme must report exactly that stored id on resume, not
						// a freshly-derived node-address id (migration-safety). A settled op with no request
						// row is a durable inconsistency -- defer, don't mint a new external id.
						match host.operation_request_get(workflow_id, seq) {
							mf.OperationRequestGetOutcome::Found(rec) => { last_op_id_hex = _bytes_to_hex(&rec.operation_id); },
							mf.OperationRequestGetOutcome::NotFound => {
								return _defer_dispatch(host, workflow_id, fencing_token, "settled_op_request_missing", admission);
							}
						}
						settled.push(ir.OpResult(node_id = _dup(node_id), result_json = _dup(&r)));
						final_result = move r;
						prior_done = true;
					},
					mf.OperationResultOutcome::Requested => {},
					mf.OperationResultOutcome::NotFound => {}
				}
				if prior_done { continue; }
				var is_final = false;
				if seq == n { is_final = true; }

				// Recover the durable request for this seq, or derive it from the graph step's
				// operation + canonical input. The durable request (if any) is authoritative — a
				// restarted worker must not depend on re-deriving identical fields.
				var op_name: String = "";
				var input_json: String = "";
				var schema_version: Int = 0;
				var operation_id: Array<Byte> = _operation_id_node(workflow_canon_hex, content_hash_hex, node_id);
				var input_hash: String = "";
				var recovered = false;
				match host.operation_request_get(workflow_id, seq) {
					mf.OperationRequestGetOutcome::Found(rec) => {
						recovered = true;
						op_name = _dup(&rec.operation_name);
						input_json = _dup(&rec.input_json);
						schema_version = rec.schema_version;
						operation_id = _copy_bytes(&rec.operation_id);
						input_hash = _dup(&rec.input_hash);
					},
					mf.OperationRequestGetOutcome::NotFound => {
						op_name = _dup(op);
						input_json = _dup(input);
						input_hash = _input_hash(&input_json);
					}
				}
				val operation_id_hex = _bytes_to_hex(&operation_id);

				// Resolve the operation; pin the durable schema_version on a resume.
				var base_url: String = "";
				var ok = false;
				var pinned: Optional<Int> = Optional<Int>::None();
				if recovered { pinned = Optional<Int>::Some(schema_version); }
				try {
					val r = _resolve_operation(cfg, &op_name, pinned);
					schema_version = r.schema_version;
					base_url = _dup(&r.base_url);
					ok = true;
				} catch RunnerError(e) { console.eprintln(e.message); }
				if !ok {
					return _defer_dispatch(host, workflow_id, fencing_token, "pinned_contract_unavailable", admission);
				}

				// Persist the request (idempotent: a resume re-requests the same identity and gets
				// Exists) + the suspended continuation BEFORE dispatch.
				val cont_dispatch = "{\"pos\":\"op:" + fmt.format_int(seq) + ":dispatched\",\"operation_seq\":" + fmt.format_int(seq) + "}";
				val t_req = _now(host);
				match host.operation_request(workflow_id, fencing_token, seq, &operation_id,
				                             &op_name, schema_version, &input_json, &input_hash,
				                             &cont_dispatch, &t_req, &"{}") {
					mf.OperationRequestOutcome::Requested(_) => {},
					mf.OperationRequestOutcome::Exists(_) => {},
					mf.OperationRequestOutcome::FenceLost => {
						return Outcome::Aborted(reason = "request_fence_lost", code = 3);
					},
					mf.OperationRequestOutcome::OperationConflict => {
						return Outcome::Aborted(reason = "operation_conflict", code = 3);
					},
					mf.OperationRequestOutcome::PlanViolation(reason) => {
						// The request is out of the pinned plan (seq range / predecessor not
						// settled). Stop BEFORE dispatch — never a remote side effect out of order.
						return Outcome::Aborted(reason = "request_plan_violation:" + move reason, code = 8);
					},
					mf.OperationRequestOutcome::EventTimeSkew(defer_until) => {
						return _defer(host, workflow_id, fencing_token, &defer_until, "request_event_time_skew", admission);
					},
					default => {
						throw RunnerError(message = "operation_request unexpected outcome");
					}
				}

				// Dispatch through the generic dispatcher. A RECOVERED request (durable from a
				// prior drive) reconciles GET-first; a FRESH request is PUT-first.
				match _dispatch_or_reconcile(recovered, &base_url, &op_name, &operation_id_hex, &input_json) {
					DispatchResult::Done(r) => {
						// Checkpoint payload = the operation INPUT (what compensation needs to
						// reverse it); the result is recorded separately + fed back into replay.
						val t_settle = _now(host);
						var cont_settle = "{\"pos\":\"complete\"}";
						if !is_final { cont_settle = "{\"pos\":\"op:" + fmt.format_int(seq) + ":settled\",\"next_operation_seq\":" + fmt.format_int(seq + 1) + "}"; }
						match host.operation_settle(workflow_id, fencing_token, seq, &operation_id, seq,
						                            &r, &input_json, &cont_settle, &t_settle, &"{}", is_final) {
							mf.OperationSettleOutcome::Settled(res) => {
								last_op_id_hex = _dup(&operation_id_hex);
								settled.push(ir.OpResult(node_id = _dup(node_id), result_json = _dup(&res)));
								final_result = move res;
							},
							mf.OperationSettleOutcome::AlreadySettled(res) => {
								last_op_id_hex = _dup(&operation_id_hex);
								settled.push(ir.OpResult(node_id = _dup(node_id), result_json = _dup(&res)));
								final_result = move res;
							},
							mf.OperationSettleOutcome::FenceLost => {
								return Outcome::Aborted(reason = "settle_fence_lost", code = 3);
							},
							mf.OperationSettleOutcome::PlanViolation(reason) => {
								// The settle is outside the pinned plan (seq/checkpoint/finality): a
								// runner/plan inconsistency, never silently settle. Stop and report.
								return Outcome::Aborted(reason = "settle_plan_violation:" + move reason, code = 8);
							},
							mf.OperationSettleOutcome::EventTimeSkew(defer_until) => {
								return _defer(host, workflow_id, fencing_token, &defer_until, "settle_event_time_skew", admission);
							},
							default => {
								throw RunnerError(message = "operation_settle unexpected outcome");
							}
						}
					},
					DispatchResult::Pending => {
						return _defer_pending(host, workflow_id, fencing_token, admission);
					},
					DispatchResult::Rejected(reason) => {
						// A DEFINITE forward rejection ALWAYS begins reversal (the model: every
						// definite forward failure reverses). begin_reversal unwinds any prior
						// compensable checkpoints; with NONE (e.g. the first operation rejected) it
						// reaches `reversed` immediately. Never `blocked_resolution` for a definite
						// forward rejection — that is reserved for an UNCERTAIN forward outcome.
						return _begin_reversal_unwind(host, cfg, workflow_id, workflow_canon_hex, fencing_token, seq, &operation_id, move reason, admission);
					}
				}
			}
		}
	}

	// Defensive: a validated acyclic graph reaches Completed within plan_length steps.
	console.eprintln("forward drive exceeded step budget");
	return _defer_dispatch(host, workflow_id, fencing_token, "forward_budget_exceeded", admission);
}

// A definite forward failure with a compensable checkpoint stack: transition
// forward -> reversing (or straight to reversed when nothing is compensable) via the
// existing begin_reversal transition, then drive the unwind in the SAME claim. The
// trigger operation is still status=requested (rejected, never settled), which
// begin_reversal requires.
fn _begin_reversal_unwind(host: &mf.MicroflowsHost, cfg: &json.JsonNode, workflow_id: &Array<Byte>,
                          workflow_canon_hex: &String, fencing_token: Int, operation_seq: Int,
                          operation_id: &Array<Byte>, reason: String, admission: &AdmissionState) -> Outcome {
	val t = _now(host);
	match host.begin_reversal(workflow_id, fencing_token, operation_seq, operation_id, &t, &reason) {
		mf.BeginReversalOutcome::Reversing(_) => {
			return _run_reversal(host, cfg, workflow_id, workflow_canon_hex, fencing_token, admission);
		},
		mf.BeginReversalOutcome::Reversed => {
			// No active checkpoints: a trivial unwind (nothing to compensate).
			return Outcome::Reversed();
		},
		mf.BeginReversalOutcome::AlreadyBegun(state) => {
			// Idempotent replay of a committed begin: resume from the recorded state.
			if state == STATE_REVERSING {
				return _run_reversal(host, cfg, workflow_id, workflow_canon_hex, fencing_token, admission);
			}
			if state == STATE_REVERSED {
				return Outcome::Reversed();
			}
			return Outcome::Blocked(reason = "");
		},
		mf.BeginReversalOutcome::FenceLost => {
			return Outcome::ReverseAborted(reason = "begin_reversal_fence_lost", code = 7);
		},
		mf.BeginReversalOutcome::EventTimeSkew(defer_until) => {
			return _defer(host, workflow_id, fencing_token, &defer_until, "begin_reversal_skew", admission);
		},
		default => {
			// trigger_mismatch / operation_not_found / operation_conflict /
			// operation_not_failed / not_found: a durable-state inconsistency, not a
			// retryable condition. Report and stop.
			return Outcome::ReverseAborted(reason = "begin_reversal_precondition", code = 8);
		}
	}
}

// ===== HTTP dispatch =====

// A PUT either gets an HTTP response (any status) or fails at the transport
// level (timeout / disconnect) — a genuinely uncertain outcome: the participant
// MAY have committed. TransportFailed -> reconcile by GET.
pub variant PutOutcome { Responded(status: Int, body: String), TransportFailed }

// A GET observes the durable participant state, classified by status — only
// 202 is pending; 400/409 are definite rejections; 5xx/unreadable/unreachable
// are transport-uncertain.
pub variant GetOutcome {
	Terminal(result: String),    // 200 terminal result
	Pending,                     // 202 accepted / working, not terminal
	Unknown,                     // 404 no record
	Rejected(reason: String),    // 400 / 409 definite protocol rejection
	TransportFailed              // 5xx / unreadable body / unreachable
}

// The classified dispatch result fed back to the workflow loop:
//   Done     -> a terminal result to settle
//   Pending  -> not terminal (or unreachable); durably defer and re-poll later
//   Rejected -> definite protocol rejection; abort
pub variant DispatchResult { Done(result: String), Pending, Rejected(reason: String) }

fn _op_url(base: &String, operation_name: &String, operation_id_hex: &String) nothrow -> String {
	return _dup(base) + "/microflows/v1/operations/" + _dup(operation_name) + "/" + _dup(operation_id_hex);
}

fn _dispatch_put(base: &String, operation_name: &String, operation_id_hex: &String,
                 input_json: &String, io_timeout_ms: Int) nothrow -> PutOutcome {
	val url = _op_url(base, operation_name, operation_id_hex);
	var cfg = client.new_client_config();
	client.with_io_timeout(&mut cfg, io_timeout_ms);
	var session = client.new_session(move cfg);
	var req = client.new_request("PUT", move url);
	client.set_json_body(&mut req, _dup(input_json));
	match client.send(&session, move req) {
		core.Result::Ok(resp) => {
			match client.response_body_string(&resp) {
				core.Result::Ok(body) => { return PutOutcome::Responded(resp.status, move body); },
				// An unreadable response body is NOT a known response: the outcome
				// is uncertain -> TransportFailed (reconcile), never Responded("").
				core.Result::Err(_) => { return PutOutcome::TransportFailed(); }
			}
		},
		core.Result::Err(_) => { return PutOutcome::TransportFailed(); }
	}
}

// Classify the PUT outcome (§5.2). 200 success; 202 pending (defer + re-poll);
// 400 invalid; 409 conflict; 5xx/other/transport-failure -> uncertain ->
// reconcile by GET.
fn _classify_dispatch(base: &String, operation_name: &String, operation_id_hex: &String, input_json: &String) -> DispatchResult {
	match _dispatch_put(base, operation_name, operation_id_hex, input_json, PUT_IO_TIMEOUT_MS) {
		PutOutcome::Responded(status, body) => {
			if status == 200 { return DispatchResult::Done(_extract_result(&body)); }
			if status == 202 { return DispatchResult::Pending(); }
			if status == 400 { return DispatchResult::Rejected("participant_invalid_request"); }
			if status == 409 { return DispatchResult::Rejected("participant_identity_conflict"); }
			return _reconcile(base, operation_name, operation_id_hex, input_json);
		},
		PutOutcome::TransportFailed => {
			return _reconcile(base, operation_name, operation_id_hex, input_json);
		}
	}
}

fn _get_op(base: &String, operation_name: &String, operation_id_hex: &String) nothrow -> GetOutcome {
	val url = _op_url(base, operation_name, operation_id_hex);
	var cfg = client.new_client_config();
	client.with_io_timeout(&mut cfg, RECONCILE_IO_TIMEOUT_MS);
	var session = client.new_session(move cfg);
	var req = client.new_request("GET", move url);
	match client.send(&session, move req) {
		core.Result::Ok(resp) => {
			if resp.status == 404 { return GetOutcome::Unknown(); }
			if resp.status == 202 { return GetOutcome::Pending(); }
			if resp.status == 400 { return GetOutcome::Rejected("participant_invalid_request"); }
			if resp.status == 409 { return GetOutcome::Rejected("participant_identity_conflict"); }
			if resp.status == 200 {
				match client.response_body_string(&resp) {
					core.Result::Ok(body) => {
						match _try_extract_result(&body) {
							Optional::Some(r) => { return GetOutcome::Terminal(move r); },
							Optional::None => { return GetOutcome::TransportFailed(); }
						}
					},
					core.Result::Err(_) => { return GetOutcome::TransportFailed(); }
				}
			}
			// 5xx or any other status: unreachable / uncertain.
			return GetOutcome::TransportFailed();
		},
		core.Result::Err(_) => { return GetOutcome::TransportFailed(); }
	}
}

// Reconcile an uncertain outcome by GET on the stable operation id. Terminal ->
// Done; 202/working or unreachable -> Pending (defer); 400/409 -> Rejected; a
// 404 means the participant has no record -> safe re-PUT the identical request
// under the same id, then GET again (effectively-once replay).
fn _reconcile(base: &String, operation_name: &String, operation_id_hex: &String, input_json: &String) -> DispatchResult {
	match _get_op(base, operation_name, operation_id_hex) {
		GetOutcome::Terminal(r) => { return DispatchResult::Done(move r); },
		GetOutcome::Pending => { return DispatchResult::Pending(); },
		GetOutcome::Rejected(reason) => { return DispatchResult::Rejected(move reason); },
		GetOutcome::TransportFailed => {
			// Unreachable/uncertain -> defer + retry later; never throw holding the lease.
			return DispatchResult::Pending();
		},
		GetOutcome::Unknown => {
			// 404-reconcile: participant has no record -> resubmit identical PUT.
			match _dispatch_put(base, operation_name, operation_id_hex, input_json, RECONCILE_IO_TIMEOUT_MS) {
				PutOutcome::Responded(status, body) => {
					if status == 200 { return DispatchResult::Done(_extract_result(&body)); }
					if status == 202 { return DispatchResult::Pending(); }
					if status == 400 { return DispatchResult::Rejected("participant_invalid_request"); }
					if status == 409 { return DispatchResult::Rejected("participant_identity_conflict"); }
					return _reconcile_after_resubmit(base, operation_name, operation_id_hex);
				},
				PutOutcome::TransportFailed => { return _reconcile_after_resubmit(base, operation_name, operation_id_hex); }
			}
		}
	}
}

fn _reconcile_after_resubmit(base: &String, operation_name: &String, operation_id_hex: &String) -> DispatchResult {
	match _get_op(base, operation_name, operation_id_hex) {
		GetOutcome::Terminal(r) => { return DispatchResult::Done(move r); },
		GetOutcome::Rejected(reason) => { return DispatchResult::Rejected(move reason); },
		// Still not terminal (pending / unreachable / 404 again) -> defer + retry.
		default => { return DispatchResult::Pending(); }
	}
}

// Workflow not claimable: inspect to distinguish terminal / active / deferred,
// and report. Terminal -> replay the LOCAL authoritative result (Microflows
// already persisted it; no dependency on the participant being reachable).
fn _inspect_report(host: &mf.MicroflowsHost, workflow_id: &Array<Byte>, operation_id_hex: &String, result_seq: Int) -> Outcome {
	val now = _now(host);
	match host.inspect_workflow(workflow_id, &now) {
		mf.WorkflowInspectOutcome::Found(snap) => {
			if snap.is_terminal {
				return _report_terminal(host, workflow_id, &snap, operation_id_hex, result_seq);
			}
			if snap.leased {
				return Outcome::Active(reason = "leased_by_another");
			}
			return Outcome::Deferred(reason = "not_yet_due_or_blocked", defer_until = "", code = 5);
		},
		mf.WorkflowInspectOutcome::NotFound => {
			throw RunnerError(message = "workflow vanished during inspect");
		}
	}
}

// Branch by terminal state: ONLY `completed` carries a successful operation
// result; `reversed` and `resolved_exception` are terminal WITHOUT a forward
// success, so they must not assume one.
fn _report_terminal(host: &mf.MicroflowsHost, workflow_id: &Array<Byte>,
                    snap: &mf.WorkflowSnapshot, operation_id_hex: &String, result_seq: Int) -> Outcome {
	if snap.state_code == STATE_COMPLETED {
		// The authoritative completed result is the LAST operation's (the plan may
		// have run several); a single-op workflow's last seq is 1.
		match host.operation_result(workflow_id, result_seq) {
			mf.OperationResultOutcome::Succeeded(r) => {
				return Outcome::AlreadyTerminal(operation_id = _dup(operation_id_hex), result = move r);
			},
			mf.OperationResultOutcome::Requested => {
				// COMPLETED but the operation has only a request, no settled result:
				// inconsistent durable state. A completed workflow MUST carry its
				// forward result — this is an error, not a success.
				return Outcome::Error(reason = "completed_operation_unsettled");
			},
			mf.OperationResultOutcome::NotFound => {
				// COMPLETED but no operation row at all: corrupted durable state.
				return Outcome::Error(reason = "completed_without_operation");
			}
		}
	}
	if snap.state_code == STATE_REVERSED {
		return Outcome::Reversed();
	}
	if snap.state_code == STATE_RESOLVED_EXCEPTION {
		return Outcome::ResolvedException();
	}
	return Outcome::TerminalState(state = snap.state_code);
}

// Operation pending (202/working) or participant unreachable: durably defer by
// releasing the lease with a near-term next-attempt, so the workflow becomes
// due again and re-polls. Reports only on a committed release (else a distinct
// defer_failed outcome — never claim a transition that did not happen).
fn _defer_pending(host: &mf.MicroflowsHost, workflow_id: &Array<Byte>, fencing_token: Int, admission: &AdmissionState) -> Outcome {
	// Admission (slice 2): while draining/stopped, do NOT schedule new retry work — release at now
	// and report pending_restart so the drain converges. Admission is THREADED from the drive
	// boundary (`_run`), so a library caller passing Draining is honored without any env dependency.
	if !_admission_accepting(admission) { return _drain_release(host, workflow_id, fencing_token, admission); }
	// Schedule the next attempt PENDING_RETRY_SECONDS out (NOT the lease window):
	// the DB clock returns this as an absolute next-attempt deadline.
	val clock = host.clock_read(PENDING_RETRY_SECONDS);
	match host.release(workflow_id, fencing_token, &clock.now, &clock.deadline) {
		mf.ReleaseOutcome::Released => {
			return Outcome::Pending(reason = "operation_pending", defer_until = _dup(&clock.deadline));
		},
		mf.ReleaseOutcome::FenceLost => {
			return Outcome::DeferFailed(reason = "release_fence_lost", code = 7);
		},
		mf.ReleaseOutcome::NotFound => {
			return Outcome::DeferFailed(reason = "release_not_found", code = 8);
		}
	}
}

// Clock skew (non-increasing event_ts): release/defer the workflow until the
// LAST ACCEPTED event time + margin (defer_until), rather than adjusting the
// timestamp or retrying immediately. The deferral is only reported once the
// release actually COMMITS; a failed release yields a distinct outcome (never
// claim a durable transition that did not happen).
fn _defer(host: &mf.MicroflowsHost, workflow_id: &Array<Byte>, fencing_token: Int,
          defer_until: &String, reason: String, admission: &AdmissionState) -> Outcome {
	// Admission (slice 2): suppress new defers while draining/stopped (see _defer_pending).
	if !_admission_accepting(admission) { return _drain_release(host, workflow_id, fencing_token, admission); }
	val clock = host.clock_read(LEASE_SECONDS);
	match host.release(workflow_id, fencing_token, &clock.now, defer_until) {
		mf.ReleaseOutcome::Released => {
			return Outcome::Deferred(reason = move reason, defer_until = _dup(defer_until), code = 6);
		},
		mf.ReleaseOutcome::FenceLost => {
			return Outcome::DeferFailed(reason = "release_fence_lost", code = 7);
		},
		mf.ReleaseOutcome::NotFound => {
			return Outcome::DeferFailed(reason = "release_not_found", code = 8);
		}
	}
}

// Durable OPERATIONAL deferral of a dispatch for a REPAIRABLE reason (e.g. a
// pinned binding temporarily unavailable in config). The workflow stays forward
// and claimable; sp_mf_operation_dispatch_defer clears the lease, sets an
// absolute future next_attempt, and appends an 'operation_dispatch_deferred'
// audit event with the reason on ENTRY into the wait condition (deduped on
// retry), so restoring config auto-recovers it — NOT a failure, NOT blocked.
fn _defer_dispatch(host: &mf.MicroflowsHost, workflow_id: &Array<Byte>, fencing_token: Int, reason: String, admission: &AdmissionState) -> Outcome {
	// Admission (slice 2): suppress new dispatch defers while draining/stopped (see _defer_pending).
	if !_admission_accepting(admission) { return _drain_release(host, workflow_id, fencing_token, admission); }
	val clock = host.clock_read(DISPATCH_DEFER_SECONDS);
	match host.defer_dispatch(workflow_id, fencing_token, &clock.now, &clock.deadline, &clock.now, &reason) {
		mf.ReleaseOutcome::Released => {
			return Outcome::Deferred(reason = move reason, defer_until = _dup(&clock.deadline), code = 9);
		},
		mf.ReleaseOutcome::FenceLost => {
			return Outcome::DeferFailed(reason = "defer_fence_lost", code = 7);
		},
		mf.ReleaseOutcome::NotFound => {
			return Outcome::DeferFailed(reason = "defer_not_found", code = 8);
		}
	}
}

// Durable non-retryable failure on a definite participant rejection. Without
// this the runner would exit while still forward/requested AND holding the
// lease; after lease expiry the workflow becomes claimable again and repeats
// the rejected dispatch indefinitely. operation_fail atomically transitions
// forward(1) -> blocked_resolution(3) (disposition failed) and clears the lease,
// so the workflow stops advancing forward. Idempotent (AlreadyBlocked).
fn _fail_operation(host: &mf.MicroflowsHost, workflow_id: &Array<Byte>, fencing_token: Int,
                   operation_id: &Array<Byte>, reason: String, admission: &AdmissionState) -> Outcome {
	val t = _now(host);
	val cont = "{\"pos\":\"op:1:failed\"}";
	val payload = "{\"reason\":\"" + _dup(&reason) + "\",\"kind\":\"non_retryable_failure\"}";
	match host.operation_fail(workflow_id, fencing_token, OPERATION_SEQ, operation_id, &cont, &t, &payload) {
		mf.OperationFailOutcome::Blocked => {
			return Outcome::Failed(reason = move reason);
		},
		mf.OperationFailOutcome::AlreadyBlocked => {
			// Idempotent replay of the same non-retryable failure.
			return Outcome::Failed(reason = move reason);
		},
		mf.OperationFailOutcome::FenceLost => {
			return Outcome::FailAborted(reason = "fail_fence_lost", code = 7);
		},
		mf.OperationFailOutcome::OperationConflict => {
			return Outcome::FailAborted(reason = "fail_operation_conflict", code = 7);
		},
		mf.OperationFailOutcome::NotFound => {
			return Outcome::FailAborted(reason = "fail_workflow_not_found", code = 8);
		},
		mf.OperationFailOutcome::OperationNotFound => {
			return Outcome::FailAborted(reason = "fail_operation_not_found", code = 8);
		},
		mf.OperationFailOutcome::EventTimeSkew(defer_until) => {
			return _defer(host, workflow_id, fencing_token, &defer_until, "fail_event_time_skew", admission);
		}
	}
}

// ===== reversal / compensation unwind (reverse direction) =====
//
// Stable reverse-invocation id, DERIVED deterministically from (workflow, seq) in a
// space DISTINCT from forward operation ids, so recovery re-derives the same id.
fn _reverse_id(workflow_hex: &String, seq: Int) nothrow -> Array<Byte> {
	val rev = fmt.format_int(SCRIPT_REVISION);
	val s = fmt.format_int(seq);
	val seed = _join3(workflow_hex, &rev, &s) + "reverse:1";
	val u = uuid.v3_from_string(&seed);
	return uuid.to_bytes(&u);
}

// Build the standard forward-context envelope a compensation receives (E):
// {forward:{workflow_id, operation, operation_id, schema_version, input, result}}. input/result are
// passed through OPAQUELY (structural v1: the coordinator validates the SHAPE, not the semantic types of
// forward.input/forward.result). forward.operation_id is the CORRELATION key (the forward op being
// undone); the compensation's OWN id is its reverse id.
fn _comp_envelope(workflow_hex: &String, operation: &String, forward_op_id_hex: &String,
                  schema_version: Int, input_node: &json.JsonNode, result_node: &json.JsonNode) nothrow -> String {
	var fwd = json.new_object();
	fwd.set("workflow_id", json.JsonNode::String(value = _dup(workflow_hex)));
	fwd.set("operation", json.JsonNode::String(value = _dup(operation)));
	fwd.set("operation_id", json.JsonNode::String(value = _dup(forward_op_id_hex)));
	fwd.set("schema_version", json.JsonNode::Number(raw = fmt.format_int(schema_version)));
	// input/result are PRE-PARSED from durable state by the caller (strict; never synthesized here).
	fwd.set("input", input_node.clone_deep());
	fwd.set("result", result_node.clone_deep());
	var o = json.new_object();
	o.set("forward", fwd.to_node());
	val node = o.to_node();
	return json.encode_compact(&node);
}

// Manual-IR compensation binding for a forward operation (None if it declares no
// compensation — then its checkpoint cannot be auto-unwound).
fn _compensation_for(cfg: &json.JsonNode, fwd_op: &String) -> Optional<CompensationBinding> {
	match cfg.get(&"operations") {
		Optional::Some(on) => {
			match on.as_array() {
				Optional::Some(items) => {
					var i = 0;
					while i < items.len {
						val nm = _req_str(&items[i], &"name", "operation.name");
						if _str_eq(&nm, fwd_op) {
							match items[i].get(&"compensation") {
								Optional::Some(c) => {
									val cop = _req_str(c, &"operation", "compensation.operation");
									val csv = _req_int(c, &"schema_version", "compensation.schema_version");
									return Optional<CompensationBinding>::Some(CompensationBinding(op_name = move cop, schema_version = csv));
								},
								Optional::None => { return Optional<CompensationBinding>::None(); }
							}
						}
						i = i + 1;
					}
				},
				Optional::None => {}
			}
		},
		Optional::None => {}
	}
	return Optional<CompensationBinding>::None();
}

// Enter blocked_resolution (reverse direction) when a compensation cannot continue.
fn _reverse_block(host: &mf.MicroflowsHost, workflow_id: &Array<Byte>, fencing_token: Int,
                  seq: Int, rev_id: &Array<Byte>, reason: String, admission: &AdmissionState) -> Outcome {
	val ts = _now(host);
	match host.reverse_block(workflow_id, fencing_token, seq, rev_id, 2, &reason, &ts) {
		mf.ReverseBlockOutcome::Blocked => {
			return Outcome::Blocked(reason = move reason);
		},
		mf.ReverseBlockOutcome::AlreadyBlocked => {
			return Outcome::Blocked(reason = move reason);
		},
		mf.ReverseBlockOutcome::FenceLost => {
			return Outcome::ReverseAborted(reason = "block_fence_lost", code = 7);
		},
		mf.ReverseBlockOutcome::EventTimeSkew(defer_until) => {
			// Time-disciplined like every transition: defer to the supplied deadline
			// rather than reporting failure with the lease still held.
			return _defer(host, workflow_id, fencing_token, &defer_until, "reverse_block_skew", admission);
		},
		default => {
			return Outcome::ReverseAborted(reason = "reverse_block_failed", code = 8);
		}
	}
}

// Dispatch ONE compensation (generic dispatcher) + settle/defer/block. Returns
// Continue to descend to the next checkpoint, or Terminal with the exit code.
// A RECOVERED durable request (forward OR reverse) is reconciled GET-first: the
// request was already durably issued in a prior drive, so observe its outcome by GET
// on the stable id and only re-PUT if the participant has no record (404). A FRESH
// request is dispatched PUT-first. Selecting here keeps recovery from blindly
// re-PUTting a request the participant may already have committed.
fn _dispatch_or_reconcile(recover: Bool, base: &String, operation_name: &String,
                          operation_id_hex: &String, input_json: &String) -> DispatchResult {
	if recover {
		return _reconcile(base, operation_name, operation_id_hex, input_json);
	}
	return _classify_dispatch(base, operation_name, operation_id_hex, input_json);
}

fn _compensate(host: &mf.MicroflowsHost, workflow_id: &Array<Byte>, fencing_token: Int,
               seq: Int, comp_op: &String, base: &String, rev_id: &Array<Byte>,
               rev_id_hex: &String, rev_input: &String, recover: Bool, admission: &AdmissionState) -> CompStep {
	match _dispatch_or_reconcile(recover, base, comp_op, rev_id_hex, rev_input) {
		DispatchResult::Done(result) => {
			val ts = _now(host);
			match host.reverse_settle(workflow_id, fencing_token, seq, rev_id, &result, &ts) {
				mf.ReverseSettleOutcome::Reversed => {
					return CompStep::Terminal(Outcome::Reversed());
				},
				mf.ReverseSettleOutcome::Reversing(_) => { return CompStep::Continue(); },
				mf.ReverseSettleOutcome::AlreadyReversed => { return CompStep::Continue(); },
				mf.ReverseSettleOutcome::FenceLost => {
					return CompStep::Terminal(Outcome::ReverseAborted(reason = "settle_fence_lost", code = 7));
				},
				mf.ReverseSettleOutcome::EventTimeSkew(defer_until) => {
					return CompStep::Terminal(_defer(host, workflow_id, fencing_token, &defer_until, "reverse_settle_skew", admission));
				},
				default => {
					return CompStep::Terminal(Outcome::ReverseAborted(reason = "reverse_settle_failed", code = 8));
				}
			}
		},
		DispatchResult::Pending => {
			return CompStep::Terminal(_defer_dispatch(host, workflow_id, fencing_token, "compensation_pending", admission));
		},
		DispatchResult::Rejected(reason) => {
			// Persist the CLASSIFIED participant reason as blocked-resolution evidence.
			return CompStep::Terminal(_reverse_block(host, workflow_id, fencing_token, seq, rev_id, move reason, admission));
		}
	}
}

// Drive the compensation UNWIND of a reversing workflow: the checkpoint stack
// (reverse_head) is authoritative. Top active checkpoint -> derive + persist the
// compensation binding (pending) or reconcile the persisted one (dispatched) ->
// dispatch via the generic dispatcher -> settle/descend, defer on pending, block on
// definite rejection. Terminal reversed clears the lease.
fn _run_reversal(host: &mf.MicroflowsHost, cfg: &json.JsonNode, workflow_id: &Array<Byte>,
                 workflow_canon_hex: &String, fencing_token: Int, admission: &AdmissionState) -> Outcome {
	while true {
		match host.reverse_head(workflow_id) {
			mf.ReverseHeadOutcome::NoneActive => {
				// A reversing workflow with NO active checkpoint is an inconsistency (a
				// fully-compensated workflow would be reversed). Do NOT exit holding the
				// lease with no record — that recurs after lease expiry. Durably DEFER
				// with an audit reason: the lease is released, a deduped diagnostic event
				// is recorded, and the state is observable rather than silently pinning a
				// worker until expiry.
				return _defer_dispatch(host, workflow_id, fencing_token, "reverse_no_active_checkpoint", admission);
			},
			mf.ReverseHeadOutcome::Pending(seq, forward_operation_name, forward_payload) => {
				val rev_id = _reverse_id(workflow_canon_hex, seq);
				val rev_id_hex = _bytes_to_hex(&rev_id);
				var comp_op: String = "";
				var comp_sv: Int = 0;
				match _compensation_for(cfg, &forward_operation_name) {
					Optional::Some(c) => { comp_op = _dup(&c.op_name); comp_sv = c.schema_version; },
					Optional::None => {
						// PRE-dispatch resolution failure: nothing was dispatched, so
						// reverse_block (which requires a persisted reverse id) cannot
						// apply and would leave the lease held. Durably DEFER as a
						// repairable config state — restoring the binding resumes the unwind.
						return _defer_dispatch(host, workflow_id, fencing_token, "no_compensation_binding", admission);
					}
				}
				// E: assemble the standard forward-context envelope from DURABLE data. forward.operation_id +
				// schema_version come from the stored request (authoritative, NOT re-derived); forward.result from
				// operation_result. A compensable checkpoint MUST have a settled forward op, so a missing
				// request/result is a durable inconsistency -> defer through the existing path, never synthesize.
				var fwd_op_id_hex: String = "";
				var fwd_sv: Int = 0;
				match host.operation_request_get(workflow_id, seq) {
					mf.OperationRequestGetOutcome::Found(rec) => { fwd_op_id_hex = _bytes_to_hex(&rec.operation_id); fwd_sv = rec.schema_version; },
					mf.OperationRequestGetOutcome::NotFound => {
						return _defer_dispatch(host, workflow_id, fencing_token, "reverse_forward_request_missing", admission);
					}
				}
				var fwd_result: String = "{}";
				var have_fwd_result = false;
				match host.operation_result(workflow_id, seq) {
					mf.OperationResultOutcome::Succeeded(r) => { fwd_result = move r; have_fwd_result = true; },
					default => {}
				}
				if !have_fwd_result {
					return _defer_dispatch(host, workflow_id, fencing_token, "reverse_forward_result_missing", admission);
				}
				// Reversal context comes from DURABLE state and is never synthesized: strict-parse the stored
				// forward input + result; a malformed value is a durable inconsistency -> defer with a distinct reason.
				var fwd_input_node = json.JsonNode::Null();
				match json.parse_strict(&forward_payload) {
					core.Result::Ok(n) => { fwd_input_node = move n; },
					core.Result::Err(_) => { return _defer_dispatch(host, workflow_id, fencing_token, "reverse_forward_input_invalid", admission); }
				}
				var fwd_result_node = json.JsonNode::Null();
				match json.parse_strict(&fwd_result) {
					core.Result::Ok(n) => { fwd_result_node = move n; },
					core.Result::Err(_) => { return _defer_dispatch(host, workflow_id, fencing_token, "reverse_forward_result_invalid", admission); }
				}
				val rev_input = _comp_envelope(workflow_canon_hex, &forward_operation_name, &fwd_op_id_hex, fwd_sv, &fwd_input_node, &fwd_result_node);
				val rev_hash = _input_hash(&rev_input);
				// resolve the pinned reverse contract (registry, not workflow input)
				var base: String = "";
				var rok = false;
				try {
					val r = _resolve_operation(cfg, &comp_op, Optional<Int>::Some(comp_sv));
					base = _dup(&r.base_url);
					rok = true;
				} catch RunnerError(e) { console.eprintln(e.message); }
				if !rok {
					return _defer_dispatch(host, workflow_id, fencing_token, "pinned_contract_unavailable", admission);
				}
				// persist the binding BEFORE dispatch (crash-safe)
				val treq = _now(host);
				var ready = false;
				match host.reverse_request(workflow_id, fencing_token, seq, &rev_id, &comp_op, comp_sv,
				                           &rev_input, &rev_hash, &treq) {
					mf.ReverseRequestOutcome::Requested(_) => { ready = true; },
					mf.ReverseRequestOutcome::AlreadyRequested(_, _, _, _, _) => { ready = true; },
					mf.ReverseRequestOutcome::BindingConflict => {},   // persisted binding wins -> re-read head
					mf.ReverseRequestOutcome::CheckpointInactive(_) => {},  // already advanced -> re-read head
					mf.ReverseRequestOutcome::FenceLost => {
						return Outcome::ReverseAborted(reason = "reverse_request_fence_lost", code = 7);
					},
					mf.ReverseRequestOutcome::EventTimeSkew(defer_until) => {
						return _defer(host, workflow_id, fencing_token, &defer_until, "reverse_request_skew", admission);
					},
					default => {
						return Outcome::ReverseAborted(reason = "reverse_request_failed", code = 8);
					}
				}
				if ready {
					// Fresh dispatch of a just-persisted binding: PUT-first.
					match _compensate(host, workflow_id, fencing_token, seq, &comp_op, &base, &rev_id, &rev_id_hex, &rev_input, false, admission) {
						CompStep::Continue => {},
						CompStep::Terminal(code) => { return code; }
					}
				}
			},
			mf.ReverseHeadOutcome::Dispatched(seq, forward_operation_name, reverse_invocation_id, reverse_operation_name, reverse_schema_version, reverse_input_json, reverse_input_hash) => {
				val _ = forward_operation_name; val _ = reverse_input_hash;
				val rev_op = _dup(&reverse_operation_name);
				val rev_sv = reverse_schema_version;
				val rev_input = _dup(&reverse_input_json);
				// USE the DURABLE persisted reverse id (decode it) for dispatch + settle,
				// never a re-derived one — so recovery targets exactly the recorded
				// invocation even if derivation changes or seeded state is inconsistent.
				val rev_id = _hex_to_bytes(&reverse_invocation_id);
				val rev_id_hex = _dup(&reverse_invocation_id);
				var base: String = "";
				var rok = false;
				try {
					val r = _resolve_operation(cfg, &rev_op, Optional<Int>::Some(rev_sv));
					base = _dup(&r.base_url);
					rok = true;
				} catch RunnerError(e) { console.eprintln(e.message); }
				if !rok {
					return _defer_dispatch(host, workflow_id, fencing_token, "pinned_contract_unavailable", admission);
				}
				// Durable binding already dispatched (recovery): GET-first reconcile,
				// never a blind re-PUT.
				match _compensate(host, workflow_id, fencing_token, seq, &rev_op, &base, &rev_id, &rev_id_hex, &rev_input, true, admission) {
					CompStep::Continue => {},
					CompStep::Terminal(code) => { return code; }
				}
			}
		}
	}
}

// Extract the participant envelope's `result` object as compact JSON text.
fn _extract_result(envelope: &String) -> String {
	match _try_extract_result(envelope) {
		Optional::Some(r) => { return move r; },
		Optional::None => { throw RunnerError(message = "participant response has no result"); }
	}
}

fn _try_extract_result(envelope: &String) nothrow -> Optional<String> {
	match json.parse(envelope) {
		core.Result::Ok(n) => {
			match n.get(&"result") {
				Optional::Some(r) => { return Optional<String>::Some(json.encode_compact(r)); },
				Optional::None => { return Optional<String>::None(); }
			}
		},
		core.Result::Err(_) => { return Optional<String>::None(); }
	}
}

// ===== time =====

fn _clock(host: &mf.MicroflowsHost) -> mf.ClockReading {
	return host.clock_read(LEASE_SECONDS);
}

fn _now(host: &mf.MicroflowsHost) -> String {
	return host.clock_read(LEASE_SECONDS).now;
}

// ===== identity / hashing =====

fn _join3(a: &String, b: &String, c: &String) nothrow -> String {
	return fmt.format_int(a.byte_length()) + ":" + _dup(a) + ";"
	     + fmt.format_int(b.byte_length()) + ":" + _dup(b) + ";"
	     + fmt.format_int(c.byte_length()) + ":" + _dup(c) + ";";
}

// LEGACY single-op path only (--operation/--config): positional id. The planned/manifest path uses
// node-address identity (_operation_id_node). Kept unchanged so legacy workflows keep their persisted ids.
fn _operation_id(workflow_hex: &String, operation_seq: Int) nothrow -> Array<Byte> {
	val rev = fmt.format_int(SCRIPT_REVISION);
	val seq = fmt.format_int(operation_seq);
	// invocation = 1 (first occurrence of this static call site).
	val seed = _join3(workflow_hex, &rev, &seq) + "inv:1";
	val u = uuid.v3_from_string(&seed);
	return uuid.to_bytes(&u);
}

// Node-address operation identity (planned path). INVARIANT: a compiled operation node executes AT MOST
// ONCE per workflow instance — the validated graph is acyclic and loops are side-effect-free (no op
// statements inside map/filter/fold), so there is no occurrence dimension. Thus (workflow instance,
// pinned script content_hash, compiled node id) uniquely + stably identifies one executed operation:
// branch-distinct (two arms are different nodes), retry/resume-stable (content_hash + node id are
// pinned). Derived ONLY at fresh dispatch; resume/replay adopts the durably-stored id. `_join3` is
// length-prefixed and the seed carries the `mf-op;` domain tag, so this id space is disjoint from any
// reverse-id space.
fn _operation_id_node(workflow_hex: &String, content_hash_hex: &String, node_id: &String) nothrow -> Array<Byte> {
	val seed = "mf-op;" + _join3(workflow_hex, content_hash_hex, node_id);
	val u = uuid.v3_from_string(&seed);
	return uuid.to_bytes(&u);
}

fn _input_hash(input_json: &String) -> String {
	val cfg = json.JsonConfig(key_order = json.JsonKeyOrder::OrderedLexUtf8());
	match json.parse_strict(input_json) {
		core.Result::Ok(n) => {
			val compact = json.encode_compact_with_config(&n, &cfg);
			val u = uuid.v3_from_string(&compact);
			val bytes = uuid.to_bytes(&u);
			return _bytes_to_hex(&bytes);
		},
		core.Result::Err(_) => { throw RunnerError(message = "input is not valid JSON"); }
	}
}

// ===== participant / operation registry (trusted deployment config) =====
//
// `participants` is the LASTING deployment boundary: a logical id -> transport
// policy. `operations` is a TEMPORARY manual-IR registry: op -> participant +
// schema_version, shaped like future compiler output. Resolution sits behind this
// boundary — the dispatcher consumes only a ResolvedOperation. Routing and
// credentials come ONLY from this trusted config, never from workflow input;
// credentials are never persisted in operation requests.

// Validate the WHOLE registry at startup, before any execution.
fn _validate_registry(cfg: &json.JsonNode) -> Void {
	val ids = _validate_participants(cfg);
	_validate_operations(cfg, &ids);
}

// Validate every participant's transport; return the owned set of participant ids.
fn _validate_participants(cfg: &json.JsonNode) -> Array<String> {
	var ids: Array<String> = [];
	match cfg.get(&"participants") {
		Optional::Some(pn) => {
			match pn.as_array() {
				Optional::Some(items) => {
					var i = 0;
					while i < items.len {
						val pid = _req_str(&items[i], &"id", "participant.id");
						if _contains(&ids, &pid) { throw RunnerError(message = "duplicate participant id: " + _dup(&pid)); }
						_validate_transport(&items[i], &pid);
						ids.push(move pid);
						i = i + 1;
					}
				},
				Optional::None => { throw RunnerError(message = "config: 'participants' must be a JSON array"); }
			}
		},
		Optional::None => { throw RunnerError(message = "config: missing 'participants'"); }
	}
	return move ids;
}

fn _validate_operations(cfg: &json.JsonNode, ids: &Array<String>) -> Void {
	var names: Array<String> = [];
	var svs: Array<Int> = [];
	match cfg.get(&"operations") {
		Optional::Some(on) => {
			match on.as_array() {
				Optional::Some(items) => {
					var i = 0;
					while i < items.len {
						val nm = _req_str(&items[i], &"name", "operation.name");
						if !_is_op_name_safe(&nm) { throw RunnerError(message = "operation name is empty or not a URI-safe segment: '" + _dup(&nm) + "' (allowed: A-Z a-z 0-9 . _ -)"); }
						if _contains(&names, &nm) { throw RunnerError(message = "duplicate operation binding: " + _dup(&nm)); }
						val pref = _req_str(&items[i], &"participant", "operation.participant");
						if !_contains(ids, &pref) { throw RunnerError(message = "operation '" + _dup(&nm) + "' references unknown participant '" + _dup(&pref) + "'"); }
						val sv = _req_int(&items[i], &"schema_version", "operation.schema_version");
						if sv < 1 { throw RunnerError(message = "operation '" + _dup(&nm) + "' has invalid schema_version"); }
						svs.push(sv);
						names.push(move nm);
						i = i + 1;
					}
					// Second pass: validate optional compensation bindings now that all
					// names are known (a compensation must reference a registered op).
					var k = 0;
					while k < items.len {
						match items[k].get(&"compensation") {
							Optional::Some(c) => {
								val cop = _req_str(c, &"operation", "compensation.operation");
								if !_contains(&names, &cop) {
									throw RunnerError(message = "compensation references unknown operation '" + _dup(&cop) + "'");
								}
								val csv = _req_int(c, &"schema_version", "compensation.schema_version");
								if csv < 1 { throw RunnerError(message = "compensation for an operation has invalid schema_version"); }
								// The pinned compensation version must MATCH the referenced
								// operation's registered version — reject an inconsistent
								// registry at startup, not by deferring during execution.
								var reg_sv = 0;
								var fi = 0;
								while fi < names.len {
									if _str_eq(&names[fi], &cop) { reg_sv = svs[fi]; }
									fi = fi + 1;
								}
								if reg_sv != csv {
									throw RunnerError(message = "compensation pins schema_version " + fmt.format_int(csv)
										+ " but operation '" + _dup(&cop) + "' offers version " + fmt.format_int(reg_sv));
								}
							},
							Optional::None => {}
						}
						k = k + 1;
					}
				},
				Optional::None => { throw RunnerError(message = "config: 'operations' must be a JSON array"); }
			}
		},
		Optional::None => { throw RunnerError(message = "config: missing 'operations'"); }
	}
}

// Build the forward PLAN from config "plan" (the manual IR). None when absent (the
// legacy single --operation path). Each step is {operation: string, input: object};
// the input is normalized to compact JSON text for stable hashing + storage.
fn _build_plan(cfg: &json.JsonNode) -> Optional<Array<PlanStep>> {
	match cfg.get(&"plan") {
		Optional::Some(pn) => {
			match pn.as_array() {
				Optional::Some(items) => {
					var steps: Array<PlanStep> = [];
					var i = 0;
					while i < items.len {
						val op = _req_str(&items[i], &"operation", "plan.operation");
						// The input is the operation request body; the operation layer
						// requires a JSON OBJECT. Reject a scalar/array at STARTUP (before
						// any claim) so a bad plan can't fail post-claim and strand the lease.
						var input: String = "{}";
						match items[i].get(&"input") {
							Optional::Some(inode) => {
								match inode.as_object() {
									Optional::Some(_) => { input = json.encode_compact(inode); },
									Optional::None => { throw RunnerError(message = "plan step input must be a JSON object"); }
								}
							},
							Optional::None => {}
						}
						steps.push(PlanStep(operation = move op, input_json = move input));
						i = i + 1;
					}
					if steps.len == 0 { throw RunnerError(message = "config: 'plan' must not be empty"); }
					return Optional<Array<PlanStep>>::Some(move steps);
				},
				Optional::None => { throw RunnerError(message = "config: 'plan' must be a JSON array"); }
			}
		},
		Optional::None => { return Optional<Array<PlanStep>>::None(); }
	}
}

// Validate the forward plan at startup (a bad plan fails BEFORE any
// create/claim/execution): every step's operation must resolve in the registry, and
// every step that can PRECEDE a later (potentially failing) step must declare a
// compensation binding. Only the FINAL step needs none: if it succeeds the workflow
// completes (nothing reverses it); if it fails it leaves no checkpoint and the PRIOR
// steps compensate. A single-operation plan therefore requires no compensation.
fn _validate_plan(cfg: &json.JsonNode) -> Void {
	match _build_plan(cfg) {
		Optional::Some(plan) => {
			val last = plan.len - 1;
			var i = 0;
			while i < plan.len {
				val _ = _resolve_operation(cfg, &plan[i].operation, Optional<Int>::None());
				// Steps before the last could be a "prior success" when a later step fails,
				// so they must be compensable. The last step never needs compensation.
				if i < last {
					match _compensation_for(cfg, &plan[i].operation) {
						Optional::Some(_) => {},
						Optional::None => {
							throw RunnerError(message = "plan operation '" + _dup(&plan[i].operation)
								+ "' (not the final step) has no compensation binding — it must be reversible");
						}
					}
				}
				i = i + 1;
			}
		},
		Optional::None => {}
	}
}

fn _validate_transport(part: &json.JsonNode, pid: &String) -> Void {
	match part.get(&"transport") {
		Optional::Some(tr) => {
			val kind = _req_str(tr, &"kind", "transport.kind");
			if kind != "http" { throw RunnerError(message = "participant '" + _dup(pid) + "' unsupported transport kind: " + kind); }
			val sel = _req_str(tr, &"selection", "transport.selection");
			if sel != "ordered_failover" { throw RunnerError(message = "participant '" + _dup(pid) + "' unsupported selection: " + sel); }
			match tr.get(&"endpoints") {
				Optional::Some(epn) => {
					match epn.as_array() {
						Optional::Some(eps) => {
							if eps.len == 0 { throw RunnerError(message = "participant '" + _dup(pid) + "' has an empty endpoint list"); }
							// This slice resolves a SINGLE endpoint (ordered selection over a
							// one-element list). Multi-endpoint ordered_failover is not
							// implemented yet, so reject >1 rather than silently ignore the rest.
							if eps.len > 1 { throw RunnerError(message = "participant '" + _dup(pid) + "' declares " + fmt.format_int(eps.len) + " endpoints; multi-endpoint ordered_failover is not implemented in this slice (use exactly one)"); }
							var k = 0;
							while k < eps.len {
								match eps[k].as_string() {
									Optional::Some(u) => { if !_is_http_url(&u) { throw RunnerError(message = "participant '" + _dup(pid) + "' invalid endpoint URL: " + u); } },
									Optional::None => { throw RunnerError(message = "participant '" + _dup(pid) + "' endpoint is not a string"); }
								}
								k = k + 1;
							}
						},
						Optional::None => { throw RunnerError(message = "participant '" + _dup(pid) + "' endpoints must be a JSON array"); }
					}
				},
				Optional::None => { throw RunnerError(message = "participant '" + _dup(pid) + "' missing endpoints"); }
			}
		},
		Optional::None => { throw RunnerError(message = "participant '" + _dup(pid) + "' missing transport"); }
	}
	// Only a null/absent auth_profile is supported in this slice; ANY non-null
	// value (object, string, boolean, number, array) is an unsupported credential
	// mechanism -> fail. Check is_null() directly so no JSON type slips through.
	match part.get(&"auth_profile") {
		Optional::Some(ap) => {
			if !ap.is_null() { throw RunnerError(message = "participant '" + _dup(pid) + "' has an unsupported auth_profile (only null/absent supported in this slice)"); }
		},
		Optional::None => {}
	}
}

// Resolve op_name -> {schema_version, base_url}. Ordered selection picks the first
// endpoint. `pinned` is the durable contract version on RESUME: the registry's
// binding MUST still offer exactly that version, else the pinned contract is
// unavailable and we fail safely rather than dispatch a persisted request through
// a different (e.g. upgraded) binding. Throws if the operation or its participant
// is absent. Resolution is thus by (operation_name, schema_version) on resume.
fn _resolve_operation(cfg: &json.JsonNode, op_name: &String, pinned: Optional<Int>) -> ResolvedOperation {
	match cfg.get(&"operations") {
		Optional::Some(on) => {
			match on.as_array() {
				Optional::Some(items) => {
					var i = 0;
					while i < items.len {
						val nm = _req_str(&items[i], &"name", "operation.name");
						if _str_eq(&nm, op_name) {
							val pref = _req_str(&items[i], &"participant", "operation.participant");
							val sv = _req_int(&items[i], &"schema_version", "operation.schema_version");
							match pinned {
								Optional::Some(req) => {
									if sv != req {
										throw RunnerError(message = "pinned contract version " + fmt.format_int(req)
											+ " for operation '" + _dup(op_name) + "' is unavailable (registry offers version "
											+ fmt.format_int(sv) + ")");
									}
								},
								Optional::None => {}
							}
							val base = _participant_base_url(cfg, &pref);
							return ResolvedOperation(operation_name = _dup(op_name), schema_version = sv, participant_id = _dup(&pref), base_url = move base);
						}
						i = i + 1;
					}
				},
				Optional::None => {}
			}
		},
		Optional::None => {}
	}
	throw RunnerError(message = "operation not registered: " + _dup(op_name));
}

fn _participant_base_url(cfg: &json.JsonNode, pid: &String) -> String {
	match cfg.get(&"participants") {
		Optional::Some(pn) => {
			match pn.as_array() {
				Optional::Some(items) => {
					var i = 0;
					while i < items.len {
						val id = _req_str(&items[i], &"id", "participant.id");
						if _str_eq(&id, pid) {
							return _first_endpoint(&items[i], pid);
						}
						i = i + 1;
					}
				},
				Optional::None => {}
			}
		},
		Optional::None => {}
	}
	throw RunnerError(message = "unknown participant: " + _dup(pid));
}

fn _first_endpoint(part: &json.JsonNode, pid: &String) -> String {
	match part.get(&"transport") {
		Optional::Some(tr) => {
			match tr.get(&"endpoints") {
				Optional::Some(epn) => {
					match epn.as_array() {
						Optional::Some(eps) => {
							if eps.len == 0 { throw RunnerError(message = "participant '" + _dup(pid) + "' has no endpoints"); }
							match eps[0].as_string() {
								Optional::Some(u) => { return move u; },
								Optional::None => { throw RunnerError(message = "participant '" + _dup(pid) + "' endpoint is not a string"); }
							}
						},
						Optional::None => { throw RunnerError(message = "participant '" + _dup(pid) + "' endpoints must be a JSON array"); }
					}
				},
				Optional::None => { throw RunnerError(message = "participant '" + _dup(pid) + "' missing endpoints"); }
			}
		},
		Optional::None => { throw RunnerError(message = "participant '" + _dup(pid) + "' missing transport"); }
	}
}

fn _req_str(n: &json.JsonNode, key: &String, what: String) -> String {
	match n.get(key) {
		Optional::Some(v) => {
			match v.as_string() {
				Optional::Some(s) => { return move s; },
				Optional::None => { throw RunnerError(message = what + " must be a string"); }
			}
		},
		Optional::None => { throw RunnerError(message = "missing " + what); }
	}
}

fn _req_int(n: &json.JsonNode, key: &String, what: String) -> Int {
	match n.get(key) {
		Optional::Some(v) => {
			match v.as_int() {
				Optional::Some(x) => { return x; },
				Optional::None => { throw RunnerError(message = what + " must be an integer"); }
			}
		},
		Optional::None => { throw RunnerError(message = "missing " + what); }
	}
}

fn _contains(arr: &Array<String>, s: &String) nothrow -> Bool {
	var i = 0;
	while i < arr.len { if _str_eq(&arr[i], s) { return true; } i = i + 1; }
	return false;
}

fn _str_eq(a: &String, b: &String) nothrow -> Bool {
	val n = a.byte_length();
	if n != b.byte_length() { return false; }
	var i = 0;
	while i < n { if a.byte_at(i) != b.byte_at(i) { return false; } i = i + 1; }
	return true;
}

fn _starts_with(s: &String, prefix: &String) nothrow -> Bool {
	val pn = prefix.byte_length();
	if s.byte_length() < pn { return false; }
	var i = 0;
	while i < pn { if s.byte_at(i) != prefix.byte_at(i) { return false; } i = i + 1; }
	return true;
}

fn _is_http_url(s: &String) nothrow -> Bool {
	if _starts_with(s, &"https://") and s.byte_length() > 8 { return true; }
	if _starts_with(s, &"http://") and s.byte_length() > 7 { return true; }
	return false;
}

// A non-empty URI path-SEGMENT-safe operation name (the name is interpolated raw
// into the dispatch URL). Allowed: A-Z a-z 0-9 . _ - — no '/', spaces, or other
// reserved/percent-requiring characters. Rejecting empty here also keeps an empty
// registry name from ever matching an omitted --operation.
fn _is_op_name_safe(s: &String) nothrow -> Bool {
	val n = s.byte_length();
	if n == 0 { return false; }
	// Reject the dot-segments "." and ".." — even though their bytes are in the
	// allowed set, as a whole URL path segment they are normalized away / climb the
	// path, which would change the route.
	if _str_eq(s, &".") or _str_eq(s, &"..") { return false; }
	var i = 0;
	while i < n {
		val b = s.byte_at(i);
		val ok: Bool = (b >= 48 and b <= 57)        // 0-9
		            or (b >= 65 and b <= 90)        // A-Z
		            or (b >= 97 and b <= 122)       // a-z
		            or b == 46 or b == 95 or b == 45;   // . _ -
		if !ok { return false; }
		i = i + 1;
	}
	return true;
}

// ===== config =====

fn _build_host(b: mf.HostBuilder) -> arc.Arc<mf.MicroflowsHost> {
	match mf.build_host(move b) {
		core.Result::Ok(h) => { return move h; },
		core.Result::Err(_) => { throw RunnerError(message = "microflows host build failed"); }
	}
}

fn _require_db(cfg: &json.JsonNode) -> json.JsonNode {
	match cfg.get(&"db") {
		Optional::Some(n) => { return n.clone_deep(); },
		Optional::None => { throw RunnerError(message = "config: missing 'db' subtree"); }
	}
}

fn _load_config_json(path: &String) throws -> json.JsonNode {
	val timeout = conc.Duration(millis = 5000);
	match io.file_builder(_dup(path)).read(true).timeout(timeout).build() {
		core.Result::Ok(file) => {
			val text = _drain(move file);
			// STRICT: reject duplicate keys + non-standard number forms (a lenient parse would
			// keep-last duplicates and weaken canonical identity / the unknown-key guarantee).
			match json.parse_strict(&text) {
				core.Result::Ok(n) => { return move n; },
				core.Result::Err(_) => { throw RunnerError(message = "config: JSON parse failed"); }
			}
		},
		core.Result::Err(_) => { throw RunnerError(message = "config: cannot open " + _dup(path)); }
	}
}

fn _drain(var f: io.ConfiguredFile) throws -> String {
	var out: String = "";
	var buf = io.buffer(4096);
	var done = false;
	while !done {
		match f.read(&mut buf) {
			core.Result::Ok(n) => {
				if n == 0 { done = true; }
				else { out = out + core.string_from_utf8_bytes(io.buffer_ptr(&buf), n); }
			},
			core.Result::Err(_) => { val _ = f.close(); throw RunnerError(message = "config: read error"); }
		}
	}
	val _ = f.close();
	return move out;
}

fn _config_str(cfg: &json.JsonNode, key: &String, default_val: String) nothrow -> String {
	match cfg.get(key) {
		Optional::Some(n) => { match n.as_string() { Optional::Some(s) => { if s.byte_length() > 0 { return move s; } }, Optional::None => {} } },
		Optional::None => {}
	}
	return move default_val;
}

// ===== bytes / hex =====

fn _hex_to_bytes(hex: &String) -> Array<Byte> {
	match codec.hex_decode(hex) {
		core.Result::Ok(b) => { if b.len == 16 { return move b; } throw RunnerError(message = "workflow-id must be 16 bytes"); },
		core.Result::Err(_) => { throw RunnerError(message = "workflow-id not valid hex"); }
	}
}

fn _bytes_to_hex(b: &Array<Byte>) nothrow -> String {
	return codec.hex_encode(b);
}

fn _copy_bytes(b: &Array<Byte>) nothrow -> Array<Byte> {
	var out: Array<Byte> = Array<type Byte>::with_capacity(b.len);
	var i = 0;
	while i < b.len { out.push(b[i]); i = i + 1; }
	return move out;
}

fn _dup(s: &String) nothrow -> String {
	val n = s.byte_length();
	var buf = io.buffer(n);
	var i = 0;
	while i < n { io.buffer_write(&mut buf, i, s.byte_at(i)); i = i + 1; }
	return core.string_from_utf8_bytes(io.buffer_ptr(&buf), n);
}

// ===== ScriptRegistry SERVICE shell (roadmap item 3b: long-running web.rest front-door) =====
//
// A THIN long-running wrapper over the SAME drive boundary the CLI uses (no new workflow semantics):
//   - loads the manifest ONCE into an in-memory, swappable ScriptRegistry;
//   - serves submit/resume/health over web.rest; each request calls `_drive_manifest_request` ->
//     `_run_core` (drive_workflow) -> Outcome with the ONE shared, internally-pooled host;
//   - owns runtime-mutable admission: SIGTERM -> draining (then graceful shutdown), enforced by the
//     SAME admission rules the drive already applies (a fresh submission while draining -> Refused ->
//     HTTP 503; in-flight resume converges via pending_restart);
//   - staged reload on SIGUSR1: load+validate a NEW manifest into a standby, atomically swap on
//     success, keep serving the OLD registry on failure;
//   - maps Outcome -> a semantic HTTP status, the body being the EXACT Outcome JSON (contract
//     unchanged), so a CLI consumer and an HTTP consumer read identical outcome documents.
// INTERNAL API ONLY. Auth is roadmap item 5: the `/v1/workflows` route GROUP is the seam where
// web.rest auth middleware / a security context plugs in later — no auth logic is built here.
const ADM_ACCEPTING: Int = 0;
const ADM_DRAINING: Int = 1;
const ADM_STOPPED: Int = 2;

fn _admission_of_int(n: Int) nothrow -> AdmissionState {
	if n == ADM_DRAINING { return AdmissionState::Draining(); }
	if n == ADM_STOPPED { return AdmissionState::Stopped(); }
	return AdmissionState::Accepting();
}

fn _admission_to_int(a: &AdmissionState) nothrow -> Int {
	match a {
		AdmissionState::Draining() => { return ADM_DRAINING; },
		AdmissionState::Stopped() => { return ADM_STOPPED; },
		AdmissionState::Accepting() => { return ADM_ACCEPTING; }
	}
}

struct ServiceApp {
	host: arc.Arc<mf.MicroflowsHost>,
	registry: conc.Mutex<arc.Arc<ManifestSet>>,   // swapped atomically on SIGUSR1 reload
	admission: conc.AtomicInt,                     // ADM_ACCEPTING / ADM_DRAINING / ADM_STOPPED
	manifest_path: String,
	logger: log.Logger                             // shared, long-lived; bare calls auto-carry VT request context
}

// A consistent snapshot of the active registry: clone the inner Arc under the lock, release before the
// drive — an in-flight request keeps its snapshot even if a concurrent reload swaps the active one.
fn _registry_snapshot(m: &conc.Mutex<arc.Arc<ManifestSet>>) nothrow -> arc.Arc<ManifestSet> {
	var g = conc.lock(m);
	return conc.mutex_guard_get_mut(&mut g).clone();
}

// Staged reload: load+validate a NEW manifest into a standby, atomically swap on success; on an
// EXPECTED (RunnerError) manifest failure keep serving the OLD registry. Returns true on swap.
// `throws`: an UNEXPECTED defect is NOT a RunnerError, so it propagates (out through the signal loop ->
// service_main's fatal catch) rather than being silently converted into a reload rejection.
fn _service_reload(app: &ServiceApp) throws -> Bool {
	var new_opt: Optional<ManifestSet> = Optional<ManifestSet>::None();
	var ok = false;
	// EXPECTED manifest failures (missing/unreadable/invalid script, bad semver, duplicate name) are
	// RunnerError -> reject the reload, keep the active registry. A truly UNEXPECTED defect is NOT a
	// RunnerError, so it is NOT caught here and fails loudly rather than masquerading as "bad manifest"
	// (the same discipline applied to config-build errors in _run_planned).
	try { new_opt = Optional<ManifestSet>::Some(_load_manifest(&app.manifest_path)); ok = true; } catch RunnerError(e) { app.logger.error("manifest-reload-rejected", {"reason": "invalid_manifest", "message": e.message}); ok = false; }
	if !ok { return false; }
	match move new_opt {
		Optional::Some(ms) => {
			var g = conc.lock(&app.registry);
			val slot = conc.mutex_guard_get_mut(&mut g);
			*slot = conc.arc(ms);
			app.logger.info("manifest-reloaded", {"manifest": _dup(&app.manifest_path)});
			return true;
		},
		Optional::None => { return false; }
	}
}

// Outcome -> semantic HTTP status. The body is ALWAYS the exact Outcome JSON (contract unchanged), so
// the status is advisory for load balancers / clients; the document is authoritative.
fn _outcome_http_status(o: &Outcome) nothrow -> Int {
	match o {
		Outcome::Completed(a, b) => { return 200; },
		Outcome::AlreadyTerminal(a, b) => { return 200; },
		Outcome::Reversed() => { return 200; },
		Outcome::ResolvedException() => { return 200; },
		Outcome::TerminalState(s) => { return 200; },
		Outcome::Pending(r, d) => { return 202; },
		Outcome::PendingRestart(r) => { return 503; },   // drain back-pressure: same 503 contract as Refused (§13)
		Outcome::Refused(r) => { return 503; },
		Outcome::Deferred(r, d, c) => { if _str_eq(r, &"workflow_conflict") { return 409; } return 202; },
		Outcome::Aborted(r, c) => { if _str_eq(r, &"not_found") { return 404; } return 400; },
		Outcome::Active(r) => { return 409; },
		Outcome::Blocked(r) => { return 409; },
		Outcome::Failed(r) => { return 409; },
		Outcome::DeferFailed(r, c) => { return 500; },
		Outcome::ReverseAborted(r, c) => { return 500; },
		Outcome::FailAborted(r, c) => { return 500; },
		Outcome::Error(r) => { return 500; }
	}
}

fn _outcome_response(o: &Outcome) nothrow -> rest.Response {
	return rest.json_response(_outcome_http_status(o), _oc_render(o));
}

implement ServiceApp {
	// Drive one request through the shared host + a registry snapshot, mapping Outcome -> HTTP.
	fn drive(self: &ServiceApp, wf: &String, script: &String, has_script: Bool, args: &String, has_arguments: Bool) -> rest.Response {
		if wf.byte_length() != 32 { return rest.json_response(400, "{\"workflow\":\"aborted\",\"reason\":\"bad_workflow_id\"}"); }
		val adm = _admission_of_int(self.admission.load(conc.MemoryOrder::SeqCst()));
		val snap = _registry_snapshot(&self.registry);
		var resp: rest.Response = rest.json_response(500, "{\"workflow\":\"error\",\"reason\":\"runner-fatal\"}");
		try {
			val outcome = _drive_manifest_request(&self.host, snap.get(), wf, script, has_script, &"", &"{}", args, has_arguments, &adm);
			resp = _outcome_response(&outcome);
		} catch unexpected {
			self.logger.error("workflow-handler-failed", {"reason": "runner_fatal"});
			resp = rest.json_response(500, "{\"workflow\":\"error\",\"reason\":\"runner-fatal\"}");
		}
		return move resp;
	}
	// POST /v1/workflows/{id}/submit?script=NAME  — body = instance arguments (JSON object).
	pub fn handle_submit(self: &ServiceApp, req: &rest.Request) throws -> rest.Response {
		val wf = rest.path_param(req, "id").or_throw();
		var script = "";
		var has_script = false;
		match rest.query_param(req, &"script") { Optional::Some(s) => { script = move s; has_script = true; }, Optional::None => {} }
		logging.set_workflow_fields(_dup(&wf), _dup(&script));
		self.logger.info("workflow-submit-received", {"script": _dup(&script)});
		// The submit body MUST be a valid JSON document (the instance arguments — `{}` if none). A
		// malformed/empty body is a structured 400 BEFORE any drive — never silently coerced to `{}`
		// (which could create a valid empty-argument workflow for a script that accepts no fields).
		var args = "";
		var have_args = false;
		match rest.body_json(req) { core.Result::Ok(h) => { args = h.encode_compact(); have_args = true; }, core.Result::Err(_) => {} }
		if !have_args {
			self.logger.error("workflow-submit-rejected", {"reason": "malformed_arguments"});
			return rest.json_response(400, "{\"workflow\":\"aborted\",\"reason\":\"malformed_arguments\"}");
		}
		val resp = self.drive(&wf, &script, has_script, &args, true);
		self.logger.info("workflow-submit-completed", {"status": fmt.format_int(resp.status)});
		return move resp;
	}
	// POST /v1/workflows/{id}/resume  — no script, no args; driven strictly by the durable pin.
	pub fn handle_resume(self: &ServiceApp, req: &rest.Request) throws -> rest.Response {
		val wf = rest.path_param(req, "id").or_throw();
		logging.set_workflow_fields(_dup(&wf), "");
		self.logger.info("workflow-resume-received", {"workflow_id": _dup(&wf)});
		val resp = self.drive(&wf, &"", false, &"", false);
		self.logger.info("workflow-resume-completed", {"status": fmt.format_int(resp.status)});
		return move resp;
	}
	// GET /healthz — liveness (process up).
	pub fn handle_healthz(self: &ServiceApp, req: &rest.Request) throws -> rest.Response {
		return rest.json_response(200, "{\"status\":\"ok\"}");
	}
	// GET /readyz — readiness: registry loaded AND accepting; draining/stopped -> 503 (LB stops routing).
	pub fn handle_readyz(self: &ServiceApp, req: &rest.Request) throws -> rest.Response {
		if self.admission.load(conc.MemoryOrder::SeqCst()) == ADM_ACCEPTING { return rest.json_response(200, "{\"status\":\"ready\"}"); }
		return rest.json_response(503, "{\"status\":\"draining\"}");
	}
}

// The long-running service: `--manifest FILE` [`--port N`]. A second artifact (uflowsd).
fn service_main(argv: Array<String>) nothrow -> Int {
	var p = cli.parser("uflowsd", "0.1.0", "Microflows coordinator service (manifest-driven, long-running)");
	val _ = p.option_string("manifest", "m", "FILE", "deployment manifest (named scripts + shared deployment routing)", true);
	val _ = p.option_int("port", "p", "PORT", "listening port (default 8088)", false);
	val _ = p.option_string("log-level", "l", "LEVEL", "log level: debug | info | error (default: info)", false);
	var manifest_path = "";
	var port = 8088;
	var log_level = log.Level::Info();
	match p.parse(argv) {
		core.Result::Ok(parsed) => {
			match parsed.get_string("manifest", p) { Some(v) => { manifest_path = _dup(v); }, None => {} }
			match parsed.get_int("port", p) { Some(v) => { port = v; }, None => {} }
			match parsed.get_string("log-level", p) {
				Some(v) => {
					if *v == "debug" { log_level = log.Level::Debug(); }
					else if *v == "info" { log_level = log.Level::Info(); }
					else if *v == "error" { log_level = log.Level::Error(); }
					else { console.eprintln("uflowsd: unknown --log-level (expected debug|info|error)"); return 2; }
				},
				None => {}
			}
		},
		core.Result::Err(_) => { console.eprintln("uflowsd: bad arguments"); return 2; }
	}
	return try _service_run(&manifest_path, port, log_level) catch unexpected { console.eprintln("uflowsd: fatal"); 1 };
}

fn _service_run(manifest_path: &String, port: Int, log_level: log.Level) throws -> Int {
	// Operational logger (Bookkeeper-style): JSON ISO-8601 to stderr; a VT request-context resolver so
	// bare logger calls carry req/workflow_id/script automatically. Shared via ServiceApp.logger.
	var cfgb = log.config_builder();
	cfgb.sink(log.stderr_sink());
	cfgb.min_level(log_level);
	cfgb.formatter(log.FormatterKind::JsonIso8601());
	cfgb.context_resolver(conc.arc(logging.AppLogResolver()).as_interface<type log.ContextResolver>());
	val logger = log.create_logger("uflowsd", cfgb.build());
	logger.info("uflowsd-startup-begin", {"port": fmt.format_int(port)});
	// Load + validate the WHOLE manifest at startup; refuse to start on any error (fail-fast).
	logger.info("manifest-load-begin", {"manifest": _dup(manifest_path)});
	var ms_opt: Optional<ManifestSet> = Optional<ManifestSet>::None();
	try {
		ms_opt = Optional<ManifestSet>::Some(_load_manifest(manifest_path));
	} catch RunnerError(e) {
		logger.error("manifest-load-rejected", {"reason": "invalid_manifest", "message": e.message});
		return 2;
	}
	match move ms_opt {
		Optional::Some(ms) => {
			logger.info("manifest-load-completed", {"manifest": _dup(manifest_path)});
			// ONE shared, internally-pooled host (from the manifest's deployment db) for all requests.
			val db_sub = _require_db(&ms.deployment);
			val worker_id = _config_str(&ms.deployment, &"worker_id", "runner-1");
			val identity = mf.identity_from_worker_name(&worker_id);
			var hb = mf.new_host_builder();
			mf.with_json(&mut hb, &db_sub);
			mf.with_identity(&mut hb, move identity);
			val host = _build_host(move hb);
			// Initial admission from MICROFLOWS_ADMISSION (accepting unless told otherwise); SIGTERM
			// later flips it to draining at runtime. The drive applies the SAME admission rules.
			val adm0 = _admission_from_env();
			val app = conc.arc(ServiceApp(host = move host, registry = conc.mutex(conc.arc(ms)),
			                              admission = conc.atomic_int(_admission_to_int(&adm0)), manifest_path = _dup(manifest_path),
				                              logger = logger));

			var ab = rest.new_app_builder();
			rest.bind(ab, "0.0.0.0", port);
			var web_app = rest.build_app(move ab);
				// Global middleware: VT-scoped request context + a single terminal `req-out` audit line on
				// every termination path (mirrors Bookkeeper). /perf/* (none today) would skip logging.
				rest.add_middleware(web_app, |req, ctx, next| captures(share app) => {
					val _ = logging.ensure_request_context();
					val _g = logging.push_request_context(req.method + " " + req.path);
					val start = time.now_monotonic();
					val skip_logging = txt.starts_with(req.path, "/perf/");
					val result = next.call(req, ctx);
					if !skip_logging {
						val elapsed = time.elapsed_ms(start);
						val a = app.get();
						match &result {
							core.Result::Ok(resp) => { val _ = a.logger.info("req-out", {"status": fmt.format_int(resp.status), "elapsed": fmt.format_int(elapsed)}); },
							core.Result::Err(e) => { val _ = a.logger.error("req-out", {"status": fmt.format_int(e.status), "elapsed": fmt.format_int(elapsed), "tag": e.tag}); }
						}
					}
					return move result;
				});
			// AUTH SEAM (roadmap item 5): the `/v1/workflows` route group is where web.rest auth
			// middleware / a request security context attaches later. No auth logic now.
			val wf_rg = rest.add_route_group(web_app, "/v1/workflows").or_throw();
			rest.add_route_group_throws_route(web_app, wf_rg, "POST", "/{id}/submit",
				|req, ctx| captures(share app) => { return app.get().handle_submit(req); }).or_throw();
			rest.add_route_group_throws_route(web_app, wf_rg, "POST", "/{id}/resume",
				|req, ctx| captures(share app) => { return app.get().handle_resume(req); }).or_throw();
			rest.add_throws_route(web_app, "GET", "/healthz",
				|req, ctx| captures(share app) => { return app.get().handle_healthz(req); }).or_throw();
			rest.add_throws_route(web_app, "GET", "/readyz",
				|req, ctx| captures(share app) => { return app.get().handle_readyz(req); }).or_throw();

			app.get().logger.info("uflowsd-listening", {"port": fmt.format_int(port)});
			var running = rest.start(move web_app, conc.Duration(millis = 0));
			// Signal loop: SIGUSR1 -> staged reload; SIGTERM -> drain (refuse new) + graceful shutdown.
			var serving = true;
			while serving {
				match conc.await_signal() {
					conc.ProcessSignal::User1 => { val _ = _service_reload(app.get()); },
					conc.ProcessSignal::Terminate => { app.get().admission.store(ADM_DRAINING, conc.MemoryOrder::SeqCst()); serving = false; },
					conc.ProcessSignal::Interrupt => { serving = false; }
				}
			}
			app.get().logger.info("uflowsd-shutdown", {"reason": "signal"});
			val _ = rest.shutdown(running);
			return 0;
		},
		Optional::None => { return 2; }
	}
}
