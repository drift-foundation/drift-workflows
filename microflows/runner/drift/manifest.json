{
  "schema_version": 2,
  "project": {
    "name": "microflows-runner",
    "license": "MIT"
  },
  "artifacts": [
    {
      "kind": "app",
      "name": "microflows-runner",
      "module_namespace": "microflows.runner",
      "version": "0.0.0",
      "description": "Microflows coordinator runner — first dispatch slice (manual IR)",
      "entry_module": "src/runner.drift",
      "entry_point": "microflows.runner::main",
      "modules": ["src/"],
      "package_deps": [
        { "name": "mariadb-rpc", "version": "0.8" },
        { "name": "web-client", "version": "0.5" },
        { "name": "web-rest", "version": "0.6" }
      ]
    },
    {
      "kind": "app",
      "name": "uflowsd",
      "module_namespace": "microflows.runner",
      "version": "0.0.0",
      "description": "Microflows coordinator service — long-running manifest-driven web.rest front-door (roadmap 3b)",
      "entry_module": "src/runner.drift",
      "entry_point": "microflows.runner::service_main",
      "modules": ["src/"],
      "package_deps": [
        { "name": "mariadb-rpc", "version": "0.8" },
        { "name": "web-client", "version": "0.5" },
        { "name": "web-rest", "version": "0.6" }
      ]
    }
  ]
}
