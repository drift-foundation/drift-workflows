# Microflows reference participant stub — narrow PUT/GET operation endpoint
# backed by Singular. The protocol conformance reference for Microflows.
#
# Environment:
#   DRIFT_TOOLCHAIN_ROOT — required toolchain
#   DRIFT_PKG_ROOT       — foundation package root for EXTERNAL deps
#                          (default: $HOME/opt/drift/certified/current/libs)
#   MDB_ROOT_PWD         — MariaDB root password (Singular schema load)
#
# Singular is compiled FROM SOURCE with the stub (it is a Foundation-owned sibling in this monorepo and
# the package under certification — never consumed as a pre-deployed package). Same approach as the
# integration planner (integration/coordinator-singular/tools/emit_test_plan.py) and the runner build.

MANIFEST := "drift/manifest.json"
_pkg-root := env("DRIFT_PKG_ROOT", env("HOME") + "/opt/drift/certified/current/libs")
BIN_DIR := "build/dist/bin"

# Resolve EXTERNAL dependencies and write drift/lock.json (singular is a source dep, not locked).
prepare:
	#!/usr/bin/env bash
	set -euo pipefail
	DRIFT="${DRIFT_TOOLCHAIN_ROOT:-$HOME/opt/drift/certified/current/toolchain}/bin/drift"
	"$DRIFT" prepare --package-root "{{_pkg-root}}"

# Build the participant-stub binary FROM SOURCE: compile the Singular LIBRARY source together with the
# stub app source, resolving only EXTERNAL deps from the package root (mirrors the integration planner +
# the runner build). Singular is NOT consumed as a package, so this works on a fresh checkout / cert host
# where no local or certified singular package exists. External --dep flags come from this app's lock.
build:
	#!/usr/bin/env bash
	set -euo pipefail
	DC="${DRIFT_TOOLCHAIN_ROOT:-$HOME/opt/drift/certified/current/toolchain}/bin/driftc"
	mkdir -p "{{BIN_DIR}}"
	DEPS="$(python3 -c "import json; r=json.load(open('drift/lock.json'))['artifacts']['microflows-participant-stub']['resolved']; print(' '.join('--dep %s@%s'%(n, r[n]['version']) for n in sorted(r) if n != 'singular'))")"
	[[ -n "$DEPS" ]] || { echo "error: no external deps resolved in drift/lock.json (run 'just prepare')" >&2; exit 1; }
	"$DC" --target-word-bits 64 --trust-store drift/trust.json --package-root "{{_pkg-root}}" \
	  $DEPS --entry "microflows.participant_stub::main" \
	  ../../singular/drift/packages/singular/src/*.drift src/*.drift \
	  -o "{{BIN_DIR}}/participant-stub"

# Run the stub. Pass a JSON config file via --config.
#   just run config/local.json
run CONFIG: build
	#!/usr/bin/env bash
	set -euo pipefail
	exec ./{{BIN_DIR}}/participant-stub --config "{{CONFIG}}"

# Black-box HTTP conformance harness (stdlib Python). Builds first, then spawns
# the stub against the running `singular` schema and asserts protocol behavior.
# Requires MariaDB up + `singular` schema loaded (cd ../../singular && just
# db-load-schema) and MDB_ROOT_PWD.
test-http: build
	#!/usr/bin/env bash
	set -euo pipefail
	python3 tests/http/conformance.py

# Wipe build artifacts.
clean:
	rm -rf build
