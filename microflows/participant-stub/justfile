# Microflows reference participant stub — narrow PUT/GET operation endpoint
# backed by Singular. The protocol conformance reference for Microflows.
#
# Environment:
#   DRIFT_TOOLCHAIN_ROOT — required toolchain
#   DRIFT_PKG_ROOT       — foundation package root
#                          (default: $HOME/opt/drift/certified/current/libs)
#   PUSHCOIN_LIB_ROOT    — PushCoin-published lib root for `singular`
#                          (default: ../../pushcoin/singular/build/dist/lib)
#   MDB_ROOT_PWD         — MariaDB root password (Singular schema load)

MANIFEST := "drift/manifest.json"
_pkg-root := env("DRIFT_PKG_ROOT", env("HOME") + "/opt/drift/certified/current/libs")
_pkg-local := env("PUSHCOIN_LIB_ROOT", "../../singular/drift/build/dist/lib")
BIN_DIR := "build/dist/bin"

# Resolve dependencies and write drift/lock.json.
prepare:
	#!/usr/bin/env bash
	set -euo pipefail
	DRIFT="${DRIFT_TOOLCHAIN_ROOT:-$HOME/opt/drift/certified/current/toolchain}/bin/drift"
	PKG_LOCAL="$(realpath -m "{{_pkg-local}}")"
	"$DRIFT" prepare --package-root "$PKG_LOCAL" --package-root "{{_pkg-root}}"

# Build the participant-stub binary.
build:
	#!/usr/bin/env bash
	set -euo pipefail
	DRIFT="${DRIFT_TOOLCHAIN_ROOT:-$HOME/opt/drift/certified/current/toolchain}/bin/drift"
	PKG_LOCAL="$(realpath -m "{{_pkg-local}}")"
	mkdir -p "{{BIN_DIR}}"
	"$DRIFT" build --timing --package-root "$PKG_LOCAL" --package-root "{{_pkg-root}}" -o "{{BIN_DIR}}/participant-stub"

# Run the stub. Pass a JSON config file via --config.
#   just run config/local.json
run CONFIG: build
	#!/usr/bin/env bash
	set -euo pipefail
	exec ./{{BIN_DIR}}/participant-stub --config "{{CONFIG}}"

# Wipe build artifacts.
clean:
	rm -rf build
