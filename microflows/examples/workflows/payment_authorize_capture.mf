# payment_authorize_capture — authorize a card payment, capture it, record it in the ledger.
#
# Business intent: take money for an order in the standard two-phase card flow (authorize then
# capture), then write an immutable ledger entry. If any later step fails, Microflows automatically
# unwinds the completed steps in reverse order using the compensations declared in the deployment.
#
# Operation contracts (each operation is owned by a PARTICIPANT service; see deployment.json):
#   authorize     payments   {order_id,customer_id,amount} -> {auth_id}        compensation: void_authorization
#   capture       payments   {auth_id,amount}              -> {capture_id}     compensation: refund_capture
#   record_ledger payments   {reference}                   -> {ledger_entry_id}   (terminal; no compensation)
#
# Compensation behavior: if `capture` fails after `authorize` succeeded, `void_authorization` runs.
# If `record_ledger` fails after both, `refund_capture` then `void_authorization` run in that order.
# Compensations are bound in the deployment, never here — this file only expresses the business flow.

args {
  order_id:    string
  customer_id: string
  amount:      { value: int, currency: string }
}

op authorize     { input: { order_id: string, customer_id: string, amount: { value: int, currency: string } }  result: { auth_id: string } }
op capture       { input: { auth_id: string, amount: { value: int, currency: string } }                        result: { capture_id: string } }
op record_ledger { input: { reference: string }                                                                result: { ledger_entry_id: string } }

steps {
  let authorization = authorize { order_id: arg order_id, customer_id: arg customer_id, amount: arg amount }
  let payment       = capture   { auth_id: result authorization.auth_id, amount: arg amount }
  record_ledger { reference: result payment.capture_id }
}
