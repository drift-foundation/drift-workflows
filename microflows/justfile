# Drift Workflows — Microflows component build/test/db recipes.
# (Drift Workflows = Microflows [this tree] + Singular [external lib]. This
#  justfile builds the Microflows package; milestone 1: MariaDB reference host.)
#
# Environment:
#   DRIFT_TOOLCHAIN_ROOT — required for test gates (just test). Toolchain >= 0.35.0.
#   DRIFT_PKG_ROOT       — foundation-libs root for resolving external deps
#                          (default: $HOME/opt/drift/certified/current/pkgs).
#   DRIFT_SIGN_KEY_FILE  — Ed25519 author-claim signer (The Drift Foundation identity)
#                          (default: $HOME/.config/drift/keys/default.seed).
#   DRIFT_DIST_ROOT      — deploy destination (default: build/dist/lib)
#   MDB_ROOT_PWD         — MariaDB root password for db-* recipes.

MANIFEST := "drift/manifest.json"
DEPLOY_DEST := env("DRIFT_DIST_ROOT", "build/dist/lib")
_pkg-root := env("DRIFT_PKG_ROOT", env("HOME") + "/opt/drift/certified/current/pkgs")
HEARTBEAT_SECS := "30"

DB_SCHEMA := "microflows"
# External-capability env (Mariachi path; MariaDB host/port/user/password; DB lock key + held group) is
# resolved by the repo-root shim `tools/cert-env.sh`, sourced at the top of every DB-backed recipe: from
# DRIFT_CERT_CAPABILITIES in cert mode (authoritative, fail-early), or local-dev defaults otherwise. It
# sets MARIACHI_BIN / DB_HOST / DB_PORT / DB_USER / DB_LOCK / DB_HELD_GROUP + ensures MDB_ROOT_PWD. The
# shared host-global DB lock ($DB_LOCK) is the same flocker key the test executor uses for its serial DB
# jobs, so a destructive reset / DB regression here can't overlap another gate's DB-backed execution; the
# executor's per-job key ($DB_HELD_GROUP) is distinct so its lock can't deadlock against the outer hold.
# flocker is toolchain-provided (not a declared capability).
FLOCKER := env("DRIFT_TOOLCHAIN_ROOT", env("HOME") + "/opt/drift/certified/current/toolchain") + "/bin/flocker"

# --- Certification gates (shared executor) ---
# Gates run on the toolchain's shared `drift_test_run` executor (mechanism),
# driven by tools/emit_test_plan.py (policy: which files/deps/lanes).

# Correctness gate (microflows-only): unit (parallel base/memcheck/asan, DB-free)
# + e2e (serial base/asan/memcheck on the shared mdb114-a) + the stored-procedure
# regression. Requires DRIFT_TOOLCHAIN_ROOT, a running mdb114-a, and MDB_ROOT_PWD.
# Cross-component E2E lives under ../integration and is run by the ROOT gate, not
# here — this recipe stays component-isolated.
# PUBLIC entry: acquire the shared host-global DB lock ONCE, then run the whole
# setup+DB-test phase under it (so no other checkout can reset/migrate the schema
# mid-test). Lock ownership is conveyed by recipe STRUCTURE (this acquires it; the
# private `_test-locked` is reachable only from here) — never by a caller-settable
# env var. flocker is REQUIRED (ships with the toolchain); missing => hard error.
test:
	#!/usr/bin/env bash
	set -euo pipefail
	source "../tools/cert-env.sh"
	: "${DRIFT_TOOLCHAIN_ROOT:?set DRIFT_TOOLCHAIN_ROOT to a toolchain >= 0.35.0}"
	# Runner-owned unit tests (the V1 control-flow graph IR in runner/src/ir.drift) are
	# DB-free — run them as part of THIS component gate, before taking the DB lock. (ir.drift
	# is Microflows code; this is its component home.)
	( cd runner && just test )
	[[ -x "{{FLOCKER}}" ]] || { echo "error: flocker not found at {{FLOCKER}} (required for DB serialization; ships with the toolchain)" >&2; exit 1; }
	exec "{{FLOCKER}}" --key "$DB_LOCK" -j 1 --heartbeat {{HEARTBEAT_SECS}} -- just _test-locked

# PRIVATE: the complete setup+DB-test phase. Runs ONLY under the shared lock held
# by `test`. The executor's DB jobs take a non-shared serial key ($DB_HELD_GROUP
# via --db-group) so their per-job lock can't deadlock against the outer hold.
_test-locked:
	#!/usr/bin/env bash
	set -euo pipefail
	source "../tools/cert-env.sh"
	: "${DRIFT_TOOLCHAIN_ROOT:?set DRIFT_TOOLCHAIN_ROOT to a toolchain >= 0.35.0}"
	export DRIFT_PKG_ROOT="{{_pkg-root}}"
	RUNNER="${DRIFT_TOOLCHAIN_ROOT}/lib/tools/drift_test_run.py"
	[[ -f "$RUNNER" ]] || { echo "error: shared executor not found at $RUNNER (need toolchain >= 0.33.17)" >&2; exit 1; }
	# Provision the microflows schema fresh BEFORE the e2e lane (already under the lock).
	just _db-load-schema
	# Test-only fixture procs (e.g. reversing-state seed for the host e2e). Private
	# recipe: already under the shared lock here (flocker is not re-entrant).
	just _db-load-test-fixtures
	WORK="$(mktemp -d -t microflows-test-XXXXXX)"
	trap 'rm -rf "$WORK"' EXIT
	python3 tools/emit_test_plan.py test --db-group "$DB_HELD_GROUP" --out "$WORK/plan.json"
	python3 "$RUNNER" --plan "$WORK/plan.json" --work-dir "$WORK" --heartbeat {{HEARTBEAT_SECS}}
	# Stored-procedure regression reuses the freshly-loaded schema (unique ids per run).
	just _test-sp

# --- Dev workflows (generic, via the same emitter) ---

# Build + run one test file (base lane). e2e files get an isolated namespace.
#   just check-one packages/microflows/tests/unit/state_test.drift
check-one FILE:
	#!/usr/bin/env bash
	set -uo pipefail
	: "${DRIFT_TOOLCHAIN_ROOT:?set DRIFT_TOOLCHAIN_ROOT to a toolchain >= 0.35.0}"
	export DRIFT_PKG_ROOT="{{_pkg-root}}"
	RUNNER="${DRIFT_TOOLCHAIN_ROOT}/lib/tools/drift_test_run.py"
	[[ -f "$RUNNER" ]] || { echo "error: shared executor not found at $RUNNER (need toolchain >= 0.33.17)" >&2; exit 1; }
	WORK="$(mktemp -d /tmp/microflows-one.XXXXXX)"
	trap 'rm -rf "$WORK"' EXIT
	python3 tools/emit_test_plan.py one --file "{{FILE}}" --out "$WORK/plan.json"
	python3 "$RUNNER" --plan "$WORK/plan.json" --work-dir "$WORK"

# Type-check one file against microflows's sources (no entry, no run).
#   just compile-check packages/microflows/src/state.drift
compile-check FILE="packages/microflows/src/lib.drift":
	#!/usr/bin/env bash
	set -uo pipefail
	: "${DRIFT_TOOLCHAIN_ROOT:?set DRIFT_TOOLCHAIN_ROOT to a toolchain >= 0.35.0}"
	export DRIFT_PKG_ROOT="{{_pkg-root}}"
	RUNNER="${DRIFT_TOOLCHAIN_ROOT}/lib/tools/drift_test_run.py"
	[[ -f "$RUNNER" ]] || { echo "error: shared executor not found at $RUNNER (need toolchain >= 0.33.17)" >&2; exit 1; }
	WORK="$(mktemp -d /tmp/microflows-compile.XXXXXX)"
	trap 'rm -rf "$WORK"' EXIT
	python3 tools/emit_test_plan.py compile --file "{{FILE}}" --out "$WORK/plan.json"
	python3 "$RUNNER" --plan "$WORK/plan.json" --work-dir "$WORK"

# --- Package lifecycle ---

# Resolve dependencies and refresh drift/lock.json against the current cert pool.
prepare:
	#!/usr/bin/env bash
	set -euo pipefail
	DRIFT="${DRIFT_TOOLCHAIN_ROOT:-$HOME/opt/drift/certified/current/toolchain}/bin/drift"
	"$DRIFT" prepare --package-root "{{_pkg-root}}"

# NON-RELEASE component manifest: this `microflows` project is for local dev / source compilation +
# component tests only. It is intentionally NOT signed or deployed as a release here (no per-component
# `author-claim` / `deploy`). The certified, DB-asset-bearing `microflows` package (code + microflows/db)
# is published ONLY from the repo-root `drift/manifest.json` via the root `just deploy` — exactly one
# signed meaning per public version (microflows = code + microflows/db). Apps that import microflows
# (the runner/service) compile it FROM SOURCE; a second same-version no-asset signed identity must never
# be created (do not run `drift author`/`drift deploy` from this component tree).

# NOTE: there is intentionally no test-time `deploy` recipe. The cross-component
# integration suite COMPILES the runner directly against these library sources
# (integration/coordinator-singular/tools/emit_test_plan.py), so `just test`
# never needs a signed package, signing keys, or author-claim mutation. A signed
# library deploy is a RELEASE operation (run `drift deploy` with real
# credentials), deliberately kept out of the test path.

# --- Stress / perf gates (Foundation standard) ---
# Empty scaffolds so certification has the recipes; populate as scenarios land.

# Stress gate. The coordinator's stress scenario is inherently CROSS-COMPONENT (it needs a live
# Singular-backed participant + the coordinator's MariaDB control state), so it lives in the integration
# suite — `integration/coordinator-singular` `just stress` (concurrent-submit recovery race), run by the
# root aggregate gate via `_integration-gate stress`. No microflows-ONLY (participant-less) stress exists.
stress:
	#!/usr/bin/env bash
	set -euo pipefail
	echo "[stress] coordinator stress is the integration gate: integration/coordinator-singular (just stress)"

# Perf gate. Same rationale: the coordinator drive-throughput perf is cross-component and lives in
# `integration/coordinator-singular` `just perf` (service drive throughput vs a committed baseline), run
# by the root aggregate via `_integration-gate perf`. No microflows-ONLY perf scenario exists.
perf:
	#!/usr/bin/env bash
	set -euo pipefail
	echo "[perf] coordinator perf is the integration gate: integration/coordinator-singular (just perf)"

# Wipe all generated artifacts under build/.
clean:
	rm -rf build

# --- Database (Mariachi) ---
# Coordinator control-state schema + stored procedures live under
# db/{schema,procs,constants,grants} in Mariachi-compatible form and are
# deployed via Mariachi (the Foundation schema orchestrator), not ad-hoc
# loaders. Mariachi handles ordering (FK parents before children) and
# idempotent apply. One-time bootstrap: `cd ../mariachi && just setup`. The Mariachi
# binary path ($MARIACHI_BIN) is resolved by the cert-env shim, sourced per recipe.

# (Re-)create the microflows schema from the db/ template via Mariachi
# (dev recreation; --destroy-database is refused on production-marked DBs).
# PUBLIC entry: acquire the shared DB lock, then run the private reset. flocker is
# REQUIRED (ships with the toolchain); missing => hard error so a destructive reset
# never runs unserialized.
db-load-schema:
	#!/usr/bin/env bash
	set -euo pipefail
	source "../tools/cert-env.sh"
	[[ -x "{{FLOCKER}}" ]] || { echo "error: flocker not found at {{FLOCKER}} (required for DB serialization; ships with the toolchain)" >&2; exit 1; }
	exec "{{FLOCKER}}" --key "$DB_LOCK" -j 1 -- just _db-load-schema

# PRIVATE: the actual destructive reset. Runs ONLY under the shared lock (held by
# `db-load-schema` or `_test-locked`) — not a standalone entry point.
_db-load-schema:
	#!/usr/bin/env bash
	set -euo pipefail
	source "../tools/cert-env.sh"
	"$DB_INSTANCE_SH" up >/dev/null   # ensure our repo-private MariaDB fixture is running (idempotent; ~8ms if up)
	[[ -x "$MARIACHI_BIN" ]] || { echo "error: mariachi not found at '$MARIACHI_BIN' (set MARIACHI_BIN or DRIFT_CERT_CAPABILITIES.tool:mariachi)" >&2; exit 1; }
	"$MARIACHI_BIN" \
	  --schema-template db \
	  --host "$DB_HOST" --port "$DB_PORT" \
	  --user "$DB_USER" --password-env MDB_ROOT_PWD \
	  apply --schema {{DB_SCHEMA}} --env=development --allow-destructive --destroy-database

# Load TEST-ONLY fixture procedures into a SEPARATE `microflows_test` schema (Mariachi template
# db-tests/seed) — they write into the product `microflows` schema with qualified names. NOT part of
# the production schema apply — only the test gate (and dev e2e runs) load these. Run AFTER
# db-load-schema (which destroys+recreates the product schema).
# PUBLIC entry: acquire the shared DB lock, then run the private load. flocker is
# REQUIRED so a direct invocation can never overlap another checkout's tests.
db-load-test-fixtures:
	#!/usr/bin/env bash
	set -euo pipefail
	source "../tools/cert-env.sh"
	[[ -x "{{FLOCKER}}" ]] || { echo "error: flocker not found at {{FLOCKER}} (required for DB serialization; ships with the toolchain)" >&2; exit 1; }
	exec "{{FLOCKER}}" --key "$DB_LOCK" -j 1 -- just _db-load-test-fixtures

# PRIVATE: the actual fixture load. Runs ONLY under the shared lock (held by the
# public wrapper or by _test-locked). Test-only seed procs live in a SEPARATE Mariachi-managed
# schema `microflows_test` (db-tests/seed) that writes into the product `microflows` schema with
# qualified names — loaded the same way as everything else, via Mariachi (the one declared DB tool).
# No mariadb client binary; not in the product schema (the app/prod role is never granted EXECUTE here).
_db-load-test-fixtures:
	#!/usr/bin/env bash
	set -euo pipefail
	source "../tools/cert-env.sh"
	"$MARIACHI_BIN" \
	  --schema-template db-tests/seed \
	  --host "$DB_HOST" --port "$DB_PORT" \
	  --user "$DB_USER" --password-env MDB_ROOT_PWD \
	  apply --schema microflows_test --env development --allow-destructive --destroy-database

# Plan a schema diff (no mutation) via Mariachi.
db-plan:
	#!/usr/bin/env bash
	set -euo pipefail
	source "../tools/cert-env.sh"
	[[ -x "$MARIACHI_BIN" ]] || { echo "error: mariachi not found at '$MARIACHI_BIN' (set MARIACHI_BIN or DRIFT_CERT_CAPABILITIES.tool:mariachi)" >&2; exit 1; }
	"$MARIACHI_BIN" \
	  --schema-template db \
	  --host "$DB_HOST" --port "$DB_PORT" \
	  --user "$DB_USER" --password-env MDB_ROOT_PWD \
	  plan --schema {{DB_SCHEMA}}

# DEV-ONLY ad-hoc SQL convenience — NOT on any cert gate path (test/stress/perf never reach it). This
# one recipe uses the `mariadb` client for interactive output; it is the ONLY remaining mariadb-CLI use
# and is intentionally not part of the cert capability surface (which is exactly tool:mariachi +
# tool:docker). Cert-gate DB work all goes through Mariachi against the repo-private Docker fixture.
db-sql SQL:
	#!/usr/bin/env bash
	set -euo pipefail
	source "../tools/cert-env.sh"
	mariadb -h "$DB_HOST" -P "$DB_PORT" -u "$DB_USER" -p"${MDB_ROOT_PWD}" {{DB_SCHEMA}} -e "{{SQL}}"

# Focused SQL regression for the operation lifecycle stored procedures
# (NULL fencing, command-identity conflict, idempotent settle, invariants) PLUS the
# composition (1b.1) workflow-call stored procedures (sp_call_test.py).
# Requires the schema loaded (just db-load-schema) + MDB_ROOT_PWD.
# PUBLIC entry: acquire the shared DB lock, then run the private regression.
test-sp:
	#!/usr/bin/env bash
	set -euo pipefail
	source "../tools/cert-env.sh"
	[[ -x "{{FLOCKER}}" ]] || { echo "error: flocker not found at {{FLOCKER}} (required for DB serialization; ships with the toolchain)" >&2; exit 1; }
	exec "{{FLOCKER}}" --key "$DB_LOCK" -j 1 -- just _test-sp

# PRIVATE: the DB-backed regression. Runs ONLY under the shared lock (held by
# `test-sp` or `_test-locked`).
_test-sp:
	#!/usr/bin/env bash
	set -euo pipefail
	source "../tools/cert-env.sh"
	# Honor the MARIACHI_BIN env contract: the SP regression needs the mariachi venv's PYTHON
	# (pymysql), which lives beside the `mariachi` binary — derive it instead of hardcoding a path.
	MARIACHI_PY="$(dirname "$MARIACHI_BIN")/python"
	[[ -x "$MARIACHI_PY" ]] || { echo "error: mariachi venv python not found at $MARIACHI_PY (set MARIACHI_BIN to the venv's mariachi binary)" >&2; exit 1; }
	"$MARIACHI_PY" db-tests/sp_operation_test.py
	"$MARIACHI_PY" db-tests/sp_call_test.py
	# 1b.1: runner-level integration (actual NeedCall dispatch + call_kind reversal through the built
	# mfrunner binary, not just the SP layer). Needs the binary the top-level `test` recipe already
	# built (`cd runner && just test`, which runs before the DB lock is taken).
	MF_RUNNER_BIN="$(pwd)/runner/build/dist/bin/mfrunner" "$MARIACHI_PY" db-tests/call_integration_test.py

# NOTE: the cross-component coordinator<->Singular E2E moved to the repository
# level: integration/coordinator-singular/ (run via root `just test-integration`
# or `just test`). The fixtures it seeds remain a microflows schema asset at
# db-tests/coordinator/scenarios/coordinator-fixtures/.
