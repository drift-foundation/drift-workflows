# --- Package lifecycle ---

# Resolve dependencies and refresh drift/lock.json against the current cert pool.
prepare:
	#!/usr/bin/env bash
	set -euo pipefail
	DRIFT="${DRIFT_TOOLCHAIN_ROOT:-$HOME/opt/drift/certified/current/toolchain}/bin/drift"
	"$DRIFT" prepare --package-root "{{_pkg-root}}"

# Re-mint drift/microflows.author-claim under the Drift Foundation author key
# (Foundation convention: tools.drift_author + DRIFT_SIGN_KEY_FILE). Run after
# any source change that affects SCI (modules, assets, deps, version).
author-claim:
	#!/usr/bin/env bash
	set -euo pipefail
	DRIFT_LANG_ROOT="${DRIFT_LANG_ROOT:-${HOME}/src/drift-lang}"
	KEY_FILE="${DRIFT_SIGN_KEY_FILE:-${HOME}/.config/drift/keys/default.seed}"
	[[ -d "${DRIFT_LANG_ROOT}/tools/drift_author" ]] || { echo "error: tools.drift_author not found at ${DRIFT_LANG_ROOT}" >&2; exit 1; }
	[[ -f "${KEY_FILE}" ]] || { echo "error: signing key not found: ${KEY_FILE}" >&2; exit 1; }
	echo "[author-claim] minting drift/microflows.author-claim"
	PYTHONPATH="${DRIFT_LANG_ROOT}" python3 -m tools.drift_author publish \
	  --manifest "$(pwd)/drift/manifest.json" \
	  --artifact microflows \
	  --key-file "${KEY_FILE}" \
	  --overwrite

